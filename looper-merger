#
# looper-merger: a project's merger (looper#251; tacplus-dev/roadmap
# decisions/agentic-dev-flow-2026-11-25.md, step 5 and the panel's items 4, 5
# and 7, D1 and D2). A small fixed program, not an agent: it runs on a machine
# that runs no project code (no checkout, no build: it reads and writes the
# forge alone), as the identity that may write main (the ruleset's bypass
# actor, looper#83), and it decides nothing a model would.
#
#   looper-merger pass --repo NAME [--dry-run]
#                     one pass over NAME's open merge requests into main, one at
#                     a time, by priority label (priority:high, unlabelled,
#                     priority:low), then oldest; --dry-run says what it would
#                     do and writes nothing. Exit 0 when the pass ran (whatever
#                     it merged or held), 2 when it could not read what it needs
#
# A merge request (a GitHub pull request into main, from a branch of the same
# repository: a fork's is never merged) is:
#   green      its head carries the commit status LOOPER_MERGER_CONTEXT (default
#              looper/gates: not tacplus-dev/build, which a report's own --build
#              sets too, on the gate set it chose: PROPOSALS.md) success, set by
#              one of LOOPER_MERGER_TRUSTED (logins, comma-separated, required:
#              the identity a report cannot mint, panel item 5; a status of
#              anyone else's is not read). Pending, red or none, it waits: its
#              report's business.
#   clean      green, and GitHub finds it mergeable into main: it is merged at
#              once, with no build, while the rolling check's gate is open (below):
#              a merge commit, one first-parent commit of main per merge request
#              (what the check bisects and reverts whole), at exactly the head
#              that is green (`sha`, so a push after the status merges nothing).
#              A mergeability GitHub has not computed yet waits for the next pass.
#   conflicting  green, and not mergeable: sent back to its issue (the branch
#              `looper/NAME-N` or `looper/mr-NAME-N`, else a `Closes #N` in its body), whose next
#              report resolves it, the agent with the change's context (panel
#              item 4): a comment on the merge request and on the issue, and the
#              issue's looper:landing and looper:merge-request (a VM report's
#              hold, looper#250) removed so it is ready again. Once per
#              head: the merge request's comment carries the head it sent back.
# A merged one gets "The merger merged" on its issue, and its looper:landing
# and looper:merge-request removed, so the issue's next run reports and closes it.
#
# The bound (panel item 7, D2): clean merges are unbuilt only while the
# rolling check (looper#249) is behind them, and it is the check's to say:
# before each clean merge the merger asks its gate, LOOPER_MERGER_GATE (default
# `looper-check gate`, beside this script) --repo NAME --branch BRANCH --sha
# HEAD --dir LOOPER_MERGER_DIR/clones/NAME (its clone: objects, no checkout).
# Exit 0 open, anything else closed: no main-green or no state of the check,
# the check red, bisecting or reverting (but for the recovery's own branch),
# more than 4 merges on main unchecked or the oldest of them older than its
# age, or a head that builds on a merge main reverted. Its one line is the
# merger's reason, logged with the hold. Asked for each one, after the pass's
# own merges, so each counts at once; one that cannot be asked (no looper-check
# yet, GitHub unreadable) is closed: the merger is live only with the check.
# Conflicts go back whatever the gate says.
#
# The shadow compile (D1): with LOOPER_MERGER_SHADOW set, a command, after the
# pass's merges it runs `$LOOPER_MERGER_SHADOW NAME SHA` for each merge commit
# (the merged tree), at most LOOPER_MERGER_SHADOW_TIMEOUT seconds (default
# 600), and appends what it measured to LOOPER_MERGER_DIR/shadow.tsv (default
# $HOME/looper-merger): time, repository, merge request, head, merge commit,
# exit and seconds. It is measured, never required: its result merges or holds
# nothing. The merger runs no project code, so the command asks another
# machine for the compile (the project's VM). Requiring it is a decision on its
# numbers (PROPOSALS.md), not a mode here.
#
# Environment: GH_TOKEN or GH_CONFIG_DIR (gh's: the main-writing identity for a
# pass, a reader's for --dry-run), LOOPER_ORG, LOOPER_MERGER_TRUSTED,
# LOOPER_MERGER_CONTEXT, LOOPER_MERGER_GATE, LOOPER_MERGER_GATE_TIMEOUT
# (seconds, default 300), LOOPER_MERGER_SHADOW, LOOPER_MERGER_SHADOW_TIMEOUT,
# LOOPER_MERGER_DIR; the gate's own (LOOPER_CHECK_LOGIN, the check's login,
# whose statuses alone it reads; LOOPER_CHECK_MAX_UNCHECKED, LOOPER_CHECK_MAX_AGE).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=looper-lib.sh
source "${LOOPER_LIB:-$HERE/looper-lib.sh}"

CONTEXT="${LOOPER_MERGER_CONTEXT:-looper/gates}"
read -ra GATE <<<"${LOOPER_MERGER_GATE:-$HERE/looper-check gate}"
GATE_TIMEOUT="${LOOPER_MERGER_GATE_TIMEOUT:-300}"
SHADOW="${LOOPER_MERGER_SHADOW:-}"
SHADOW_TIMEOUT="${LOOPER_MERGER_SHADOW_TIMEOUT:-600}"
DIR="${LOOPER_MERGER_DIR:-$HOME/looper-merger}"

usage() { sed -n '/^#   looper-merger pass/,/^#$/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# The newest state of commit SHA's status CONTEXT set by a trusted login, or nothing.
status_of() { # sha context
  gh api "repos/$R/commits/$1/statuses?per_page=100" | jq -r --arg ctx "$2" --arg trusted "$LOOPER_MERGER_TRUSTED" '
    ($trusted | split(",") | map(select(. != ""))) as $t
    | first(.[] | select(.context == $ctx and ((.creator.login // "") as $l | $t | index($l)))) | .state // empty'
}

# The rolling check's gate for a clean merge request: GATE_SAYS its line;
# exit 0 open, 1 closed (or it could not be asked).
gate() { # branch head
  local rc=0 out
  out="$(timeout -k 10 "$GATE_TIMEOUT" "${GATE[@]}" --repo "$REPO" --branch "$1" --sha "$2" --dir "$DIR/clones/$REPO" 2>>"$DIR/gate.log")" || rc=$?
  GATE_SAYS="$(tail -n 1 <<<"$out")"
  case "$rc" in
    0) return 0 ;;
    1) [[ -n "$GATE_SAYS" ]] || GATE_SAYS="closed (it said nothing)" ;;
    *) GATE_SAYS="the rolling check's gate could not be asked (exit $rc)${GATE_SAYS:+: $GATE_SAYS}" ;;
  esac
  return 1
}

# The issue a merge request works: its branch's, looper/NAME-N or a VM report's
# looper/mr-NAME-N (looper#250), else its body's Closes #N.
issue_of() { # head-ref body
  if [[ "$1" =~ ^looper/(mr-)?${REPO//./\\.}-([0-9]+)$ ]]; then echo "${BASH_REMATCH[2]}"; return; fi
  grep -oiE '\b(close[sd]?|fix(e[sd])?|resolve[sd]?) #[0-9]+' <<<"$2" | head -1 | grep -oE '[0-9]+$' || true
}

# Sends back a conflicting merge request, once per head.
send_back() { # pr head issue
  local pr="$1" head="$2" n="$3" who mark="<!-- looper-merger: sent back $2 -->"
  if gh api "repos/$R/issues/$pr/comments?per_page=100" --jq '.[].body' | grep -qF -- "$mark"; then
    log "#$pr: conflicts with main; sent back already at ${head:0:7}"; return
  fi
  if [[ -n "$DRY" ]]; then log "#$pr: would send back (conflicts with main)${n:+ to #$n}"; return; fi
  who="Its report"; [[ -z "$n" ]] || who="Issue #$n's next report"
  forge_issue_comment "$REPO" "$pr" "The merger sent this back: it conflicts with main at ${head:0:7}, and the merger resolves nothing (looper#251). $who resolves the conflict, builds and pushes; the merger merges it once it is clean and green.
$mark"
  if [[ -n "$n" ]]; then
    forge_issue_comment "$REPO" "$n" "The merger sent back #$pr: it conflicts with main at ${head:0:7}. This issue's next report resolves the conflict (it has the change's context), builds its gates and pushes; the merger merges it once it is clean and green (looper#251)."
    forge_issue_edit "$REPO" "$n" --remove-label "$LABEL_LANDING" --remove-label "$LABEL_MR" || log "#$n: could not remove $LABEL_LANDING, $LABEL_MR"
  fi
  log "#$pr: sent back (conflicts with main)${n:+ to #$n}"
}

pass() {
  local prs pr head ref body n iss mergeable st sha merged=()
  log "$R: a merger's pass${DRY:+ (dry run)}"
  prs="$(gh api "repos/$R/pulls?state=open&base=main&per_page=100" | jq -c --arg repo "$R" "
    map(select(.draft | not) | . + {createdAt: .created_at, fork: (.head.repo.full_name != \$repo)})
    | sort_by($ISSUE_ORDER)[] | {number, title, sha: .head.sha, ref: .head.ref, body: (.body // \"\"), fork}")" ||
    die "$R: could not list its merge requests"
  [[ -n "$prs" ]] || { log "$R: no open merge request"; return 0; }
  mkdir -p "$DIR/clones"
  while IFS= read -r pr; do
    n="$(jq -r .number <<<"$pr")"; head="$(jq -r .sha <<<"$pr")"; ref="$(jq -r .ref <<<"$pr")"; body="$(jq -r .body <<<"$pr")"
    iss="$(issue_of "$ref" "$body")"
    [[ "$(jq -r .fork <<<"$pr")" == false ]] || { log "#$n: from a fork: never merged"; continue; }
    st="$(status_of "$head" "$CONTEXT")" || die "$R: could not read #$n's statuses"
    [[ "$st" == success ]] || { log "#$n: not green at ${head:0:7} ($CONTEXT ${st:-none}): waits"; continue; }
    mergeable="$(gh api "repos/$R/pulls/$n" --jq '.mergeable')" || die "$R: could not read #$n"
    case "$mergeable" in
      true) ;;
      false) send_back "$n" "$head" "$iss"; continue ;;
      *) log "#$n: GitHub has not computed its mergeability yet: the next pass"; continue ;;
    esac
    # A conflict goes back whatever the gate says; a clean merge waits for it.
    gate "$ref" "$head" || { log "#$n: clean and green at ${head:0:7}: held, $GATE_SAYS"; continue; }
    if [[ -n "$DRY" ]]; then log "#$n: would merge ${head:0:7}, unbuilt"; continue; fi
    sha="$(gh api -X PUT "repos/$R/pulls/$n/merge" -f sha="$head" -f merge_method=merge --jq .sha)" ||
      { log "#$n: GitHub refused its merge at ${head:0:7}: the next pass"; continue; }
    merged+=("$n $head $sha")
    log "#$n: merged ${head:0:7} as ${sha:0:7}, unbuilt (the rolling check's gate: $GATE_SAYS)"
    [[ -n "$iss" ]] || continue
    forge_issue_comment "$REPO" "$iss" "The merger merged #$n (${head:0:7}, its $CONTEXT green) into main as ${sha:0:7}, unbuilt: a clean merge, the rolling check's gate open ($GATE_SAYS); the check builds it next (looper#251)." ||
      log "#$iss: could not comment"
    forge_issue_edit "$REPO" "$iss" --remove-label "$LABEL_LANDING" --remove-label "$LABEL_MR" || log "#$iss: could not remove $LABEL_LANDING, $LABEL_MR"
  done <<<"$prs"
  [[ -z "$SHADOW" ]] || shadow "${merged[@]}"
}

# The shadow compile (D1) of each merge commit: measured, never required.
shadow() { # "pr head sha"...
  local m pr head sha rc t0 t
  mkdir -p "$DIR"
  for m in "$@"; do
    read -r pr head sha <<<"$m"
    t0="$(date +%s)"; rc=0
    timeout -k 10 "$SHADOW_TIMEOUT" "$SHADOW" "$REPO" "$sha" > "$DIR/shadow-$pr.log" 2>&1 || rc=$?
    t=$(( $(date +%s) - t0 ))
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$REPO" "$pr" "$head" "$sha" "$rc" "$t" >> "$DIR/shadow.tsv"
    log "#$pr: shadow compile of ${sha:0:7}: exit $rc in ${t}s (measured, never required)"
  done
}

[[ $# -ge 1 ]] || usage
CMD="$1"; shift
REPO=""; DRY=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) REPO="${2:-}"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    *) usage ;;
  esac
done
[[ "$CMD" == pass && -n "$REPO" ]] || usage
[[ "$LOOPER_FORGE" == github ]] || die "the merger merges GitHub pull requests: LOOPER_FORGE=$LOOPER_FORGE"
[[ -n "${LOOPER_MERGER_TRUSTED:-}" ]] || die "LOOPER_MERGER_TRUSTED names no login whose statuses the merger trusts"
[[ "$GATE_TIMEOUT" =~ ^[0-9]+$ ]] || die "LOOPER_MERGER_GATE_TIMEOUT: '$GATE_TIMEOUT' is not a whole number of seconds"
need gh; need jq
R="$LOOPER_ORG/$REPO"
pass
