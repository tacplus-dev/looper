#
# looper-scan: the build pipeline's deterministic security checks (looper#49;
# README: Security checks). A floor under the nightly agent scan: the same
# commit, the same tools (pinned in the looper image), the vulnerability
# databases of the day (their snapshot recorded), the same policy.
#
#   run      the security job (security-<repo>, in the child pipeline
#            looper-build plan writes): every tool of the run's kind on the
#            commit's checkout and on the code its gates generated
#            (generated/, the gates job's artifact), the policy and the
#            security-exceptions.yaml of the commit; the reports in security/
#   report   the security-report job: the run's findings as the repository's
#            latest (the build project's generic package security-<repo>),
#            what the nightly agent scan reads, and as its commit's; a
#            nightly's as the last nightly's too (version nightly), what every
#            run's new is measured against (looper#211)
#   local    the same checks on a checkout, by hand: no credential, no previous run
#   baseline a run's findings as the repository's recorded baseline
#            (security-baseline.json, looper#146): what it accepts as its start
#   sbom     an SBOM, CycloneDX and SPDX, of a source (publish: the release image)
#   image    the Go binaries of an image (looper#167): govulncheck -mode=binary
#            on each under its /usr/local/bin, the policy, a commit's exceptions
#
# The kinds (BUILD_SCAN_KIND): build (every build): OSV-Scanner, govulncheck,
# cargo-deny, Semgrep CE, gitleaks, gosec, clippy, Bandit, SpotBugs with
# FindSecBugs, Trivy on the release jars the gates built (the dependencies
# they shade, looper#147), and a Syft SBOM; nightly and release add CodeQL
# and Trivy (filesystem, Kubernetes manifests, the Dockerfiles' base images).
# They run side by side, BUILD_SCAN_JOBS at a time (default the job's CPUs),
# each one's duration in the summary (looper#207); a build's gitleaks reads
# the commit's tree, not the code its gates generated from it.
#
# The policy: a secret fails, and so does a HIGH or CRITICAL finding with a
# fix (a fixed version, or our own code: a SAST finding outside test code,
# looper#179, which is listed, never failing), unless an unexpired
# exception names it; an exception that has expired, or says less than an id,
# a reason, who decided and an expiry date, fails too. A finding the commit's
# security-baseline.json records (by tool, rule and file, not line: up to its
# count) is baselined, never new (new: not the last nightly's, looper#211); a secret, a HIGH or CRITICAL finding, one
# the policy fails or an exception accepts is never baselined. A land's build
# (BUILD_BASE: main's commit it is built on, looper#180) fails only on the
# blocking findings its change adds: one the base's build reported too (by
# tool, rule and file, up to its count) is standing, reported and not failed,
# the nightly's to file (a base no build published: its nearest published
# first-parent ancestor's, else the last nightly's, looper#217); a nightly and a release fail on every one. A tool that cannot run
# fails the run. It runs in the looper image (jq, the scanners), never in the
# repository's build image; it sources looper-build for the build's
# credentials (the tacplus-reader app, read-only) and checkout.
set -euo pipefail

SCAN_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Whether BUILD_OUT was given (looper-build's default is here): local's reports
# go to a directory of their own without it (looper#161).
SCAN_OUT_GIVEN="${BUILD_OUT:+1}"
# shellcheck source=looper-build
source "${LOOPER_BUILD:-$SCAN_SELF_DIR/looper-build}"

SCAN_KIND="${BUILD_SCAN_KIND:-build}"
SCAN_OUT="$BUILD_OUT/security"
# Semgrep CE's community rules (the Semgrep Rules License v1.0: free to use on
# our own code, README), fetched from the registry each run.
SEMGREP_CONFIG="${BUILD_SEMGREP_CONFIG:-p/default}"
# clippy's security lints: denied, every other lint allowed.
CLIPPY_LINTS="${BUILD_CLIPPY_LINTS:--A clippy::all -D clippy::correctness -D clippy::suspicious}"
FINDSECBUGS="${BUILD_FINDSECBUGS:-/opt/scanners/findsecbugs-plugin.jar}"
# SpotBugs' heap in MB (its -maxHeap); unset, it is sized to the job's memory.
SPOTBUGS_MAXHEAP="${BUILD_SPOTBUGS_MAXHEAP:-}"
# CodeQL (nightly and release): the bundle is fetched when a run needs it,
# checked against its pinned checksum (it is 680 MB: not in the image).
CODEQL_VERSION="${BUILD_CODEQL_VERSION:-2.27.3}"
CODEQL_URL="${BUILD_CODEQL_URL:-https://github.com/github/codeql-action/releases/download/codeql-bundle-v$CODEQL_VERSION/codeql-bundle-linux-arm64.tar.gz}"
CODEQL_SHA256="${BUILD_CODEQL_SHA256:-0c9e32e9fcf65be4ab8df0cf0a7bb83e64aff4099fffc5f4930e84c12a454c8b}"
CODEQL_DIR="${BUILD_CODEQL_DIR:-${HOME:-/tmp}/.cache/looper-codeql/$CODEQL_VERSION}"
# CodeQL's memory in MB (its --ram) and threads (its --threads); unset, they
# are sized to the job's memory and CPUs, never the node's (looper#189).
CODEQL_RAM="${BUILD_CODEQL_RAM:-}"
CODEQL_THREADS="${BUILD_CODEQL_THREADS:-}"
# The job's cgroup, whose limits size SpotBugs and CodeQL.
SCAN_CGROUP="${BUILD_SCAN_CGROUP:-/sys/fs/cgroup}"
# The exceptions a repository accepts, at its root.
EXCEPTIONS_FILE=security-exceptions.yaml
# The findings a repository accepts as its starting point, at its root (looper#146).
BASELINE_FILE=security-baseline.json
# What a baseline records and matches: a finding no policy fails, not a secret,
# MEDIUM, LOW or UNKNOWN, no exception's; its file, its where without the line
# or the line range (gosec's "669-684", looper#156), whose first line is its line.
JQ_BASELINE='
def baselinable: .excepted == null and (.blocking | not) and .kind != "secret" and (.severity | IN("MEDIUM", "LOW", "UNKNOWN"));
def file_of: .where | sub(":[0-9]+(-[0-9]+)?$"; "");
def line_of: (.where | capture(":(?<l>[0-9]+)(-[0-9]+)?$").l // "0") | tonumber;
'
# A HIGH or CRITICAL finding the last nightly had too (not new), neither
# baselined nor excepted: the summary's standing ones, which the nightly scan
# files when no open issue names them (looper#211).
JQ_STANDING='
def standing_high: (.severity | IN("HIGH", "CRITICAL")) and (.new | not) and (.baselined | not) and .excepted == null;
'
# An exception's where (looper#182), a path glob, as a regular expression on a
# finding's file_of: * and ? match within a path segment, ** across them ("**/"
# also none); every other character is itself. A dependency's where is its
# package and, in parentheses, its file ("golang.org/x/text@0.3.0 (go.mod)",
# govulncheck's "(go.mod, called: ...)"): that file matches too (looper#183).
JQ_GLOB='
def glob_re: "^" + (split("**/") | map(split("**") | map(split("*") | map(split("?")
    | map(gsub("(?<c>[.+^$()|{}\\[\\]\\\\])"; "\\\(.c)")) | join("[^/]")) | join("[^/]*")) | join(".*")) | join("(.*/)?")) + "$";
def in_where($glob): ($glob | glob_re) as $re
  | (file_of | test($re)) or any(.where | capture("^[^ ]+ \\((?<p>[^,)]+)[,)]").p; test($re));
'

scan_usage() {
  cat <<'EOF'
usage: looper-scan run               the security checks of BUILD_REPO at BUILD_SHA (BUILD_SCAN_KIND build|nightly|release)
       looper-scan local DIR         the same checks on a checkout (and DIR's generated/ under BUILD_OUT), nothing published
       looper-scan report            the run's findings, published as the repository's latest (a nightly's also as the last nightly's, what new is measured against)
       looper-scan baseline FINDINGS a run's findings.json as a security-baseline.json (MEDIUM, LOW and UNKNOWN only)
       looper-scan sbom SOURCE DIR   a CycloneDX and an SPDX SBOM of SOURCE (dir:..., oci-archive:...) in DIR
       looper-scan image ROOT DIR    the Go binaries under ROOT/usr/local/bin (an image's root), govulncheck -mode=binary,
                                     under the policy with DIR's security-exceptions.yaml and security-baseline.json
Reports go to BUILD_OUT/security (default: ./security; local: a new temporary directory, which its
summary names). local never scans its own reports: a BUILD_OUT/security inside DIR is written once the scan is done.
EOF
}

# The run's verdict, security/verdict: "pass" or "fail: <why>"; fail ends the job.
scan_verdict() { # pass | fail <why>
  if [[ "$1" == pass ]]; then
    echo pass > "$SCAN_OUT/verdict"; log "security verdict: pass"
  else
    shift; echo "fail: $*" > "$SCAN_OUT/verdict"; log "security verdict: FAIL: $*"; exit 1
  fi
}

# A tool that could not run: at a tree's root it fails the run; in a project
# nested in the tree (a fixture, an example) it is listed as not analyzed.
problems=()
notes=()
# What the run reports and does not fail on: an exception not scoped by a where.
warnings=()
# The memory CodeQL's analyses took, at their peak (looper#189).
peaks=()
tool_error() { # tool tree dir what
  if [[ "$3" == "$2" ]]; then problems+=("$1: $4"); else notes+=("$1: ${3#"$2"/}: not analyzed ($4)"); fi
  log "$1: $4 ($3)"
}

# Why a tool that failed did: the exception a JVM threw ("Exception in thread
# ..."), else the last exception a log names (a Python traceback's), else its
# last line; never the tail of a stack (looper#149).
tool_cause() { # log
  local l
  l="$(grep -m1 '^Exception in thread ' "$1")" ||
    l="$(grep -E '^(Caused by: )?[A-Za-z_][A-Za-z0-9_.$]*(Exception|Error)(: |$)' "$1" | tail -1)" || l=""
  [[ -n "$l" ]] || l="$(tail -1 "$1")"
  printf '%s' "$l"
}

need() { # tool
  command -v "$1" >/dev/null || { problems+=("$1: not in this image"); return 1; }
}

# The projects of a tree: the directories holding a file name, outside
# dependency, build output and test-data directories, sorted.
projects() { # tree file
  find "$1" \( -name .git -o -name node_modules -o -name vendor -o -name target -o -name testdata -o -name .venv \) -prune \
    -o -name "$2" -type f -print | xargs -r -n1 dirname | LC_ALL=C sort -u
}
has_files() { # tree glob
  [[ -n "$(find "$1" \( -name .git -o -name node_modules -o -name target -o -name .venv \) -prune -o -name "$2" -type f -print -quit)" ]]
}

# --- the tools ----------------------------------------------------------------
# Each writes its native report(s) to security/raw/<tool>-<label>*.json and
# its findings, normalized, to security/norm/<tool>-<label>*.json: an array of
# {tool, kind (sca|sast|secret|policy|config), id, aliases, severity, fix,
# where, title}. where is a path in the tree, prefixed with generated/ for
# the generated code; the tree's label is source or generated.

# A CVSS score (or v3 vector) as a severity.
JQ_LIB='
def bucket: if . == null then "UNKNOWN" elif . >= 9 then "CRITICAL" elif . >= 7 then "HIGH"
  elif . >= 4 then "MEDIUM" elif . > 0 then "LOW" else "UNKNOWN" end;
def roundup: (. * 10 | ceil) / 10;
# A finding the tool itself has LOW confidence in counts one severity lower.
def unsure($confidence): if $confidence == "LOW" then {"CRITICAL": "HIGH", "HIGH": "MEDIUM", "MEDIUM": "LOW"}[.] // . else . end;
def cvss3: (if type == "string" and test("^CVSS:3") then
    (split("/")[1:] | map(split(":") | {(.[0]): .[1]}) | add) as $m
    | ({"N": 0.85, "A": 0.62, "L": 0.55, "P": 0.2}[$m.AV]) as $av
    | ({"L": 0.77, "H": 0.44}[$m.AC]) as $ac
    | (if $m.S == "C" then {"N": 0.85, "L": 0.68, "H": 0.5} else {"N": 0.85, "L": 0.62, "H": 0.27} end)[$m.PR] as $pr
    | ({"N": 0.85, "R": 0.62}[$m.UI]) as $ui
    | ({"H": 0.56, "L": 0.22, "N": 0}) as $cia
    | (1 - (1 - $cia[$m.C]) * (1 - $cia[$m.I]) * (1 - $cia[$m.A])) as $iss
    | (if $m.S == "C" then 7.52 * ($iss - 0.029) - 3.25 * pow($iss - 0.02; 15) else 6.42 * $iss end) as $imp
    | (8.22 * $av * $ac * $pr * $ui) as $exp
    | if $imp <= 0 then 0 elif $m.S == "C" then ([1.08 * ($imp + $exp), 10] | min | roundup)
      else ([$imp + $exp, 10] | min | roundup) end
  else null end);
def finding($tool; $kind; $id; $aliases; $sev; $fix; $where; $title):
  {tool: $tool, kind: $kind, id: $id, aliases: ($aliases // [] | map(select(. != $id)) | unique),
   severity: $sev, fix: $fix, where: $where, title: ($title // "" | tostring | .[0:300])};
def rel($root; $prefix): ltrimstr($root + "/") | ltrimstr("./") | $prefix + .;
'

norm() { # out jq-program raw [jq args...]
  local out="$1" prog="$2" raw="$3"; shift 3
  jq -s "$@" "$JQ_LIB $prog" "$raw" > "$out.tmp" && mv "$out.tmp" "$out"
}

tool_osv() { # tree label prefix
  need osv-scanner || return 0
  local raw="$SCAN_OUT/raw/osv-scanner-$2.json" rc=0
  osv-scanner scan source -r --format json --output "$raw" "$1" >/dev/null 2>"$SCAN_OUT/raw/osv-scanner-$2.log" || rc=$?
  if ((rc > 1 && rc != 128)) && grep -q '^failed resolution for ' "$SCAN_OUT/raw/osv-scanner-$2.log"; then
    # A manifest whose transitive dependencies it cannot resolve (a Maven
    # module's sibling SNAPSHOT): its declared dependencies only, and said so.
    notes+=("osv-scanner: $2: transitive dependencies not resolved: $(grep -m1 '^failed resolution for ' "$SCAN_OUT/raw/osv-scanner-$2.log" | cut -c1-200)")
    rc=0; osv-scanner scan source -r --no-resolve --format json --output "$raw" "$1" >/dev/null 2>>"$SCAN_OUT/raw/osv-scanner-$2.log" || rc=$?
  fi
  case "$rc" in 0|1) ;; 128) echo '{"results": []}' > "$raw" ;; *) tool_error osv-scanner "$1" "$1" "exited $rc: $(grep -m1 -i error "$SCAN_OUT/raw/osv-scanner-$2.log")"; return 0 ;; esac
  norm "$SCAN_OUT/norm/osv-scanner-$2.json" '
    [.[0].results[]? | (.source.path | rel($root; $prefix)) as $where | .packages[]? | .package as $p | (.vulnerabilities // []) as $vs
     | .groups[]? | . as $g
     | ([$vs[] | select(.id as $i | $g.ids | index($i)) | .affected[]?.ranges[]?.events[]? | .fixed // empty] | length > 0) as $fix
     | finding("osv-scanner"; "sca"; $g.ids[0]; ($g.aliases + $g.ids); ($g.max_severity | if . == null or . == "" then null else tonumber end | bucket);
               $fix; ($p.name + "@" + ($p.version // "") + " (" + $where + ")");
               ([$vs[] | select(.id == $g.ids[0]) | .summary // empty][0]))]' \
    "$raw" --arg root "$1" --arg prefix "$3"
}

tool_govulncheck() { # tree label prefix
  local d i=0 raw
  [[ -n "$(projects "$1" go.mod)" ]] || return 0
  need govulncheck || return 0
  while read -r d; do
    i=$((i + 1)); raw="$SCAN_OUT/raw/govulncheck-$2-$i.json"
    if ! (cd "$d" && govulncheck -format json ./... > "$raw" 2>"$raw.log"); then
      tool_error govulncheck "$1" "$d" "$(grep -m1 . "$raw.log")"; continue
    fi
    norm "$SCAN_OUT/norm/govulncheck-$2-$i.json" "$JQ_GOVULNCHECK" "$raw" --arg where "$(rel_dir "$1" "$d" "$3")go.mod"
  done < <(projects "$1" go.mod)
}

# Reachable only: a finding whose trace reaches a vulnerable function, the
# first by package and function (govulncheck's order varies from run to run);
# where is the module's place (its go.mod, a binary).
JQ_GOVULNCHECK='
([.[] | .osv // empty | {(.id): .}] | add // {}) as $osv
| [.[] | .finding // empty | select(.trace[0].function != null)]
| sort_by(.osv, .trace[0].package, .trace[0].function) | unique_by(.osv) | map(.trace[0] as $t
  | finding("govulncheck"; "sca"; .osv; ($osv[.osv].aliases // []); "HIGH"; ((.fixed_version // "") != "");
            ($t.module + "@" + ($t.version // "") + " (" + $where + ", called: " + ($t.package // "") + "." + ($t.function // "") + ")");
            $osv[.osv].summary))'

# The base image's binaries, as an image's Dockerfile records them before it
# adds its own (looper#167): a first line "# <base image>", then each file of
# its /usr/local/bin as sha256sum prints it ("<sha256>  /usr/local/bin/<name>").
BASE_RECORD=usr/local/share/looper/base-image.sha256
# The repository a base image is built from: ghcr.io/<org>/<repo>/..., else the image.
image_repo() { # ref
  if [[ "$1" =~ ^ghcr\.io/([^/]+)/([^/:@]+) ]]; then echo "${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"; else echo "$1"; fi
}

# Every Go binary under an image's /usr/local/bin (looper#167), read by
# govulncheck -mode=binary: what the tree's scans cannot see (the tools a
# Dockerfile builds or downloads, the base image's). A binary the base image
# has as recorded is its repository's to fix; one stripped of its symbol
# table is read at package level, each vulnerable function of a package it
# links taken as called (#64): its findings count, and the summary says so.
binaries=()
tool_binaries() { # root
  local root="$1" f rel v i=0 raw base="" owner="" attrs from notgo=()
  need go || return 0
  need govulncheck || return 0
  if [[ -f "$root/$BASE_RECORD" ]]; then
    base="$(sed -n '1s/^# *//p' "$root/$BASE_RECORD")"; owner="$(image_repo "$base")"
  else
    notes+=("no record of the base image's binaries (/$BASE_RECORD): every binary is counted as the image's own")
  fi
  while read -r f; do
    rel="/${f#"$root"/}"
    v="$(go version "$f" 2>/dev/null | awk -v f="$f:" '$1 == f && $2 ~ /^go[0-9]/ { print $2 }')"
    [[ -n "$v" ]] || { notgo+=("$rel"); continue; }
    attrs=""
    go tool nm "$f" >/dev/null 2>&1 || {
      attrs+=", read stripped"
      notes+=("govulncheck: $rel: read stripped (no symbol table): every vulnerable function of a package it links counts as called")
    }
    from=""
    if [[ -n "$base" ]] && grep -qxF "$(sha256sum < "$f" | cut -d' ' -f1)  $rel" "$root/$BASE_RECORD"; then
      attrs+=", the base image's: $owner"; from=" ($base)"
    fi
    binaries+=("$rel: $v$attrs$from")
    i=$((i + 1)); raw="$SCAN_OUT/raw/govulncheck-binary-$i-$(basename "$f").json"
    if ! govulncheck -mode=binary -format json "$f" > "$raw" 2>"$raw.log"; then
      tool_error govulncheck "$root" "$root" "$rel: $(grep -m1 . "$raw.log")"; continue
    fi
    norm "$SCAN_OUT/norm/govulncheck-binary-$i.json" "$JQ_GOVULNCHECK" "$raw" --arg where "$rel$attrs"
  done < <(find "$root/usr/local/bin" -type f 2>/dev/null | LC_ALL=C sort)
  ((${#notgo[@]} == 0)) || notes+=("govulncheck: not Go, not read: $(printf '%s\n' "${notgo[@]}" | paste -sd, - | sed 's/,/, /g')")
}

# A project's directory in its tree, as a path prefix: "" at the root, else "sub/".
rel_dir() { # tree dir prefix
  local r="${2#"$1"}"; r="${r#/}"; echo "$3${r:+$r/}"
}

# The policy cargo-deny applies where a repository has no deny.toml of its own:
# the RustSec advisories, licenses an Apache-2.0 project may ship, crates.io only.
default_deny_toml() {
  cat <<'EOF'
# looper-scan's default (looper#49): a repository's own deny.toml replaces it.
[advisories]
version = 2
yanked = "deny"
[licenses]
version = 2
confidence-threshold = 0.9
allow = ["Apache-2.0", "Apache-2.0 WITH LLVM-exception", "MIT", "MIT-0", "BSD-2-Clause", "BSD-3-Clause", "ISC",
         "Zlib", "0BSD", "CC0-1.0", "Unicode-3.0", "Unicode-DFS-2016", "BSL-1.0", "MPL-2.0", "Unlicense", "CDLA-Permissive-2.0"]
[bans]
multiple-versions = "allow"
wildcards = "allow"
[sources]
unknown-registry = "deny"
unknown-git = "deny"
EOF
}

# cargo-deny reads the build's graph with cargo metadata, which needs the
# manifest of every path dependency. A service that path-depends on the
# crates its gates generate (its tacplus.yaml output-dir: gateway's
# target/generated-sources/model) has them when the gates built them (built/,
# laid over the checkout); else from the gates' generated/, laid at the
# output-dir in a copy of the tree; else cargo-deny checks the Cargo.lock's
# crates alone, and the summary says so (looper#126).
deny_run() { # manifest config raw: 0 when cargo-deny reported; else DENY_ERROR says why
  local rc=0 e
  cargo-deny --format json --manifest-path "$1" --config "$2" check advisories licenses sources bans \
    2> "$3" >/dev/null || rc=$?
  jq -e 'select(.type == "summary")' "$3" >/dev/null 2>&1 && return 0
  # Its last error (its log is JSON) from cargo's own "error:" line on, else its last line.
  e="$(jq -Rrn '[inputs | fromjson? | select(.type == "log" and .fields.level == "ERROR") | .fields.message]
                | last // "" | split("\n") | map(select(test("\\S"))) as $l
                | ([$l | to_entries[] | select(.value | test("^error: "))][0].key // 0) as $i | $l[$i:$i + 2] | join("; ")' \
          "$3" 2>/dev/null)" || e=""
  [[ -n "$e" ]] || e="$(grep -v '^{' "$3" | tail -1)"
  DENY_ERROR="exited $rc: $e"; return 1
}

# The tree with the gates' generated/ at its tacplus.yaml's generated tree, a
# copy made once a tree; fails when there is no such tree or generated/.
deny_overlay() { # tree label
  local copy="$SCAN_WORK/cargo-overlay-$2" out
  [[ -f "$1/tacplus.yaml" && -n "$(ls -A "$BUILD_OUT/generated" 2>/dev/null)" ]] || return 1
  out="$(tacplus_generated_dir "$1/tacplus.yaml")" || return 1
  if [[ ! -d "$copy" ]]; then
    mkdir -p "$copy/$out"
    (cd "$1" && tar --exclude=./.git -cf - .) | tar -xf - -C "$copy" && cp -a "$BUILD_OUT/generated/." "$copy/$out/" || return 1
  fi
  echo "$copy"
}

# The name of the lock-only manifest's own crate, whose findings are not ours.
DENY_LOCK_CRATE=looper-scan-cargo-lock
# A manifest that depends on exactly the crates a Cargo.lock locks from
# crates.io or git (pinned: =version, the commit), beside a copy of the lock;
# a crate of another registry it cannot name is printed.
deny_lock_manifest() { # project-dir dir
  mkdir -p "$2"; cp "$1/Cargo.lock" "$2/Cargo.lock"; : > "$2/lib.rs"
  printf '[package]\nname = "%s"\nversion = "1.0.0"\nedition = "2021"\npublish = false\n\n[lib]\npath = "lib.rs"\n\n[dependencies]\n' \
    "$DENY_LOCK_CRATE" > "$2/Cargo.toml"
  awk -v manifest="$2/Cargo.toml" '
    function val(s) { sub(/^[a-z]+ = "/, "", s); sub(/"[ \t]*$/, "", s); return s }
    function flush(  url, rev) {
      if (name == "") return
      if (source ~ /^(registry\+https:\/\/github\.com\/rust-lang\/crates\.io-index|sparse\+https:\/\/index\.crates\.io\/)$/)
        printf "lock-%d = { package = \"%s\", version = \"=%s\", default-features = false }\n", ++n, name, version >> manifest
      else if (source ~ /^git\+/) {
        url = substr(source, 5); rev = url; sub(/#.*/, "", url); sub(/\?.*/, "", url); sub(/^[^#]*#/, "", rev)
        printf "lock-%d = { package = \"%s\", git = \"%s\", rev = \"%s\", default-features = false }\n", ++n, name, url, rev >> manifest
      } else if (source != "") print name "@" version " (" source ")"
      name = version = source = ""
    }
    /^\[\[package\]\]/ { flush(); next }
    /^\[/ { flush(); next }
    /^name = "/ { name = val($0) } /^version = "/ { version = val($0) } /^source = "/ { source = val($0) }
    END { flush() }' "$1/Cargo.lock"
}

tool_cargo_deny() { # tree label prefix
  local d i=0 raw cfg first overlay lock skipped
  [[ -n "$(projects "$1" Cargo.lock)" ]] || return 0
  need cargo-deny || return 0
  default_deny_toml > "$SCAN_WORK/deny.toml"
  while read -r d; do
    [[ -f "$d/Cargo.toml" ]] || continue
    i=$((i + 1)); raw="$SCAN_OUT/raw/cargo-deny-$2-$i.json"
    cfg="$SCAN_WORK/deny.toml"; [[ -f "$1/deny.toml" ]] && cfg="$1/deny.toml"; [[ -f "$d/deny.toml" ]] && cfg="$d/deny.toml"
    if ! deny_run "$d/Cargo.toml" "$cfg" "$raw"; then
      first="$DENY_ERROR"; mv "$raw" "${raw%.json}-checkout.json"
      if overlay="$(deny_overlay "$1" "$2")" && [[ -f "$overlay${d#"$1"}/Cargo.toml" ]] &&
         deny_run "$overlay${d#"$1"}/Cargo.toml" "$cfg" "$raw"; then
        log "cargo-deny: $d: with the gates' generated/ at its output-dir"
      else
        [[ ! -f "$raw" ]] || mv "$raw" "${raw%.json}-generated.json"
        lock="$SCAN_WORK/cargo-lock-$2-$i"
        skipped="$(deny_lock_manifest "$d" "$lock" | paste -sd ' ' -)"
        if ! deny_run "$lock/Cargo.toml" "$cfg" "$raw"; then
          tool_error cargo-deny "$1" "$d" "$first (Cargo.lock alone: $DENY_ERROR)"; continue
        fi
        notes+=("cargo-deny: $(rel_dir "$1" "$d" "$3")Cargo.lock: its crates alone, not the build's graph (Cargo.toml does not load: ${first#*: })${skipped:+; not checked, of another registry: $skipped}")
        log "cargo-deny: $d: Cargo.lock's crates alone ($first)"
      fi
    fi
    norm "$SCAN_OUT/norm/cargo-deny-$2-$i.json" '
      [.[] | select(.type == "diagnostic" and .fields.severity == "error") | .fields
       | ((.graphs[0].Krate // {}) | (.name // "") + "@" + (.version // "")) as $krate
       | select($krate | startswith($lockcrate + "@") | not)
       | if .advisory then
           finding("cargo-deny"; "sca"; .advisory.id; .advisory.aliases; (.advisory.cvss | cvss3 | bucket);
                   ([.notes[]? | select(startswith("Solution: Upgrade"))] | length > 0);
                   ($krate + " (" + $where + ")"); .advisory.title)
         else
           finding("cargo-deny"; "policy"; ("cargo-deny:" + .code + ":" + $krate); []; "HIGH"; true;
                   ($krate + " (" + $where + ")"); .message)
         end]' \
      "$raw" --arg where "$(rel_dir "$1" "$d" "$3")Cargo.lock" --arg lockcrate "$DENY_LOCK_CRATE"
  done < <(projects "$1" Cargo.lock)
}

# What a run's Semgrep read of the code the gates generated (looper#207), as
# the security report publishes it: a first line "# <semgrep version>
# <config>", then each file as sha256sum prints it ("<sha256>  <path>", from
# the tree's root), sorted. Semgrep CE reads each file on its own: a file at
# the same path with the same bytes, read by the same version with the same
# rules, has the same findings. A land's build (BUILD_BASE) reads only what
# differs from its base's read and takes the base's findings for the rest;
# tacplus's generated sets took its Semgrep 29 of its 49 minutes, and a land
# changes few of their files. The nightly and a release read every file.
SEMGREP_READ=semgrep-generated.sha256
semgrep_read() { # tree
  echo "# $(semgrep --version 2>/dev/null | head -1) $SEMGREP_CONFIG"
  (cd "$1" && find . -type f -print0 | LC_ALL=C sort -z | xargs -0r sha256sum | sed 's#  \./#  #')
}

tool_semgrep() { # tree label prefix
  need semgrep || return 0
  local raw="$SCAN_OUT/raw/semgrep-$2.json" rc=0 target="$1" read="" same="" base="$SCAN_WORK/$SEMGREP_READ.base" n
  if [[ "$2" == generated ]]; then
    read="$SCAN_WORK/$SEMGREP_READ"; semgrep_read "$1" > "$read"
    # The base's read, by the same version and rules, its .semgrepignore the same: the files it read the same.
    if [[ "$SCAN_KIND" == build && -f "$base" && -f "$SCAN_WORK/base.json" && "$(head -1 "$base")" == "$(head -1 "$read")" ]] &&
       [[ "$(grep -E '  \.semgrepignore$' "$base" || true)" == "$(grep -E '  \.semgrepignore$' "$read" || true)" ]]; then
      same="$SCAN_WORK/semgrep-same-$2"; target="$SCAN_WORK/semgrep-changed-$2"
      LC_ALL=C comm -12 <(tail -n +2 "$base" | LC_ALL=C sort) <(tail -n +2 "$read" | LC_ALL=C sort) | sed 's/^[0-9a-f]*  //' > "$same"
      mkdir -p "$target"
      LC_ALL=C comm -13 <(tail -n +2 "$base" | LC_ALL=C sort) <(tail -n +2 "$read" | LC_ALL=C sort) | sed 's/^[0-9a-f]*  //' |
        { cat; [[ ! -f "$1/.semgrepignore" ]] || echo .semgrepignore; } |
        (cd "$1" && tar -cf - -T -) | tar -xf - -C "$target"
      n="$(find "$target" -type f | wc -l)"
      notes+=("semgrep: $2: $(wc -l < "$same") file(s) read the same in the base's build (${SCAN_BASE:0:12}): its findings there; $n read here")
      log "semgrep: $2: $(wc -l < "$same") file(s) as the base's (its findings), $n to read"
    fi
  fi
  semgrep scan --config "$SEMGREP_CONFIG" --metrics=off --disable-version-check --json -o "$raw" -q "$target" \
    >/dev/null 2>"$SCAN_OUT/raw/semgrep-$2.log" || rc=$?
  ((rc == 0)) || { tool_error semgrep "$1" "$1" "exited $rc: $(tool_cause "$SCAN_OUT/raw/semgrep-$2.log")"; return 0; }
  norm "$SCAN_OUT/norm/semgrep-$2.json" '
    [.[0].results[]? | finding("semgrep"; "sast"; .check_id; [];
       (.extra.metadata.confidence as $c | {"ERROR": "HIGH", "WARNING": "MEDIUM", "INFO": "LOW"}[.extra.severity] // "UNKNOWN" | unsure($c));
       true; ((.path | rel($root; $prefix)) + ":" + (.start.line | tostring)); .extra.message)]' \
    "$raw" --arg root "$target" --arg prefix "$3"
  if [[ -n "$same" ]]; then
    # The base's findings in the files read the same, as Semgrep gave them.
    jq --rawfile same "$same" --arg prefix "$3" "$JQ_BASELINE"'
      ($same | split("\n") | map(select(. != "") | {($prefix + .): true}) | add // {}) as $s
      | . + [$base[0][] | select(.tool == "semgrep" and $s[file_of]) | {tool, kind, id, aliases, severity, fix, where, title}]' \
      --slurpfile base "$SCAN_WORK/base.json" "$SCAN_OUT/norm/semgrep-$2.json" > "$SCAN_OUT/norm/semgrep-$2.json.tmp"
    mv "$SCAN_OUT/norm/semgrep-$2.json.tmp" "$SCAN_OUT/norm/semgrep-$2.json"
  fi
  # What it read, for a land built on this commit: only once it read it all.
  [[ -z "$read" ]] || cp "$read" "$SCAN_OUT/$SEMGREP_READ"
}

# A build's gitleaks reads the commit's tree, not the code its gates generated
# (looper#207: tacplus's took minutes, its tree seconds): that code comes, the
# same every time, from the templates the commit's tree holds, which it reads.
# The nightly and a release read it too.
tool_gitleaks() { # tree label prefix
  if [[ "$SCAN_KIND" == build && "$2" == generated ]]; then
    notes+=("gitleaks: generated: not read in a build (the commit's templates are; the nightly and a release read it)"); return 0
  fi
  need gitleaks || return 0
  local raw="$SCAN_OUT/raw/gitleaks-$2.json" rc=0
  # The tree, not .git: the commit's files are what it ships.
  gitleaks dir --no-banner --redact --exit-code 0 -f json -r "$raw" "$1" >/dev/null 2>"$SCAN_OUT/raw/gitleaks-$2.log" || rc=$?
  ((rc == 0)) || { tool_error gitleaks "$1" "$1" "exited $rc: $(tool_cause "$SCAN_OUT/raw/gitleaks-$2.log")"; return 0; }
  norm "$SCAN_OUT/norm/gitleaks-$2.json" '
    [.[0][]? | select(.File | ltrimstr($root + "/") | startswith(".git/") | not)
     | (.File | rel($root; $prefix)) as $f
     | finding("gitleaks"; "secret"; ($f + ":" + .RuleID + ":" + (.StartLine | tostring)); [.RuleID]; "CRITICAL"; true;
               ($f + ":" + (.StartLine | tostring)); .Description)]' \
    "$raw" --arg root "$1" --arg prefix "$3"
}

tool_gosec() { # tree label prefix
  local d i=0 raw
  [[ -n "$(projects "$1" go.mod)" ]] || return 0
  need gosec || return 0
  while read -r d; do
    i=$((i + 1)); raw="$SCAN_OUT/raw/gosec-$2-$i.json"
    if ! (cd "$d" && gosec -no-fail -fmt json -out "$raw" ./... >/dev/null 2>"$raw.log") || [[ ! -s "$raw" ]]; then
      tool_error gosec "$1" "$d" "$(grep -m1 -i 'error' "$raw.log" || tool_cause "$raw.log")"; continue
    fi
    norm "$SCAN_OUT/norm/gosec-$2-$i.json" '
      [.[0].Issues[]? | finding("gosec"; "sast"; .rule_id; ["CWE-" + (.cwe.id // "")]; (.confidence as $c | .severity | unsure($c)); true;
         ((.file | rel($root; $prefix)) + ":" + .line); .details)]' \
      "$raw" --arg root "$1" --arg prefix "$3"
  done < <(projects "$1" go.mod)
}

tool_bandit() { # tree label prefix
  has_files "$1" '*.py' || return 0
  need bandit || return 0
  local raw="$SCAN_OUT/raw/bandit-$2.json" rc=0
  bandit -q -r -f json -o "$raw" --exit-zero -x '*/.git/*,*/node_modules/*,*/.venv/*,*/target/*' "$1" \
    >/dev/null 2>"$SCAN_OUT/raw/bandit-$2.log" || rc=$?
  ((rc == 0)) || { tool_error bandit "$1" "$1" "exited $rc: $(tool_cause "$SCAN_OUT/raw/bandit-$2.log")"; return 0; }
  norm "$SCAN_OUT/norm/bandit-$2.json" '
    [.[0].results[]? | finding("bandit"; "sast"; .test_id; ["CWE-" + (.issue_cwe.id // "" | tostring)];
       (.issue_confidence as $c | {"HIGH": "HIGH", "MEDIUM": "MEDIUM", "LOW": "LOW"}[.issue_severity] // "UNKNOWN" | unsure($c)); true;
       ((.filename | rel($root; $prefix)) + ":" + (.line_number | tostring)); .issue_text)]' \
    "$raw" --arg root "$1" --arg prefix "$3"
}

tool_clippy() { # tree label prefix
  local d i=0 raw rc
  [[ -n "$(projects "$1" Cargo.lock)" ]] || return 0
  command -v cargo >/dev/null && cargo clippy --version >/dev/null 2>&1 || { problems+=("clippy: not in this image"); return 0; }
  while read -r d; do
    [[ -f "$d/Cargo.toml" ]] || continue
    i=$((i + 1)); raw="$SCAN_OUT/raw/clippy-$2-$i.json"; rc=0
    # shellcheck disable=SC2086  # the lints are words
    CARGO_TARGET_DIR="$SCAN_WORK/clippy-target" cargo clippy --manifest-path "$d/Cargo.toml" --all-targets --locked \
      --message-format=json -q -- $CLIPPY_LINTS > "$raw" 2>"$raw.log" || rc=$?
    norm "$SCAN_OUT/norm/clippy-$2-$i.json" '
      [.[] | select(.reason == "compiler-message" and .message.level == "error" and ((.message.code.code // "") | startswith("clippy::")))
       | .message as $m | ($m.spans[] | select(.is_primary)) as $s
       | finding("clippy"; "sast"; $m.code.code; []; "HIGH"; true; ($dir + $s.file_name + ":" + ($s.line_start | tostring)); $m.message)]
      | unique_by(.where + .id)' \
      "$raw" --arg dir "$(rel_dir "$1" "$d" "$3")"
    if ((rc != 0)) && [[ "$(jq length "$SCAN_OUT/norm/clippy-$2-$i.json")" == 0 ]]; then
      tool_error clippy "$1" "$d" "exited $rc: $(grep -m1 '^error' "$raw.log" || tool_cause "$raw.log")"
    fi
  done < <(projects "$1" Cargo.lock)
}

# A SARIF report's results: the rule's security-severity, else the level.
JQ_SARIF='
[.[0].runs[]? | (.tool.driver.rules // [] | map({(.id): .}) | add // {}) as $rules | .results[]?
 | (.locations[0].physicalLocation // {}) as $loc
 | finding($tool; "sast"; .ruleId; [];
     (($rules[.ruleId].properties["security-severity"] // null) as $ss
      | if $ss then ($ss | tonumber | bucket) else ({"error": "HIGH", "warning": "MEDIUM", "note": "LOW"}[.level // "warning"] // "UNKNOWN") end);
     true; (($loc.artifactLocation.uri // "" | ltrimstr("file://") | rel($root; $prefix)) + ":" + ($loc.region.startLine // 0 | tostring));
     .message.text)]'

# SpotBugs' heap in MB: SPOTBUGS_MAXHEAP, else three quarters of the job's
# memory (its cgroup's limit, else the machine's), never under the launcher's
# own 768, which kernel's analysis outgrew (looper#149).
spotbugs_heap() {
  local m
  if [[ -n "$SPOTBUGS_MAXHEAP" ]]; then
    [[ "$SPOTBUGS_MAXHEAP" =~ ^[1-9][0-9]*$ ]] || return 1
    echo "$SPOTBUGS_MAXHEAP"; return 0
  fi
  m=$(($(job_memory_mb) * 3 / 4))
  echo $((m > 768 ? m : 768))
}

# The job's memory in MB: its cgroup's limit (v2, else v1), else the machine's.
job_memory_mb() {
  local f b="" m
  for f in "$SCAN_CGROUP/memory.max" "$SCAN_CGROUP/memory/memory.limit_in_bytes"; do
    b="$(cat "$f" 2>/dev/null)" && [[ "$b" =~ ^[0-9]{1,18}$ ]] && break
    b=""
  done
  m="$(awk '$1 == "MemTotal:" { printf "%d", $2 * 1024 }' /proc/meminfo 2>/dev/null)" || m=""
  [[ -n "$b" && ( -z "$m" || "$b" -lt "$m" ) ]] || b="${m:-0}"
  echo $((b / 1048576))
}

# The job's CPUs, whole: its cgroup's quota (v2's cpu.max, else v1's), else
# the machine's; at least 1.
job_cpus() {
  local q p n
  if read -r q p 2>/dev/null < "$SCAN_CGROUP/cpu.max" && [[ "$q" =~ ^[0-9]+$ && "$p" =~ ^[1-9][0-9]*$ ]]; then :
  else q="$(cat "$SCAN_CGROUP/cpu/cpu.cfs_quota_us" 2>/dev/null)"; p="$(cat "$SCAN_CGROUP/cpu/cpu.cfs_period_us" 2>/dev/null)"; fi
  n="$(nproc 2>/dev/null)" || n=1
  if [[ "$q" =~ ^[0-9]+$ && "$p" =~ ^[1-9][0-9]*$ ]] && ((q / p < n)); then n=$((q / p)); fi
  echo $((n > 1 ? n : 1))
}

# CodeQL's --ram and --threads (looper#189): BUILD_CODEQL_RAM and
# BUILD_CODEQL_THREADS, else the job's. Its --ram bounds the evaluator's and
# the Java extractor's heaps, not the JVMs' own memory nor its native
# extractors' (Rust's): CODEQL_RESERVE_MB of the job's is left them, at least
# a quarter. Unset, CodeQL reads the node's memory, not the pod's.
CODEQL_RESERVE_MB=2048
codeql_ram() {
  local m r
  if [[ -n "$CODEQL_RAM" ]]; then
    [[ "$CODEQL_RAM" =~ ^[1-9][0-9]*$ ]] || return 1
    echo "$CODEQL_RAM"; return 0
  fi
  m="$(job_memory_mb)"; r=$((m / 4 > CODEQL_RESERVE_MB ? m / 4 : CODEQL_RESERVE_MB))
  echo $((m - r > 1024 ? m - r : 1024))
}
codeql_threads() {
  if [[ -n "$CODEQL_THREADS" ]]; then
    [[ "$CODEQL_THREADS" =~ ^[1-9][0-9]*$ ]] || return 1
    echo "$CODEQL_THREADS"; return 0
  fi
  job_cpus
}

# The job's memory in MB at its highest while a command runs (looper#189),
# into FILE: its working set (the cgroup's memory.current less its inactive
# page cache, what the kubelet measures against the limit), read every second
# (nothing else of the job runs then), above what FILE holds; nothing without a
# cgroup v2.
working_set_mb() {
  local c i
  c="$(cat "$SCAN_CGROUP/memory.current" 2>/dev/null)" && [[ "$c" =~ ^[0-9]+$ ]] || return 1
  i="$(awk '$1 == "inactive_file" { print $2 }' "$SCAN_CGROUP/memory.stat" 2>/dev/null)"
  [[ "$i" =~ ^[0-9]+$ && "$i" -le "$c" ]] || i=0
  echo $(((c - i) / 1048576))
}
peak_sample() { # file
  local p c
  c="$(working_set_mb)" || return 0
  p="$(cat "$1" 2>/dev/null)"; [[ "$p" =~ ^[0-9]+$ ]] && ((p >= c)) || echo "$c" > "$1"
}
peak_of() { # file command...
  local f="$1" w rc=0; shift
  working_set_mb >/dev/null || { "$@"; return; }
  peak_sample "$f"
  ( while sleep 1; do peak_sample "$f"; done ) & w=$!
  "$@" || rc=$?
  kill "$w" 2>/dev/null; wait "$w" 2>/dev/null || true
  return "$rc"
}

# The bytecode SpotBugs reads: every target/classes of the tree, which the
# gates compiled (built/); this job compiles nothing (a build may run tacplus).
tool_spotbugs() { # tree label prefix
  has_files "$1" '*.java' || return 0
  need spotbugs || return 0
  local raw="$SCAN_OUT/raw/spotbugs-$2.sarif" classes=() heap rc=0
  mapfile -t classes < <(find "$1" -path '*/target/classes' -type d -not -path '*/node_modules/*' | LC_ALL=C sort)
  if ((${#classes[@]} == 0)); then notes+=("spotbugs: $2: Java sources, but the gates compiled no target/classes"); return 0; fi
  [[ -f "$FINDSECBUGS" ]] || { problems+=("spotbugs: FindSecBugs is not at $FINDSECBUGS"); return 0; }
  heap="$(spotbugs_heap)" || { problems+=("spotbugs: BUILD_SPOTBUGS_MAXHEAP '$SPOTBUGS_MAXHEAP' is not a size in MB"); return 0; }
  log "spotbugs: $2: a heap of $heap MB"
  spotbugs -textui -maxHeap "$heap" -quiet -effort:max -pluginList "$FINDSECBUGS" -sarif="$raw" "${classes[@]}" \
    >/dev/null 2>"$SCAN_OUT/raw/spotbugs-$2.log" || rc=$?
  ((rc == 0)) || { tool_error spotbugs "$1" "$1" "exited $rc: $(tool_cause "$SCAN_OUT/raw/spotbugs-$2.log")"; return 0; }
  norm "$SCAN_OUT/norm/spotbugs-$2.json" "$JQ_SARIF" "$raw" --arg tool spotbugs --arg root "$1" --arg prefix "$3"
}

tool_trivy() { # tree label prefix
  need trivy || return 0
  local raw="$SCAN_OUT/raw/trivy-$2.json" rc=0 ref i=0
  trivy fs -q --scanners vuln,misconfig --format json -o "$raw" "$1" 2>"$SCAN_OUT/raw/trivy-$2.log" || rc=$?
  if ((rc != 0)); then tool_error trivy "$1" "$1" "exited $rc: $(tool_cause "$SCAN_OUT/raw/trivy-$2.log")"
  else norm "$SCAN_OUT/norm/trivy-$2.json" "$JQ_TRIVY" "$raw" --arg where "$3"; fi
  # The Dockerfiles' base images (by name: a private one it cannot read is not analyzed).
  while read -r ref; do
    i=$((i + 1)); raw="$SCAN_OUT/raw/trivy-$2-image-$i.json"; rc=0
    trivy image -q --scanners vuln --format json -o "$raw" "$ref" 2>"$raw.log" || rc=$?
    if ((rc != 0)); then notes+=("trivy: image $ref: not analyzed ($(tool_cause "$raw.log"))"); continue; fi
    norm "$SCAN_OUT/norm/trivy-$2-image-$i.json" "$JQ_TRIVY" "$raw" --arg where "image $ref: "
  done < <(base_images "$1")
}
# A package in a jar is where the jar is (PkgPath), else where the result is.
JQ_TRIVY='
[.[0].Results[]? | .Target as $t
 | ((.Vulnerabilities // [])[] | finding("trivy"; "sca"; .VulnerabilityID; []; (.Severity // "UNKNOWN"); ((.FixedVersion // "") != "");
     (.PkgName + "@" + (.InstalledVersion // "") + " (" + $where + (.PkgPath // $t) + ")"); .Title)),
   ((.Misconfigurations // [])[] | select(.Status != "PASS") | finding("trivy"; "config"; .ID; []; (.Severity // "UNKNOWN"); true;
     ($where + $t); .Title))]'

# The release jars of a tree (looper-build's RELEASE_JAR: what the gates keep
# in built/), in every kind: the dependencies a jar shades are in no manifest
# the other tools read (tacplus-dev/kernel#59). trivy rootfs reads the jars
# alone, copied at their paths: a jar's findings are where it is.
tool_jars() { # tree label prefix
  local jars=() j root="$SCAN_WORK/jars-$2" raw="$SCAN_OUT/raw/trivy-jars-$2.json" rc=0
  mapfile -t jars < <(cd "$1" && find . \( -name .git -o -name node_modules -o -name vendor -o -name .venv \) -prune -o -type f -print |
                        sed 's:^\./::' | { grep -E -e "$RELEASE_JAR" || true; } | { grep -vE -e "$NOT_RELEASE_JAR" || true; } | LC_ALL=C sort)
  ((${#jars[@]})) || return 0
  need trivy || return 0
  for j in "${jars[@]}"; do mkdir -p "$root/$(dirname "$j")"; cp "$1/$j" "$root/$j"; done
  trivy rootfs -q --scanners vuln --format json -o "$raw" "$root" 2>"$raw.log" || rc=$?
  if ((rc != 0)); then tool_error trivy "$1" "$1" "the release jars: exited $rc: $(tail -1 "$raw.log")"; return 0; fi
  norm "$SCAN_OUT/norm/trivy-jars-$2.json" "$JQ_TRIVY" "$raw" --arg where "$3"
}

# The images a tree's Dockerfiles build FROM: by name, not a stage, not scratch.
base_images() { # tree
  local f
  while read -r f; do
    awk 'toupper($1) == "FROM" { r = ""; for (i = 2; i <= NF; i++) if ($i !~ /^--/) { r = $i; break }
           for (j = i + 1; j < NF; j++) if (toupper($j) == "AS") stage[tolower($(j + 1))] = 1
           if (r != "" && r != "scratch" && r !~ /\$/ && !(tolower(r) in stage)) print r }' "$f"
  done < <(find "$1" \( -name .git -o -name node_modules -o -name target \) -prune -o -type f \( -name Dockerfile -o -name '*.Dockerfile' -o -name 'Dockerfile.*' \) -print) | LC_ALL=C sort -u
}

codeql_bundle() {
  [[ -x "$CODEQL_DIR/codeql/codeql" ]] && return 0
  local tmp; tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/codeql.tar.gz" "$CODEQL_URL" || { rm -rf "$tmp"; return 1; }
  echo "$CODEQL_SHA256  $tmp/codeql.tar.gz" | sha256sum -c - >/dev/null || { log "codeql: the bundle's checksum is not $CODEQL_SHA256"; rm -rf "$tmp"; return 1; }
  mkdir -p "$CODEQL_DIR"; tar -xzf "$tmp/codeql.tar.gz" -C "$CODEQL_DIR"; rm -rf "$tmp"
}

tool_codeql() { # tree label prefix
  local langs=() lang db raw mode ram threads peak rc
  [[ -f "$1/go.mod" ]] && langs+=(go)
  has_files "$1" '*.py' && langs+=(python)
  has_files "$1" '*.java' && langs+=(java)
  { has_files "$1" '*.ts' || has_files "$1" '*.js'; } && langs+=(javascript)
  [[ -f "$1/Cargo.toml" ]] && langs+=(rust)
  ((${#langs[@]})) || return 0
  if [[ "${SCAN_PUBLIC:-unknown}" != true ]]; then
    notes+=("codeql: not run: $BUILD_REPO is not known to be public (CodeQL's free terms cover open-source code only)"); return 0
  fi
  if ! command -v codeql >/dev/null; then
    codeql_bundle || { problems+=("codeql: the pinned bundle $CODEQL_VERSION could not be fetched"); return 0; }
    PATH="$CODEQL_DIR/codeql:$PATH"
  fi
  ram="$(codeql_ram)" || { problems+=("codeql: BUILD_CODEQL_RAM '$CODEQL_RAM' is not a size in MB"); return 0; }
  threads="$(codeql_threads)" || { problems+=("codeql: BUILD_CODEQL_THREADS '$CODEQL_THREADS' is not a count"); return 0; }
  for lang in "${langs[@]}"; do
    db="$SCAN_WORK/codeql-$2-$lang"; raw="$SCAN_OUT/raw/codeql-$2-$lang.sarif"; peak="$SCAN_WORK/codeql-$2-$lang.peak"
    mode=none; [[ "$lang" == go ]] && mode=autobuild
    log "codeql: $2: $lang: --ram $ram --threads $threads, the job's $(job_memory_mb) MB and $(job_cpus) CPU(s)"
    rc=0
    peak_of "$peak" codeql database create "$db" --language="$lang" --build-mode="$mode" --source-root="$1" --overwrite -q \
      --ram="$ram" --threads="$threads" > "$SCAN_OUT/raw/codeql-$2-$lang.log" 2>&1 &&
    peak_of "$peak" codeql database analyze "$db" "codeql/$lang-queries" --format=sarif-latest --output="$raw" -q \
      --ram="$ram" --threads="$threads" >> "$SCAN_OUT/raw/codeql-$2-$lang.log" 2>&1 || rc=$?
    [[ ! -f "$peak" ]] || peaks+=("codeql: $2: $lang: $(cat "$peak") MB at its peak of the job's $(job_memory_mb) MB (--ram $ram, --threads $threads)")
    if ((rc != 0)); then
      tool_error codeql "$1" "$1" "$lang: $(tool_cause "$SCAN_OUT/raw/codeql-$2-$lang.log") (--ram $ram of the job's $(job_memory_mb) MB)"; continue
    fi
    norm "$SCAN_OUT/norm/codeql-$2-$lang.json" "$JQ_SARIF" "$raw" --arg tool codeql --arg root "$1" --arg prefix "$3"
  done
}

# --- versions and databases -----------------------------------------------------

tool_versions() {
  local t v
  for t in osv-scanner govulncheck cargo-deny semgrep gitleaks gosec bandit spotbugs trivy syft codeql cargo-clippy; do
    command -v "$t" >/dev/null || { [[ "$t" == codeql && -x "$CODEQL_DIR/codeql/codeql" ]] || continue; }
    v="$(case "$t" in
      govulncheck) go version -m "$(command -v govulncheck)" | awk '$1 == "mod" { print $3 }' ;;
      gitleaks|trivy) "$t" version | head -1 ;;
      gosec) gosec -version | sed -n 's/^Version: //p' ;;
      spotbugs) spotbugs -version | tail -1 ;;
      codeql) echo "$CODEQL_VERSION" ;;
      cargo-clippy) cargo clippy --version ;;
      *) "$t" --version | head -1 ;;
    esac 2>/dev/null)" || true
    jq -cn --arg t "$t" --arg v "$v" '{($t): $v}'
  done | jq -s 'add // {}'
}

# What each finding was checked against: the databases' snapshot times.
databases() { # started
  local trivy="{}" deny="{}" gv="{}" d f=()
  if ls "$SCAN_OUT"/raw/trivy-* >/dev/null 2>&1; then
    trivy="$(trivy version -f json 2>/dev/null | jq -c '{trivy: ({updated_at: .VulnerabilityDB.UpdatedAt, downloaded_at: .VulnerabilityDB.DownloadedAt, checks: .CheckBundle.Digest}
                   + if .JavaDB then {java_db_updated_at: .JavaDB.UpdatedAt} else {} end)}' 2>/dev/null)" || trivy="{}"
  fi
  if ls "$SCAN_OUT"/raw/cargo-deny-* >/dev/null 2>&1; then
    for d in "${CARGO_HOME:-$HOME/.cargo}"/advisory-dbs/*/; do
      [[ -d "$d/.git" ]] || continue
      deny="$(jq -cn --arg c "$(git -C "$d" log -1 --format=%H)" --arg t "$(git -C "$d" log -1 --format=%cI)" \
                '{"cargo-deny": {advisory_db_commit: $c, advisory_db_time: $t}}')"
    done
  fi
  mapfile -t f < <(find "$SCAN_OUT/raw" -name 'govulncheck-*.json' | LC_ALL=C sort)
  if ((${#f[@]})); then
    gv="$(cat "${f[@]}" | jq -cs '[.[] | .config // empty][0] // null
           | if . then {govulncheck: {db: .db, db_last_modified: .db_last_modified}} else {} end' 2>/dev/null)" || gv="{}"
  fi
  [[ -n "$trivy" ]] || trivy="{}"; [[ -n "$gv" ]] || gv="{}"
  # OSV-Scanner and Semgrep: when they ran (an image's run has only govulncheck).
  local osv=false sg=false
  ls "$SCAN_OUT"/raw/osv-scanner-* >/dev/null 2>&1 && osv=true
  ls "$SCAN_OUT"/raw/semgrep-* >/dev/null 2>&1 && sg=true
  jq -n --arg at "$1" --argjson trivy "$trivy" --argjson deny "$deny" --argjson gv "$gv" --arg sg "$SEMGREP_CONFIG" \
        --argjson osv_ran "$osv" --argjson sg_ran "$sg" '
    (if $osv_ran then {"osv-scanner": {db: "api.osv.dev", queried_at: $at}} else {} end)
    + (if $sg_ran then {semgrep: {rules: $sg, fetched_at: $at}} else {} end) + $gv + $deny + $trivy'
}

# --- the exceptions ---------------------------------------------------------------

# security-exceptions.yaml, read as a strict subset of YAML (no YAML library
# in the image's shell): a list "exceptions:" of entries with exactly id,
# reason, decided_by and expires (YYYY-MM-DD), and an optional where (a path
# or a path glob: the entry accepts its id's findings there only, looper#182).
# Prints a JSON array; a file it cannot read that way is a problem, never an
# empty list.
read_exceptions() { # file
  [[ -f "$1" ]] || { echo '[]'; return 0; }
  awk '
    function flush() { if (n) printf "%s}", (out++ ? "," : "") cur; cur = ""; n = 0 }
    function str(v) { gsub(/^[ \t]+|[ \t]+$/, "", v)
      if (v ~ /^".*"$/ || v ~ /^\047.*\047$/) v = substr(v, 2, length(v) - 2)
      gsub(/\\/, "\\\\", v); gsub(/"/, "\\\"", v); return "\"" v "\"" }
    function field(s, k, v) { k = s; sub(/:.*/, "", k); v = s; sub(/^[^:]*:/, "", v)
      if (k !~ /^(id|reason|decided_by|expires|where)$/) { print "line " NR ": unknown key \"" k "\"" > "/dev/stderr"; bad = 1 }
      cur = cur (n++ ? "," : "{") "\"" k "\":" str(v) }
    BEGIN { printf "[" }
    /^[ \t]*(#|$)/ { next }
    /^exceptions:[ \t]*(\[\])?[ \t]*$/ { seen = 1; next }
    seen && /^  - [a-z_]+:/ { flush(); s = $0; sub(/^  - /, "", s); field(s); next }
    seen && n && /^    [a-z_]+:/ { s = $0; sub(/^    /, "", s); field(s); next }
    { print "line " NR ": not an exception entry: " $0 > "/dev/stderr"; bad = 1 }
    END { flush(); printf "]\n"; if (!seen && NR) { print "no exceptions: list" > "/dev/stderr"; bad = 1 }; exit bad }
  ' "$1"
}

# --- run ----------------------------------------------------------------------------

# A step of looper-build's, whose fail verdict is this run's.
build_step() { # function args...
  ( BUILD_OUT="$SCAN_OUT"; "$@" ) && return 0
  scan_verdict fail "$(sed -n '1s/^fail: //p' "$SCAN_OUT/build-verdict" 2>/dev/null || true)"
}

cmd_run() {
  case "$SCAN_KIND" in build|nightly|release) ;; *) echo "BUILD_SCAN_KIND '$SCAN_KIND' is not build, nightly or release" >&2; exit 2 ;; esac
  rm -rf "$SCAN_OUT"; mkdir -p "$SCAN_OUT/raw" "$SCAN_OUT/norm"
  build_step refuse_write_credentials
  build_step check_inputs
  SCAN_WORK="$(mktemp -d)"
  # shellcheck disable=SC2064  # this run's directory
  trap "rm -rf '$SCAN_WORK'" EXIT
  local started; started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  # The last nightly's findings, while the job's token is still here: what
  # new is measured against (looper#211). Not the latest, which a land's build
  # or a --build publishes too: a finding one of them saw first was never new
  # to the nightly, so never filed.
  local previous="$SCAN_WORK/previous.json"
  if [[ -n "${CI_JOB_TOKEN:-}" && -n "${CI_API_V4_URL:-}" && -n "${CI_PROJECT_ID:-}" ]] &&
     curl -fsS -H "JOB-TOKEN: $CI_JOB_TOKEN" -o "$previous" "$(package_url nightly findings.json)" 2>/dev/null &&
     jq -e 'type == "array"' "$previous" >/dev/null 2>&1; then
    log "compared with the last nightly of $BUILD_REPO"
  else
    rm -f "$previous"; log "no nightly of $BUILD_REPO to compare with: every finding is new"
  fi
  local key="${TACPLUS_READER_APP_KEY:-}"
  BUILD_GITHUB_TOKEN="$(reader_token '"contents":"read","metadata":"read"')" ||
    scan_verdict fail "no read-only GitHub token (the tacplus-reader app)"
  # CodeQL's free terms cover open-source code: it runs on a public repository only.
  SCAN_PUBLIC="$(curl -fsS -H "Authorization: Bearer $BUILD_GITHUB_TOKEN" -H 'Accept: application/vnd.github+json' \
                   "$BUILD_GITHUB_API/repos/$BUILD_ORG/$BUILD_REPO" 2>/dev/null | jq -r 'if .private == false then "true" else "false" end')" ||
    SCAN_PUBLIC=unknown
  [[ -n "$key" ]] && rm -f "$key"
  unset TACPLUS_READER_APP_KEY TACPLUS_READER_APP_ID TACPLUS_READER_INSTALLATION_ID
  export BUILD_GITHUB_TOKEN; git_credentials

  # A land's base: the findings of main's commit it is built on (looper#180),
  # else of its nearest ancestor with any, else the last nightly's (looper#217),
  # while the job's token is still here; its history is read with the source's.
  local base="$SCAN_WORK/base.json"
  if [[ "$SCAN_KIND" == build && -n "${BUILD_BASE:-}" ]]; then
    find_base "$base" "$previous"
    # The files of the generated code its Semgrep read (looper#207): what it
    # need not read again.
    if [[ -f "$base" ]] && curl -fsS -H "JOB-TOKEN: $CI_JOB_TOKEN" -o "$SCAN_WORK/$SEMGREP_READ.base" \
         "$(package_url "$SCAN_BASE_VERSION" "$SEMGREP_READ")" 2>/dev/null; then
      log "the base's Semgrep read of the generated code: what it read the same is not read again"
    else
      rm -f "$SCAN_WORK/$SEMGREP_READ.base"
    fi
  fi
  drop_job_credentials
  export GOPRIVATE="${GOPRIVATE:-github.com/$BUILD_ORG/*}" GOFLAGS="${GOFLAGS:--mod=mod}"
  local src="$SCAN_WORK/src"
  build_step fetch_commit "$src"
  build_step refuse_push_credential "$src"
  # The tree as the gates built it: their untracked sources and bytecode (built/).
  if [[ -d "$BUILD_OUT/built" ]]; then
    cp -a "$BUILD_OUT/built/." "$src/"
    [[ -z "$(git -C "$src" status --porcelain --untracked-files=no)" ]] || scan_verdict fail "the gates' built files change tracked files"
    log "with what the gates built ($(find "$BUILD_OUT/built" -type f | wc -l) files)"
  fi
  scan_tree "$src" "$previous" "$started" "$base"
}

# The checks, the policy and the reports of a checkout (and of the code its
# gates generated, in $BUILD_OUT/generated); the verdict ends the run.
scan_tree() { # src previous-findings started [base-findings]
  local src="$1" previous="$2" started="$3" base="${4:-/nonexistent}"
  log "security ($SCAN_KIND): $BUILD_REPO $BUILD_SHA"

  # The trees: the commit, and the code its gates generated.
  local trees=("$src|source|") t tree label prefix t0
  [[ -n "$(ls -A "$BUILD_OUT/generated" 2>/dev/null)" ]] && trees+=("$BUILD_OUT/generated|generated|generated/")
  local tools=(osv govulncheck cargo_deny semgrep gitleaks gosec clippy bandit spotbugs jars)
  [[ "$SCAN_KIND" == build ]] || tools+=(codeql trivy)
  scan_tools "${trees[@]}" -- "${tools[@]}"
  skip_generated_tree "$src"
  for t in "${trees[@]}"; do IFS='|' read -r tree label prefix <<<"$t"; mark_test_code "$tree" "$label" "$prefix"; done
  if need syft; then
    t0="$(date +%s)"
    syft scan -q "dir:$src" -o "cyclonedx-json=$SCAN_OUT/sbom.cdx.json" -o "spdx-json=$SCAN_OUT/sbom.spdx.json" 2>"$SCAN_OUT/raw/syft.log" ||
      problems+=("syft: $(tool_cause "$SCAN_OUT/raw/syft.log")")
    durations+=("syft|source|$(($(date +%s) - t0))")
  fi
  write_durations > "$SCAN_OUT/durations.json"

  scan_policy "$src" "$previous" "$started" "$base"
}

# The scanners side by side (looper#207: one after another, tacplus's took 49
# minutes): each a lane of its own over every tree in turn, SCAN_JOBS lanes at
# a time, Trivy's two in one (they share its cache). SpotBugs and CodeQL, each
# sized to the job's memory (CodeQL's peak measured on it), run after them,
# one at a time. What each tool adds to problems, notes and peaks is read back
# in the order a run one after another would give them; a tool that stopped
# before it finished is a problem.
SCAN_LANES=(clippy gosec bandit gitleaks semgrep cargo_deny govulncheck osv "jars trivy")
SCAN_ALONE=(spotbugs codeql)
# The lanes at a time: BUILD_SCAN_JOBS, else the job's CPUs, at least 2 (a
# scanner waits on the network too).
scan_jobs() {
  local j="${BUILD_SCAN_JOBS:-}"
  if [[ -n "$j" ]]; then [[ "$j" =~ ^[1-9][0-9]*$ ]] || return 1; echo "$j"; return 0; fi
  j="$(job_cpus)"; echo $((j > 2 ? j : 2))
}
# How long each tool took on each tree: "tool|label|seconds" (looper#207).
durations=()
SCAN_SECONDS=""
SCAN_JOBS_USED=""
# The durations as JSON (security/durations.json): each tool's seconds on each
# tree, the scanners' together, and how many ran at a time.
write_durations() {
  printf '%s\n' "${durations[@]}" | jq -Rn --argjson wall "${SCAN_SECONDS:-0}" --argjson jobs "${SCAN_JOBS_USED:-1}" '
    {seconds: $wall, jobs: $jobs,
     tools: [inputs | select(. != "") | split("|") | {tool: .[0], tree: .[1], seconds: (.[2] | tonumber)}]}'
}

# One tool on one tree, in a subshell of its own: what it adds, kept in
# $SCAN_WORK/runs/<n>.*, its seconds last (no .secs: it stopped).
scan_one() { # n tool tree label prefix
  local f="$SCAN_WORK/runs/$1" tool="$2" t0; shift 2
  problems=() notes=() peaks=()
  log "$tool: $2"; t0="$(date +%s)"
  "tool_$tool" "$@"
  { ((${#problems[@]} == 0)) || printf '%s\0' "${problems[@]}"; } > "$f.problems"
  { ((${#notes[@]} == 0)) || printf '%s\0' "${notes[@]}"; } > "$f.notes"
  { ((${#peaks[@]} == 0)) || printf '%s\0' "${peaks[@]}"; } > "$f.peaks"
  echo $(($(date +%s) - t0)) > "$f.secs"
  log "$tool: $2: done in $(cat "$f.secs")s"
}
# A lane's tools, each over every tree, one after another.
scan_lane() { # lane trees...
  local tool t i tree label prefix lane="$1"; shift
  for tool in $lane; do
    in_list "$tool" "${SCAN_RUN[@]}" || continue
    i=0
    for t in "$@"; do
      i=$((i + 1)); IFS='|' read -r tree label prefix <<<"$t"
      ( scan_one "$i-$tool" "$tool" "$tree" "$label" "$prefix" ) & wait "$!" || true
    done
  done
}
# A tool's name, as the summary gives it (its function's, else).
tool_name() { # tool
  case "$1" in osv) echo osv-scanner ;; cargo_deny) echo cargo-deny ;; jars) echo "trivy (the release jars)" ;; *) echo "$1" ;; esac
}
in_list() { # word list...
  local w="$1" x; shift
  for x; do [[ "$x" == "$w" ]] && return 0; done; return 1
}
SCAN_RUN=()
scan_tools() { # trees... -- tools...
  local trees=() tool t i lane running=0 jobs a=() f t0
  while [[ "$1" != -- ]]; do trees+=("$1"); shift; done; shift
  SCAN_RUN=("$@")
  jobs="$(scan_jobs)" || { problems+=("BUILD_SCAN_JOBS '${BUILD_SCAN_JOBS:-}' is not a count"); jobs=1; }
  mkdir -p "$SCAN_WORK/runs"
  SCAN_JOBS_USED="$jobs"
  log "the scanners: $jobs at a time (the job's $(job_cpus) CPU(s))"
  t0="$(date +%s)"
  for lane in "${SCAN_LANES[@]}"; do
    if ((running >= jobs)); then wait -n || true; running=$((running - 1)); fi
    scan_lane "$lane" "${trees[@]}" & running=$((running + 1))
  done
  wait
  for tool in "${SCAN_ALONE[@]}"; do scan_lane "$tool" "${trees[@]}"; done
  SCAN_SECONDS=$(($(date +%s) - t0))
  i=0
  for t in "${trees[@]}"; do
    i=$((i + 1)); IFS='|' read -r tree label prefix <<<"$t"
    for tool in "$@"; do
      f="$SCAN_WORK/runs/$i-$tool"
      if [[ ! -f "$f.secs" ]]; then problems+=("$tool: $label: it stopped before it finished (the job's log)"); continue; fi
      mapfile -d '' -t a < "$f.problems"; problems+=("${a[@]}")
      mapfile -d '' -t a < "$f.notes"; notes+=("${a[@]}")
      mapfile -d '' -t a < "$f.peaks"; peaks+=("${a[@]}")
      durations+=("$(tool_name "$tool")|$label|$(cat "$f.secs")")
    done
  done
}

# A land's base (looper#180): the commit whose findings it is compared with
# (BUILD_BASE's, else its ancestor's, else the last nightly's), once asked
# for; whether they were read is whether its base-findings file is there.
SCAN_BASE=""
SCAN_BASE_READ=""
# Their package's version (the commit, or nightly), and what the summary says
# when they are not BUILD_BASE's own.
SCAN_BASE_VERSION=""
SCAN_BASE_FROM=""
# How many of main's first-parent commits, from BUILD_BASE, a base's findings
# are looked for in (looper#217).
SCAN_BASE_DEPTH=20

# The findings a land is compared with (looper#217). A base no build published
# (the manager's HISTORY.md push, the nightly's PROPOSALS.md, a ROADMAP edit)
# takes the nearest of its first-parent ancestors that one did, up to
# SCAN_BASE_DEPTH commits from it, else the last nightly's: never nothing while
# main has a report. Its history is fetched, commits alone, only then.
find_base() { # base-findings previous-findings
  local out="$1" previous="$2" c n=0 hist="$SCAN_WORK/base-history" commits=()
  SCAN_BASE="$BUILD_BASE"; SCAN_BASE_VERSION="$BUILD_BASE"
  [[ -n "${CI_JOB_TOKEN:-}" && -n "${CI_API_V4_URL:-}" && -n "${CI_PROJECT_ID:-}" ]] ||
    { log "no findings of the base $BUILD_BASE (no package registry): every blocking finding fails"; return 0; }
  if base_package "$BUILD_BASE" "$out"; then
    log "compared with the base $BUILD_BASE: its blocking findings are standing"; return 0
  fi
  git init -q "$hist"
  if git -C "$hist" fetch -q --depth "$SCAN_BASE_DEPTH" --filter=tree:0 "$(repo_url)" "$BUILD_BASE" 2>/dev/null; then
    mapfile -t commits < <(git -C "$hist" rev-list --first-parent --max-count="$SCAN_BASE_DEPTH" FETCH_HEAD 2>/dev/null | tail -n +2)
  else
    log "the base's history cannot be read: its ancestors are not looked at"
  fi
  rm -rf "$hist"
  for c in "${commits[@]}"; do
    n=$((n + 1))
    if base_package "$c" "$out"; then
      SCAN_BASE="$c"; SCAN_BASE_VERSION="$c"
      SCAN_BASE_FROM="its nearest first-parent ancestor with a report, $c, $n commit(s) before it"
      log "no findings of the base $BUILD_BASE: compared with $c, its ancestor $n commit(s) back"; return 0
    fi
  done
  if [[ -f "$previous" ]]; then
    cp "$previous" "$out"
    # The commit it was of: its summary's heading names it.
    SCAN_BASE=""
    if curl -fsS -H "JOB-TOKEN: $CI_JOB_TOKEN" -o "$SCAN_WORK/nightly.md" "$(package_url nightly summary.md)" 2>/dev/null; then
      SCAN_BASE="$(sed -n '1s/^## Security checks: [^ ]* \([0-9a-f]\{40\}\) (nightly)$/\1/p' "$SCAN_WORK/nightly.md")"
    fi
    SCAN_BASE="${SCAN_BASE:-nightly}"; SCAN_BASE_VERSION=nightly
    SCAN_BASE_FROM="the last nightly's, of ${SCAN_BASE:0:12}: none of its last $SCAN_BASE_DEPTH first-parent commits has one"
    log "no findings of the base $BUILD_BASE nor of its ancestors: compared with the last nightly ($SCAN_BASE)"; return 0
  fi
  log "no findings of the base $BUILD_BASE, of its ancestors or of a nightly: every blocking finding fails"
}

# A commit's published findings into file, if they are there and a list.
base_package() { # commit file
  curl -fsS -H "JOB-TOKEN: $CI_JOB_TOKEN" -o "$2" "$(package_url "$1" findings.json)" 2>/dev/null &&
    jq -e 'type == "array"' "$2" >/dev/null 2>&1 && return 0
  rm -f "$2"; return 1
}

# The policy on the run's findings, with dir's security-exceptions.yaml and
# security-baseline.json (the commit's), the reports; the verdict ends the run.
# With a base's findings, a finding the base has (by tool, rule and file, up to
# its count there, in line order) is standing: a blocking one fails no build.
scan_policy() { # dir previous-findings started [base-findings]
  local src="$1" previous="$2" started="$3" base="${4:-/nonexistent}" t
  [[ -f "$base" ]] && SCAN_BASE_READ=1
  # The exceptions, the policy, the comparison.
  local exceptions errs today
  today="$(date -u +%Y-%m-%d)"
  if ! exceptions="$(read_exceptions "$src/$EXCEPTIONS_FILE" 2>"$SCAN_WORK/exc.err")"; then
    problems+=("$EXCEPTIONS_FILE: $(head -1 "$SCAN_WORK/exc.err")"); exceptions='[]'
  fi
  errs="$(jq -r --arg today "$today" '.[] |
      if (.id // "") == "" then "an exception without an id"
      elif ((.reason // "") == "" or (.decided_by // "") == "") then "exception \(.id): it needs a reason and who decided (decided_by)"
      elif ((.expires // "") | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$") | not) then "exception \(.id): expires \(.expires // "" | @json) is not a date YYYY-MM-DD"
      elif .expires < $today then "exception \(.id) expired on \(.expires) (\(.decided_by): \(.reason))"
      elif has("where") and .where == "" then "exception \(.id): its where is empty (a path or a path glob, or no where)"
      else empty end' <<<"$exceptions")"
  [[ -z "$errs" ]] || while IFS= read -r t; do problems+=("$t"); done <<<"$errs"
  errs="$(jq -r '.[] | select(has("where") | not) | "exception \(.id) has no where: it accepts \(.id) in every file (scope it: where)"' <<<"$exceptions")"
  [[ -z "$errs" ]] || while IFS= read -r t; do warnings+=("$t"); done <<<"$errs"
  local baseline='[]'
  if [[ -f "$src/$BASELINE_FILE" ]] && ! baseline="$(jq -ce 'if type == "array" and all(.[]; type == "object" and keys == ["count", "file", "id", "tool"]
           and ([.tool, .id, .file] | all(type == "string")) and (.count | type == "number" and . >= 1 and . == floor)) then . else error end' \
         "$src/$BASELINE_FILE" 2>/dev/null)"; then
    problems+=("$BASELINE_FILE: not a list of {tool, id, file, count} (looper-scan baseline writes it)"); baseline='[]'
  fi
  # As files, never arguments: a baseline of thousands is past what one
  # argument may hold (looper#201).
  printf '%s\n' "$exceptions" > "$SCAN_WORK/exceptions.json"; printf '%s\n' "$baseline" > "$SCAN_WORK/baseline.json"

  local norms=()
  mapfile -t norms < <(find "$SCAN_OUT/norm" -name '*.json' | LC_ALL=C sort)
  ((${#norms[@]})) || norms=(/dev/null)
  # The baseline's count of a tool, rule and file goes to its findings in line
  # order, and so does the base's.
  jq -s --slurpfile exc "$SCAN_WORK/exceptions.json" --arg today "$today" --slurpfile base "$SCAN_WORK/baseline.json" --slurpfile prev <(cat "$previous" 2>/dev/null || echo '[]') \
        --slurpfile landbase <(cat "$base" 2>/dev/null || echo '[]') "$JQ_BASELINE$JQ_GLOB"'
    ($prev[0] // [] | map(.tool + "|" + .id + "|" + .where) | map({(.): true}) | add // {}) as $old
    | ($base[0] | map({(.tool + "|" + .id + "|" + .file): .count}) | add // {}) as $quota
    | ($landbase[0] // [] | map(.tool + "|" + .id + "|" + file_of) | group_by(.) | map({(.[0]): length}) | add // {}) as $standing
    | [.[][]] | unique_by([.tool, .id, .where]) | map(
        . as $f
        | ([$exc[0][] | select(.expires >= $today and (.id as $x | $f.id == $x or any($f.aliases[]; . == $x))
                          and ((has("where") | not) or (.where != "" and (.where as $w | $f | in_where($w)))))][0]) as $e
        | . + {excepted: ($e.id // null), test: (.test == true),
               blocking: ($e == null and (.kind == "secret" or ((.severity == "HIGH" or .severity == "CRITICAL") and .fix and (.test != true)))),
               new: ($old[.tool + "|" + .id + "|" + .where] | not)})
    | sort_by(.tool, .id, file_of, line_of)
    | reduce .[] as $f ({q: $quota, s: $standing, out: []};
        ($f.tool + "|" + $f.id + "|" + ($f | file_of)) as $k
        | ((.s[$k] // 0) > 0) as $st | (if $st then .s[$k] -= 1 else . end)
        | if ($f | baselinable) and (.q[$k] // 0) > 0 then .q[$k] -= 1 | .out += [$f + {baselined: true, new: false, standing: $st}]
          else .out += [$f + {baselined: false, standing: $st}] end)
    | .out
    | sort_by(if .blocking then 0 else 1 end, {"CRITICAL": 0, "HIGH": 1, "MEDIUM": 2, "LOW": 3}[.severity] // 4, .tool, .id, file_of, line_of)' \
    "${norms[@]}" > "$SCAN_OUT/findings.json" || scan_verdict fail "the findings could not be read together (a tool's report)"

  tool_versions > "$SCAN_OUT/tools.json"
  databases "$started" > "$SCAN_OUT/databases.json"
  write_sarif > "$SCAN_OUT/findings.sarif"
  local blocking failing
  blocking="$(jq '[.[] | select(.blocking)] | length' "$SCAN_OUT/findings.json")"
  failing="$(jq '[.[] | select(.blocking and (.standing | not))] | length' "$SCAN_OUT/findings.json")"
  write_summary "$blocking" "$started" > "$SCAN_OUT/summary.md"
  cat "$SCAN_OUT/summary.md" >&2

  if ((${#problems[@]})); then scan_verdict fail "${problems[0]}$( ((${#problems[@]} > 1)) && echo " (and $((${#problems[@]} - 1)) more: security/summary.md)")"; fi
  if ((failing)); then
    scan_verdict fail "$failing security finding(s) the policy fails$([[ -z "$SCAN_BASE_READ" ]] || echo ", not the base's"): $(jq -r '[.[] | select(.blocking and (.standing | not)) | .id][0:3] | join(", ")' "$SCAN_OUT/findings.json") (security/summary.md)"
  fi
  ((blocking == 0)) || log "$blocking blocking finding(s), each the base's (standing): main's, the nightly's to file"
  scan_verdict pass
}

# yaml_scalar, tacplus_field, inside_dir, tacplus_generated_dir and
# tacplus_output_spec (a tacplus config's generated tree, as tacplus writes it)
# are looper-build's (sourced above): the gates keep that tree whole (looper#155).

# A service's generated trees (looper#108, looper#149, looper#152): the tree
# every tacplus.yaml in the tree (a service's, a client subproject's)
# generates, each relative to its config, as path prefixes ("tacplus/") in
# SCAN_GEN; none of a config without an output-dir, or whose tree is not a
# directory inside it.
SCAN_GEN=()
generated_tree() { # src
  local p rel d
  SCAN_GEN=()
  while read -r p; do
    rel="${p#"$1"}"; rel="${rel#/}"; rel="${rel:+$rel/}"
    if d="$(tacplus_generated_dir "$p/tacplus.yaml")"; then SCAN_GEN+=("$rel$d/")
    else notes+=("${rel}tacplus.yaml: $(tacplus_output_spec "$p/tacplus.yaml") is not a directory inside its project: its generated code is counted")
    fi
  done < <(projects "$1" tacplus.yaml)
}

# The code tacplus generates is tacplus's (looper#108): a service's SAST
# findings and secrets in its generated tree are kept aside
# (security/generated.json), not counted, since tacplus scans its generated
# output itself, at the source (its `generated` recipe). Its dependencies are
# still checked (SCA), as is everything a `generated` recipe gives.
scan_gen_list() { printf '%s\n' "${SCAN_GEN[@]}" | LC_ALL=C sort | paste -sd, - | sed 's/,/, /g'; }
skip_generated_tree() { # src
  local f
  generated_tree "$1"
  ((${#SCAN_GEN[@]})) || return 0
  local parts=() g
  g="$(printf '%s\n' "${SCAN_GEN[@]}" | jq -R . | jq -sc .)"
  for f in "$SCAN_OUT"/norm/*-source.json "$SCAN_OUT"/norm/*-source-*.json; do
    [[ -f "$f" ]] || continue
    jq --argjson g "$g" '[.[] | select((.kind == "sast" or .kind == "secret") and (.where as $w | any($g[]; . as $p | $w | startswith($p))))]' "$f" > "$f.gen"
    jq --argjson g "$g" '[.[] | select((.kind == "sast" or .kind == "secret") and (.where as $w | any($g[]; . as $p | $w | startswith($p))) | not)]' "$f" > "$f.tmp"
    mv "$f.tmp" "$f"; parts+=("$f.gen")
  done
  ((${#parts[@]})) || parts=(/dev/null)
  jq -s '[.[][]] | unique_by([.tool, .id, .where]) | sort_by(.tool, .id, .where)' "${parts[@]}" > "$SCAN_OUT/generated.json"
  rm -f "$SCAN_OUT"/norm/*.gen
  log "the generated tree ($(scan_gen_list)): $(jq length "$SCAN_OUT/generated.json") SAST finding(s) and secret(s) not counted (tacplus's to scan)"
}

# Test code (looper#179): a SAST finding there is listed (test: true), never
# failing the policy; a secret, a dependency or a misconfiguration there keeps
# its rules. Test code is, by its language: Rust, a #[cfg(test)] module (from
# its attribute to its closing brace, RUST_TEST_MODULES) or a file under a
# tests/ directory; Go, a _test.go file; TypeScript and JavaScript, a file
# under a test/ directory or named *.test.*; Java, a file under src/test/.
JQ_TEST='
def test_path: split("/") as $c | $c[-1] as $b | $c[:-1] as $dirs
  | if $b | endswith(".rs") then any($dirs[]; . == "tests")
    elif $b | endswith(".go") then $b | test("^.+_test[.]go$")
    elif $b | test("[.][cm]?[jt]sx?$") then any($dirs[]; . == "test") or ($b | test("^.+[.]test[.][^.]+$"))
    elif $b | endswith(".java") then [range(0; ($dirs | length) - 1) as $i | $dirs[$i:$i + 2]] | any(. == ["src", "test"])
    else false end;
def test_code($modules): file_of as $f | line_of as $l
  | ($f | test_path) or any($modules[$f][]?; $l >= .[0] and $l <= .[1]);
'
# A Rust file's #[cfg(test)] modules, outermost only: "first last", the
# attribute's line and the closing brace's (an unclosed one, to the end of the
# file); a file whose own inner #![cfg(test)] makes it test code, "1 last".
# Comments, strings, raw strings and character literals are blanked first: a
# brace in one counts for nothing. A `mod name;` declared under #[cfg(test)]
# is a file this does not follow (PROPOSALS.md).
RUST_TEST_MODULES='
function blank(s,    o, i, n, c, t, m) {
  o = ""; i = 1; n = length(s)
  while (i <= n) {
    c = substr(s, i, 1); t = substr(s, i, 2)
    if (blk) { if (t == "/*") { blk++; i += 2 } else if (t == "*/") { blk--; i += 2; if (!blk) o = o " " } else i++; continue }
    if (str) { if (c == "\\") i += 2; else { if (c == "\"") { str = 0; o = o "\"\"" } i++ } continue }
    if (raw != "") { m = index(substr(s, i), raw); if (!m) return o; i += m - 1 + length(raw); raw = ""; o = o "\"\""; continue }
    if (t == "//") return o
    if (t == "/*") { blk = 1; i += 2; continue }
    if (c == "\"") { str = 1; i++; continue }
    if ((c == "r" || t == "br") && (i == 1 || substr(s, i - 1, 1) !~ /[A-Za-z0-9_]/) && match(substr(s, i), /^b?r#*"/)) {
      raw = "\"" substr(s, i + 1 + (c == "b"), RLENGTH - 2 - (c == "b")); i += RLENGTH; continue
    }
    if (c == "\047" && match(substr(s, i), /^\047(\\.[^\047]*|[^\\\047])\047/)) { o = o "\047 \047"; i += RLENGTH; continue }
    o = o c; i++
  }
  return o
}
# The items: st 1 after a #[cfg(test)] (its attributes, visibility and
# keywords up to mod), 2 after its mod, 3 after the module name.
function token(t, line) {
  if (st == 1) { if (t == "mod") { st = 2; return } if (t ~ /^(#|[A-Za-z_][A-Za-z0-9_]*$|[():])/) return; st = 0 }
  else if (st == 2) { if (t ~ /^[A-Za-z_][A-Za-z0-9_]*$/) { st = 3; return } st = 0 }
  else if (st == 3) { st = 0; if (t == "{") { if (!open) { open = 1; target = depth; first = start } depth++; return } }
  if (t == "#test") { if (!open) { st = 1; start = line } }
  else if (t == "#!test") { if (depth == 0) whole = 1 }
  else if (t == "{") depth++
  else if (t == "}") { depth--; if (open && depth == target) { print first, line; open = 0 } }
}
function scan(s, line,    i, n, c) {
  i = 1; n = length(s)
  while (i <= n) {
    c = substr(s, i, 1)
    if (attr) {
      if (c == "[") attr++; else if (c == "]" && !--attr) { gsub(/[ \t]/, "", a); token((a == "cfg(test)" ? (inner ? "#!test" : "#test") : "#"), line); i++; continue }
      a = a c; i++; continue
    }
    if (c == "#" && match(substr(s, i), /^#!?[ \t]*\[/)) { attr = 1; a = ""; inner = substr(s, i + 1, 1) == "!"; i += RLENGTH; continue }
    if (c ~ /[ \t]/) { i++; continue }
    if (match(substr(s, i), /^[A-Za-z_][A-Za-z0-9_]*/)) { token(substr(s, i, RLENGTH), line); i += RLENGTH; continue }
    token(c, line); i++
  }
  if (attr) a = a " "
}
{ scan(blank($0), NR) }
END { if (open) print first, NR; if (whole) print 1, NR }
'
rust_test_modules() { # file
  LC_ALL=C awk "$RUST_TEST_MODULES" "$1"
}
mark_test_code() { # tree label prefix
  local f r modules
  for f in "$SCAN_OUT/norm/"*-"$2".json "$SCAN_OUT/norm/"*-"$2"-*.json; do
    [[ -f "$f" ]] || continue
    modules="$(jq -r --arg prefix "$3" "$JQ_BASELINE"'.[] | select(.kind == "sast") | file_of | select(endswith(".rs")) | ltrimstr($prefix)' "$f" |
      LC_ALL=C sort -u | while IFS= read -r r; do
        [[ -f "$1/$r" ]] || continue
        rust_test_modules "$1/$r" | jq -R --arg f "$3$r" '{file: $f, range: (split(" ") | map(tonumber))}'
      done | jq -sc 'group_by(.file) | map({(.[0].file): map(.range)}) | add // {}')"
    jq --slurpfile modules <(printf '%s\n' "$modules") "$JQ_BASELINE$JQ_TEST"'map(if .kind == "sast" then . + {test: test_code($modules[0])} else . end)' "$f" > "$f.tmp"
    mv "$f.tmp" "$f"
  done
}

# The same checks on a directory, as a build would run them on its commit:
# no credential, no last nightly (every finding is new), nothing published.
cmd_local() { # dir
  [[ -d "${1:-}" ]] || { scan_usage >&2; exit 2; }
  local dir; dir="$(cd "$1" && pwd)"
  BUILD_REPO="${BUILD_REPO:-$(basename "$dir")}"
  BUILD_SHA="${BUILD_SHA:-$(git -C "$dir" rev-parse HEAD 2>/dev/null || echo local)}"
  SCAN_PUBLIC="${BUILD_SCAN_PUBLIC:-unknown}"   # true: CodeQL may run (an open-source repository)
  # The reports are never in the tree while it is scanned (looper#161): its
  # scanners would read them (gitleaks: govulncheck's commit hashes as
  # tokens). Without a BUILD_OUT they go to a directory of their own; a
  # BUILD_OUT/security inside DIR gets them once the scan is done.
  local reports="$SCAN_OUT" scratch=""
  [[ -n "$SCAN_OUT_GIVEN" ]] || reports="$(mktemp -d)/security"
  rm -rf "$reports"; mkdir -p "$reports"; SCAN_REPORTS="$(cd "$reports" && pwd)"
  SCAN_OUT="$SCAN_REPORTS"
  case "$(cd "$reports" && pwd -P)/" in
    "$(cd "$dir" && pwd -P)"/*) rmdir "$reports"; scratch="$(mktemp -d)"; SCAN_OUT="$scratch/security" ;;
  esac
  mkdir -p "$SCAN_OUT/raw" "$SCAN_OUT/norm"
  SCAN_WORK="$(mktemp -d)"
  # shellcheck disable=SC2064  # this run's directories
  if [[ -n "$scratch" ]]; then trap "rm -rf '$SCAN_WORK'; mv '$SCAN_OUT' '$SCAN_REPORTS'; rmdir '$scratch'" EXIT
  else trap "rm -rf '$SCAN_WORK'" EXIT; fi
  scan_tree "$dir" /nonexistent "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

# The repository's findings: a generic package of the build project (its
# package registry, which a job's token may read and write), a version each:
# latest, nightly (the last nightly's, looper#211), or a commit's (looper#180:
# a land's base's).
package_url() { # version file
  echo "$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/security-$BUILD_REPO/$1/$2"
}

# One SARIF log, a run per tool, of every finding (the native SARIF of
# Semgrep, SpotBugs and CodeQL is in raw/ too).
write_sarif() {
  jq '{"$schema": "https://json.schemastore.org/sarif-2.1.0.json", version: "2.1.0",
       runs: (group_by(.tool) | map({tool: {driver: {name: .[0].tool, informationUri: "https://github.com/tacplus-dev/looper#security-checks",
         rules: (map({id: .id, properties: {severity: .severity}}) | unique_by(.id))}},
         results: map({ruleId: .id, level: (if .blocking then "error" elif .excepted or .baselined or .test then "note" else "warning" end),
           message: {text: ((.title // "") + (if .excepted then " (accepted: security-exceptions.yaml)" elif .baselined then " (baselined: security-baseline.json)" elif .test then " (in test code)" else "" end)
                            + (if .standing then " (standing: the base has it)" else "" end))},
           properties: {severity: .severity, fix: .fix, kind: .kind, new: .new, baselined: .baselined, test: .test, standing: .standing, aliases: .aliases},
           locations: [{physicalLocation: {artifactLocation: {uri: (.where | sub(":[0-9]+$"; ""))},
             region: {startLine: ((.where | capture(":(?<l>[0-9]+)$").l // "1") | tonumber)}}}]})}))}' \
    "$SCAN_OUT/findings.json"
}

write_summary() { # blocking started
  local f="$SCAN_OUT/findings.json" p
  echo "## Security checks: $BUILD_REPO $BUILD_SHA ($SCAN_KIND)"
  # Its run (looper#210): the commit is main's night after night, the pipeline and the time are not.
  echo; echo "$(run_of) started $2."
  echo
  jq -r '"\(length) finding(s): \([.[] | select(.blocking)] | length) failing the policy, \([.[] | select(.new)] | length) new since the last nightly, \([.[] | select(.baselined)] | length) baselined (security-baseline.json), \([.[] | select(.excepted)] | length) accepted by an exception, \([.[] | select(.test)] | length) SAST in test code (listed, never failing)."' "$f"
  if [[ -n "$SCAN_BASE_READ" ]]; then
    echo; printf '%s finding(s) standing (%s'"'"'s), %s of them failing the policy: main'"'"'s, reported and not failed here (the nightly'"'"'s to file); this build fails only on what its change adds (looper#180).\n' \
      "$(jq '[.[] | select(.standing)] | length' "$f")" "$([[ -n "$SCAN_BASE_FROM" ]] || echo "the base ")${SCAN_BASE:0:12}" "$(jq '[.[] | select(.blocking and .standing)] | length' "$f")"
    [[ -z "$SCAN_BASE_FROM" ]] ||
      { echo; echo "The base ${BUILD_BASE:0:12} published no findings (no build ran on it): its findings are $SCAN_BASE_FROM (looper#217)."; }
  elif [[ -n "$SCAN_BASE" ]]; then
    echo; echo "No findings of the base ${SCAN_BASE:0:12} (its build published none), of its last $SCAN_BASE_DEPTH first-parent commits or of a nightly: every finding failing the policy fails this build."
  fi
  [[ -z "${SCAN_REPORTS:-}" ]] || { echo; echo "Reports: $SCAN_REPORTS"; }
  if ((${#problems[@]})); then echo; echo "### Problems (each fails the run)"; for p in "${problems[@]}"; do echo "- $p"; done; fi
  if ((${#warnings[@]})); then echo; echo "### Warnings (none fails the run)"; for p in "${warnings[@]}"; do echo "- $p"; done; fi
  if (($1)); then echo; echo "### Failing the policy"; jq -r '.[] | select(.blocking) | "- \(.severity) \(.tool) \(.id): \(.where)\(if .title != "" then ": " + .title else "" end)\(if .standing then " (standing)" else "" end)"' "$f"; fi
  if jq -e 'any(.new)' "$f" >/dev/null; then echo; echo "### New since the last nightly"; jq -r '.[] | select(.new) | "- \(.severity) \(.tool) \(.id): \(.where)"' "$f"; fi
  # What the last nightly had too (looper#211): the nightly scan files each one no open issue names.
  if jq -e "$JQ_STANDING"'any(standing_high)' "$f" >/dev/null; then
    echo; echo "### Standing HIGH/CRITICAL, not baselined, not excepted"
    jq -r "$JQ_STANDING"'.[] | select(standing_high) | "- \(.severity) \(.tool) \(.id): \(.where)\(if .title != "" then ": " + .title else "" end)"' "$f"
  fi
  if jq -e 'any(.excepted)' "$f" >/dev/null; then echo; echo "### Accepted (security-exceptions.yaml)"; jq -r '.[] | select(.excepted) | "- \(.excepted): \(.tool) \(.where)"' "$f"; fi
  if jq -e 'any(.test)' "$f" >/dev/null; then
    echo; echo "### In test code (SAST: listed, never failing the policy; looper#179)"
    jq -r '.[] | select(.test) | "- \(.severity) \(.tool) \(.id): \(.where)\(if .title != "" then ": " + .title else "" end)"' "$f"
  fi
  if ((${#SCAN_GEN[@]})); then
    echo; echo "### Not counted: the generated tree ($(scan_gen_list))"
    jq -r 'length as $n | "\($n) SAST finding(s) and secret(s) in the code tacplus generates (security/generated.json): tacplus scans its generated output at the source; its dependencies are checked here (looper#108)."
           , (group_by(.tool + " " + .id)[] | "- \(.[0].tool) \(.[0].id): \(length)")' "$SCAN_OUT/generated.json"
  fi
  if ((${#binaries[@]})); then
    echo; echo "### The image's binaries (govulncheck -mode=binary on every Go binary under $SCAN_IMAGE_ROOT/usr/local/bin)"
    for p in "${binaries[@]}"; do echo "- $p"; done
  fi
  if ((${#notes[@]})); then echo; echo "### Not analyzed, or in part"; for p in "${notes[@]}"; do echo "- $p"; done; fi
  if ((${#peaks[@]})); then echo; echo "### Memory"; for p in "${peaks[@]}"; do echo "- $p"; done; fi
  if [[ -f "$SCAN_OUT/durations.json" ]]; then
    echo; echo "### Durations (looper#207)"
    jq -r 'def t: if . >= 60 then "\(. / 60 | floor)m \(. % 60)s" else "\(.)s" end;
      "The scanners: \(.seconds | t), \(.jobs) at a time; one after another, \([.tools[] | select(.tool != "syft") | .seconds] | add // 0 | t).",
      (.tools | group_by(.tool) | map({tool: .[0].tool, seconds: (map(.seconds) | add), trees: .}) | sort_by(-.seconds, .tool)[]
       | "- \(.tool): \(.seconds | t)\(if (.trees | length) > 1 then " (" + (.trees | map("\(.tree) \(.seconds | t)") | join(", ")) + ")" else "" end)")' \
      "$SCAN_OUT/durations.json"
  fi
  echo; echo "### Checked against"; jq -r 'to_entries[] | "- \(.key): \(.value | to_entries | map("\(.key) \(.value)") | join(", "))"' "$SCAN_OUT/databases.json"
  echo; echo "### Tools"; jq -r 'to_entries[] | "- \(.key) \(.value)"' "$SCAN_OUT/tools.json"
}

# The Go binaries of an image (looper#167): ROOT is its root (/ in the image
# itself, as its Dockerfile's last step runs it, or its files unpacked), DIR
# the commit's checkout or a directory holding its security-exceptions.yaml
# (and security-baseline.json). No last nightly: every finding is new.
cmd_image() { # root dir
  [[ $# -eq 2 && -d "$1" && -d "$2" ]] || { scan_usage >&2; exit 2; }
  local dir; SCAN_IMAGE_ROOT="$(cd "$1" && pwd)"; SCAN_IMAGE_ROOT="${SCAN_IMAGE_ROOT%/}"; dir="$(cd "$2" && pwd)"
  SCAN_KIND=image
  BUILD_REPO="${BUILD_REPO:-image}"; BUILD_SHA="${BUILD_SHA:-${SCAN_IMAGE_ROOT:-/}}"
  [[ -n "$SCAN_OUT_GIVEN" ]] || { SCAN_OUT="$(mktemp -d)/security"; SCAN_REPORTS="$SCAN_OUT"; }
  rm -rf "$SCAN_OUT"; mkdir -p "$SCAN_OUT/raw" "$SCAN_OUT/norm"
  SCAN_WORK="$(mktemp -d)"
  # shellcheck disable=SC2064  # this run's directory
  trap "rm -rf '$SCAN_WORK'" EXIT
  local started; started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  log "security (image): the Go binaries under $SCAN_IMAGE_ROOT/usr/local/bin"
  tool_binaries "$SCAN_IMAGE_ROOT"
  scan_policy "$dir" /nonexistent "$started"
}

# The pipeline and job a summary is of, the start of its line: "Pipeline <url>,
# job <url>," (a run by hand: "Run here (no pipeline),").
run_of() {
  if [[ -n "${CI_PIPELINE_URL:-}" ]]; then echo "Pipeline $CI_PIPELINE_URL,${CI_JOB_URL:+ job $CI_JOB_URL,}"
  else echo "Run here (no pipeline),"; fi
}

# --- report -------------------------------------------------------------------------

# A security job that left no findings (looper#210): killed, OOM-killed, timed
# out, its pod never scheduled or its runner lost. Its summary, saying so, is
# the latest's, so that no one reads the last run's as this one's: the run, why,
# and the last report, whose findings the latest still holds. The findings are
# left as they are: the latest's, the commit's (what a land compares with) and
# the last nightly's (what new is measured against). Fails the job.
report_none() {
  local why last s="$SCAN_WORK/summary.md" pkg="security-$BUILD_REPO"
  why="$(sed -n '1s/^fail: /its verdict: fail: /p' "$SCAN_OUT/verdict" 2>/dev/null || true)"
  [[ -n "$why" ]] || why="no security/ artifact: it was killed, OOM-killed or timed out, its pod never scheduled, or its runner lost (its log in the pipeline says which)"
  if curl -fsS -H "JOB-TOKEN: $CI_JOB_TOKEN" -o "$SCAN_WORK/last.md" "$(package_url latest summary.md)" 2>/dev/null; then
    last="$(sed -n '/^Last report[,:] /{p;q}' "$SCAN_WORK/last.md")"
    [[ -n "$last" ]] || last="Last report, whose findings $pkg/latest/findings.json still holds: $(sed -n '1s/^## Security checks: //p' "$SCAN_WORK/last.md"); $(
      sed -n '/^Pipeline .*, started .*\.$/{p;q}' "$SCAN_WORK/last.md" | grep . || echo "its summary names no run (before looper#210).")"
  else
    last="Last report: none ($pkg/latest had no summary)."
  fi
  { echo "## Security checks: $BUILD_REPO $BUILD_SHA ($SCAN_KIND): no report"
    echo; echo "$(run_of) reported $(date -u +%Y-%m-%dT%H:%M:%SZ)."
    echo; echo "### Problems (each fails the run)"; echo "- security-$BUILD_REPO left no findings: $why"
    echo; echo "$last"
  } > "$s"
  cat "$s"
  curl -fsS -o /dev/null -H "JOB-TOKEN: $CI_JOB_TOKEN" --upload-file "$s" "$(package_url latest summary.md)" ||
    { log "the package registry refused summary.md (latest)"; exit 1; }
  log "the security job left no findings: published $pkg/latest/summary.md saying so (the findings are left as they were)"
  exit 1
}

cmd_report() {
  check_inputs
  [[ -f "$SCAN_OUT/summary.md" ]] && cat "$SCAN_OUT/summary.md"
  : "${CI_JOB_TOKEN:?no job token: the report publishes with it}" "${CI_API_V4_URL:?}" "${CI_PROJECT_ID:?}"
  if [[ ! -f "$SCAN_OUT/findings.json" ]]; then
    SCAN_WORK="$(mktemp -d)"
    # shellcheck disable=SC2064  # this run's directory
    trap "rm -rf '$SCAN_WORK'" EXIT
    report_none
  fi
  local f v
  # As the latest, and as its commit's: what a land built on it compares with
  # (looper#180); a nightly's as the last nightly's too, what new is measured
  # against (looper#211).
  for v in latest "$BUILD_SHA" $([[ "$SCAN_KIND" != nightly ]] || echo nightly); do
    for f in findings.json summary.md "$SEMGREP_READ"; do
      [[ -f "$SCAN_OUT/$f" ]] || continue
      curl -fsS -o /dev/null -H "JOB-TOKEN: $CI_JOB_TOKEN" --upload-file "$SCAN_OUT/$f" "$(package_url "$v" "$f")" ||
        { log "the package registry refused $f ($v)"; exit 1; }
    done
  done
  log "published as security-$BUILD_REPO/latest (what the nightly scan reads) and security-$BUILD_REPO/$BUILD_SHA (a land on it compares with it)$([[ "$SCAN_KIND" != nightly ]] || echo ", and as security-$BUILD_REPO/nightly (what the next run's new is measured against)")"
}

# --- baseline -----------------------------------------------------------------------

# A run's findings (its findings.json: the security job's artifact, or the
# repository's latest) as the security-baseline.json a repository commits:
# per tool, rule and file, how many of its findings a later run takes as
# baselined. Only what may be baselined; one entry a line, sorted, its keys
# too (as the README shows it; jq's tojson keeps the order they were put in,
# looper#154), so a change to it reads as a diff.
cmd_baseline() { # findings
  [[ $# -eq 1 && -f "$1" ]] || { scan_usage >&2; exit 2; }
  jq -e 'type == "array"' "$1" >/dev/null 2>&1 || { echo "looper-scan: $1 is not a findings list" >&2; exit 1; }
  jq -r "$JQ_BASELINE"'
    [.[] | select(baselinable) | {file: file_of, id, tool}] | group_by([.tool, .id, .file]) | map({count: length} + .[0])
    | "[", (.[:-1][] | "  " + tojson + ","), (.[-1:][] | "  " + tojson), "]"' "$1"
}

# --- sbom ---------------------------------------------------------------------------

cmd_sbom() { # source dir
  [[ $# -eq 2 ]] || { scan_usage >&2; exit 2; }
  mkdir -p "$2"
  syft scan -q "$1" -o "cyclonedx-json=$2/sbom.cdx.json" -o "spdx-json=$2/sbom.spdx.json"
}

case "${1:-}" in
  run) cmd_run ;;
  local) shift; cmd_local "$@" ;;
  report) cmd_report ;;
  baseline) shift; cmd_baseline "$@" ;;
  sbom) shift; cmd_sbom "$@" ;;
  image) shift; cmd_image "$@" ;;
  -h|--help) scan_usage ;;
  *) scan_usage >&2; exit 2 ;;
esac
