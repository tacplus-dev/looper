#
# looper-dispatch: the kicker. It does no work itself and runs as the
# kicker schedule of the GitLab looper pipeline (LOOPER_PIPELINE, default
# tacplus-dev/looper; looper#24): nothing runs on the Mac. Each pass clears
# looper:in-progress from issues no looper job holds any more, then looks for
# tacplus-dev repositories with a ready issue and, when one of them has no
# looper job created, pending, waiting or running, starts that pipeline, whose
# plan runs repo-looper in ghcr.io/tacplus-dev/looper:main on the autoscaled
# runner. The nightly scan and the port scan are its other schedules.
#
#   looper-dispatch run                one pass: start the pipeline if a repository needs it
#   looper-dispatch run --for SECONDS  a pass every LOOPER_INTERVAL seconds (default 180) for
#                                      SECONDS (the kicker job); fails at the end if a pass failed
#   looper-dispatch status             the looper jobs in GitLab, and what is ready
#   looper-dispatch ready              each repository's next ready issue, "<repo> <issue>", in the
#                                      order the plan takes them: priority:high first (looper#31)
#   looper-dispatch plan               the pipeline's child jobs, one per free repository with a
#                                      ready issue, as YAML on stdout (ci/instance.gitlab-ci.yml)
#   looper-dispatch uninstall          remove the launchd job earlier versions installed on a Mac
#
# The forge (looper#29): LOOPER_FORGE=github (the default; issues through gh)
# or gitlab (a GitLab group's issues through its API, LOOPER_FORGE_TOKEN), and
# LOOPER_ORG, the org or group (looper-lib.sh). SeaBeam's instance is the
# second: README, A SeaBeam instance.
#
# Credentials (looper#25; README, Credentials): GH_TOKEN (GitHub issues),
# GITLAB_TOKEN (read_api on the pipeline's project: its jobs) and
# LOOPER_TRIGGER_TOKEN (the project's pipeline trigger: starting it), project
# CI variables of the pipeline's project, masked and protected. Without
# LOOPER_TRIGGER_TOKEN the pipeline is started with GITLAB_TOKEN, which then
# needs api scope.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=looper-lib.sh
source "${LOOPER_LIB:-$HERE/looper-lib.sh}"

PIPELINE="${LOOPER_PIPELINE:-tacplus-dev/looper}"
INTERVAL="${LOOPER_INTERVAL:-180}"
API="${CI_API_V4_URL:-https://gitlab.com/api/v4}/projects/${PIPELINE//\//%2F}"

gitlab() { # curl args...
  [[ -n "${GITLAB_TOKEN:-}" ]] || die "no GITLAB_TOKEN: a GitLab token with api scope on $PIPELINE"
  curl -fsS --retry 2 -H "PRIVATE-TOKEN: $GITLAB_TOKEN" "$@"
}

# Starts the pipeline on main: through its trigger, whose token is on no
# command line, else with GITLAB_TOKEN.
start_pipeline() {
  if [[ -n "${LOOPER_TRIGGER_TOKEN:-}" ]]; then
    printf 'token=%s&ref=main' "$LOOPER_TRIGGER_TOKEN" | curl -fsS --retry 2 -X POST "$API/trigger/pipeline" --data @- >/dev/null
  else
    gitlab -X POST "$API/pipeline" -d ref=main >/dev/null
  fi
}

# Names of the looper pipeline's jobs that are created, pending, waiting for
# their resource_group or running (busy() in looper-lib.sh).
active_jobs() {
  gitlab "$API/jobs?$LOOPER_JOB_SCOPES&per_page=100" | jq -r '.[].name'
}

# A run killed outright (its runner gone, looper#20) never removes
# looper:in-progress. An issue labelled so in a repository with no looper job
# created, pending, waiting or running is held by no run: the label goes, the
# issue says why, and the pipeline's job resumes it from its checkpoint.
release_orphans() { # active jobs
  local repo n
  forge_search_issues "$LABEL_IN_PROGRESS" 200 repository,number '.[] | "\(.repository.name) \(.number)"' \
  | while read -r repo n; do
      busy "$repo" "$1" >/dev/null && continue
      forge_issue_edit "$repo" "$n" --remove-label "$LABEL_IN_PROGRESS" >/dev/null || continue
      forge_issue_comment "$repo" "$n" "This issue was \`$LABEL_IN_PROGRESS\`, but $repo has no looper job created, pending, waiting or running in $PIPELINE: the run that held it is gone (killed with its runner, say). The label is removed, so the next run takes it, resuming from its branch if it left one (looper#20)." >/dev/null || true
      log "$repo#$n: $LABEL_IN_PROGRESS with no looper job; label removed"
    done
}

# One pass: release the orphans, then start the pipeline for the first
# repository with a ready issue and no looper job of its own, in the order of
# ready_by_repo (priority:high first, looper#31).
pass() {
  local jobs ready repo n
  jobs="$(active_jobs)"
  release_orphans "$jobs"
  # A plan under way will take every ready issue; wait for it.
  grep -qx 'looper-plan' <<<"$jobs" && { log "looper-plan under way; nothing to start"; return 0; }
  ready="$(ready_by_repo)"
  while read -r repo n; do
    [[ -n "$repo" ]] || continue
    busy "$repo" "$jobs" >/dev/null && continue
    start_pipeline
    log "started the $PIPELINE pipeline ($repo has a ready issue)"
    return 0
  done <<<"$ready"
  log "no repository with a ready issue is free; nothing to start"
}

# The pipeline's plan (looper#29; ci/instance.gitlab-ci.yml): its child
# pipeline on stdout, one job per repository with a ready issue and no looper
# job of its own active (looper#16), named looper-<repo>-<issue>, in the order
# of ready_by_repo (priority:high first, looper#31), sized by
# `repo-looper --job-timeout` (looper#33), one at a time per repository
# (resource_group looper-<repo>). LOOPER_JOB_IMAGE and LOOPER_JOB_TAGS
# (comma-separated) are the jobs' image and runner tags; LOOPER_JOB_TAGS_<repo>
# (`-` as `_`) overrides the tags for one repository's job (looper#55: tacplus's
# on the 16-CPU pool). With none to plan, one job that says so: a child
# pipeline has at least one.
plan() {
  local jobs ready repo n t v tags image="${LOOPER_JOB_IMAGE:-ghcr.io/tacplus-dev/looper:main}" any=""
  jobs="$(active_jobs)"; ready="$(ready_by_repo)"
  printf 'variables:\n  GIT_STRATEGY: none\n  LOOPER_WORK: /builds/looper\n'
  while read -r repo n; do
    [[ -n "$repo" ]] || continue
    if busy "$repo" "$jobs" >/dev/null; then log "$repo already has a looper job; not planned again" >&2; continue; fi
    t="$("$HERE/repo-looper" --repo "$repo" --job-timeout "$n")" || t=6h
    v="LOOPER_JOB_TAGS_${repo//[^A-Za-z0-9_]/_}"; tags="${!v:-${LOOPER_JOB_TAGS:-arm64, autoscale}}"
    any=1; log "planned looper-$repo-$n ($t, tags $tags)" >&2
    cat <<YML
looper-$repo-$n:
  image: $image
  tags: [$tags]
  retry:
    max: 2
    when: [runner_system_failure, scheduler_failure, unknown_failure]
  resource_group: looper-$repo
  timeout: $t
  variables:
    LOOPER_RUNS: \$CI_PROJECT_DIR/looper-runs
  script:
    - repo-looper --repo "$repo" --issue $n
  artifacts:
    when: always
    expire_in: 30 days
    paths: [looper-runs/]
YML
  done <<<"$ready"
  [[ -n "$any" ]] || printf 'looper-none:\n  image: %s\n  tags: [%s]\n  script:\n    - echo "no repository with a ready issue is free"\n' \
    "$image" "${LOOPER_JOB_TAGS:-arm64, autoscale}"
}

case "${1:-}" in
  run)
    forge_need; need curl
    if [[ "${2:-}" == --for ]]; then
      [[ "${3:-}" =~ ^[0-9]+$ ]] || die "run --for SECONDS"
      end=$((SECONDS + $3)); failed=0
      while :; do
        next=$((SECONDS + INTERVAL))   # from this pass's start: a slow pass does not stretch the interval
        # Its own process: errexit holds in the pass, so GitLab unreadable is never "no jobs".
        "${BASH_SOURCE[0]}" run || { failed=1; log "pass failed"; }
        (( next <= end )) || break
        (( next <= SECONDS )) || sleep $((next - SECONDS))
      done
      exit "$failed"
    fi
    pass ;;
  status)
    forge_need; jobs="$(active_jobs)"; ready="$(ready_by_repo)"
    echo "active jobs in $PIPELINE: $(tr '\n' ' ' <<<"$jobs")"
    while read -r repo n; do
      [[ -n "$repo" ]] && echo "$repo: ready $n$(busy "$repo" "$jobs" >/dev/null && echo ' (busy)')"
    done <<<"$ready" ;;
  ready) forge_need; ready_by_repo ;;
  plan) forge_need; need curl; plan ;;
  uninstall)
    # run and nightly: the launchd jobs earlier versions installed (looper#24).
    for job in run nightly; do
      plist="$HOME/Library/LaunchAgents/dev.tacplus.looper.$job.plist"
      launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true; rm -f "$plist"
    done; log "uninstalled" ;;
  -h|--help|help|"") sed -n '5,/^set -euo pipefail$/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (see --help)" ;;
esac
