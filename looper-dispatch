#
# looper-dispatch: the kicker. It does no work itself and runs as the
# kicker schedule of the GitLab looper pipeline (LOOPER_PIPELINE, default
# tacplus-dev/looper; looper#24): nothing runs on the Mac. Each pass clears
# looper:in-progress from issues no looper job holds any more, then looks for
# tacplus-dev repositories with a ready issue and, when one of them has no
# looper job created, pending, waiting or running, starts that pipeline, whose
# plan runs repo-looper in ghcr.io/tacplus-dev/looper:main on the autoscaled
# runner. The nightly scan and the port scan are its other schedules.
#
#   looper-dispatch run                one pass: start the pipeline if a repository needs it
#   looper-dispatch run --for SECONDS  a pass every LOOPER_INTERVAL seconds (default 180) for
#                                      SECONDS (the kicker job); fails at the end if a pass failed
#   looper-dispatch status             the looper jobs in GitLab, and what is ready
#   looper-dispatch uninstall          remove the launchd job earlier versions installed on a Mac
#
# Credentials: GH_TOKEN (GitHub issues) and GITLAB_TOKEN, with api scope on the
# pipeline's project (its jobs, and starting it), both tacplus-dev GitLab group
# CI variables, masked and protected.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=looper-lib.sh
source "${LOOPER_LIB:-$HERE/looper-lib.sh}"

PIPELINE="${LOOPER_PIPELINE:-tacplus-dev/looper}"
INTERVAL="${LOOPER_INTERVAL:-180}"
API="${CI_API_V4_URL:-https://gitlab.com/api/v4}/projects/${PIPELINE//\//%2F}"

gitlab() { # curl args...
  [[ -n "${GITLAB_TOKEN:-}" ]] || die "no GITLAB_TOKEN: a GitLab token with api scope on $PIPELINE"
  curl -fsS --retry 2 -H "PRIVATE-TOKEN: $GITLAB_TOKEN" "$@"
}

# Names of the looper pipeline's jobs that are created, pending, waiting for
# their resource_group or running (busy() in looper-lib.sh).
active_jobs() {
  gitlab "$API/jobs?$LOOPER_JOB_SCOPES&per_page=100" | jq -r '.[].name'
}

# Repositories with at least one open approved issue: one search for the whole org.
repos_with_approved() {
  gh search issues --owner "$LOOPER_ORG" --state open --label "$LABEL_APPROVED" --limit 200 \
    --json repository --jq '.[].repository.name' | sort -u
}

# A run killed outright (its runner gone, looper#20) never removes
# looper:in-progress. An issue labelled so in a repository with no looper job
# created, pending, waiting or running is held by no run: the label goes, the
# issue says why, and the pipeline's job resumes it from its checkpoint.
release_orphans() { # active jobs
  local repo n
  gh search issues --owner "$LOOPER_ORG" --state open --label "$LABEL_IN_PROGRESS" --limit 200 \
    --json repository,number --jq '.[] | "\(.repository.name) \(.number)"' \
  | while read -r repo n; do
      busy "$repo" "$1" >/dev/null && continue
      gh issue edit "$n" --repo "$LOOPER_ORG/$repo" --remove-label "$LABEL_IN_PROGRESS" >/dev/null || continue
      gh issue comment "$n" --repo "$LOOPER_ORG/$repo" --body "This issue was \`$LABEL_IN_PROGRESS\`, but $repo has no looper job created, pending, waiting or running in $PIPELINE: the run that held it is gone (killed with its runner, say). The label is removed, so the next run takes it, resuming from its branch if it left one (looper#20)." >/dev/null || true
      log "$repo#$n: $LABEL_IN_PROGRESS with no looper job; label removed"
    done
}

# One pass: release the orphans, then start the pipeline for the first
# repository with a ready issue and no looper job of its own.
pass() {
  local jobs repo
  jobs="$(active_jobs)"
  release_orphans "$jobs"
  # A plan under way will take every ready issue; wait for it.
  grep -qx 'looper-plan' <<<"$jobs" && { log "looper-plan under way; nothing to start"; return 0; }
  for repo in $(repos_with_approved); do
    busy "$repo" "$jobs" >/dev/null && continue
    [[ -n "$(next_ready "$repo")" ]] || continue
    gitlab -X POST "$API/pipeline" -d ref=main >/dev/null
    log "started the $PIPELINE pipeline ($repo has a ready issue)"
    return 0
  done
  log "no repository with a ready issue is free; nothing to start"
}

case "${1:-}" in
  run)
    need gh; need curl; need jq
    if [[ "${2:-}" == --for ]]; then
      [[ "${3:-}" =~ ^[0-9]+$ ]] || die "run --for SECONDS"
      end=$((SECONDS + $3)); failed=0
      while :; do
        next=$((SECONDS + INTERVAL))   # from this pass's start: a slow pass does not stretch the interval
        # Its own process: errexit holds in the pass, so GitLab unreadable is never "no jobs".
        "${BASH_SOURCE[0]}" run || { failed=1; log "pass failed"; }
        (( next <= end )) || break
        (( next <= SECONDS )) || sleep $((next - SECONDS))
      done
      exit "$failed"
    fi
    pass ;;
  status)
    jobs="$(active_jobs)"
    echo "active jobs in $PIPELINE: $(tr '\n' ' ' <<<"$jobs")"
    for repo in $(repos_with_approved); do
      echo "$repo: ready $(next_ready "$repo" | tr '\n' ' ')$(busy "$repo" "$jobs" >/dev/null && echo '(busy)')"
    done ;;
  uninstall)
    # run and nightly: the launchd jobs earlier versions installed (looper#24).
    for job in run nightly; do
      plist="$HOME/Library/LaunchAgents/dev.tacplus.looper.$job.plist"
      launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true; rm -f "$plist"
    done; log "uninstalled" ;;
  -h|--help|help|"") sed -n '5,22p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (see --help)" ;;
esac
