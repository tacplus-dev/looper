#
# looper-dispatch: the top-level loop, and the only part that runs on this Mac.
# It clones nothing, builds nothing and starts no container. Every few minutes
# it clears looper:in-progress from issues no looper job holds any more, then
# looks for tacplus-dev repositories with a ready issue and, when one of them
# has no looper job queued, waiting or running, starts the looper pipeline in GitLab
# (LOOPER_PIPELINE, default tacplus-dev/looper). That pipeline runs
# repo-looper in ghcr.io/tacplus-dev/looper:main on the autoscaled GCE runner.
# The nightly scan is that pipeline's schedule, not this script.
#
#   looper-dispatch run        one pass: start the pipeline if a repository needs it
#   looper-dispatch status     the looper jobs in GitLab, and what is ready
#   looper-dispatch install    launchd: `run` every LOOPER_INTERVAL seconds (default 180)
#   looper-dispatch uninstall
#
# Credentials: gh (GitHub issues) and glab (GitLab pipelines) as logged in on
# this Mac. The pipeline's own credentials are tacplus-dev GitLab group CI
# variables (GH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN, GITLAB_TOKEN).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=looper-lib.sh
source "$HERE/looper-lib.sh"

PIPELINE="${LOOPER_PIPELINE:-tacplus-dev/looper}"
INTERVAL="${LOOPER_INTERVAL:-180}"
STATE="$HOME/.looper"
mkdir -p "$STATE"

# Names of the looper pipeline's jobs that are created, pending, waiting for
# their resource_group or running (busy() in looper-lib.sh).
active_jobs() {
  glab api "projects/${PIPELINE//\//%2F}/jobs?$LOOPER_JOB_SCOPES&per_page=100" \
    | jq -r '.[].name'
}

# Repositories with at least one open approved issue: one search for the whole org.
repos_with_approved() {
  gh search issues --owner "$LOOPER_ORG" --state open --label "$LABEL_APPROVED" --limit 200 \
    --json repository --jq '.[].repository.name' | sort -u
}

# A run killed outright (its runner gone, looper#20) never removes
# looper:in-progress. An issue labelled so in a repository with no looper job
# created, pending, waiting or running is held by no run: the label goes, the
# issue says why, and the pipeline's job resumes it from its checkpoint.
release_orphans() { # active jobs
  local repo n
  gh search issues --owner "$LOOPER_ORG" --state open --label "$LABEL_IN_PROGRESS" --limit 200 \
    --json repository,number --jq '.[] | "\(.repository.name) \(.number)"' \
  | while read -r repo n; do
      busy "$repo" "$1" >/dev/null && continue
      gh issue edit "$n" --repo "$LOOPER_ORG/$repo" --remove-label "$LABEL_IN_PROGRESS" >/dev/null || continue
      gh issue comment "$n" --repo "$LOOPER_ORG/$repo" --body "This issue was \`$LABEL_IN_PROGRESS\`, but $repo has no looper job created, pending, waiting or running in $PIPELINE: the run that held it is gone (killed with its runner, say). The label is removed, so the next run takes it, resuming from its branch if it left one (looper#20)." >/dev/null || true
      log "$repo#$n: $LABEL_IN_PROGRESS with no looper job; label removed"
    done
}

case "${1:-}" in
  run)
    need gh; need glab; need jq
    jobs="$(active_jobs)"
    release_orphans "$jobs"
    # A plan under way will take every ready issue; wait for it.
    grep -qx 'looper-plan' <<<"$jobs" && exit 0
    for repo in $(repos_with_approved); do
      busy "$repo" "$jobs" >/dev/null && continue
      [[ -n "$(next_ready "$repo")" ]] || continue
      glab ci run --branch main --repo "$PIPELINE" >/dev/null
      log "started the $PIPELINE pipeline ($repo has a ready issue)"
      break
    done ;;
  status)
    jobs="$(active_jobs)"
    echo "active jobs in $PIPELINE: $(tr '\n' ' ' <<<"$jobs")"
    for repo in $(repos_with_approved); do
      echo "$repo: ready $(next_ready "$repo" | tr '\n' ' ')$(busy "$repo" "$jobs" >/dev/null && echo '(busy)')"
    done ;;
  install)
    label="dev.tacplus.looper.run"; plist="$HOME/Library/LaunchAgents/$label.plist"
    cat > "$plist" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$HERE/looper-dispatch</string><string>run</string></array>
  <key>StartInterval</key><integer>$INTERVAL</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string><key>HOME</key><string>$HOME</string>
  </dict>
  <key>StandardOutPath</key><string>$STATE/run.log</string>
  <key>StandardErrorPath</key><string>$STATE/run.log</string>
</dict></plist>
PL
    launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    log "installed $label" ;;
  uninstall)
    # nightly: the job earlier versions installed.
    for job in run nightly; do
      plist="$HOME/Library/LaunchAgents/dev.tacplus.looper.$job.plist"
      launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true; rm -f "$plist"
    done; log "uninstalled" ;;
  -h|--help|help|"") sed -n '5,21p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (see --help)" ;;
esac
