#
# looper-dispatch: the kicker. It does no work itself and runs as the
# kicker schedule of the GitLab looper pipeline (LOOPER_PIPELINE, default
# tacplus-dev/looper; looper#24): nothing runs on the Mac. Each pass clears
# looper:in-progress from issues no looper job holds any more, then starts that
# pipeline when a tacplus-dev repository has a ready issue no report job holds
# and fewer reports than its cap (caps.yaml, looper#70), or commits queued to
# land (an issue labelled looper:landing) and no manager job; the pipeline's
# plan runs repo-looper in ghcr.io/tacplus-dev/looper:main. The nightly scan
# is its other schedule.
#
#   looper-dispatch run                one pass: start the pipeline if a repository needs it
#   looper-dispatch run --for SECONDS  a pass every LOOPER_INTERVAL seconds (default 180) for
#                                      SECONDS (the kicker job); fails at the end if a pass failed
#   looper-dispatch status             the looper jobs in GitLab, and what is ready
#   looper-dispatch ready              each repository's next ready issue, "<repo> <issue>", in the
#                                      order the plan takes them: priority:high first (looper#31)
#   looper-dispatch plan               the pipeline's child jobs: a report per ready issue, up to each
#                                      repository's cap, and its manager (on a schedule, a scan per
#                                      repository), as YAML
#                                      on stdout (ci/instance.gitlab-ci.yml, ci/tacplus-dev.gitlab-ci.yml)
#   looper-dispatch uninstall          remove the launchd job earlier versions installed on a Mac
#
# The forge (looper#29): LOOPER_FORGE=github (the default; issues through gh)
# or gitlab (a GitLab group's issues through its API, LOOPER_FORGE_TOKEN), and
# LOOPER_ORG, the org or group (looper-lib.sh). SeaBeam's instance is the
# second: README, A SeaBeam instance.
#
# Credentials (looper#25; README, Credentials): GH_TOKEN (GitHub issues),
# GITLAB_TOKEN (read_api on the pipeline's project: its jobs) and
# LOOPER_TRIGGER_TOKEN (the project's pipeline trigger: starting it), project
# CI variables of the pipeline's project, masked and protected. Without
# LOOPER_TRIGGER_TOKEN the pipeline is started with GITLAB_TOKEN, which then
# needs api scope. Once the project has the apps (looper#83; README, Only the
# manager writes main), GitHub is the tacplus-looper app's token instead of
# GH_TOKEN (looper-token, from the job's id_token), which no job holds any
# more; and the plan gives each job its id_token and environment, which name
# the app it may use: looper-report, looper-manager, looper-scan.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=looper-lib.sh
source "${LOOPER_LIB:-$HERE/looper-lib.sh}"

PIPELINE="${LOOPER_PIPELINE:-tacplus-dev/looper}"
TOKEN_CMD="${LOOPER_TOKEN:-$HERE/looper-token}"   # looper-token (a test's stub)

# The kicker's and the plan's GitHub identity with the apps (looper#83): the
# report app's token as gh's configuration, fresh for this process's life (a
# kicker's passes, its own processes, share it). A job that still holds a
# personal token refuses to run.
apps() { [[ "$LOOPER_FORGE" == github ]] && "$TOKEN_CMD" configured; }
identity() {
  apps || return 0
  [[ -z "${LOOPER_GH_IDENTITY:-}" ]] || return 0
  local v held=() d
  for v in GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN; do [[ -z "${!v:-}" ]] || held+=("$v"); done
  for v in $(compgen -e); do
    case "${!v:-}" in ghp_*|github_pat_*|gho_*|ghu_*) [[ " ${held[*]} " == *" $v "* ]] || held+=("$v") ;; esac
  done
  ((${#held[@]} == 0)) || die "this job holds ${held[*]}: with the apps (looper#83) no job holds a personal GitHub token; delete the project's GH_TOKEN variable (README, Only the manager writes main)"
  d="$(mktemp -d -t looper-tokens.XXXXXX)"
  "$TOKEN_CMD" start report "$d" $$ >/dev/null || die "no report token (looper-token)"
  export GH_CONFIG_DIR="$d" GH_NO_UPDATE_NOTIFIER=1 LOOPER_GH_IDENTITY=1
}
INTERVAL="${LOOPER_INTERVAL:-180}"
API="${CI_API_V4_URL:-https://gitlab.com/api/v4}/projects/${PIPELINE//\//%2F}"

gitlab() { # curl args...
  [[ -n "${GITLAB_TOKEN:-}" ]] || die "no GITLAB_TOKEN: a GitLab token with api scope on $PIPELINE"
  curl -fsS --retry 2 -H "PRIVATE-TOKEN: $GITLAB_TOKEN" "$@"
}

# Starts the pipeline on main: through its trigger, whose token is on no
# command line, else with GITLAB_TOKEN.
start_pipeline() {
  if [[ -n "${LOOPER_TRIGGER_TOKEN:-}" ]]; then
    printf 'token=%s&ref=main' "$LOOPER_TRIGGER_TOKEN" | curl -fsS --retry 2 -X POST "$API/trigger/pipeline" --data @- >/dev/null
  else
    gitlab -X POST "$API/pipeline" -d ref=main >/dev/null
  fi
}

# Names of the looper pipeline's jobs that are created, pending, waiting for
# their resource_group or running (busy() in looper-lib.sh).
active_jobs() {
  gitlab "$API/jobs?$LOOPER_JOB_SCOPES&per_page=100" | jq -r '.[].name'
}
# The same, as "<name> <status>".
active_job_statuses() {
  gitlab "$API/jobs?$LOOPER_JOB_SCOPES&per_page=100" | jq -r '.[] | "\(.name) \(.status)"'
}

# A run killed outright (its runner gone, looper#20) never removes
# looper:in-progress. An issue labelled so with no report job of its own
# (looper-<repo>-<issue>, looper#70) created, pending, waiting or running is
# held by no run: the label goes, the issue says why, and its next report
# resumes it from its checkpoint.
release_orphans() { # active jobs
  local repo n
  forge_search_issues "$LABEL_IN_PROGRESS" 200 repository,number '.[] | "\(.repository.name) \(.number)"' \
  | while read -r repo n; do
      busy "$repo" "$1" "$n" >/dev/null && continue
      forge_issue_edit "$repo" "$n" --remove-label "$LABEL_IN_PROGRESS" >/dev/null || continue
      forge_issue_comment "$repo" "$n" "This issue was \`$LABEL_IN_PROGRESS\`, but it has no looper job created, pending, waiting or running in $PIPELINE: the run that held it is gone (killed with its runner, say). The label is removed, so the next run takes it, resuming from its branch if it left one (looper#20)." >/dev/null || true
      log "$repo#$n: $LABEL_IN_PROGRESS with no looper job; label removed"
    done
}

# The reports a repository may still start (looper#70): its cap less its
# active report jobs.
free_reports() { # repo jobs
  local k; k="$(busy "$1" "$2" | grep -c . || true)"
  echo $(( $(repo_cap "$1") - k ))
}

# The repositories with commits queued to land (an open issue labelled
# looper:landing, looper#70), one a line.
landing_repos() {
  forge_search_issues "$LABEL_LANDING" 200 repository '.[] | .repository.name' | sort -u
}

# Each repository's reports against its cap, its ready issues with no report
# waiting at the cap and its lands queued (open issues labelled looper:landing,
# a line each in LANDING; `?` when GitHub could not say), as one line,
# `capacity: <repo> reports=N cap=N waiting=<n,...> landing=N; ...`, for every
# repository with any of them (`capacity: none` for none): the nightly recap
# reads it from the kicker's log, a pass every LOOPER_INTERVAL (looper#72).
capacity_line() { # jobs ready landing
  local repo n k cap w l out=()
  for repo in $( { grep -E '^looper-.+-[0-9]+$' <<<"$1" | sed -E 's/^looper-(.+)-[0-9]+$/\1/'
                   cut -d' ' -f1 <<<"$2"; [[ "$3" == "?" ]] || printf '%s\n' "$3"; } | grep . | sort -u); do
    k="$(busy "$repo" "$1" | grep -c . || true)"; cap="$(repo_cap "$repo")"; w=""
    if (( k >= cap )); then
      while read -r _ n; do busy "$repo" "$1" "$n" >/dev/null || w+="${w:+,}$n"; done < <(awk -v r="$repo" '$1 == r' <<<"$2")
    fi
    if [[ "$3" == "?" ]]; then l="?"; else l="$(grep -cxF -- "$repo" <<<"$3" || true)"; fi
    out+=("$repo reports=$k cap=$cap waiting=$w landing=$l")
  done
  (( ${#out[@]} )) || out=(none)
  l="$(printf '%s; ' "${out[@]}")"
  log "capacity: ${l%; }"
}

# One pass: release the orphans, then start the pipeline for the first
# repository with a ready issue no report job holds and a free report (its
# cap, caps.yaml), in the order of ready_all_by_repo (priority:high first,
# looper#31), or with commits queued to land and no manager job (looper#70).
pass() {
  local jobs ready repo n landing
  jobs="$(active_jobs)"
  release_orphans "$jobs"
  # A plan under way will take every ready issue; wait for it.
  grep -qx 'looper-plan' <<<"$jobs" && { log "looper-plan under way; nothing to start"; return 0; }
  ready="$(ready_all_by_repo)"
  landing="$(forge_search_issues "$LABEL_LANDING" 200 repository '.[] | .repository.name')" || landing="?"
  capacity_line "$jobs" "$ready" "$landing"
  while read -r repo n; do
    [[ -n "$repo" ]] || continue
    busy "$repo" "$jobs" "$n" >/dev/null && continue
    (( $(free_reports "$repo" "$jobs") > 0 )) || continue
    start_pipeline
    log "started the $PIPELINE pipeline ($repo#$n is ready)"
    return 0
  done <<<"$ready"
  for repo in $([[ "$landing" == "?" ]] || sort -u <<<"$landing"); do
    grep -qx "$(manager_job "$repo")" <<<"$jobs" && continue
    start_pipeline
    log "started the $PIPELINE pipeline ($repo has commits queued to land and no manager)"
    return 0
  done
  log "no ready issue has a free report, and no queued land lacks a manager; nothing to start"
}

# The pipeline's plan (looper#29; ci/instance.gitlab-ci.yml, and
# ci/tacplus-dev.gitlab-ci.yml since looper#56): its child pipeline on stdout.
# A scheduled pipeline's (CI_PIPELINE_SOURCE schedule, the nightly scan) is a
# job per repository of the org, looper-scan-<repo>, running repo-looper
# --scan (resource_group looper-<repo>). Any other's (looper#70) is a
# report per ready issue, looper-<repo>-<issue> running repo-looper --issue N,
# in the order of ready_all_by_repo (priority:high first, looper#31), none for
# an issue whose report is active, and at most the repository's cap
# (caps.yaml) active at once (when GitLab cannot be read, the cap alone), each
# sized by `repo-looper --job-timeout` and one at a time per issue
# (resource_group looper-<repo>-<issue>); and for each repository with a report
# planned or commits queued to land (looper:landing), its manager,
# looper-<repo>-manager running repo-looper --manage, the only job that merges
# to its main (resource_group looper-<repo>-main), unless one is already
# waiting to start. The managers come first (looper#75): a pool's runner starts
# its pending jobs in id order, the plan's, and a manager behind its own reports
# waits for every one of them to get a VM while their work stays unmerged and the
# later ones start from a stale main. LOOPER_JOB_IMAGE and LOOPER_JOB_TAGS (comma-separated) are the
# jobs' image and runner tags; LOOPER_JOB_TAGS_<repo> (`-` as `_`) overrides the
# tags for one repository's jobs (looper#55: tacplus's on the 16-CPU pool). The
# plan's GIT_AUTHOR_NAME/EMAIL and GIT_COMMITTER_NAME/EMAIL, those it has, are
# the jobs' too. With none to plan, one job that says so: a child pipeline has
# at least one.
plan() {
  local jobs ready repo n t v any="" image="${LOOPER_JOB_IMAGE:-ghcr.io/tacplus-dev/looper:main}"
  printf 'variables:\n  GIT_STRATEGY: none\n  LOOPER_WORK: /builds/looper\n'
  for v in GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL; do
    [[ -z "${!v:-}" ]] || printf '  %s: %s\n' "$v" "${!v}"
  done
  if [[ "${CI_PIPELINE_SOURCE:-}" == schedule ]]; then
    ready="$(forge_repos)"   # a forge it cannot read fails the plan: never an empty scan
    for repo in $ready; do plan_job "looper-scan-$repo" 5h "looper-$repo" --repo "$repo" --scan; any=1; done
  else
    local statuses="" landing free managed=" " reports=""; local -A left=()
    if statuses="$(active_job_statuses)"; then jobs="$(cut -d' ' -f1 <<<"$statuses")"
    else log "could not read $PIPELINE's jobs; planning each repository's ready issues up to its cap" >&2; jobs=""; fi
    ready="$(ready_all_by_repo)"
    while read -r repo n; do
      [[ -n "$repo" ]] || continue
      if busy "$repo" "$jobs" "$n" >/dev/null; then log "$repo#$n already has its report job; not planned again" >&2; continue; fi
      [[ -n "${left[$repo]:-}" ]] || left[$repo]="$(free_reports "$repo" "$jobs")"
      if (( ${left[$repo]} <= 0 )); then log "$repo#$n waits: $repo is at its cap of $(repo_cap "$repo") reports" >&2; continue; fi
      left[$repo]=$(( ${left[$repo]} - 1 ))
      t="$("$HERE/repo-looper" --repo "$repo" --job-timeout "$n")" || t=5h
      [[ "$t" =~ ^[0-9]{1,2}h$ ]] || t=5h
      reports+="$(plan_job "looper-$repo-$n" "$t" "looper-$repo-$n" --repo "$repo" --issue "$n")"$'\n'; any=1
      [[ "$managed" == *" $repo "* ]] || managed+="$repo "
    done <<<"$ready"
    landing="$(landing_repos)" || landing=""
    for repo in $landing; do [[ "$managed" == *" $repo "* ]] || managed+="$repo "; done
    for repo in $managed; do
      # One already waiting to start serves these too; one running may be ending.
      if grep -qE "^$(manager_job "$repo") (created|pending|waiting_for_resource)\$" <<<"$statuses"; then
        log "$(manager_job "$repo") is already waiting to start; not planned again" >&2; continue
      fi
      plan_job "$(manager_job "$repo")" "${LOOPER_MANAGER_TIMEOUT:-11h}" "looper-$repo-main" --repo "$repo" --manage; any=1
    done
    printf '%s' "$reports"
  fi
  [[ -n "$any" ]] || printf 'looper-none:\n  image: %s\n  tags: [%s]\n  script:\n    - echo "no repository with a ready issue is free"\n' \
    "$image" "${LOOPER_JOB_TAGS:-arm64, autoscale}"
}

# A planned job's environment (looper#83), by its repo-looper arguments.
job_environment() { # --repo REPO args...
  case " $* " in *" --manage "*) echo looper-manager ;; *" --scan "*) echo looper-scan ;; *) echo looper-report ;; esac
}

# One job of the plan, its repository's; repo-looper's arguments are names and
# numbers, unquoted in its script.
plan_job() { # name timeout resource-group --repo REPO repo-looper-args...
  local name="$1" t="$2" group="$3" repo="$5" v tags; shift 3
  v="LOOPER_JOB_TAGS_${repo//[^A-Za-z0-9_]/_}"; tags="${!v:-${LOOPER_JOB_TAGS:-arm64, autoscale}}"
  log "planned $name ($t, tags $tags)" >&2
  cat <<YML
$name:
  image: $image
  tags: [$tags]
  retry:
    max: 2
    when: [runner_system_failure, scheduler_failure, unknown_failure]
  resource_group: $group
  timeout: $t
YML
  # With the apps (looper#83): the id_token looper-token exchanges, and the
  # environment that GCP's binding of each app's key names.
  if apps; then
    cat <<YML
  id_tokens:
    GCP_ID_TOKEN:
      aud: https://iam.googleapis.com/$GCP_WIF_PROVIDER
  environment: {name: $(job_environment "$@"), action: prepare}
YML
  fi
  cat <<YML
  variables:
    LOOPER_RUNS: \$CI_PROJECT_DIR/looper-runs
  script:
    - repo-looper $*
  artifacts:
    when: always
    expire_in: 30 days
    paths: [looper-runs/]
YML
}

case "${1:-}" in
  run)
    forge_need; need curl; identity
    if [[ "${2:-}" == --for ]]; then
      [[ "${3:-}" =~ ^[0-9]+$ ]] || die "run --for SECONDS"
      # The clock is `date +%s` and `sleep`, not $SECONDS, so a test can fake it (looper#78).
      end=$(( $(date +%s) + $3 )); failed=0
      while :; do
        next=$(( $(date +%s) + INTERVAL ))   # from this pass's start: a slow pass does not stretch the interval
        # Its own process: errexit holds in the pass, so GitLab unreadable is never "no jobs".
        "${BASH_SOURCE[0]}" run || { failed=1; log "pass failed"; }
        (( next <= end )) || break
        now=$(date +%s); (( next <= now )) || sleep $((next - now))
      done
      exit "$failed"
    fi
    pass ;;
  status)
    forge_need; identity; jobs="$(active_jobs)"; ready="$(ready_by_repo)"
    echo "active jobs in $PIPELINE: $(tr '\n' ' ' <<<"$jobs")"
    while read -r repo n; do
      [[ -n "$repo" ]] && echo "$repo: ready $n$(busy "$repo" "$jobs" >/dev/null && echo ' (busy)')"
    done <<<"$ready" ;;
  ready) forge_need; identity; ready_by_repo ;;
  plan)
    forge_need; need curl; identity
    ! apps || [[ -n "${GCP_WIF_PROVIDER:-}" ]] || die "the project variable GCP_WIF_PROVIDER is not set: the plan's jobs need it for their id_tokens"
    plan ;;
  uninstall)
    # run and nightly: the launchd jobs earlier versions installed (looper#24).
    for job in run nightly; do
      plist="$HOME/Library/LaunchAgents/dev.tacplus.looper.$job.plist"
      launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true; rm -f "$plist"
    done; log "uninstalled" ;;
  -h|--help|help|"") sed -n '5,/^set -euo pipefail$/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (see --help)" ;;
esac
