#
# repo-looper: the one looper of one tacplus-dev repository. It runs in the
# looper container, as a job of the GitLab looper pipeline on the autoscaled
# runner (one job per repository at a time), and only while the repository
# has work.
#
#   repo-looper --repo NAME             drain NAME's ready issues, oldest first
#   repo-looper --repo NAME --issue N   work issue N only, if it is still ready (what the pipeline runs)
#   repo-looper --repo NAME --scan      the nightly scan: file issues, change no code
#   repo-looper --repo NAME --list      print the ready issues
#
# Ready: open, labeled `approved`, not held (looper:in-progress, looper:stuck,
# needs-decision), and every `Blocked-by:` issue in its body closed.
#
# One checkout per repository, kept across issues and runs under
# LOOPER_WORK/NAME/checkout: the looper always works the same code base. Claude
# may run sub-agents in that checkout for independent parts; only this script's
# top-level run commits and pushes, to main (pre-production rule, Jody 2026-10-26).
#
# Each run's record (prompt.md, claude.log, outcome) is a directory under
# LOOPER_RUNS. The pipeline sets it inside the job's project directory and
# uploads it as the job's artifacts: the runner VM does not outlive the job.
#
# After the run: closed or needs-decision is the run's own outcome. A fix that
# is pushed while the gates wait on another open issue (the run writes
# `Blocked-by: <issue>` to its outcome file) gets that line in the issue body
# and stays approved, so it is worked again for the gates once that issue
# closes. Anything else is looper:stuck, for a person.
#
# Environment: GH_TOKEN (pushes and issue calls), CLAUDE_CODE_OAUTH_TOKEN (the
# model), LOOPER_WORK (default /work), LOOPER_RUNS (default LOOPER_WORK/NAME/runs),
# LOOPER_MODEL (default claude-opus-5-5), LOOPER_TIMEOUT (seconds per issue,
# default 14400), LOOPER_GATES (default `just gates` when the repository has a
# justfile), GIT_AUTHOR_NAME/EMAIL. In a GitLab job, CI_JOB_URL and
# CI_PROJECT_DIR name the job and its artifacts in issue comments.
set -euo pipefail

usage() { sed -n '5,38p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }
case "${1:-}" in -h|--help|help) usage; exit 0 ;; esac

# Run from a private copy: a pull that rewrites this file mid-run must not corrupt the running process.
if [ -z "${LOOPER_RUNNING_COPY:-}" ]; then
  copy="$(mktemp -t repo-looper-run.XXXXXX)"; cp "${BASH_SOURCE[0]}" "$copy"
  LOOPER_RUNNING_COPY="$copy" LOOPER_LIB="${LOOPER_LIB:-$(dirname "${BASH_SOURCE[0]}")/looper-lib.sh}" exec bash "$copy" "$@"
fi
# shellcheck source=looper-lib.sh
source "$LOOPER_LIB"

REPO=""; ISSUE=""; MODE=drain
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) REPO="$2"; shift 2 ;;
    --issue) ISSUE="$2"; MODE=one; shift 2 ;;
    --scan) MODE=scan; shift ;;
    --list) MODE=list; shift ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
done
[[ -n "$REPO" ]] || die "no repository: --repo NAME (a $LOOPER_ORG repository)"
need gh; need git; need jq
[[ "$MODE" == list ]] && { approved_issues "$REPO" | while read -r n; do if ready "$REPO" "$n"; then echo "$n"; fi; done; exit 0; }
need claude

WORK="${LOOPER_WORK:-/work}/$REPO"
CHECKOUT="$WORK/checkout"
MODEL="${LOOPER_MODEL:-claude-opus-5-5}"
TIMEOUT="${LOOPER_TIMEOUT:-14400}"
RUNS="${LOOPER_RUNS:-$WORK/runs}"
mkdir -p "$RUNS"
gh auth setup-git >/dev/null 2>&1 || true

# The repository's checkout at origin/main. Anything a previous run left
# unpushed is kept on a local branch for a person to look at, never pushed.
sync_checkout() {
  if [[ ! -d "$CHECKOUT/.git" ]]; then
    gh repo clone "$LOOPER_ORG/$REPO" "$CHECKOUT" -- --quiet
  fi
  git -C "$CHECKOUT" fetch -q origin
  git -C "$CHECKOUT" checkout -q main 2>/dev/null || git -C "$CHECKOUT" checkout -q -b main origin/main
  if [[ -n "$(git -C "$CHECKOUT" status --porcelain)" || \
        "$(git -C "$CHECKOUT" rev-list --count origin/main..main)" != 0 ]]; then
    local keep; keep="looper/left-$(date -u +%Y%m%dT%H%M%SZ)"
    git -C "$CHECKOUT" add -A && git -C "$CHECKOUT" commit -q -m "left by an unfinished looper run" || true
    git -C "$CHECKOUT" branch -q "$keep"
    log "kept unpushed work on local branch $keep"
  fi
  git -C "$CHECKOUT" reset -q --hard origin/main
}

gates_hint() {
  if [[ -n "${LOOPER_GATES:-}" ]]; then echo "$LOOPER_GATES"
  elif [[ -f "$CHECKOUT/justfile" ]]; then echo "just gates (see the justfile)"
  else echo "the repository's own build and tests (README, CONTRIBUTING, CI workflows)"; fi
}

run_claude() { # prompt-file log-file
  local rc=0
  ( cd "$CHECKOUT" && timeout "$TIMEOUT" claude --print --model "$MODEL" --permission-mode acceptEdits \
      --allowedTools "Bash,Read,Edit,Write,Grep,Glob,Task,Agent,TodoWrite,WebFetch,WebSearch" \
      < "$1" > "$2" 2>&1 ) || rc=$?
  return "$rc"
}

# Where a person finds a run's record: the job and its artifact when this is a
# GitLab job, the path on this host otherwise.
run_record() { # run-dir
  if [[ -n "${CI_JOB_URL:-}" ]]; then
    local rel="${1#"${CI_PROJECT_DIR:-}"/}"
    if [[ -n "${CI_PROJECT_DIR:-}" && "$rel" != "$1" ]]; then
      echo "job $CI_JOB_URL, artifact \`$rel/claude.log\` ($CI_JOB_URL/artifacts/browse/$rel/)"
    else
      echo "job $CI_JOB_URL"
    fi
  else
    echo "\`$1/claude.log\` on $(hostname)"
  fi
}

# The fix is pushed and only the gates wait: the run's outcome file names one
# open issue as `Blocked-by:`. Adds that line to the issue's body (once) and
# prints it; fails when the outcome is anything else.
gates_blocked() { # issue run-dir head-before head-after
  local n="$1" ref r b state body line
  [[ "$3" != "$4" && -f "$2/outcome" ]] || return 1
  ref="$(parse_blockers "$REPO" < "$2/outcome" | head -n 1)" || return 1
  read -r r b <<<"$ref"; [[ -n "${b:-}" ]] || return 1
  state="$(gh issue view "$b" --repo "$LOOPER_ORG/$r" --json state --jq .state)" || return 1
  [[ "$state" == OPEN ]] || return 1
  if [[ "$r" == "$REPO" ]]; then line="Blocked-by: #$b"; else line="Blocked-by: $LOOPER_ORG/$r#$b"; fi
  body="$(gh issue view "$n" --repo "$LOOPER_ORG/$REPO" --json body --jq .body)" || return 1
  if ! parse_blockers "$REPO" <<<"$body" | grep -qx "$r $b"; then
    gh issue edit "$n" --repo "$LOOPER_ORG/$REPO" --body "$body

$line" >/dev/null || return 1
  fi
  echo "$line"
}

work_issue() { # issue
  local n="$1" run head_before head_after
  run="$RUNS/$(date -u +%Y%m%dT%H%M%SZ)-issue-$n"; mkdir -p "$run"
  log "taking $LOOPER_ORG/$REPO#$n ($run)"
  gh issue edit "$n" --repo "$LOOPER_ORG/$REPO" --add-label "$LABEL_IN_PROGRESS" >/dev/null
  sync_checkout
  head_before="$(git -C "$CHECKOUT" rev-parse HEAD)"
  cat > "$run/prompt.md" <<PR
You are the looper of $LOOPER_ORG/$REPO, working issue #$n. Your working directory is this repository's
checkout on main, at origin/main. Read the issue first: \`gh issue view $n --repo $LOOPER_ORG/$REPO --comments\`.
It was approved by someone with write access; issues it links to and the documents it cites (decision
records, IDENTITY.md, CONTRIBUTING, docs/) are your context. Read them before changing anything.

Rules:
1. Do what the issue asks, completely: its acceptance criteria are the definition of done. If it asks for
   something you believe is wrong, or needs a decision you may not make (a public contract the issue does
   not settle, a change in another repository), comment on the issue with the question and your
   recommendation, add the label $LABEL_DECISION, and stop without committing.
2. Tests first where the change has behaviour: write the test that fails, then make it pass. Surgical
   changes, the existing style, no hacks. Generated code is never edited by hand: change the generator or
   the proto and regenerate. \`tacplus\` in this container runs the compiler image for this repository's
   MAJOR.MINOR floor (tacplus.yaml), always its latest patch.
3. You may use sub-agents (the Task/Agent tool) for independent parts, in this same checkout. They do not
   commit or push; you do.
4. Verify with $(gates_hint). Long builds: start them detached (\`nohup ... > /tmp/x.log 2>&1 &\`) and
   poll with short checks; never end your reply while one runs. You run non-interactively: ending your
   reply ends the run.
5. Commit on main with a message that says why and ends with
   \`Co-Authored-By: Claude <noreply@anthropic.com>\`, then \`git pull --rebase origin main\`, re-run the
   gates if the rebase brought changes, and \`git push origin main\`. If the push is rejected, rebase and
   verify again. Never force-push. Never commit secrets.
6. A repository with release/MAJOR.MINOR branches: a BUG fix is also backported as a pull request against
   each release branch whose .0 tag is under twelve months old (never pushed to one directly); a FEATURE is
   main only.
7. When it is pushed, comment on the issue with what changed (commit hashes), the gates you ran and their
   last lines, and anything you could not verify; then close it: \`gh issue close $n --repo $LOOPER_ORG/$REPO\`.
8. If the fix is pushed but the gates cannot run until another open issue is done (a compiler floor that
   does not exist yet, say), do not close this issue: comment what you pushed and why the gates wait, and
   write the one line \`Blocked-by: #N\` (this repository) or \`Blocked-by: $LOOPER_ORG/<repo>#N\` to
   $run/outcome . The looper adds it to the issue, which is worked again for the gates once #N is closed.
PR
  if run_claude "$run/prompt.md" "$run/claude.log"; then log "claude finished #$n"; else log "claude exited non-zero on #$n"; fi
  git -C "$CHECKOUT" fetch -q origin
  head_after="$(git -C "$CHECKOUT" rev-parse origin/main)"
  gh issue edit "$n" --repo "$LOOPER_ORG/$REPO" --remove-label "$LABEL_IN_PROGRESS" >/dev/null || true
  local state labels
  state="$(gh issue view "$n" --repo "$LOOPER_ORG/$REPO" --json state --jq .state)"
  labels="$(gh issue view "$n" --repo "$LOOPER_ORG/$REPO" --json labels --jq '.labels[].name')"
  if [[ "$state" == CLOSED ]]; then log "#$n done (main $head_before..$head_after)"; return 0; fi
  if grep -qx "$LABEL_DECISION" <<<"$labels"; then log "#$n waits on a decision"; return 0; fi
  local blocked
  if blocked="$(gates_blocked "$n" "$run" "$head_before" "$head_after")"; then
    gh issue comment "$n" --repo "$LOOPER_ORG/$REPO" \
      --body "The fix is pushed (main $head_before..$head_after); the gates wait, so this issue is now \`$blocked\` and stays $LABEL_APPROVED: it is worked again for the gates once that issue is closed. Run record: $(run_record "$run")." >/dev/null || true
    log "#$n pushed, gates wait ($blocked)"; return 0
  fi
  tail -n 40 "$run/claude.log" || true
  gh issue comment "$n" --repo "$LOOPER_ORG/$REPO" \
    --body "The looper ended without finishing this issue. Run record: $(run_record "$run"). Marked $LABEL_STUCK for a person to look at." >/dev/null || true
  gh issue edit "$n" --repo "$LOOPER_ORG/$REPO" --add-label "$LABEL_STUCK" >/dev/null || true
  return 0
}

scan() {
  local run; run="$RUNS/$(date -u +%Y%m%dT%H%M%SZ)-scan"; mkdir -p "$run"
  sync_checkout
  cat > "$run/prompt.md" <<PR
You are the nightly scanner of $LOOPER_ORG/$REPO. Your working directory is its checkout at origin/main.
Change no code and push nothing. Find, in order:
1. Known vulnerabilities in dependencies (the ecosystem's own auditor where it applies: cargo audit,
   npm audit, govulncheck, pip-audit, the Maven/Gradle dependency tree against advisories).
2. The repository's own gates failing on main ($(gates_hint)).
3. Pins that break the project's rule: a tacplus floor or base image that is not the latest released
   MAJOR.MINOR line it should follow.
For each finding, first check the open issues (\`gh issue list --repo $LOOPER_ORG/$REPO\`) and skip one already
filed. File each new finding as one issue with a title, the evidence (command and output), the fix you
recommend and acceptance criteria. Label it \`$LABEL_APPROVED\` when the fix is mechanical and safe (a patched
dependency version, a gate fix with an obvious cause); otherwise label it \`$LABEL_DECISION\`. If nothing is
found, file nothing.
PR
  run_claude "$run/prompt.md" "$run/claude.log" || log "scan exited non-zero"
  log "scan of $REPO finished"
}

case "$MODE" in
  scan) scan ;;
  one)
    gh issue view "$ISSUE" --repo "$LOOPER_ORG/$REPO" --json labels --jq '.labels[].name' | grep -qx "$LABEL_APPROVED" \
      || die "#$ISSUE is not labeled $LABEL_APPROVED"
    # A job planned for an issue another run took or finished meanwhile.
    approved_issues "$REPO" | grep -qx "$ISSUE" && ready "$REPO" "$ISSUE" \
      || { log "#$ISSUE is no longer ready; nothing to do"; exit 0; }
    work_issue "$ISSUE" ;;
  drain)
    # One pass over each issue per run: if a label write ever fails, the same
    # issue must not be taken again and again.
    seen=" "
    while :; do
      n=""
      for c in $(approved_issues "$REPO"); do
        [[ "$seen" == *" $c "* ]] && continue
        if ready "$REPO" "$c"; then n="$c"; break; fi
      done
      [[ -n "$n" ]] || { log "no ready issue in $REPO; exiting"; break; }
      seen="$seen$n "
      work_issue "$n"
    done ;;
esac
