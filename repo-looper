  # An outcome it wrote that was not taken (a Blocked-by naming this issue, or
  # one that cannot be read) is for a person; one naming only issues closed by
  # now resumes: nothing waits (looper#46).
  [[ ! -s "$run/outcome" ]] || progress=""
  # A run idle after its build had no verdict within the wait (a build that
  # ran that long, or hung) is retried, never stuck (looper#133).
  local capped=""; [[ "$stopped" != idle ]] || capped="$(build_capped "$run")" || true
  if [[ -n "$timed_out" ]]; then ended="The run reached its time limit ($(hours "$limit")) before finishing."
  elif [[ "$stopped" == build-cap ]]; then
    ended="The run asked for more than $VM_BUILDS_PER_ISSUE local builds, this looper VM's cap per issue per run (LOOPER_VM_BUILDS_PER_ISSUE), so the looper stopped it."
  elif [[ -n "$capped" ]]; then
    ended="The run's build had $capped, and the run then went idle: no output and no change in its checkout for ${LOOPER_IDLE_MINUTES:-20} minutes, so the looper stopped it."
  elif [[ "$stopped" == idle && -n "$head_after" && -n "$progress" ]]; then
    ended="The run went idle after its fix landed: no output and no change in its checkout for ${LOOPER_IDLE_MINUTES:-20} minutes, so the looper stopped it."
  elif [[ "$stopped" == idle ]]; then ended="The run went idle: no output and no change in its checkout for ${LOOPER_IDLE_MINUTES:-20} minutes, so the looper stopped it."
  elif [[ -n "$pending" && "$rc" == 0 ]]; then ended="The run queued its land and ended, as the merge train asks (looper#86: reports never wait for a build)."
  elif [[ -n "$mr" && "$rc" == 0 ]]; then ended="The run opened its merge request and ended (looper#250: a report never waits for its merge)."
  else ended="The run ended before finishing (exit $rc)."; fi
  if [[ -n "$mr" && -z "$pending" ]]; then
    report "$n" mr-open
    forge_issue_comment "$REPO" "$n" "$ended Its merge request is open, with its evidence: $mr (looper#250). $where

$done_left

