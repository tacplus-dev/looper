      if [[ -n "$bad" ]] || (( ${#lines[@]} + ${#closed[@]} == 0 )); then
        think_say "The run's outcome was blocked, but named no open issue, or this one."; think_outcome stuck
      elif (( ${#lines[@]} )); then
