The issue, #$n (its title and body, then each comment, oldest first):

$(issue_texts "$n")
PR
  local rc=0
  run_claude "$run/prompt.md" "$run/claude.log" "$(( limit > STOP_EARLY ? limit - STOP_EARLY : limit ))" "$run" "$n" || rc=$?
  # The model's comment goes on the issue: never the nonce (looper#40).
  if [[ -f "$out/comment.md" ]]; then redact < "$out/comment.md" > "$out/comment.md.new" && mv "$out/comment.md.new" "$out/comment.md"; fi
  local stopped=""; [[ -s "$run/stopped" ]] && stopped="$(cat "$run/stopped")"
  local type title="" step=""
  type="$({ sed -n 's/^type:[[:space:]]*\([a-z]*\)[[:space:]]*$/\1/p' "$out/outcome" 2>/dev/null || true; } | head -n 1)"
  [[ -s "$run/step" ]] && step="$(cat "$run/step")"
  case "$type" in
    pr)
      title="$(sed -n 's/^title:[[:space:]]*//p' "$out/outcome" | head -n 1 | cut -c1-120)"
      title="${title:-$(forge_issue_view "$REPO" "$n" title .title 2>/dev/null || echo "#$n")}"
      if [[ -n "$(cd "$CHECKOUT" && git status --porcelain -- ROADMAP.md; git diff --name-only "$base" HEAD -- ROADMAP.md)" ]]; then
        think_say "The change touches ROADMAP.md, which only Jody changes."; think_outcome stuck; think_change "$base"; return 0
      fi
      # HISTORY.md's line for the issue, part of what the gates pass on.
      local t; t="$(forge_issue_view "$REPO" "$n" title .title 2>/dev/null)" || t="#$n"
      ( cd "$CHECKOUT" && append_history "- $(date -u +%F) looper issue $t (#$n, $REPO-looper[bot] pull request)" )
      local gates="${LOOPER_GATES:-}" grc=0
      [[ -n "$gates" || ! -f "$CHECKOUT/justfile" ]] || gates="just gates"
      if [[ -z "$gates" ]]; then
        think_say "The change is done, but $REPO has no gates (a justfile's \`gates\` recipe) to pass it on."; think_outcome stuck
      else
        think_change "$base"; local tested; tested="$(cat "$out/tree")"
        log "think: #$n: the gates ($gates) on tree $tested"
        ( cd "$CHECKOUT" && bash -c "$gates" ) > "$run/gates.log" 2>&1 || grc=$?
        think_change "$base"
        if (( grc == 0 )) && [[ "$(cat "$out/tree")" != "$tested" ]]; then
          think_say "The gates changed the tree they ran on (a file not ignored, or a tracked one): it is not the tested tree."; think_outcome stuck
        elif (( grc == 0 )); then think_outcome pr "title: $title"
        else
          think_say "$(printf 'the gates (`%s`) failed after the run, exit %s; their end:\n\n~~~~~~\n%s\n~~~~~~' "$gates" "$grc" "$(tail -n 30 "$run/gates.log" | redact)")"
          think_outcome stuck
        fi
      fi ;;
    question) think_outcome question ;;
    blocked)
      # A blocker closed by now is dropped, and said so; one naming only
      # closed issues resumes, nothing waiting (looper#46).
      local refs r b ref state lines=() closed=() bad="" dropped
      refs="$(parse_blockers "$REPO" < "$out/outcome" | awk '!seen[$0]++')"
      while read -r r b; do
        [[ -n "$r" ]] || continue
        if [[ "$r $b" == "$REPO $n" ]] || ! state="$(issue_state "$r" "$b" 2>/dev/null)"; then bad=1; continue; fi
        if [[ "$r" == "$REPO" ]]; then ref="#$b"; else ref="$LOOPER_ORG/$r#$b"; fi
        case "$state" in OPEN) lines+=("Blocked-by: $ref") ;; CLOSED) closed+=("\`$ref\`") ;; *) bad=1 ;; esac
      done <<<"$refs"
