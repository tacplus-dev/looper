4. Pins that break the project's rule: a tacplus floor or base image that is not the latest released
   MAJOR.MINOR line it should follow. A pin's patch, dated build and digest are the looper's (tacplus-dev/looper#212,
   #226): it read main's pins (each pin file's \`build_image:\` and \`tacplus:\`, each Dockerfile FROM by digest, and
   every file naming them) against their lines' newest patches and builds and their tags' digests now, and pinned each
   release Dockerfile's FROM at a floating tag at its tag's digest (#234); file nothing for those.
IT
  if [[ ! -s "$run/relock.txt" ]]; then echo "   None is behind."
  elif [[ -n "$MAINT_HELD" ]]; then echo "   Behind ($run/relock.txt): the maintenance land is #$MAINT_N, already at work."
  else echo "   Behind ($run/relock.txt): the looper queues them after you, with your fixes of item 5, as one land (${MAINT_N:+#$MAINT_N}${MAINT_N:-a new \`$LABEL_BUG\`})."; fi
  [[ ! -s "$run/relock-unread.txt" ]] || echo "   Some could not be read ($run/relock-unread.txt): check those yourself, and file one that lags as above."
}
# The scan's item 5 (looper#226), printed for the prompt.
tools_item() { # run-dir report-dir
  local run="$1"
  [[ -n "$MAINT_WT" && -n "$2" ]] || { echo "5. The CI tools' advisories: no security report or no maintenance land this night (looper#226): nothing to fix; file them as item 1 says."; return 0; }
  cat <<IT
5. The CI tools' advisories (tacplus-dev/looper#226; tacplus-dev/roadmap decisions/security-gates-ship-only-2026-11-23.md):
   the findings of item 1's report in a tool only this repository's pipelines run, never one it ships: a binary its CI
   tool script installs (\`ci/tools.sh\` or its equivalent under ci/; the finding's \`where\` names the binary, as
   \`bin/lego (...)\`). The build image's own packages are item 4's, not yours. For each one:
IT
  if [[ -n "$MAINT_HELD" ]]; then cat <<IT
   the maintenance land is #$MAINT_N, already at work: change no file for them; comment on #$MAINT_N with each one
   (its id and binary) and its fix as below (the bump, or the exception), for its report. File no other issue for them.
IT
  return 0; fi
  cat <<IT
   - move the tool's pin in that script to the newest upstream release that fixes it (the advisory's fixed version
     in the release's own dependencies: its go.mod, its lock; the newest release, not the first fixed one);
   - if no release fixes it yet, add an entry to security-exceptions.yaml (README: Security checks) for that binary
     alone: \`id\` the advisory, \`where\` the binary (its \`where\` without the parentheses), \`expires: $(date -u -d '+14 days' +%F)\`,
     \`decided_by: jodydadescott\` (the decision's), \`reason\` naming the advisory, the binary, the upstream release it
     waits on (or that none is out yet) and looper#226. One accepted until later already is left as it is.
   Change only that script and security-exceptions.yaml (under ci/ and at the root): the looper takes nothing else of
   yours but PROPOSALS.md. Write what you did to $run/tools.md, a line an advisory:
   \`- <id> in <binary>: <tool> <from> → <to>\` or \`- <id> in <binary>: excepted until <date>, waiting on <release>\`.
   The looper queues them after you, with item 4's moves, as one land on the maintenance issue
   (${MAINT_N:+#$MAINT_N}${MAINT_N:-one it files}), which names them: file no other issue for them. You verify nothing: its build does.
IT
}
# After the model (looper#226): the model's CI tool fixes (security-exceptions.yaml
# and ci/, nothing else of its) with the pins' moves, one commit on the
# maintenance issue's branch, its land queued; the issue filed if none is open.
maint_land() { # run-dir taken-worktree report-dir
  local run="$1" taken="$2" n="$MAINT_N" new="" b id title msg f
  [[ -n "$MAINT_WT" ]] || return 0
  if [[ -n "$MAINT_HELD" ]]; then rm -rf "$MAINT_WT"; MAINT_WT=""; return 0; fi
  : > "$run/tools.patch"
  # Its new files too (a first security-exceptions.yaml): scan_take staged them.
  if [[ -n "${3:-}" && -n "$taken" ]]; then
    git -C "$taken" diff --cached --no-ext-diff --no-textconv --binary HEAD -- security-exceptions.yaml ci > "$run/tools.patch" 2>/dev/null ||
      : > "$run/tools.patch"
  fi
  if [[ -s "$run/tools.patch" ]] && ! git -C "$MAINT_WT" apply "$run/tools.patch" 2>"$run/tools.patch.log"; then
    log "maintenance: the model's CI tool fixes do not apply with the pins' moves ($run/tools.patch.log): left out"; : > "$run/tools.patch"
  fi
  [[ -s "$run/tools.patch" ]] || rm -f "$run/tools.md"
  if [[ -z "$(git -C "$MAINT_WT" status --porcelain)" ]]; then rm -rf "$MAINT_WT"; MAINT_WT=""; return 0; fi
  if [[ -s "$run/relock.txt" ]]; then
    title="Pinned images behind their lines: relock ($(head -n 1 "$run/relock.txt" | sed 's/ (.*//; s/@sha256:[0-9a-f]*//g')$( (( $(wc -l < "$run/relock.txt") < 2 )) || echo ", and $(( $(wc -l < "$run/relock.txt") - 1 )) more"))"
    msg="Relock: the pinned images to their lines' newest patches and builds and their tags' digests"
  else
    title="CI tools' advisories: the nightly maintenance ($(maint_tools "$run/tools.md" "$run/tools.patch" | grep -m 1 -oE '^- [^ ]+' | cut -c3-))"
    msg="Nightly maintenance: the CI tools' advisories"
  fi
  if [[ -z "$n" ]]; then
    if n="$(forge_issue_create "$REPO" "$title" "$(relock_body "$run/relock.txt" "$MAINT_MAIN" "$run/tools.md")" "$LABEL_BUG" "$LABEL_APPROVED")"; then
      new=1; log "maintenance: filed #$n"
    else log "maintenance: could not file the issue"; rm -rf "$MAINT_WT"; MAINT_WT=""; return 0; fi
  fi
  b="$(wip_branch "$n")"; id="$(date -u +%Y%m%dT%H%M%SZ)-$n-relock"
  if ( cd "$MAINT_WT" && git add -A &&
       git commit -q -m "$msg (#$n)" \
         -m "$(cat "$run/relock.txt")$(maint_tools "$run/tools.md" "$run/tools.patch")" \
         -m "The nightly maintenance (looper#212, looper#226): a pin moves in a commit, on the gates, never by a build." &&
       mkdir -p .looper && printf 'id=%s\ngates=%s\nstate=queued\nqueued=%s\n' "$id" "$(land_gates)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > .looper/land &&
       git add -f .looper/land && git commit -q -m "looper: the nightly maintenance of #$n (land queued)" &&
       { [[ -z "$MANAGER_GH" ]] || export GH_CONFIG_DIR="$MANAGER_GH"; } &&
       git push -q --force-with-lease="refs/heads/$b:" origin "HEAD:refs/heads/$b" ); then
    forge_issue_edit "$REPO" "$n" --add-label "$LABEL_LANDING" >/dev/null || true
    [[ -n "$new" ]] || forge_issue_comment "$REPO" "$n" "The nightly scan of $(date -u +%F) queued the nightly maintenance on \`$b\` for the manager's merge train (looper#212, looper#226):"$'\n\n'"$( [[ ! -s "$run/relock.txt" ]] || sed 's/^/- /' "$run/relock.txt")$(maint_tools "$run/tools.md" "$run/tools.patch")" >/dev/null || true
    log "maintenance: queued on $b for #$n"
  else
    log "maintenance: could not queue it on $b: #$n stays for its report to make"
    [[ -n "$new" || ! -s "$run/tools.patch" ]] || forge_issue_comment "$REPO" "$n" "The nightly scan of $(date -u +%F) could not queue its maintenance on \`$b\` (looper#226); make it yourself:"$'\n\n'"$( [[ ! -s "$run/relock.txt" ]] || sed 's/^/- /' "$run/relock.txt")$(maint_tools "$run/tools.md" "$run/tools.patch")"$'\n\n'"<details><summary>The CI tool fixes</summary>"$'\n\n```diff\n'"$(cat "$run/tools.patch")"$'\n```\n</details>' >/dev/null || true
  fi
  rm -rf "$MAINT_WT"; MAINT_WT=""
}

# Main's ruleset, each night (looper#233): a public repository's
# `looper-ruleset check`, with the scan's own token (a report's, with the
# apps), fails when its ruleset is missing, differs or that token can bypass
# it, and the kicker starts no report of it until it passes. The looper files
# it, a bug approved priority:high (the hub runs looper-ruleset apply: no
# report can), once while one is open; once the check passes, it closes it. A
# check that cannot run files nothing: the next night checks again.
RULESET_CMD="${LOOPER_RULESET:-$(dirname "$LOOPER_SELF")/looper-ruleset}"   # looper-ruleset (a test's stub)
RULESET_TITLE="Main's ruleset fails looper-ruleset check"
ruleset_bug() { # run-dir
  local out rc=0 open i
  [[ "$LOOPER_FORGE" == github ]] || return 0
  out="$(LOOPER_ORG="$LOOPER_ORG" "$RULESET_CMD" check "$REPO" 2>"$1/ruleset.log")" || rc=$?
  printf '%s\n' "$out" >> "$1/ruleset.log"
  if (( rc > 1 )); then log "scan: looper-ruleset check of $REPO could not run ($(tail -n 1 "$1/ruleset.log")): the next scan checks again"; return 0; fi
  open="$(forge_issue_list "$REPO" open 1000 number,title "[.[] | select(.title | startswith(\"$RULESET_TITLE\")) | .number] | .[]")" ||
    { log "scan: the open issues could not be read: $REPO's ruleset is not filed nor closed (looper-ruleset check: $out)"; return 0; }
  if (( rc == 0 )); then
    for i in $open; do
      forge_issue_comment "$REPO" "$i" "The nightly scan of $(date -u +%F): \`looper-ruleset check $REPO\` passes (\`$out\`): main is the manager's alone again (looper#233)." >/dev/null || true
      if gh issue close "$i" --repo "$LOOPER_ORG/$REPO" >/dev/null; then log "scan: $REPO's ruleset passes looper-ruleset check: closed #$i"
      else log "scan: $REPO's ruleset passes looper-ruleset check, and #$i could not be closed"; fi
    done
    return 0
  fi
  if [[ -n "$open" ]]; then log "scan: $REPO's ruleset fails looper-ruleset check ($out): already filed as #${open//$'\n'/, #}"; return 0; fi
  ensure_labels "$REPO"
  if i="$(forge_issue_create "$REPO" "$RULESET_TITLE: $REPO's main is not the manager's alone (the nightly scan)" "The nightly scan of $(date -u +%F) ran \`looper-ruleset check $REPO\` with a report's token (looper#233), and it fails:

\`\`\`
$out
\`\`\`

Main's ruleset (looper#83; README, Only the manager writes main) is what keeps a report's token from writing main past the gates: without it, or with one that differs or that a report's token can bypass, it could. Until the check passes, the kicker starts no report of $REPO.

**The fix** is the hub's, as an org owner (a report's token cannot edit a ruleset): \`looper-ruleset apply $REPO\` (README, Only the manager writes main), then \`looper-ruleset check $REPO\`.

**Acceptance:** \`looper-ruleset check $REPO\` passes, as an org owner and with a report's token, and \`looper-ruleset probe $REPO\` with a report's token passes. The nightly scan closes this issue once its check passes." "$LABEL_BUG" "$LABEL_APPROVED" "$LABEL_PRIORITY_HIGH")"; then
    log "scan: $REPO's ruleset fails looper-ruleset check ($out): filed as #$i"
  else log "scan: $REPO's ruleset fails looper-ruleset check ($out), and the issue could not be filed: the next scan files it"; fi
}

scan() {
  local run before report base taken gates=""; run="$RUNS/$(date -u +%Y%m%dT%H%M%SZ)-scan"; mkdir -p "$run"
  sync_checkout
  # Its model runs as looper-scan (looper#83), with no container runtime (looper#73).
  model_job_private
  choose_model "$run"
  ruleset_bug "$run"
  # A pinned repository's scan, as its reports, with no container runtime
  # (looper#73): its gates are the nightly build's, read, not run.
  BUILD_JOBS=""
  if build_jobs origin/main; then BUILD_JOBS=1; log "$REPO pins its build image: this scan reads the nightly build's gates, its model with no container runtime"; fi
  if [[ "$REPO" == "$LOOPER_ROADMAP_REPO" ]]; then suggest_scan "$run"; return; fi
  report="$(security_report "$run")"
  [[ -z "$BUILD_JOBS" ]] || gates="$(gates_record "$run")"
  ensure_labels "$REPO"
  if [[ -n "$report" ]] && ! security_unfiled "$report"; then
    log "scan: the open issues could not be read: every finding the policy fails or HIGH or CRITICAL is the model's to check"
    jq '[.[] | select(.excepted == null and (.blocking or (.severity | IN("HIGH", "CRITICAL"))))]' "$report/findings.json" > "$report/unfiled.json"
  fi
  verify_bugs "$run"
  release_bugs "$run"
  gatemiss_bugs "$run" "$gates"
  maint_prepare "$run"
  before="$(forge_issue_list "$REPO" all 1 number '.[0].number // 0')" || before=""
  cat > "$run/prompt.md" <<PR
You are the nightly scanner of $LOOPER_ORG/$REPO. Your working directory is its checkout at origin/main.
Change no code but item 5's CI tool fixes. Find, in order:
$(security_item "$report")
2. Known vulnerabilities in dependencies the build's checks do not cover (the ecosystem's own auditor where it
   applies: cargo audit, npm audit, govulncheck, pip-audit, the Maven/Gradle dependency tree against advisories).
   An advisory an entry of the checkout's security-exceptions.yaml accepts (its \`id\` the advisory's or an alias,
   and its \`where\`, if it has one, the finding's file: README: Security checks) is not filed until its \`expires\` has passed or a fixed version is published, whichever
   is first; then file it again, naming the entry.$(auditors_note)
$(gates_item "$gates")
$(relock_item "$run")
$(tools_item "$run" "$report")
$(trace_item "$run")
$(blocked_on_item "$run")
For each finding, first check the open issues (\`$(forge_cmd list "$REPO")\`) and skip one already
filed, or whose cause an open issue already holds (add it to that issue's list in a comment). Each finding is a bug
($ISSUE_FLOW): file one issue per cause, not per finding, labelled \`$LABEL_BUG\`, its title the cause, with the findings
it fixes, the evidence (command and output), the fix you recommend and acceptance criteria. Label it
\`$LABEL_APPROVED\` too when the fix is mechanical and safe (a patched dependency version, a gate fix with an obvious
cause); otherwise \`$LABEL_DECISION\`. A cause another repository's open issue fixes (a generator's template, an
upstream release) is filed with its \`Blocked-by: <org>/<repo>#N\` line in the body from the start, one per issue it
waits on, so no report runs until that issue closes. If nothing is found, file nothing.
An idea for new behaviour you come across is a feature, never \`$LABEL_APPROVED\`: add it to PROPOSALS.md (what, why,
links), the one file you may change but item 5's. Leave them in the checkout: commit nothing and push nothing (only the
manager's identity writes main, looper#83); the looper commits your PROPOSALS.md change on main, and item 5's with the
maintenance land, when you are done.
$(opening_rule)
$(provenance_rule)
PR
  base="$(git -C "$CHECKOUT" rev-parse HEAD)" taken=""
  if scan_clone; then
    run_claude "$run/prompt.md" "$run/claude.log" "$TIMEOUT" "$run" || log "scan exited non-zero"
    taken="$(scan_take "$base" PROPOSALS.md security-exceptions.yaml ci)" || { log "scan: the model's files could not be read"; taken=""; }
  else log "scan: its clone could not be made: no model ran"; fi
  maint_land "$run" "$taken" "$report"
  [[ -z "$report" ]] || security_file_unfiled "$report"
  [[ -n "$before" ]] && scan_labels "$before"
  # Its PROPOSALS.md, the looper's commit (looper#83): the change since the
  # scan's main, on the current main; nothing else the model left.
  : > "$run/proposals.patch"
  [[ -z "$taken" ]] || git -C "$taken" diff --cached --no-ext-diff --no-textconv --binary HEAD -- PROPOSALS.md > "$run/proposals.patch" || : > "$run/proposals.patch"
  if [[ -s "$run/proposals.patch" ]]; then
    land "PROPOSALS.md: the nightly scan's proposals (looper)" git apply --3way "$run/proposals.patch"
  fi
  # What the model left is in the run's record now: its clone goes (looper#227).
  scan_drop "$taken"
  log "scan of $REPO finished"
}

# --- the report (looper#70) ----------------------------------------------------

# The report of an issue (looper#70): its job works it, if it is still ready
# (or its run was killed outright, looper#20), in its own clone, and touches
# no other issue and never main.
# What of the job its model's user (looper#68) may not read, a report's or a
# scan's: GitLab's file variables (CI_PROJECT_DIR.tmp, world-readable) are the
# job's alone. The model's user takes the checkpoint lock too.
model_job_private() {
  model_users || return 0
  local d
  touch "$WORK/.checkpoint.lock"; chmod 0666 "$WORK/.checkpoint.lock"
  [[ -z "${CI_PROJECT_DIR:-}" || ! -d "$CI_PROJECT_DIR.tmp" ]] || chmod -R go-rwx "$CI_PROJECT_DIR.tmp"
  # The image's tools under the job's home (tacplus's openjml, on the PATH) stay
  # the model's to run: the home is its to pass through, not to list, and
  # what in it is private stays the job's.
  if [[ -d "$HOME" && "$HOME" != / ]]; then
    chmod 0711 "$HOME"
    for d in .claude .claude.json .config .local .cache/gh .docker .ssh .gnupg .netrc .git-credentials; do
      [[ ! -e "$HOME/$d" ]] || chmod go-rwx "$HOME/$d"
    done
  fi
}

report_job() { # issue
  local n="$1"
  # Its manager first (looper#75): this job's slot is the one the manager waits
  # for. The issue stays ready, and the kicker plans it again, after the manager.
  if manager_waiting; then log "#$n yields to $(manager_job "$REPO"), which waits to start: the manager merges first; this issue is planned again after it"; return 0; fi
  if ! { approved_issues "$REPO" | grep -qx "$n" && ready "$REPO" "$n"; }; then
    if orphaned "$n"; then log "#$n is $LABEL_IN_PROGRESS, but no other report job of it is active: its run is gone; this job resumes it"
    else log "#$n is no longer ready; nothing to do"; return 0; fi
  fi
  prepare_report
  # An unpinned repository's report runs no model (looper#73).
  if ! pinned origin/main; then
    log "#$n: $(pin_first)"
    hold "$n" "$LABEL_STUCK" "$(pin_first). Nothing was run. Marked \`$LABEL_STUCK\`: once main pins it, a person removes the label."
    report "$n" stuck; return 0
  fi
  model_job_private
  # A pinned repository's report builds in build jobs, with no container runtime (looper#71).
  BUILD_JOBS=""
  if [[ -n "${LOOPER_VM:-}" ]]; then BUILD_JOBS=1; log "$REPO pins its build image: on this looper VM, its model builds locally through --build, with no container runtime of its own (looper#238)"
  elif build_jobs origin/main; then BUILD_JOBS=1; log "$REPO pins its build image: this report builds in build jobs, its model with no container runtime"
  else log "$REPO pins its build image, but this job holds no BUILD_TRIGGER_TOKEN (or its forge is not GitHub's): its model has no container runtime and no build, and its land's gates run in the manager's job (looper#71, looper#73)"; fi
  work_issue "$n"
  # Its claim given up at the run's end, whatever the outcome (looper#250).
  claim_release "$n" || log "#$n: its claim could not be given up: it lapses $(hours "$CLAIM_TTL") after its last renewal"
}

# The disk a job leaves, for the nightly recap's runner pools (looper#57), and
# a control pod's use against its requests (looper#165).
disk_log() {
  local u; u="$(df -Ph "${CI_BUILDS_DIR:-$WORK}" 2>/dev/null | awk 'NR == 2 { print $5 " used of " $2 " (" $6 ")" }')" || u=""
  [[ -z "$u" ]] || log "disk at the end: $u"
  pod_use_log
}

case "$MODE" in
  # The model's step in a report: the manager merges it (looper#70).
  land) if mr_wanted; then mr_request; else land_request; fi ;;
  # The model's build request in a pinned repository's report (looper#71).
  build) build_request ;;
  # The model's step when what is left waits on another run (looper#171).
  wait-on) wait_request ;;
  wait-until) wait_until_request ;;
  # The model's read of issue and pull request text (looper#219).
  issue-text|pr-text) read_texts ;;
  checkpoint)
    # The model's step: what is done and what is left becomes the message of
    # every checkpoint after it.
    # One that does not push fails (looper#99), and the run's last step stays
    # the one on the branch.
    last_step=""; [[ -n "${LOOPER_RUN:-}" && -f "$LOOPER_RUN/step" ]] && last_step="$(cat "$LOOPER_RUN/step")"
    [[ -n "${LOOPER_RUN:-}" ]] && printf '%s\n' "$STEP" > "$LOOPER_RUN/step"
    if ! checkpoint "$ISSUE" "a step" "${LOOPER_RUN:-}"; then
      if [[ -z "${LOOPER_RUN:-}" ]]; then :
      elif [[ -n "$last_step" ]]; then printf '%s\n' "$last_step" > "$LOOPER_RUN/step"
      else rm -f "$LOOPER_RUN/step"; fi
      exit 1
    fi ;;
  scan) trap disk_log EXIT; scan ;;
  manage) trap disk_log EXIT; manage ;;
  verdict) trap disk_log EXIT; verdict_batch ;;
  merge) merge_batch ;;
  one)
    forge_issue_view "$REPO" "$ISSUE" labels '.labels[].name' | grep -qx "$LABEL_APPROVED" \
      || die "#$ISSUE is not labeled $LABEL_APPROVED"
    trap disk_log EXIT; report_job "$ISSUE" ;;
esac
