  # (looper#35): the run stops by itself, checkpointed and its outcome
  # commented, before GitLab kills the job (an issue's `Timeout:` line can
  # change after the job was sized for it).
  local deadline left; deadline="$(job_deadline)"
  if [[ -n "$deadline" ]] && left=$(( deadline - $(date +%s) )) && (( limit > left )); then
    (( left > 0 )) || left=1   # never 0: `timeout 0` would not stop it
    log "#$n: limit $(hours "$limit") capped at $(hours "$left") by this job"
