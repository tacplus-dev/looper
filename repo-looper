    log "#$n changed nothing since its previous run: it backs off${backed_line:+ ($backed_line)}"; return 0
  fi
  # A fix landed is progress however the run ended: one that went idle waiting
  # on its land after the land was done is not stuck (looper#37), nor one that
  # waited out its build (looper#133), nor one stopped at its local builds' cap
  # (looper#248): the next run has its own.
  if [[ -n "$timed_out" || -n "$capped" || "$stopped" == build-cap ]] || [[ -n "$progress" && ( "$stopped" != idle || -n "$head_after" ) ]]; then
