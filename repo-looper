# Rule 2's word on tacplus: none in a report with no container runtime (looper#71).
tacplus_rule() {
  if [[ -n "${BUILD_JOBS:-}" ]]; then echo "\`tacplus\` runs in the build job only (rule 4)."
  else printf '%s\n   %s' "\`tacplus\` in this container runs the compiler image for this repository's" "MAJOR.MINOR floor (tacplus.yaml), always its latest patch."; fi
