# The think job's run of an issue (looper#28): the model works it in the
# checkout with a read-only token, and writes nothing to GitHub. Its outcome,
# data for the commit job, is DIR/outcome: `type: pr` (with `title:`),
# `question`, `blocked` (with its `Blocked-by:` lines), `timeout` or `stuck`;
# DIR/comment.md is the model's text. On a pull request the looper appends the
# issue's HISTORY.md line and runs the gates on the change: they must pass. The
# change is DIR/patch from DIR/base (origin/main), and DIR/tree is the tree the
# gates passed on, which the commit job must reproduce.
think_outcome() { # type [line...]: the outcome, normalized
  { echo "type: $1"; shift; (( $# )) && printf '%s\n' "$@"; } > "$THINK_OUT/outcome.new"
  mv "$THINK_OUT/outcome.new" "$THINK_OUT/outcome"
  log "think: #$ISSUE: $(head -n 1 "$THINK_OUT/outcome")"
}
think_say() { # text: the looper's word in the comment, after the model's
  if [[ -s "$THINK_OUT/comment.md" ]]; then printf '\n\n**The looper:** %s\n' "$1" >> "$THINK_OUT/comment.md"
  else printf '%s\n' "$1" > "$THINK_OUT/comment.md"; fi
}

# The checkout's change against base (the run record left out): DIR/tree and DIR/patch.
think_change() { # base
  local idx tree
  idx="$(mktemp)"; cp "$(git -C "$CHECKOUT" rev-parse --path-format=absolute --git-path index)" "$idx" 2>/dev/null || true
  ( cd "$CHECKOUT" && GIT_INDEX_FILE="$idx" git add -A && GIT_INDEX_FILE="$idx" git rm -r -q --cached --ignore-unmatch .looper >/dev/null )
  tree="$(cd "$CHECKOUT" && GIT_INDEX_FILE="$idx" git write-tree)"; rm -f "$idx"
  echo "$tree" > "$THINK_OUT/tree"
  git -C "$CHECKOUT" diff --binary --full-index "$1" "$tree" > "$THINK_OUT/patch"
}

