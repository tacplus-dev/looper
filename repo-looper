      l=",$l,"
      if [[ "$l" == *",$LABEL_FEATURE,"* ]]; then
        [[ "$l" == *",$LABEL_APPROVED,"* ]] || continue
        gh issue edit "$n" --repo "$LOOPER_ORG/$REPO" --remove-label "$LABEL_APPROVED" >/dev/null || continue
        gh issue comment "$n" --repo "$LOOPER_ORG/$REPO" --body "A scan never approves a \`$LABEL_FEATURE\` ($ISSUE_FLOW): it needs design, Jody's approval and a ROADMAP.md entry first, so \`$LABEL_APPROVED\` is removed." >/dev/null || true
        log "scan: #$n is a feature; not approved"
      elif [[ "$l" != *",$LABEL_BUG,"* ]]; then
        gh issue edit "$n" --repo "$LOOPER_ORG/$REPO" --add-label "$LABEL_BUG" >/dev/null && log "scan: #$n labelled $LABEL_BUG"
      fi
    done
}

scan() {
  local run before; run="$RUNS/$(date -u +%Y%m%dT%H%M%SZ)-scan"; mkdir -p "$run"
  sync_checkout
  ensure_kind_labels "$REPO"
  before="$(gh issue list --repo "$LOOPER_ORG/$REPO" --state all --limit 1 --json number --jq '.[0].number // 0')" || before=""
  cat > "$run/prompt.md" <<PR
You are the nightly scanner of $LOOPER_ORG/$REPO. Your working directory is its checkout at origin/main.
Change no code. Find, in order:
1. Known vulnerabilities in dependencies (the ecosystem's own auditor where it applies: cargo audit,
   npm audit, govulncheck, pip-audit, the Maven/Gradle dependency tree against advisories).
2. The repository's own gates failing on main ($(gates_hint)).
3. Pins that break the project's rule: a tacplus floor or base image that is not the latest released
   MAJOR.MINOR line it should follow.
For each finding, first check the open issues (\`gh issue list --repo $LOOPER_ORG/$REPO\`) and skip one already
filed. Each finding is a bug ($ISSUE_FLOW): file each new one as one issue labelled \`$LABEL_BUG\`, with a title, the
evidence (command and output), the fix you recommend and acceptance criteria. Label it \`$LABEL_APPROVED\` too when the
fix is mechanical and safe (a patched dependency version, a gate fix with an obvious cause); otherwise
\`$LABEL_DECISION\`. If nothing is found, file nothing.
An idea for new behaviour you come across is a feature, never \`$LABEL_APPROVED\`: add it to PROPOSALS.md (what, why,
links), the one file you may change: commit only it on main, with a message ending with
\`Co-Authored-By: Claude <noreply@anthropic.com>\`, then \`git pull --rebase origin main\` and \`git push origin main\`.
$(opening_rule)
PR
  run_claude "$run/prompt.md" "$run/claude.log" "$TIMEOUT" "$run" || log "scan exited non-zero"
  [[ -n "$before" ]] && scan_labels "$before"
  log "scan of $REPO finished"
}

# --- the parent (looper#32) ----------------------------------------------------

# How many children the runner holds: its CPUs over LOOPER_CHILD_CPUS and its
# memory over LOOPER_CHILD_MEMORY_GB, at least one, at most LOOPER_MAX_CHILDREN
# (a safety ceiling, not the plan). Prints "<n> <why>".
capacity() {
  local cpus mem_kb
  cpus="$(nproc 2>/dev/null || echo 1)"
  mem_kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null)"; mem_kb="${mem_kb:-0}"
  awk -v c="$cpus" -v m="$mem_kb" -v pc="${LOOPER_CHILD_CPUS:-2}" -v pm="${LOOPER_CHILD_MEMORY_GB:-4}" -v max="${LOOPER_MAX_CHILDREN:-6}" 'BEGIN {
    gb = m / 1048576; n = int(c / pc); k = int(gb / pm)
    if (k < n) n = k
    if (max > 0 && max < n) n = max
    if (n < 1) n = 1
    printf "%d %d CPUs at %s a child, %.0f GB at %s GB a child, ceiling %s\n", n, c, pc, gb, pm, max
  }'
}

# Why issues a and b must not run at the same time, from the plan's areas
# file, or nothing (exit 1) when they may: a conflict the plan names; a
# contract both change; a path both touch (one the other's, or under it); an
# issue whose areas the plan does not tell. The planning files are left out:
# every issue may touch them, and a landing rebases over them.
conflict_reason() { # areas a b
  awk -v a="$2" -v b="$3" '
    { sub(/^[[:space:]]*-?[[:space:]]*/, ""); i = $2; sub(/^#/, "", i) }
    $1 == "conflict" { j = $3; sub(/^#/, "", j)
      if ((i == a && j == b) || (i == b && j == a)) { $1 = $2 = $3 = ""; sub(/^ +/, ""); why = "the plan: " $0; exit } }
    $1 == "touches" && (i == a || i == b) { known[i] = 1
      for (f = 3; f <= NF; f++) { p = $f; sub(/^\.\//, "", p); sub(/\/+$/, "", p)
        if (p == "" || p ~ /^(STATE|PROPOSALS|HISTORY|ROADMAP)\.md$/) continue
        paths[i] = paths[i] " " p } }
    $1 == "contract" && (i == a || i == b) { $1 = $2 = ""; sub(/^ +/, ""); contracts[i, $0] = 1; names[i] = names[i] "\n" $0 }
    END {
      if (why != "") { print why; exit 0 }
      if (!(a in known)) { print "the plan does not tell what #" a " touches"; exit 0 }
      if (!(b in known)) { print "the plan does not tell what #" b " touches"; exit 0 }
      n = split(names[a], cs, "\n"); for (k = 1; k <= n; k++) if (cs[k] != "" && ((b, cs[k]) in contracts)) { print "both change " cs[k]; exit 0 }
      na = split(paths[a], pa, " "); nb = split(paths[b], pb, " ")
      for (x = 1; x <= na; x++) for (y = 1; y <= nb; y++) {
        p = pa[x]; q = pb[y]
        if (p == q || index(q, p "/") == 1) { print "both touch " p; exit 0 }
        if (index(p, q "/") == 1) { print "both touch " q; exit 0 } }
      exit 1
    }' "$1"
}

# The model's part of the plan: what each issue will touch, and any other
# conflict it sees, written to the areas file. Read-only, in the checkout.
plan_areas() { # dir issue...
  local dir="$1" n list=""; shift
  for n in "$@"; do list+="- #$n: $(gh issue view "$n" --repo "$LOOPER_ORG/$REPO" --json title --jq .title 2>/dev/null || echo '?')"$'\n'; done
  cat > "$dir/prompt.md" <<PR
You are the parent looper of $LOOPER_ORG/$REPO, planning which of its issues can be worked at the same time.
Each runs in its own worktree and lands on main one at a time, rebased on main with its gates re-run. Your
working directory is the repository's checkout at origin/main. Change nothing: no file, no issue, no label.
The issues (\`gh issue view <n> --repo $LOOPER_ORG/$REPO --comments\` for each, and the code it concerns):
$list
For each issue, judge what its change will touch, and write to $dir/areas, one line each:
- \`touches <n> <path> [<path>...]\`: every file or directory it will change, generated outputs included (the
  files a generator writes, not only its input); a directory when you cannot tell the files. Leave out
  STATE.md, PROPOSALS.md and HISTORY.md, which every issue may touch.
- \`contract <n> <name>\`: each contract it changes that others may depend on (a proto package, an API, a CLI's
  flags, a file format, a prompt), one name per line, the same name for the same contract in every issue.
- \`conflict <a> <b> <why>\`: two issues that must not run at the same time for any other reason you see
  (one changes what the other relies on, both would edit the same generated code, they need the same
  scarce resource...).
Write a \`touches\` line for every issue: one you cannot judge gets \`touches <n> .\` and so runs alone.
Writing the file is your last step.
PR
  ( CHECKOUT="$MAIN_CHECKOUT"; run_claude "$dir/prompt.md" "$dir/claude.log" "$PLAN_TIMEOUT" "$dir" ) \
    || log "the plan's model exited non-zero"
  touch "$dir/areas"
}

# The candidates, in the order they are taken: the job's own issue first if it
# is still ready (or its run was killed, looper#20), then the ready issues in
# ISSUE_ORDER, then any other issue a killed run left looper:in-progress.
# None already started by this parent.
candidates() { # first started
  local first="$1" started="$2" n out=()
  if [[ -n "$first" && "$started" != *" $first "* ]]; then
    if approved_issues "$REPO" | grep -qx "$first" && ready "$REPO" "$first"; then out+=("$first")
    elif orphaned "$first"; then
      log "#$first is $LABEL_IN_PROGRESS, but no other looper job of $REPO is active: its run is gone; this job resumes it" >&2
      out+=("$first")
    fi
  fi
  for n in $(approved_issues "$REPO"); do
    [[ "$started" == *" $n "* || " ${out[*]} " == *" $n "* ]] && continue
    if ready "$REPO" "$n"; then out+=("$n"); fi
  done
  if [[ -n "${CI_API_V4_URL:-}" && -n "${CI_PROJECT_ID:-}" ]]; then
    for n in $(gh issue list --repo "$LOOPER_ORG/$REPO" --state open --label "$LABEL_APPROVED" --label "$LABEL_IN_PROGRESS" \
                 --limit 100 --json number --jq '.[].number' 2>/dev/null); do
      [[ "$started" == *" $n "* || " ${out[*]} " == *" $n "* ]] && continue
      if orphaned "$n"; then log "#$n is $LABEL_IN_PROGRESS, but no other looper job of $REPO is active: this job resumes it" >&2; out+=("$n"); fi
    done
  fi
  echo "${out[@]}"
}

# Issues as "#3 #5", or "none".
issue_list() { if (( $# )); then printf '#%s ' "$@" | sed 's/ $//'; else echo none; fi; }

# The parent: plans, starts each planned issue as a child, and plans again
# whenever one ends, until no child runs and nothing more can start.
parent() { # [issue first]
  local first="${1:-}" started=" " stop="" deadline tags_seen n pid rc res t
  local -A pids=() told=()
  # In a GitLab job no child starts that would outlast it: the others must end
  # an hour before the job does, counted from the job's start. The first child
  # always starts; --job-timeout sizes the job for it and for the ready issues
  # that could run beside it (looper#33), and a child caps its own limit at the
  # deadline (looper#35).
  deadline="$(job_deadline)"
  sync_checkout
  land "Planning files from the template (looper; tacplus-dev/roadmap decisions/repo-roadmap-files-2026-10-27.md)" add_planning_files
  sync_checkout
  rm -rf "$WORK/results"; mkdir -p "$WORK/results"
  tags_seen="$(release_tags)"
  # The lander (looper#34): the children's lands, one at a time, in the parent.
  local lander_pid
  rm -rf "$LANDS"; mkdir -p "$LANDS"
  lander > >(sed -u 's/^/[lander] /') 2>&1 & lander_pid=$!
  export LOOPER_LANDER="$LANDS" LOOPER_LANDER_PID="$lander_pid"

  # One plan: which candidates start now, and why the others wait.
  plan() {
    local cands cap why free plan_dir chosen=() c o r limit reasons=() others beside=()
    read -r -a cands <<<"$(candidates "$first" "$started")"
    if (( ${#cands[@]} == 0 )); then
      if [[ "$started" == " " ]]; then
        if [[ -n "$first" ]]; then log "#$first is no longer ready, nor is any other issue; nothing to do"
        else log "no ready issue in $REPO; exiting"; fi
      fi
      return 0
    fi
    [[ "$started" != " " || -z "$first" || "${cands[0]}" == "$first" ]] || log "#$first is no longer ready; working #${cands[0]}, the next ready issue"
    read -r cap why <<<"$(capacity)"
    free=$(( cap - ${#pids[@]} ))
    plan_dir="$RUNS/$(date -u +%Y%m%dT%H%M%SZ)-plan"; mkdir -p "$plan_dir"
    # The model judges the areas only when there is something to decide.
    if (( free > 0 && ${#pids[@]} + ${#cands[@]} > 1 )); then
      plan_areas "$plan_dir" "${pids[@]}" "${cands[@]}"
    fi
    for c in "${cands[@]}"; do
      r=""
      if (( ${#chosen[@]} >= free )); then r="no free slot (capacity $cap: $why)"
      elif [[ -n "$deadline" && "$started${chosen[*]}" != " " ]] && limit="$(run_limit "$c")" && (( $(date +%s) + limit > deadline )); then
        r="its limit ($(hours "$limit")) would outlast this job"
      else
        for o in "${pids[@]}"; do
          if r="$(conflict_reason "$plan_dir/areas" "$c" "$o")"; then r="$r (#$o, running)"; break; fi
          r=""
        done
        if [[ -z "$r" ]]; then
          for o in "${chosen[@]}"; do
            if r="$(conflict_reason "$plan_dir/areas" "$c" "$o")"; then r="$r (#$o, starting)"; break; fi
            r=""
          done
        fi
      fi
      if [[ -z "$r" ]]; then chosen+=("$c"); reasons+=("#$c starts")
      else reasons+=("#$c waits: $r"); fi
    done
    { echo "plan for $REPO: capacity $cap ($why); running: $(issue_list "${pids[@]}")"
      printf '%s\n' "${reasons[@]}"; } > "$plan_dir/plan.md"
    sed 's/^/plan: /' "$plan_dir/plan.md"
    # On each issue, when there was a decision to make: why it starts beside
    # the others, or why it waits (once per reason).
    if (( ${#pids[@]} + ${#cands[@]} > 1 )); then
      for r in "${reasons[@]}"; do
        c="${r%% *}"; c="${c#\#}"
        [[ "${told[$c]:-}" == "$r" ]] && continue
        told[$c]="$r"
        beside=(); for o in "${pids[@]}" "${chosen[@]}"; do [[ "$o" == "$c" ]] || beside+=("$o"); done
        others=""; (( ${#beside[@]} == 0 )) || others="$(issue_list "${beside[@]}")"
        if [[ "$r" == *" starts" ]]; then
          gh issue comment "$c" --repo "$LOOPER_ORG/$REPO" --body "The looper of $REPO starts this issue${others:+ alongside $others, each in its own worktree, landing on main one at a time}. Its plan:

$(sed 's/^/- /' "$plan_dir/plan.md")

Plan record: $(run_record "$plan_dir")." >/dev/null || true
        else
          gh issue comment "$c" --repo "$LOOPER_ORG/$REPO" --body "The looper of $REPO holds this issue back for now: ${r#* waits: }. It plans again as each running issue ends. Plan record: $(run_record "$plan_dir")." >/dev/null || true
        fi
      done
    fi
    for c in "${chosen[@]}"; do
      started+="$c "
      prepare_worktree "$c"
      rm -f "$WORK/results/$c"
      bash "${LOOPER_RUNNING_COPY:-$LOOPER_SELF}" --repo "$REPO" --child "$c" > >(sed -u "s/^/[#$c] /") 2>&1 & pids[$!]="$c"
    done
  }

  plan
  while (( ${#pids[@]} )); do
    rc=0; pid=""; wait -n -p pid "${!pids[@]}" || rc=$?
    [[ -n "$pid" ]] || { log "lost track of the children ($(issue_list "${pids[@]}")); exiting"; break; }
    n="${pids[$pid]}"; unset "pids[$pid]"
    res="$(cat "$WORK/results/$n" 2>/dev/null || echo "ended without an outcome (exit $rc)")"
    log "#$n: $res; still running: $(issue_list "${pids[@]}")"
    # A child whose job GitLab no longer runs (looper#21): the job's retry takes over; nothing more starts,
    # and nothing more lands after the land under way (looper#34).
    [[ "$res" == job-gone ]] && { stop=1; touch "$LANDS/.stop"; }
    # HISTORY.md: a line for each release the children made.
    local new=()
    for t in $(release_tags | grep -vxF -f <(printf '%s\n' "$tags_seen") || true); do
      new+=("- $(date -u +%F) looper release $t (https://github.com/$LOOPER_ORG/$REPO/releases/tag/$t)")
      tags_seen+=$'\n'"$t"
    done
    if (( ${#new[@]} )); then land "HISTORY.md: releases (looper)" append_history "${new[@]}"; fi
    [[ -n "$stop" ]] || plan
  done
  # The lands the children left queued: the lander lands them before the job
  # ends. A job GitLab no longer runs lands no more: its retry resumes them.
  touch "$LANDS/.done"
  if [[ -z "$stop" ]] && { compgen -G "$LANDS/*.req" >/dev/null || compgen -G "$LANDS/*.running" >/dev/null; }; then
    log "landing what the children left queued"
  fi
  wait "$lander_pid" || true
}

case "$MODE" in
  # From a child of a parent, the parent lands it (looper#34).
  land) if [[ -n "${LOOPER_LANDER:-}" && -d "$LOOPER_LANDER" && "$CHECKOUT" != "$MAIN_CHECKOUT" ]]; then land_request; else land_work; fi ;;
  child) work_issue "$ISSUE" ;;
  checkpoint)
    # The model's step: what is done and what is left becomes the message of
    # every checkpoint after it.
    [[ -n "${LOOPER_RUN:-}" ]] && printf '%s\n' "$STEP" > "$LOOPER_RUN/step"
    # A think job pushes nothing: its commit job keeps the work on the branch.
    [[ -n "${LOOPER_THINK:-}" ]] || checkpoint "$ISSUE" "a step" "${LOOPER_RUN:-}" ;;
  scan) scan ;;
  think) think_issue "$ISSUE" ;;
  one)
    gh issue view "$ISSUE" --repo "$LOOPER_ORG/$REPO" --json labels --jq '.labels[].name' | grep -qx "$LABEL_APPROVED" \
      || die "#$ISSUE is not labeled $LABEL_APPROVED"
    # A job planned for an issue another run took or finished meanwhile takes
    # the next ready issue at run time instead (looper#16; priority first, #31);
    # either way the parent goes on with the others it can plan (looper#32).
    parent "$ISSUE" ;;
  # One pass over each issue per run: an issue the parent started is never
  # taken again, even if a label write failed.
  drain) parent ;;
esac
