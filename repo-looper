# The new suggestions the model left in the checkout (files of suggestions/
# that origin/main lacks), best ranked first; anything else it changed is
# logged and left out.
suggest_new() {
  local p f
  while read -r p; do
    [[ -n "$p" ]] || continue
    if [[ "$p" =~ ^suggestions/[0-9]{4}-[0-9]{2}-[0-9]{2}-[^/]+\.md$ ]] && ! git -C "$CHECKOUT" cat-file -e "origin/main:$p" 2>/dev/null && [[ -f "$CHECKOUT/$p" ]]; then
      f="${p#suggestions/}"
      echo "$(sed -n 's/^Rank:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$CHECKOUT/$p" | head -n 1 | grep . || echo 999) $f"
    elif [[ "$p" != suggestions/INDEX.md ]]; then
      log "scan: left out, not a new suggestion: $p" >&2
    fi
  done < <( { git -C "$CHECKOUT" diff --name-only origin/main --; git -C "$CHECKOUT" ls-files --others --exclude-standard; } | sort -u) \
    | sort -n -k1,1 -k2 | awk '{ print $2 }'
}

# land()'s change, in its scratch worktree at origin/main: each new suggestion
# in turn, kept when the change still passes looper-suggest check, at most
# SUGGEST_MAX; the reasons for each one dropped in the run's dropped file.
suggest_apply() { # run-dir file...
  local run="$1" f n=0 why; shift
  : > "$run/filed"; : > "$run/dropped"
  for f in "$@"; do
    (( n < SUGGEST_MAX )) || { echo "$f: over the night's $SUGGEST_MAX" >> "$run/dropped"; continue; }
    if [[ -e "suggestions/$f" ]]; then echo "$f: on main already" >> "$run/dropped"; continue; fi
    cp "$CHECKOUT/suggestions/$f" "suggestions/$f"
    "$SUGGEST" index . 2>/dev/null || true
    if why="$("$SUGGEST" check . HEAD 2>&1)"; then echo "$f" >> "$run/filed"; n=$((n + 1))
    else
      rm -f "suggestions/$f"; "$SUGGEST" index . 2>/dev/null || true
      { echo "$f:"; sed 's/^/  /' <<<"$why"; } >> "$run/dropped"
    fi
  done
  (( n > 0 )) || git checkout -q -- suggestions/INDEX.md 2>/dev/null || true
  recap_files "$run"
}

# The night's recap files, beside its suggestions (looper#57): its data,
# suggestions/recap/<night>.json (the history the next nights classify
# against), and suggestions/recap/<night>.md for Jody's daily report, linking
# the advice just filed and the issues the model said cover an item. A night
# already recorded is left as it is.
recap_files() { # run-dir
  local ctx="$1/context" night
  [[ -f "$ctx/recap-classes.json" ]] || return 0
  night="$(jq -r .night "$ctx/recap.json")"
  if [[ -e "suggestions/recap/$night.md" || -e "suggestions/recap/$night.json" ]]; then
    echo "suggestions/recap/$night.md: on main already" >> "$1/dropped"; return 0
  fi
  mkdir -p suggestions/recap
  cp "$ctx/recap.json" "suggestions/recap/$night.json"
  "$RECAP" report "$ctx/recap.json" "$ctx/recap-classes.json" --suggestions suggestions --covered "$1/covered" > "suggestions/recap/$night.md"
  echo "recap/$night.md" >> "$1/filed"
}

# A suggestion's template, suggestions/TEMPLATE.md, where it is missing.
suggest_template() { [[ -e suggestions/TEMPLATE.md ]] || "$SUGGEST" template > suggestions/TEMPLATE.md; }

suggest_scan() { # run-dir
  local run="$1" ctx new
  if [[ ! -f "$CHECKOUT/suggestions/TYPES.md" ]]; then
    log "scan: $REPO has no suggestions/TYPES.md: no suggestion pass"; return 0
  fi
  if [[ ! -e "$CHECKOUT/suggestions/TEMPLATE.md" ]]; then
    land "suggestions/TEMPLATE.md: a suggestion's template (looper-suggest template, looper#50)" suggest_template
    sync_checkout
  fi
  ctx="$( { suggest_context "$run"; recap_context "$run"; } )"
  suggest_prompt "$run" "$ctx" > "$run/prompt.md"
  run_claude "$run/prompt.md" "$run/claude.log" "$TIMEOUT" "$run" || log "scan exited non-zero"
  mapfile -t new < <(suggest_new)
  if (( ${#new[@]} == 0 )) && [[ ! -f "$run/context/recap-classes.json" ]]; then log "scan: no new suggestion tonight"
  else
    (( ${#new[@]} )) || log "scan: no new suggestion tonight; the recap only"
    land "Suggestions of $(date -u +%F) (the roadmap scan, looper#50; the nightly recap, looper#57)" suggest_apply "$run" "${new[@]+"${new[@]}"}"
    [[ ! -s "$run/dropped" ]] || { log "scan: suggestions dropped:"; sed 's/^/  /' "$run/dropped"; }
    [[ ! -s "$run/filed" ]] || log "scan: suggestions filed: $(paste -sd' ' "$run/filed")"
  fi
  # What the model left in the checkout is in the run's record now; the next run starts clean.
  git -C "$CHECKOUT" checkout -q -f -B main origin/main && git -C "$CHECKOUT" clean -fdq
  log "scan of $REPO finished"
}

# The scan's trace propagation item (looper#51): looper-trace check of main,
# run by the looper into the run's trace.txt, so services no run touched
# lately are covered too; the model verifies each finding by reading.
trace_item() { # run-dir
  local verdict
  if (cd "$CHECKOUT" && "$TRACE" check) > "$1/trace.txt" 2>&1 || [[ "$(tail -n 1 "$1/trace.txt")" == "verdict: fail"* ]]; then
    verdict="$(tail -n 1 "$1/trace.txt")"; cat <<IT
5. Trace propagation (tacplus-dev/looper#51; README: Trace propagation): \`looper-trace check\` of this checkout
   is $1/trace.txt ($verdict).
   Read each handler it lists, and the ones it cannot (calls through helpers, other languages): a handler that
   drops the inbound \`trace_id\` on a downstream call its request causes, and a handler with causal downstream
   calls and no test asserting that its \`trace_id\` arrives on them, is a finding. One it flags that reading
   shows right (the request does not cause the call) is not, but say in an issue that the call lacks its
   \`// trace: unrelated: <why>\` marker.
IT
  else
    echo "5. Trace propagation: \`looper-trace check\` could not run ($1/trace.txt): check the handlers by reading (README: Trace propagation)."
  fi
}

scan() {
  local run before report; run="$RUNS/$(date -u +%Y%m%dT%H%M%SZ)-scan"; mkdir -p "$run"
  sync_checkout
  if [[ "$REPO" == "$LOOPER_ROADMAP_REPO" ]]; then suggest_scan "$run"; return; fi
  report="$(security_report "$run")"
  ensure_labels "$REPO"
  before="$(forge_issue_list "$REPO" all 1 number '.[0].number // 0')" || before=""
  cat > "$run/prompt.md" <<PR
You are the nightly scanner of $LOOPER_ORG/$REPO. Your working directory is its checkout at origin/main.
Change no code. Find, in order:
$(security_item "$report")
2. Known vulnerabilities in dependencies the build's checks do not cover (the ecosystem's own auditor where it
   applies: cargo audit, npm audit, govulncheck, pip-audit, the Maven/Gradle dependency tree against advisories).
3. The repository's own gates failing on main ($(gates_hint)).
4. Pins that break the project's rule: a tacplus floor or base image that is not the latest released
   MAJOR.MINOR line it should follow.
$(trace_item "$run")
For each finding, first check the open issues (\`$(forge_cmd list "$REPO")\`) and skip one already
filed. Each finding is a bug ($ISSUE_FLOW): file each new one as one issue labelled \`$LABEL_BUG\`, with a title, the
evidence (command and output), the fix you recommend and acceptance criteria. Label it \`$LABEL_APPROVED\` too when the
fix is mechanical and safe (a patched dependency version, a gate fix with an obvious cause); otherwise
\`$LABEL_DECISION\`. If nothing is found, file nothing.
An idea for new behaviour you come across is a feature, never \`$LABEL_APPROVED\`: add it to PROPOSALS.md (what, why,
links), the one file you may change: commit only it on main, with a message ending with
\`Co-Authored-By: Claude <noreply@anthropic.com>\`, then \`git pull --rebase origin main\` and \`git push origin main\`.
$(opening_rule)
$(provenance_rule)
PR
  run_claude "$run/prompt.md" "$run/claude.log" "$TIMEOUT" "$run" || log "scan exited non-zero"
  [[ -n "$before" ]] && scan_labels "$before"
  log "scan of $REPO finished"
}

# --- the report (looper#70) ----------------------------------------------------

# A report's memory, in GB (looper#41): LOOPER_CHILD_MEMORY_GB, default 4; in a
# repository whose gates run Kani (the word in a justfile, a Makefile or a CI
# workflow on main), at least LOOPER_KANI_MEMORY_GB, default 12: Kani's proofs
# need many GB (tacplus#196). Prints "<GB>[ (why)]".
child_memory() {
  local gb="${LOOPER_CHILD_MEMORY_GB:-4}" kani="${LOOPER_KANI_MEMORY_GB:-12}"
  if git -C "$CHECKOUT" grep -qiwI kani -- justfile '*/justfile' '*.just' Makefile '.github/workflows/*' 2>/dev/null &&
     awk -v a="$gb" -v b="$kani" 'BEGIN { exit !(b > a) }'; then
    echo "$kani (its gates run Kani)"
  else echo "$gb"; fi
}

# The limit of each container a report's model starts (looper#41), as a
# docker size: its memory in MB, at least docker's 6. The report gives it to
# its model as LOOPER_CHILD_MEMORY; run_claude puts looper-docker in front of
# the model's docker.
child_memory_size() { child_memory | awk '{ m = int($1 * 1024); if (m < 6) m = 6; printf "%dm\n", m }'; }

# The report of an issue (looper#70): its job works it, if it is still ready
# (or its run was killed outright, looper#20), in its own clone, and touches
# no other issue and never main.
report_job() { # issue
  local n="$1"
  # Its manager first (looper#75): this job's slot is the one the manager waits
  # for. The issue stays ready, and the kicker plans it again, after the manager.
  if manager_waiting; then log "#$n yields to $(manager_job "$REPO"), which waits to start: the manager merges first; this issue is planned again after it"; return 0; fi
  if ! { approved_issues "$REPO" | grep -qx "$n" && ready "$REPO" "$n"; }; then
    if orphaned "$n"; then log "#$n is $LABEL_IN_PROGRESS, but no other report job of it is active: its run is gone; this job resumes it"
    else log "#$n is no longer ready; nothing to do"; return 0; fi
  fi
  prepare_report
  # The model's user (looper#68) takes the checkpoint lock too. GitLab's file
  # variables (CI_PROJECT_DIR.tmp, world-readable) are the job's alone.
  if model_users; then
    touch "$WORK/.checkpoint.lock"; chmod 0666 "$WORK/.checkpoint.lock"
    [[ -z "${CI_PROJECT_DIR:-}" || ! -d "$CI_PROJECT_DIR.tmp" ]] || chmod -R go-rwx "$CI_PROJECT_DIR.tmp"
    # The image's tools under the job's home (tacplus's openjml, on the PATH) stay
    # the model's to run: the home is its to pass through, not to list, and
    # what in it is private stays the job's.
    if [[ -d "$HOME" && "$HOME" != / ]]; then
      chmod 0711 "$HOME"
      for d in .claude .claude.json .config .local .cache/gh .docker .ssh .gnupg .netrc .git-credentials; do
        [[ ! -e "$HOME/$d" ]] || chmod go-rwx "$HOME/$d"
      done
    fi
  fi
  # Its containers are limited to its share (looper#41).
  LOOPER_CHILD_MEMORY="$(child_memory_size)"; export LOOPER_CHILD_MEMORY
  # A pinned repository's report builds in build jobs, with no container runtime (looper#71).
  BUILD_JOBS=""
  if build_jobs origin/main; then BUILD_JOBS=1; log "$REPO pins its build image: this report builds in build jobs, its model with no container runtime"
  elif [[ "$LOOPER_FORGE" == github ]] && pinned origin/main; then log "$REPO pins its build image, but this job holds no BUILD_TRIGGER_TOKEN: its model keeps looper-docker (looper#71)"; fi
  work_issue "$n"
}

# The disk a job leaves, for the nightly recap's runner pools (looper#57).
disk_log() {
  local u; u="$(df -Ph "${CI_BUILDS_DIR:-$WORK}" 2>/dev/null | awk 'NR == 2 { print $5 " used of " $2 " (" $6 ")" }')" || u=""
  [[ -z "$u" ]] || log "disk at the end: $u"
}

case "$MODE" in
  # The model's step in a report: the manager merges it (looper#70).
  land) land_request ;;
  # The model's build request in a pinned repository's report (looper#71).
  build) build_request ;;
  checkpoint)
    # The model's step: what is done and what is left becomes the message of
    # every checkpoint after it.
    [[ -n "${LOOPER_RUN:-}" ]] && printf '%s\n' "$STEP" > "$LOOPER_RUN/step"
    # A think job pushes nothing: its commit job keeps the work on the branch.
    [[ -n "${LOOPER_THINK:-}" ]] || checkpoint "$ISSUE" "a step" "${LOOPER_RUN:-}" ;;
  scan) trap disk_log EXIT; scan ;;
  think) think_issue "$ISSUE" ;;
  manage) trap disk_log EXIT; manage ;;
  one)
    forge_issue_view "$REPO" "$ISSUE" labels '.labels[].name' | grep -qx "$LABEL_APPROVED" \
      || die "#$ISSUE is not labeled $LABEL_APPROVED"
    trap disk_log EXIT; report_job "$ISSUE" ;;
esac
