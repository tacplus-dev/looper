    log "maintenance: #$MAINT_N's branch $b is on origin (its land queued, or its report's work): left to it"; MAINT_HELD=1
  elif forge_issue_view "$REPO" "$MAINT_N" labels '.labels[].name' 2>/dev/null | grep -qx "$LABEL_IN_PROGRESS"; then
    log "maintenance: #$MAINT_N is $LABEL_IN_PROGRESS: left to its report"; MAINT_HELD=1
  fi
}
# The scan's item 4, printed for the prompt.
relock_item() { # run-dir
