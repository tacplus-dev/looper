    log "#$n ended with its merge request open ($mr); the issue resumes once it is merged or closed"
    return 0
  fi
  if [[ -n "$pending" ]]; then
    report "$n" land-pending
    (( wrc != 0 )) || where+=" It also waits on $(cut -d' ' -f2 <<<"$waiting" | sed 's/.*/<&>/' | paste -sd, - | sed 's/,/, /g'): its next run starts once the verdict is in and that run has finished."
    [[ -z "$until_t" ]] || where+=" It also waits until $(hold_iso "$until_t") (looper#181): its next run starts then, or once the verdict is in."
    forge_issue_comment "$REPO" "$n" "$ended Its commits are queued with the manager of $REPO, which merges them after the run and gives its verdict here. $where

$done_left

This issue stays $LABEL_APPROVED, and $LABEL_LANDING until that verdict: then the next run finishes it. Run record: $(run_record "$run")." >/dev/null || true
    [[ -z "$until_t" ]] || backoff_record "$n" "$until_t" "${until_paths[@]+"${until_paths[@]}"}" >/dev/null || log "#$n: its Backed-off line could not be put in its body"
    log "#$n ended with its land queued; the manager merges it, and the issue resumes after its verdict"
    return 0
  fi
  if (( brc == 2 )); then
    report "$n" ended
    forge_issue_comment "$REPO" "$n" "The run's outcome names only issues closed by now ($dropped), so it was not taken: nothing waits on them.${head_after:+ It landed main ${head_before:0:7}..${head_after:0:7}$on.} $where

$done_left

This issue stays $LABEL_APPROVED: the next run resumes from that branch. Run record: $(run_record "$run")." >/dev/null || true
    log "#$n: its outcome names only closed issues ($(paste -sd, - "$run/blockers-closed")); it resumes on the next pass"; return 0
  fi
  # Nothing to do (looper#181): a resumed run that ended by itself with
  # nothing landed or queued and its work the tree it started from changed
  # nothing since its previous run (kernel#66, ~20 runs on 2026-11-17, each
  # re-checking that Debian had no fix yet). It backs off: the issue stays
  # approved and is not started again until something changes, or a day later.
  # A run woken before its back-off's until keeps that until and its paths
  # (looper#213): a wake that found nothing does not put the wait off a day.
  if [[ -z "$timed_out" && -z "$capped" && -z "$head_after" && -n "$progress" && "$stopped" != idle && "$stopped" != build-cap && -n "$resumed" && -s "$run/start-tree" ]] \
     && [[ "$(work_tree 2>/dev/null)" == "$(cat "$run/start-tree")" ]]; then
    local back pu prest paths=() when; back=$(( $(date +%s) + LOOPER_BACKOFF_MAX ))
    when="$(hours "$LOOPER_BACKOFF_MAX") from now, $(hold_iso "$back")"
