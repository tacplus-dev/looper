#!/usr/bin/env bash
# Copyright (c) 2026 Jody Scott
# SPDX-License-Identifier: Apache-2.0
#
# repo-looper: the one looper of one tacplus-dev repository. It runs in the
# looper container, as a job of the GitLab looper pipeline on the autoscaled
# runner (one job per repository at a time), and only while the repository
# has work.
#
#   repo-looper --repo NAME             drain NAME's ready issues, oldest first
#   repo-looper --repo NAME --issue N   work issue N if it is still ready, else the oldest ready one (what the pipeline runs)
#   repo-looper --repo NAME --scan      the nightly scan: file issues, change no code
#   repo-looper --repo NAME --list      print the ready issues; in a GitLab job, none while NAME
#                                       has a looper job queued, waiting or running there (the plan)
#   repo-looper --repo NAME --job-timeout N   the CI job timeout for issue N (its limit, plus an hour)
#   repo-looper --repo NAME --issue N --checkpoint MSG   push the checkout's work in progress (the model's step)
#
# Ready: open, labeled `approved`, not held (looper:in-progress, looper:stuck,
# needs-decision), and every `Blocked-by:` issue in its body closed.
# With --issue N in a GitLab job, N labelled looper:in-progress but otherwise
# ready, and no other looper job of NAME active, N is taken as a resume: its run
# was killed outright (looper#20).
#
# One checkout per repository, kept across issues and runs under
# LOOPER_WORK/NAME/checkout: the looper always works the same code base. Claude
# may run sub-agents in that checkout for independent parts; only this script's
# top-level run commits and pushes, to main (pre-production rule, Jody 2026-10-26).
#
# Each run's record (prompt.md, claude.log, outcome) is a directory under
# LOOPER_RUNS. The pipeline sets it inside the job's project directory and
# uploads it as the job's artifacts: the runner VM does not outlive the job.
#
# Never lose a run's work (tacplus-dev/looper#7): while the model works, its
# work in progress (commits, changes, new files) is checkpointed to the branch
# looper/NAME-N on origin, never main: whenever the model finishes a step
# (--checkpoint), every LOOPER_CHECKPOINT_INTERVAL, and when the model stops.
# A run on an issue whose branch exists starts from it, rebased on main (else
# main merged into it, its conflicts if any marked and named in the prompt), as
# uncommitted changes; the branch is deleted once the work lands on main.
#
# The run's limit is a line `Timeout: <hours>h` in the issue body (at most 10h),
# else LOOPER_TIMEOUT; the model is stopped LOOPER_STOP_EARLY seconds before it.
#
# A finished or idle run ends (tacplus-dev/looper#8): a watchdog stops the model
# when it went idle (no output and no change in the checkout for
# LOOPER_IDLE_MINUTES; the issue gets a comment with its log tail and is
# looper:stuck), and when the run is done (it closed the issue, or pushed with a
# Blocked-by outcome) and the model has not exited LOOPER_DONE_GRACE seconds
# later. Every checkpoint also carries the run's record (prompt.md, the
# claude.log tail) under .looper/, so a cancelled run still leaves its log.
#
# After the run: closed or needs-decision is the run's own outcome. A fix that
# is pushed while the gates wait on another open issue (the run writes
# `Blocked-by: <issue>` to its outcome file) gets that line in the issue body
# and stays approved, so it is worked again for the gates once that issue
# closes. A run that reached its limit says what is done and what is left and
# stays approved: the next run resumes from its branch. Anything else is
# looper:stuck, for a person.
#
# The planning files (looper#13): before the model runs, a missing STATE.md,
# PROPOSALS.md or HISTORY.md is created on main from its template in
# tacplus-dev/roadmap (ROADMAP.md never); after it, a closed issue and each
# release (a new vX.Y.Z tag) get their line at the end of HISTORY.md. A push of
# a commit that touches ROADMAP.md, Jody's, is refused (a pre-push hook in the
# checkout); the issue's own branch is exempt.
#
# Bug or feature (tacplus-dev/roadmap decisions/issue-flow-2026-10-27.md,
# looper#14): an issue labelled neither is classified by the model first (a
# comment and the label). A bug is fixed and released as the next patch, and
# backported. A feature is built only when a ROADMAP.md links it (the
# repository's or tacplus-dev/roadmap's); otherwise the model proposes its
# design (on the issue and in PROPOSALS.md) and the issue is needs-decision.
# The nightly scan files its findings as bugs and never approves a feature;
# every prompt reads the roadmaps before opening an issue.
#
# Environment: GH_TOKEN (pushes and issue calls), CLAUDE_CODE_OAUTH_TOKEN (the
# model), LOOPER_WORK (default /work), LOOPER_RUNS (default LOOPER_WORK/NAME/runs),
# LOOPER_MODEL (default claude-opus-5-5), LOOPER_TIMEOUT (seconds per issue,
# default 14400), LOOPER_STOP_EARLY (default 600), LOOPER_CHECKPOINT_INTERVAL
# (seconds, default 3600), LOOPER_IDLE_MINUTES (default 20), LOOPER_DONE_GRACE
# (seconds, default 300), LOOPER_WATCH_INTERVAL (the watchdog's, seconds,
# default 60), LOOPER_GATES (default `just gates` when the
# repository has a justfile), GIT_AUTHOR_NAME/EMAIL. In a GitLab job, CI_JOB_URL and
# CI_PROJECT_DIR name the job and its artifacts in issue comments, and --list and
# --issue read the project's jobs (CI_API_V4_URL, CI_PROJECT_ID; CI_JOB_ID, this
# job, is not another) with GITLAB_TOKEN, else CI_JOB_TOKEN.
set -euo pipefail

usage() { sed -n '5,86p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }
case "${1:-}" in -h|--help|help) usage; exit 0 ;; esac

# Run from a private copy: a pull that rewrites this file mid-run must not corrupt the running process.
if [ -z "${LOOPER_RUNNING_COPY:-}" ]; then
  copy="$(mktemp -t repo-looper-run.XXXXXX)"; cp "${BASH_SOURCE[0]}" "$copy"
  LOOPER_RUNNING_COPY="$copy" LOOPER_SELF="${LOOPER_SELF:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")}" LOOPER_LIB="${LOOPER_LIB:-$(dirname "${BASH_SOURCE[0]}")/looper-lib.sh}" exec bash "$copy" "$@"
fi
# shellcheck source=looper-lib.sh
source "$LOOPER_LIB"
# This script's own path, for the model's --checkpoint.
: "${LOOPER_SELF:=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")}"

REPO=""; ISSUE=""; MODE=drain; STEP=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) REPO="$2"; shift 2 ;;
    --issue) ISSUE="$2"; [[ "$MODE" == drain ]] && MODE=one; shift 2 ;;
    --checkpoint) STEP="$2"; MODE=checkpoint; shift 2 ;;
    --job-timeout) ISSUE="$2"; MODE=job-timeout; shift 2 ;;
    --scan) MODE=scan; shift ;;
    --list) MODE=list; shift ;;
    *) die "unknown argument: $1 (see --help)" ;;
  esac
done
[[ -n "$REPO" ]] || die "no repository: --repo NAME (a $LOOPER_ORG repository)"
need gh; need git; need jq

# The names of the looper jobs that hold a repository (busy() in looper-lib.sh)
# in this GitLab job's project, with GITLAB_TOKEN, else the job's own token.
# Outside a GitLab job, none.
project_jobs() {
  [[ -n "${CI_API_V4_URL:-}" && -n "${CI_PROJECT_ID:-}" ]] || return 0
  local auth=(-H "JOB-TOKEN: ${CI_JOB_TOKEN:-}")
  [[ -n "${GITLAB_TOKEN:-}" ]] && auth=(-H "PRIVATE-TOKEN: $GITLAB_TOKEN")
  curl -fsS --retry 2 "${auth[@]}" "$CI_API_V4_URL/projects/$CI_PROJECT_ID/jobs?$LOOPER_JOB_SCOPES&per_page=100" \
    | jq -r --arg me "${CI_JOB_ID:-}" '.[] | select((.id | tostring) != $me) | .name'
}

# A run killed outright (its runner gone, looper#20) leaves its issue
# looper:in-progress, and no run holds it. The job for that issue takes it as a
# resume when it is otherwise ready and no other looper job of the repository
# (this job excepted) is created, pending, waiting or running: the label is
# this job's. Outside a GitLab job, or when GitLab cannot be read, never.
orphaned() { # issue
  local l jobs
  [[ -n "${CI_API_V4_URL:-}" && -n "${CI_PROJECT_ID:-}" ]] || return 1
  l="$(gh issue view "$1" --repo "$LOOPER_ORG/$REPO" --json state,labels --jq 'select(.state == "OPEN") | .labels[].name')" || return 1
  grep -qx "$LABEL_IN_PROGRESS" <<<"$l" || return 1
  if grep -qxE "$LABEL_STUCK|$LABEL_DECISION" <<<"$l"; then return 1; fi
  ready "$REPO" "$1" || return 1
  jobs="$(project_jobs)" || return 1
  ! busy "$REPO" "$jobs" >/dev/null
}

# The plan (looper#16): a repository whose looper job is already created,
# pending, waiting for its resource_group or running gets no other one; that
# job takes the oldest ready issue when it runs. When GitLab cannot be read,
# the repository is planned as before. The log is stderr: stdout is the list.
if [[ "$MODE" == list ]]; then
  if jobs="$(project_jobs)"; then
    held="$(busy "$REPO" "$jobs" | tr '\n' ' ')" || true
    [[ -z "$held" ]] || { log "$REPO already has a looper job: ${held% }; not planned again" >&2; exit 0; }
  else
    log "could not read this project's jobs; planning $REPO anyway" >&2
  fi
  approved_issues "$REPO" | while read -r n; do if ready "$REPO" "$n"; then echo "$n"; fi; done
  exit 0
fi
[[ "$MODE" != checkpoint || -n "$ISSUE" ]] || die "--checkpoint needs --issue N"

WORK="${LOOPER_WORK:-/work}/$REPO"
CHECKOUT="$WORK/checkout"
MODEL="${LOOPER_MODEL:-claude-opus-5-5}"
TIMEOUT="${LOOPER_TIMEOUT:-14400}"
MAX_LIMIT=36000   # 10h: what a `Timeout:` line may ask for
STOP_EARLY="${LOOPER_STOP_EARLY:-600}"
CHECKPOINT_INTERVAL="${LOOPER_CHECKPOINT_INTERVAL:-3600}"
IDLE="$(awk -v m="${LOOPER_IDLE_MINUTES:-20}" 'BEGIN { printf "%d", m * 60 }')"
DONE_GRACE="${LOOPER_DONE_GRACE:-300}"
WATCH_INTERVAL="${LOOPER_WATCH_INTERVAL:-60}"
RECORD_LINES=400   # the claude.log tail a checkpoint keeps under .looper/
RUNS="${LOOPER_RUNS:-$WORK/runs}"

# The run's limit in seconds: a line `Timeout: <hours>h` in the issue's body,
# at most 10h, else LOOPER_TIMEOUT.
run_limit() { # issue
  local body h
  body="$(gh issue view "$1" --repo "$LOOPER_ORG/$REPO" --json body --jq .body)" || { echo "$TIMEOUT"; return 0; }
  h="$(grep -ioE '^[[:space:]]*timeout:[[:space:]]*[0-9]{1,3}h[[:space:]]*$' <<<"$body" | head -n 1 | tr -dc 0-9)" || true
  if [[ -z "$h" || "$((10#$h))" == 0 ]]; then echo "$TIMEOUT"
  elif (( 10#$h * 3600 > MAX_LIMIT )); then echo "$MAX_LIMIT"
  else echo "$((10#$h * 3600))"; fi
}
hours() { echo "$(( ($1 + 3599) / 3600 ))h"; } # seconds, rounded up

# The CI job's timeout: the run's limit plus an hour for the checkout, the
# checkpoint and the outcome.
[[ "$MODE" == job-timeout ]] && { echo "$(( ($(run_limit "$ISSUE") + 3599) / 3600 + 1 ))h"; exit 0; }
need claude
mkdir -p "$RUNS"
gh auth setup-git >/dev/null 2>&1 || true

# The repository's checkout at origin/main. Anything a previous run left
# unpushed is kept on a local branch for a person to look at, never pushed.
sync_checkout() {
  if [[ ! -d "$CHECKOUT/.git" ]]; then
    gh repo clone "$LOOPER_ORG/$REPO" "$CHECKOUT" -- --quiet
  fi
  git -C "$CHECKOUT" fetch -q origin
  # Keep what a previous run left before moving: a cancelled or killed run can
  # leave the checkout dirty, detached, or on main with local commits, and then
  # switching to main fails (the reused-worker case, tacplus#161 2026-10-27).
  local ahead_main=0
  git -C "$CHECKOUT" rev-parse -q --verify refs/heads/main >/dev/null &&
    ahead_main="$(git -C "$CHECKOUT" rev-list --count origin/main..main)"
  if [[ -n "$(git -C "$CHECKOUT" status --porcelain)" || \
        "$(git -C "$CHECKOUT" rev-list --count origin/main..HEAD)" != 0 || "$ahead_main" != 0 ]]; then
    local keep; keep="looper/left-$(date -u +%Y%m%dT%H%M%SZ)"
    git -C "$CHECKOUT" add -A && git -C "$CHECKOUT" commit -q -m "left by an unfinished looper run" || true
    git -C "$CHECKOUT" branch -q "$keep"
    [[ "$ahead_main" != 0 && "$(git -C "$CHECKOUT" symbolic-ref -q --short HEAD)" != main ]] &&
      git -C "$CHECKOUT" branch -q "$keep-main" main
    log "kept unpushed work on local branch $keep"
  fi
  git -C "$CHECKOUT" checkout -q -f -B main origin/main
  git -C "$CHECKOUT" reset -q --hard origin/main
  guard_roadmap
}

# The planning files every repository carries (tacplus-dev/roadmap
# decisions/repo-roadmap-files-2026-10-27.md, looper#13). ROADMAP.md is Jody's:
# an agent changes it at his request, a looper never does. The model keeps
# STATE.md and PROPOSALS.md. HISTORY.md is append-only, and this script appends
# its line for each closed issue and each release. A missing one is created
# from its template in tacplus-dev/roadmap, ROADMAP.md never.
PLANNING_FILES=(STATE.md PROPOSALS.md HISTORY.md)
TEMPLATES="roadmap/contents/templates/repo"   # a repository of LOOPER_ORG and its path

# A planning file's template, with the repository's name filled in.
template() { # file
  local t; t="$(mktemp)"
  gh api "repos/$LOOPER_ORG/$TEMPLATES/$1" -H "Accept: application/vnd.github.raw" > "$t" || { rm -f "$t"; return 1; }
  sed "s/<repo>/$REPO/g" "$t"; rm -f "$t"
}

# Refuses, in the checkout's pre-push hook, any push of a commit that touches
# ROADMAP.md: the model's pushes and this script's alike. The issue's own
# branch (looper/*) is exempt, so a checkpoint still keeps all the work.
# Commits already on origin (an agent's, at Jody's request) are not this push's.
guard_roadmap() {
  local hook; hook="$(git -C "$CHECKOUT" rev-parse --absolute-git-dir)/hooks/pre-push"
  mkdir -p "$(dirname "$hook")"
  cat > "$hook" <<'HOOK'
#!/usr/bin/env bash
# Installed by repo-looper (looper#13): a looper never pushes a commit that touches ROADMAP.md.
z=0000000000000000000000000000000000000000
while read -r _ lsha rref rsha; do
  [[ "$lsha" == "$z" || "$rref" == refs/heads/looper/* ]] && continue
  not=(--remotes="$1"); [[ "$rsha" != "$z" ]] && git cat-file -e "$rsha" 2>/dev/null && not+=("$rsha")
  c="$(git rev-list -n 1 "$lsha" --not "${not[@]}" -- ROADMAP.md)"
  if [[ -n "$c" ]]; then
    echo "repo-looper: refused to push $rref: commit $(git rev-parse --short "$c") touches ROADMAP.md, which only Jody changes (through an agent). Propose it in PROPOSALS.md instead." >&2
    exit 1
  fi
done
exit 0
HOOK
  chmod +x "$hook"
}

# Commits a change to main and pushes it, from a scratch worktree at
# origin/main: the checkout is untouched. The change is a command run in that
# worktree; when the push is rejected it is made again on the new origin/main.
# Never fatal.
land() { # message command [args...]
  local msg="$1" wt i; shift
  wt="$(mktemp -d)"
  for i in 1 2 3; do
    git -C "$CHECKOUT" fetch -q origin main || break
    if (( i == 1 )); then git -C "$CHECKOUT" worktree add -q -f --detach "$wt" origin/main || break
    else git -C "$wt" checkout -q -f --detach origin/main && git -C "$wt" clean -fdq; fi
    ( cd "$wt" && "$@" ) || break
    [[ -n "$(git -C "$wt" status --porcelain)" ]] || break
    git -C "$wt" add -A && git -C "$wt" commit -q -m "$msg" || break
    if git -C "$wt" push -q origin HEAD:refs/heads/main; then log "pushed to main: $msg"; break; fi
    (( i < 3 )) || log "could not push to main: $msg"
  done
  git -C "$CHECKOUT" worktree remove -f "$wt" 2>/dev/null || rm -rf "$wt"
  git -C "$CHECKOUT" worktree prune
}

add_planning_files() {
  local f
  for f in "${PLANNING_FILES[@]}"; do
    [[ -e "$f" ]] || template "$f" > "$f" || { rm -f "$f"; log "no template for $f"; }
  done
}

append_history() { # line...
  [[ -e HISTORY.md ]] || template HISTORY.md > HISTORY.md || : > HISTORY.md
  [[ -z "$(tail -c 1 HISTORY.md)" ]] || echo >> HISTORY.md
  printf '%s\n' "$@" >> HISTORY.md
}

# The release tags (vX.Y.Z) on origin.
release_tags() {
  git -C "$CHECKOUT" ls-remote --tags --refs origin 'refs/tags/v*' | sed 's#.*refs/tags/##' \
    | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V || true
}

gates_hint() {
  if [[ -n "${LOOPER_GATES:-}" ]]; then echo "$LOOPER_GATES"
  elif [[ -f "$CHECKOUT/justfile" ]]; then echo "just gates (see the justfile)"
  else echo "the repository's own build and tests (README, CONTRIBUTING, CI workflows)"; fi
}

# claude's stream-json events as the lines of claude.log: its text, each tool
# call and the start of each result. A line that is not an event (an error on
# stderr) is kept as it is.
RENDER='
  def short: tostring | gsub("\n"; " ") | if length > 300 then .[0:300] + "..." else . end;
  . as $line | try (
    fromjson
    | if type != "object" then $line
      elif .type == "assistant" then .message.content[]
        | if .type == "text" then .text
          elif .type == "tool_use" then "> \(.name) \(.input | .command // .file_path // .pattern // .url // .description // . | short)"
          else empty end
      elif .type == "user" then .message.content[]? | select(type == "object" and .type == "tool_result")
        | "< " + (.content | if type == "array" then map(.text? // "") | join(" ") else . end | short)
      elif .type == "result" then "= \(.subtype // "result")\(if .result then ": " + .result else "" end)"
      elif .type == "system" then "= \(.subtype // "system")"
      else empty end
  ) catch $line'

# Runs the model with the watchdog beside it. A run dir with an issue is an
# issue's run: the model gets LOOPER_RUN (for its --checkpoint) and the
# watchdog also ends it once the issue is done.
run_claude() { # prompt-file log-file seconds run-dir [issue head-before]
  local rc=0 dir pid fmt watcher k
  dir="$(mktemp -d)"; mkfifo "$dir/out"
  jq -R -r --unbuffered "$RENDER" < "$dir/out" > "$2" & fmt=$!
  ( cd "$CHECKOUT" && LOOPER_RUN="${5:+$4}" exec timeout -k 30 "$3" claude --print --verbose --output-format stream-json \
      --model "$MODEL" --permission-mode acceptEdits \
      --allowedTools "Bash,Read,Edit,Write,Grep,Glob,Task,Agent,TodoWrite,WebFetch,WebSearch" \
      < "$1" > "$dir/out" 2>&1 ) & pid=$!
  watch_run "$pid" "$2" "$4" "${5:-}" "${6:-}" & watcher=$!
  wait "$pid" || rc=$?
  kill "$watcher" 2>/dev/null; wait "$watcher" 2>/dev/null || true
  # The log is complete when the model's output closes; a process the model
  # left holding that output does not hold the run.
  ( sleep 10; kill "$fmt" 2>/dev/null ) & k=$!
  wait "$fmt" 2>/dev/null || true
  kill "$k" 2>/dev/null; wait "$k" 2>/dev/null || true
  rm -rf "$dir"
  return "$rc"
}

# The issue's run is done: the issue is closed, or the fix is pushed (main
# moved) and the run wrote its Blocked-by outcome.
run_done() { # issue run-dir head-before
  if [[ -f "$2/outcome" ]] && grep -qi '^[[:space:]]*blocked-by:' "$2/outcome" && \
     [[ "$(git -C "$CHECKOUT" ls-remote origin refs/heads/main | cut -f1)" != "$3" ]]; then return 0; fi
  [[ "$(gh issue view "$1" --repo "$LOOPER_ORG/$REPO" --json state --jq .state 2>/dev/null)" == CLOSED ]]
}

# The watchdog, every LOOPER_WATCH_INTERVAL until killed: stops the model when
# it went idle (no output and nothing changed in the checkout for
# LOOPER_IDLE_MINUTES) or when its issue's run is done and it has not exited
# LOOPER_DONE_GRACE seconds later. Writes why to the run's `stopped` file.
watch_run() { # pid log run-dir [issue head-before]
  local pid="$1" run="$3" n="${4:-}" size=-1 s now done_at="" z=""
  trap 'kill "$z" 2>/dev/null; exit 0' TERM
  touch "$run/.active"
  while :; do
    sleep "$WATCH_INTERVAL" & z=$!; wait "$z"
    now="$(date +%s)"; s="$(stat -c %s "$2" 2>/dev/null || echo 0)"
    if [[ "$s" != "$size" || -n "$(find "$CHECKOUT" -newer "$run/.active" -print -quit 2>/dev/null)" ]]; then
      size="$s"; touch "$run/.active"
    elif (( now - $(stat -c %Y "$run/.active") >= IDLE )); then
      echo idle > "$run/stopped"; kill -TERM "$pid" 2>/dev/null; exit 0
    fi
    if [[ -n "$n" ]] && run_done "$n" "$run" "$5"; then
      done_at="${done_at:-$now}"
      if (( now - done_at >= DONE_GRACE )); then echo "done" > "$run/stopped"; kill -TERM "$pid" 2>/dev/null; exit 0; fi
    fi
  done
}

# Known secrets out of text that leaves the job (a branch, an issue comment):
# the job's tokens by value, and anything shaped like a GitHub, GitLab or
# Anthropic token.
redact() {
  local t v; t="$(cat)"
  for v in "${GH_TOKEN:-}" "${GITHUB_TOKEN:-}" "${GITLAB_TOKEN:-}" "${CLAUDE_CODE_OAUTH_TOKEN:-}" "${ANTHROPIC_API_KEY:-}"; do
    if (( ${#v} >= 8 )); then t="${t//"$v"/[redacted]}"; fi
  done
  printf '%s\n' "$t" | sed -E 's/(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|glpat-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,})/[redacted]/g'
}

# The end of a run's log, for an issue comment.
log_tail() { # run-dir lines
  printf '~~~~~~\n%s\n~~~~~~\n' "$(tail -n "$2" "$1/claude.log" 2>/dev/null | redact)"
}

# Where a person finds a run's record: the job and its artifact when this is a
# GitLab job, the path on this host otherwise.
run_record() { # run-dir
  if [[ -n "${CI_JOB_URL:-}" ]]; then
    local rel="${1#"${CI_PROJECT_DIR:-}"/}"
    if [[ -n "${CI_PROJECT_DIR:-}" && "$rel" != "$1" ]]; then
      echo "job $CI_JOB_URL, artifact \`$rel/claude.log\` ($CI_JOB_URL/artifacts/browse/$rel/)"
    else
      echo "job $CI_JOB_URL"
    fi
  else
    echo "\`$1/claude.log\` on $(hostname)"
  fi
}

# An issue's work in progress lives on this branch of origin, never on main.
wip_branch() { echo "looper/$REPO-$1"; } # issue
wip_on_origin() { [[ -n "$(git -C "$CHECKOUT" ls-remote origin "refs/heads/$(wip_branch "$1")")" ]]; } # issue
wip_url() { echo "https://github.com/$LOOPER_ORG/$REPO/tree/$(wip_branch "$1")"; } # issue

# Pushes everything in the checkout (local commits, staged and unstaged changes,
# new files) as one commit on HEAD to the issue's branch, through a scratch index:
# the checkout's branch, index and files stay as they are, and it fetches
# nothing (the model's own git commands run in the same checkout). With a run
# dir, the run's record rides along under .looper/ (prompt.md, the claude.log
# tail, secrets redacted), so a run killed outright still leaves its log behind.
# Pushes nothing when there is nothing to keep (no record and the checkout's
# tree is main's) or nothing new since the last checkpoint. A failed checkpoint
# is logged, never fatal.
checkpoint() { # issue why [run-dir]
  local n="$1" why="$2" run="${3:-}" step="" b; b="$(wip_branch "$n")"
  [[ -n "$run" && -s "$run/step" ]] && step="$(cat "$run/step")"
  mkdir -p "$WORK"
  ( flock 9
    cd "$CHECKOUT"
    idx="$(mktemp)"; trap 'rm -f "$idx"' EXIT
    cp "$(git rev-parse --git-path index)" "$idx" 2>/dev/null || true
    GIT_INDEX_FILE="$idx" git add -A
    if [[ -n "$run" && -f "$run/prompt.md" ]]; then
      p="$(redact < "$run/prompt.md" | git hash-object -w --stdin)"
      l="$(tail -n "$RECORD_LINES" "$run/claude.log" 2>/dev/null | redact | git hash-object -w --stdin)"
      GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$p,.looper/prompt.md" --cacheinfo "100644,$l,.looper/claude.log"
    else
      [[ "$(GIT_INDEX_FILE="$idx" git write-tree)" != "$(git rev-parse 'origin/main^{tree}')" ]] || exit 0
    fi
    tree="$(GIT_INDEX_FILE="$idx" git write-tree)"; head="$(git rev-parse HEAD)"
    last="$(git rev-parse -q --verify "refs/looper/$b" || true)"
    [[ -z "$last" || "$tree" != "$(git rev-parse "$last^{tree}")" || "$head" != "$(git rev-parse "$last^")" ]] || exit 0
    c="$(git commit-tree "$tree" -p "$head" -m "looper: work in progress on #$n ($why)" ${step:+-m "$step"})"
    prev="$(git ls-remote origin "refs/heads/$b" | cut -f1)"
    git push -q --force-with-lease="refs/heads/$b:$prev" origin "$c:refs/heads/$b"
    git update-ref "refs/looper/$b" "$c"
    log "checkpoint of #$n ($why) pushed to $b: $(git diff --shortstat origin/main "$c")"
  ) 9>"$WORK/.checkpoint.lock" || log "checkpoint of #$n ($why) failed"
}

# Checkpoints every LOOPER_CHECKPOINT_INTERVAL until killed.
checkpoint_ticker() { # issue run-dir
  local s=""
  trap 'kill "$s" 2>/dev/null; exit 0' TERM
  while :; do
    sleep "$CHECKPOINT_INTERVAL" & s=$!; wait "$s"
    checkpoint "$1" hourly "$2"
  done
}

# The work landed on main: its branch goes.
drop_wip() { # issue
  local b; b="$(wip_branch "$1")"
  if wip_on_origin "$1"; then git -C "$CHECKOUT" push -q origin --delete "$b" || log "could not delete $b"; fi
  git -C "$CHECKOUT" update-ref -d "refs/looper/$b" 2>/dev/null || true
}

# Starts the run from the issue's branch when it exists, its work as
# uncommitted changes on main (tacplus-dev/looper#9): the branch rebased on
# main; else, with no history rewritten, main merged into it; else that merge
# with its conflicts marked in the files, whose paths the prompt names to
# resolve first. Only when even the merge cannot be made does the run start
# from bare main. Prints what the prompt says about it.
resume() { # issue
  local n="$1" b msg how conflicts; b="$(wip_branch "$n")"
  wip_on_origin "$n" || return 0
  git -C "$CHECKOUT" fetch -q origin "+refs/heads/$b:refs/remotes/origin/$b"
  msg="$(git -C "$CHECKOUT" log -1 --format=%B "origin/$b")"
  if git -C "$CHECKOUT" checkout -q --detach "origin/$b" && git -C "$CHECKOUT" rebase -q origin/main >/dev/null 2>&1; then
    how=rebased
  else
    git -C "$CHECKOUT" rebase --abort >/dev/null 2>&1 || true
    git -C "$CHECKOUT" checkout -q -f --detach "origin/$b" 2>/dev/null || true
    if git -C "$CHECKOUT" merge -q --no-edit -m "looper: main merged into $b" origin/main >/dev/null 2>&1; then
      how=merged
    elif conflicts="$(git -C "$CHECKOUT" diff --name-only --diff-filter=U)" && [[ -n "$conflicts" ]] \
        && git -C "$CHECKOUT" add -A && git -C "$CHECKOUT" commit -q --no-verify -m "looper: main merged into $b, with conflicts"; then
      how=conflicted
    else
      git -C "$CHECKOUT" merge --abort >/dev/null 2>&1 || true
      git -C "$CHECKOUT" checkout -q -f main && git -C "$CHECKOUT" reset -q --hard origin/main
      log "#$n: $b neither rebases on nor merges with main; starting from main" >&2
      printf 'A previous run left work in progress on the branch `%s`, but it neither rebases on nor merges with main:\nyour checkout is main. Bring that work over by hand (`git diff origin/main...origin/%s`) where it still applies.' "$b" "$b"
      printf '\nIts last checkpoint:\n\n%s\n' "$msg"
      return 0
    fi
  fi
  git -C "$CHECKOUT" checkout -q -B main "$(git -C "$CHECKOUT" rev-parse HEAD)"
  git -C "$CHECKOUT" reset -q --mixed origin/main
  # The run record is not work: it stays on the branch.
  git -C "$CHECKOUT" clean -fdq -- .looper || true
  git -C "$CHECKOUT" checkout -q -- .looper 2>/dev/null || true
  case "$how" in
    rebased)
      log "resuming #$n from $b" >&2
      printf 'A previous run left work in progress on the branch `%s`. It is in your checkout, rebased on main, as\nuncommitted changes: check it, finish the issue, and commit it on main as rule 5 says.' "$b" ;;
    merged)
      log "resuming #$n from $b (merged with main)" >&2
      printf 'A previous run left work in progress on the branch `%s`. It does not rebase on main, so it is in your\ncheckout with main merged into it, as uncommitted changes: check it, finish the issue, and commit it on\nmain as rule 5 says.' "$b" ;;
    conflicted)
      log "resuming #$n from $b (merged with main, conflicts in: $(echo $conflicts))" >&2
      printf 'A previous run left work in progress on the branch `%s`. Its merge with main conflicts with main, so it\nis in your checkout with main merged into it and the conflicts marked in the files (<<<<<<< the branch,\n>>>>>>> main), as uncommitted changes. Resolve these first, then finish the issue and commit it on main\nas rule 5 says:\n\n' "$b"
      sed 's/.*/- `&`/' <<<"$conflicts" ;;
  esac
  printf '\nIts last checkpoint:\n\n%s\n' "$msg"
}

# The fix is pushed and only the gates wait: the run's outcome file names one
# open issue as `Blocked-by:`. Adds that line to the issue's body (once) and
# prints it; fails when the outcome is anything else.
gates_blocked() { # issue run-dir head-before head-after
  local n="$1" ref r b state body line
  [[ "$3" != "$4" && -f "$2/outcome" ]] || return 1
  ref="$(parse_blockers "$REPO" < "$2/outcome" | head -n 1)" || return 1
  read -r r b <<<"$ref"; [[ -n "${b:-}" ]] || return 1
  state="$(gh issue view "$b" --repo "$LOOPER_ORG/$r" --json state --jq .state)" || return 1
  [[ "$state" == OPEN ]] || return 1
  if [[ "$r" == "$REPO" ]]; then line="Blocked-by: #$b"; else line="Blocked-by: $LOOPER_ORG/$r#$b"; fi
  body="$(gh issue view "$n" --repo "$LOOPER_ORG/$REPO" --json body --jq .body)" || return 1
  if ! parse_blockers "$REPO" <<<"$body" | grep -qx "$r $b"; then
    gh issue edit "$n" --repo "$LOOPER_ORG/$REPO" --body "$body

$line" >/dev/null || return 1
  fi
  echo "$line"
}

# The issue flow (looper#14): the issue's kind from its labels, `feature` when
# it has both; nothing when it has neither (or they cannot be read).
issue_kind() { # issue
  local l; l="$(gh issue view "$1" --repo "$LOOPER_ORG/$REPO" --json labels --jq '.labels[].name')" || return 0
  if grep -qx "$LABEL_FEATURE" <<<"$l"; then echo "$LABEL_FEATURE"
  elif grep -qx "$LABEL_BUG" <<<"$l"; then echo "$LABEL_BUG"; fi
}

# A feature is built only when a ROADMAP.md links it: this repository's (a
# bare #N counts) or the platform's (tacplus-dev/roadmap). 0: linked; 1: not;
# 2: the platform's cannot be read.
on_roadmap() { # issue
  if [[ -f "$CHECKOUT/ROADMAP.md" ]] && links_issue "$REPO" "$1" own < "$CHECKOUT/ROADMAP.md"; then return 0; fi
  local p; p="$(platform_file ROADMAP.md)" || return 2
  links_issue "$REPO" "$1" <<<"$p" || return 1
}

# Ends the issue's run without working it: the label, and a comment saying why.
hold() { # issue label why
  gh issue edit "$1" --repo "$LOOPER_ORG/$REPO" --remove-label "$LABEL_IN_PROGRESS" --add-label "$2" >/dev/null || true
  gh issue comment "$1" --repo "$LOOPER_ORG/$REPO" --body "$3" >/dev/null || true
  log "#$1 held ($2)"
}

# An unlabelled issue: the model classifies it, in a comment and a label, and
# does nothing else. Its record is the run's classify/.
classify() { # issue run-dir limit
  local n="$1" dir="$2/classify"; mkdir -p "$dir"
  cat > "$dir/prompt.md" <<PR
You are the looper of $LOOPER_ORG/$REPO, classifying issue #$n before it is worked.
Change no file and push nothing. Read it: \`gh issue view $n --repo $LOOPER_ORG/$REPO --comments\`. Every issue
is a bug or a feature ($ISSUE_FLOW):
- **bug:** the code does not do what it already promises: a defect, a vulnerability, a broken gate, a stale pin.
- **feature:** new behaviour, new surface, a changed contract.
Comment on the issue which it is and why, in a sentence or two (\`Classified as **bug**: ...\`), then label it:
\`gh issue edit $n --repo $LOOPER_ORG/$REPO --add-label $LABEL_BUG\` (or \`$LABEL_FEATURE\`). Nothing else: the looper
works it by that label.
PR
  run_claude "$dir/prompt.md" "$dir/claude.log" "$(( $3 < 1800 ? $3 : 1800 ))" "$dir" || log "classifying #$n exited non-zero"
}

# A feature that no ROADMAP.md links is not built: the model proposes its
# design, on the issue and in PROPOSALS.md, and the issue waits on a decision.
propose() { # issue run-dir limit
  local n="$1" run="$2"
  cat > "$run/prompt.md" <<PR
You are the looper of $LOOPER_ORG/$REPO, proposing a design for issue #$n. Your working directory is this
repository's checkout on main, at origin/main. Read the issue: \`gh issue view $n --repo $LOOPER_ORG/$REPO --comments\`,
and the documents it cites.

It is a feature, and no ROADMAP.md links it (neither this repository's nor tacplus-dev/roadmap's), so it is not
built ($ISSUE_FLOW): a feature needs design, Jody's approval and a ROADMAP.md entry first. Do not build it.
1. Comment on the issue with a design proposal: what and why, the approach and the alternatives, the surface or
   contract it changes, the risks, its size, and the questions Jody must answer.
2. Add it to PROPOSALS.md, in that file's format (what, why, links: this issue). Commit only PROPOSALS.md on
   main, with a message ending with \`Co-Authored-By: Claude <noreply@anthropic.com>\`, then
   \`git pull --rebase origin main\` and \`git push origin main\`. Change no other file; never ROADMAP.md.
The looper labels the issue $LABEL_DECISION when you are done.
PR
  run_claude "$run/prompt.md" "$run/claude.log" "$(( $3 < 3600 ? $3 : 3600 ))" "$run" || log "proposing #$n exited non-zero"
  hold "$n" "$LABEL_DECISION" "This is a \`$LABEL_FEATURE\` that no ROADMAP.md links (\`$LOOPER_ORG/$REPO:ROADMAP.md\`, \`$LOOPER_ORG/roadmap:ROADMAP.md\`), so it is not built ($ISSUE_FLOW): its design proposal is on this issue and in PROPOSALS.md. Once Jody approves the design and an agent adds it to a ROADMAP.md, linking this issue, remove \`$LABEL_DECISION\` and the looper builds it. Run record: $(run_record "$run")."
}

# The newest release on main (a vX.Y.Z tag main contains), or nothing.
main_release() {
  git -C "$CHECKOUT" fetch -q --tags origin 2>/dev/null || true
  git -C "$CHECKOUT" tag --merged origin/main -l 'v*' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -n 1 || true
}

# The prompt's rule 7, by the issue's kind.
kind_rule() { # kind
  if [[ "$1" == "$LABEL_FEATURE" ]]; then
    printf '%s\n' "7. This issue is a feature on a ROADMAP.md ($ISSUE_FLOW): it ships in the next minor release," \
      "   from main only: no backport, and no patch release."
    return 0
  fi
  local v; v="$(main_release)"
  printf '%s\n' "7. This issue is a bug ($ISSUE_FLOW; tacplus-dev/tacplus docs/VERSIONING.md): fix it, and ship the" \
    "   fix as a patch release on every supported release line that has it."
  if [[ -n "$v" ]]; then
    local x="${v#v}"
    printf '%s\n' "   Release the patch on main: once the fix is pushed and its gates pass, tag \`v${x%.*}.$(( ${x##*.} + 1 ))\` at it" \
      "   (this repository's newest release on main is \`$v\`) and push the tag, the way the repository releases (its" \
      "   release workflow, justfile or CONTRIBUTING). If main has taken features since \`$v\` (they belong to the next" \
      "   minor), do not cut the patch from main: it goes to release/${x%.*} as a backport, below."
  else
    echo "   This repository has no release on main yet (no vX.Y.Z tag): there is no patch to release."
  fi
  printf '%s\n' "   A repository with release/MAJOR.MINOR branches: the fix is also backported as a pull request against each" \
    "   release branch whose .0 tag is under twelve months old (never pushed to one directly), whose description" \
    "   names the patch tag to cut on that branch once it merges."
}

# What every prompt that may open an issue says about opening one.
opening_rule() { # [its number in the prompt]
  cat <<EOF
${1:+$1 }Before you open any issue (a follow-up, say), read this repository's ROADMAP.md and the platform's: tacplus-dev/roadmap's
   ROADMAP.md and items/ (\`gh api repos/$LOOPER_ORG/roadmap/contents/ROADMAP.md -H 'Accept: application/vnd.github.raw'\`).
   A feature already on a roadmap gets no new feature issue: open one, labelled \`$LABEL_FEATURE\`, asking for that
   entry to be prioritized, linking it and saying why now. Any other issue is labelled \`$LABEL_BUG\` (the code does
   not do what it already promises) or \`$LABEL_FEATURE\` (new behaviour), and a feature is never \`$LABEL_APPROVED\`: it
   needs design, Jody's approval and a ROADMAP.md entry, and it goes into PROPOSALS.md ($ISSUE_FLOW).
EOF
}

work_issue() { # issue
  local n="$1" run head_before head_after limit resumed last_comment
  run="$RUNS/$(date -u +%Y%m%dT%H%M%SZ)-issue-$n"; mkdir -p "$run"
  log "taking $LOOPER_ORG/$REPO#$n ($run)"
  gh issue edit "$n" --repo "$LOOPER_ORG/$REPO" --add-label "$LABEL_IN_PROGRESS" >/dev/null
  sync_checkout
  land "Planning files from the template (looper; tacplus-dev/roadmap decisions/repo-roadmap-files-2026-10-27.md)" add_planning_files
  sync_checkout
  local tags_before; tags_before="$(release_tags)"
  head_before="$(git -C "$CHECKOUT" rev-parse origin/main)"
  limit="$(run_limit "$n")"
  # Bug or feature (looper#14): an unlabelled issue is classified first; a
  # feature no ROADMAP.md links is proposed, never built.
  ensure_kind_labels "$REPO"
  local kind; kind="$(issue_kind "$n")"
  if [[ -z "$kind" ]]; then classify "$n" "$run" "$limit"; kind="$(issue_kind "$n")"; fi
  if [[ -z "$kind" ]]; then
    hold "$n" "$LABEL_DECISION" "This issue is labelled neither \`$LABEL_BUG\` nor \`$LABEL_FEATURE\`, and the looper could not classify it ($ISSUE_FLOW). A person labels it \`$LABEL_BUG\` or \`$LABEL_FEATURE\` and removes \`$LABEL_DECISION\`. Run record: $(run_record "$run")."
    return 0
  fi
  if [[ "$kind" == "$LABEL_FEATURE" ]]; then
    local on=0; on_roadmap "$n" || on=$?
    case "$on" in
      0) ;;
      1) propose "$n" "$run" "$limit"; return 0 ;;
      *) hold "$n" "$LABEL_STUCK" "The looper could not read \`$LOOPER_ORG/roadmap:ROADMAP.md\`, so it cannot tell whether this feature is on a roadmap ($ISSUE_FLOW): it is neither built nor proposed. Marked $LABEL_STUCK for a person to look at."
         return 0 ;;
    esac
  fi
  resumed="$(resume "$n")"
  if [[ -n "$resumed" ]]; then
    last_comment="$(gh issue view "$n" --repo "$LOOPER_ORG/$REPO" --json comments --jq '.comments[-1].body // ""')" || true
    if [[ -n "$last_comment" ]]; then resumed="$resumed

The issue's last comment:

$last_comment"; fi
    resumed="
$resumed
"
  fi
  cat > "$run/prompt.md" <<PR
You are the looper of $LOOPER_ORG/$REPO, working issue #$n. Your working directory is this repository's
checkout on main, at origin/main. Read the issue first: \`gh issue view $n --repo $LOOPER_ORG/$REPO --comments\`.
It was approved by someone with write access; issues it links to and the documents it cites (decision
records, IDENTITY.md, CONTRIBUTING, docs/) are your context. Read them before changing anything.
$resumed
Rules:
1. Do what the issue asks, completely: its acceptance criteria are the definition of done. If it asks for
   something you believe is wrong, or needs a decision you may not make (a public contract the issue does
   not settle, a change in another repository), comment on the issue with the question and your
   recommendation, add the label $LABEL_DECISION, and stop without committing.
2. Tests first where the change has behaviour: write the test that fails, then make it pass. Surgical
   changes, the existing style, no hacks. Generated code is never edited by hand: change the generator or
   the proto and regenerate. \`tacplus\` in this container runs the compiler image for this repository's
   MAJOR.MINOR floor (tacplus.yaml), always its latest patch.
3. You may use sub-agents (the Task/Agent tool) for independent parts, in this same checkout. They do not
   commit or push; you do.
4. Verify with $(gates_hint). Long builds: start them detached (\`nohup ... > /tmp/x.log 2>&1 &\`) and
   poll with short checks; never end your reply while one runs. You run non-interactively: ending your
   reply ends the run.
5. Commit on main with a message that says why and ends with
   \`Co-Authored-By: Claude <noreply@anthropic.com>\`, then \`git pull --rebase origin main\`, re-run the
   gates if the rebase brought changes, and \`git push origin main\`. If the push is rejected, rebase and
   verify again. Never force-push. Never commit secrets.
6. The planning files: update STATE.md when your change changes what it states (version, what works,
   gaps, blockers). Put the follow-ups, debt and ideas you find in PROPOSALS.md (what, why, links), not
   only in comments. Never edit ROADMAP.md: it is Jody's, changed only by an agent at his request, and a
   push of a commit that touches it is refused. HISTORY.md is append-only and not yours: the looper adds
   the line for this issue and for any release.
$(kind_rule "$kind")
8. When it is pushed, comment on the issue with what changed (commit hashes), the gates you ran and their
   last lines, and anything you could not verify; then, as your last step (any patch tagged and any backport
   pull requests open by then), close it: \`gh issue close $n --repo $LOOPER_ORG/$REPO\`. Closing it ends your run.
9. If the fix is pushed but the gates cannot run until another open issue is done (a compiler floor that
   does not exist yet, say), do not close this issue: comment what you pushed and why the gates wait, and
   write the one line \`Blocked-by: #N\` (this repository) or \`Blocked-by: $LOOPER_ORG/<repo>#N\` to
   $run/outcome as your last step: with the fix pushed, that ends your run. The looper adds it to the issue,
   which is worked again for the gates once #N is closed.
10. Your time limit is $(hours "$limit"); you are stopped $(( STOP_EARLY / 60 )) minutes before it. Whenever you finish a step,
   checkpoint it: \`$LOOPER_SELF --repo $REPO --issue $n --checkpoint "<what is done; what is left>"\`.
   It pushes everything in the checkout, committed or not, to the branch $(wip_branch "$n") (never main) and
   changes nothing in the checkout; the looper also checkpoints hourly and when you stop. If the time runs
   out, the next run resumes from that branch with your last checkpoint's message, so make it say what is
   done and what is left. Do not push to that branch yourself: your work lands on main as rule 5 says.
$(opening_rule 11.)
PR
  local rc=0 ticker
  checkpoint_ticker "$n" "$run" & ticker=$!
  run_claude "$run/prompt.md" "$run/claude.log" "$(( limit > STOP_EARLY ? limit - STOP_EARLY : limit ))" "$run" "$n" "$head_before" || rc=$?
  kill "$ticker" 2>/dev/null; wait "$ticker" 2>/dev/null || true
  local stopped=""; [[ -s "$run/stopped" ]] && stopped="$(cat "$run/stopped")"
  case "$stopped:$rc" in
    done:*) log "claude stopped on #$n: its run was done and it had not exited ${DONE_GRACE}s later" ;;
    idle:*) log "claude stopped on #$n: idle (no output, no change) for ${LOOPER_IDLE_MINUTES:-20} minutes" ;;
    :0) log "claude finished #$n" ;;
    :124|:137) log "claude stopped on #$n: the time limit ($(hours "$limit"))" ;;
    *) log "claude exited $rc on #$n" ;;
  esac
  git -C "$CHECKOUT" fetch -q origin
  head_after="$(git -C "$CHECKOUT" rev-parse origin/main)"
  gh issue edit "$n" --repo "$LOOPER_ORG/$REPO" --remove-label "$LABEL_IN_PROGRESS" >/dev/null || true
  local state labels
  state="$(gh issue view "$n" --repo "$LOOPER_ORG/$REPO" --json state --jq .state)"
  labels="$(gh issue view "$n" --repo "$LOOPER_ORG/$REPO" --json labels --jq '.labels[].name')"
  # HISTORY.md: a line for the closed issue (with the run's last commit on
  # main, if it pushed) and one for each release the run made.
  local lines=() title t
  if [[ "$state" == CLOSED ]]; then
    title="$(gh issue view "$n" --repo "$LOOPER_ORG/$REPO" --json title --jq .title)" || title=""
    t=""; [[ "$head_after" != "$head_before" ]] && t=", $(git -C "$CHECKOUT" rev-parse --short "$head_after")"
    lines+=("- $(date -u +%F) looper issue $title (#$n$t)")
  fi
  for t in $(release_tags | grep -vxF -f <(printf '%s\n' "$tags_before") || true); do
    lines+=("- $(date -u +%F) looper release $t (https://github.com/$LOOPER_ORG/$REPO/releases/tag/$t)")
  done
  if (( ${#lines[@]} )); then land "HISTORY.md: #$n (looper)" append_history "${lines[@]}"; fi
  if [[ "$state" == CLOSED ]]; then drop_wip "$n"; log "#$n done (main $head_before..$head_after)"; return 0; fi
  local blocked
  if blocked="$(gates_blocked "$n" "$run" "$head_before" "$head_after")"; then
    drop_wip "$n"
    gh issue comment "$n" --repo "$LOOPER_ORG/$REPO" \
      --body "The fix is pushed (main $head_before..$head_after); the gates wait, so this issue is now \`$blocked\` and stays $LABEL_APPROVED: it is worked again for the gates once that issue is closed. Run record: $(run_record "$run")." >/dev/null || true
    log "#$n pushed, gates wait ($blocked)"; return 0
  fi
  # Not landed: whatever the run leaves is kept on the issue's branch.
  local timed_out="" why="the run's end"
  if [[ "$stopped" == idle ]]; then why="the run went idle"
  elif [[ "$rc" == 124 || "$rc" == 137 ]]; then timed_out=1; why="the time limit"; fi
  checkpoint "$n" "$why" "$run"
  local wip="" b; b="$(wip_branch "$n")"
  wip_on_origin "$n" && wip="[\`$b\`]($(wip_url "$n"))"
  if grep -qx "$LABEL_DECISION" <<<"$labels"; then log "#$n waits on a decision"; return 0; fi
  if [[ -n "$timed_out" ]]; then
    local done_left where="It left no changes."
    [[ -n "$wip" ]] && where="Its work in progress is on $wip."
    if [[ -s "$run/step" ]]; then done_left="Its last checkpoint (what is done, what is left):

$(sed 's/^/> /' "$run/step")"
    else done_left="It checkpointed no step, so what is done is only what the branch holds."; fi
    gh issue comment "$n" --repo "$LOOPER_ORG/$REPO" --body "The run reached its time limit ($(hours "$limit")) before finishing. $where

$done_left

This issue stays $LABEL_APPROVED: the next run resumes from that branch. A line \`Timeout: <hours>h\` in the body (at most 10h) gives a run more time. Run record: $(run_record "$run")." >/dev/null || true
    log "#$n reached its time limit; it resumes on the next pass"; return 0
  fi
  tail -n 40 "$run/claude.log" || true
  local ended="The looper ended without finishing this issue."
  [[ "$stopped" == idle ]] && ended="The run went idle: no output and no change in its checkout for ${LOOPER_IDLE_MINUTES:-20} minutes, so the looper stopped it."
  gh issue comment "$n" --repo "$LOOPER_ORG/$REPO" \
    --body "$ended ${wip:+Its work in progress is on $wip. }Run record: $(run_record "$run"). Marked $LABEL_STUCK for a person to look at.

The end of its log:

$(log_tail "$run" 40)" >/dev/null || true
  gh issue edit "$n" --repo "$LOOPER_ORG/$REPO" --add-label "$LABEL_STUCK" >/dev/null || true
  return 0
}

# After the scan, the issues it filed (numbered after the newest before it):
# a finding is a bug, so one with no kind gets `bug`; a feature is never
# approved by a scan, so `approved` comes off one (looper#14).
scan_labels() { # the newest issue number before the scan
  local n l
  gh issue list --repo "$LOOPER_ORG/$REPO" --state open --limit 100 --json number,labels \
    --jq ".[] | select(.number > $1) | \"\\(.number) \\([.labels[].name] | join(\",\"))\"" \
  | while read -r n l; do
      l=",$l,"
      if [[ "$l" == *",$LABEL_FEATURE,"* ]]; then
        [[ "$l" == *",$LABEL_APPROVED,"* ]] || continue
        gh issue edit "$n" --repo "$LOOPER_ORG/$REPO" --remove-label "$LABEL_APPROVED" >/dev/null || continue
        gh issue comment "$n" --repo "$LOOPER_ORG/$REPO" --body "A scan never approves a \`$LABEL_FEATURE\` ($ISSUE_FLOW): it needs design, Jody's approval and a ROADMAP.md entry first, so \`$LABEL_APPROVED\` is removed." >/dev/null || true
        log "scan: #$n is a feature; not approved"
      elif [[ "$l" != *",$LABEL_BUG,"* ]]; then
        gh issue edit "$n" --repo "$LOOPER_ORG/$REPO" --add-label "$LABEL_BUG" >/dev/null && log "scan: #$n labelled $LABEL_BUG"
      fi
    done
}

scan() {
  local run before; run="$RUNS/$(date -u +%Y%m%dT%H%M%SZ)-scan"; mkdir -p "$run"
  sync_checkout
  ensure_kind_labels "$REPO"
  before="$(gh issue list --repo "$LOOPER_ORG/$REPO" --state all --limit 1 --json number --jq '.[0].number // 0')" || before=""
  cat > "$run/prompt.md" <<PR
You are the nightly scanner of $LOOPER_ORG/$REPO. Your working directory is its checkout at origin/main.
Change no code. Find, in order:
1. Known vulnerabilities in dependencies (the ecosystem's own auditor where it applies: cargo audit,
   npm audit, govulncheck, pip-audit, the Maven/Gradle dependency tree against advisories).
2. The repository's own gates failing on main ($(gates_hint)).
3. Pins that break the project's rule: a tacplus floor or base image that is not the latest released
   MAJOR.MINOR line it should follow.
For each finding, first check the open issues (\`gh issue list --repo $LOOPER_ORG/$REPO\`) and skip one already
filed. Each finding is a bug ($ISSUE_FLOW): file each new one as one issue labelled \`$LABEL_BUG\`, with a title, the
evidence (command and output), the fix you recommend and acceptance criteria. Label it \`$LABEL_APPROVED\` too when the
fix is mechanical and safe (a patched dependency version, a gate fix with an obvious cause); otherwise
\`$LABEL_DECISION\`. If nothing is found, file nothing.
An idea for new behaviour you come across is a feature, never \`$LABEL_APPROVED\`: add it to PROPOSALS.md (what, why,
links), the one file you may change: commit only it on main, with a message ending with
\`Co-Authored-By: Claude <noreply@anthropic.com>\`, then \`git pull --rebase origin main\` and \`git push origin main\`.
$(opening_rule)
PR
  run_claude "$run/prompt.md" "$run/claude.log" "$TIMEOUT" "$run" || log "scan exited non-zero"
  [[ -n "$before" ]] && scan_labels "$before"
  log "scan of $REPO finished"
}

case "$MODE" in
  checkpoint)
    # The model's step: what is done and what is left becomes the message of
    # every checkpoint after it.
    [[ -n "${LOOPER_RUN:-}" ]] && printf '%s\n' "$STEP" > "$LOOPER_RUN/step"
    checkpoint "$ISSUE" "a step" "${LOOPER_RUN:-}" ;;
  scan) scan ;;
  one)
    gh issue view "$ISSUE" --repo "$LOOPER_ORG/$REPO" --json labels --jq '.labels[].name' | grep -qx "$LABEL_APPROVED" \
      || die "#$ISSUE is not labeled $LABEL_APPROVED"
    # A job planned for an issue another run took or finished meanwhile takes
    # the oldest ready issue at run time instead (looper#16).
    if ! { approved_issues "$REPO" | grep -qx "$ISSUE" && ready "$REPO" "$ISSUE"; }; then
      if orphaned "$ISSUE"; then
        log "#$ISSUE is $LABEL_IN_PROGRESS, but no other looper job of $REPO is active: its run is gone; this job resumes it"
        work_issue "$ISSUE"; exit 0
      fi
      n="$(next_ready "$REPO")"
      [[ -n "$n" ]] || { log "#$ISSUE is no longer ready, nor is any other issue; nothing to do"; exit 0; }
      log "#$ISSUE is no longer ready; working #$n, the oldest ready issue"; ISSUE="$n"
    fi
    work_issue "$ISSUE" ;;
  drain)
    # One pass over each issue per run: if a label write ever fails, the same
    # issue must not be taken again and again.
    seen=" "
    while :; do
      n=""
      for c in $(approved_issues "$REPO"); do
        [[ "$seen" == *" $c "* ]] && continue
        if ready "$REPO" "$c"; then n="$c"; break; fi
      done
      [[ -n "$n" ]] || { log "no ready issue in $REPO; exiting"; break; }
      seen="$seen$n "
      work_issue "$n"
    done ;;
esac
