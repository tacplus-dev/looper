  if (( wrc == 2 )); then ended="The run's outcome names a run to wait on that the looper cannot read as a GitHub Actions run or a GitLab pipeline or job (or the issue's body could not be updated), so it was not taken."
  elif [[ -s "$run/outcome" ]]; then ended="The run's outcome names no open issue it waits on (it names this one, or one that cannot be read), so it was not taken."
  elif [[ "$stopped" != idle ]]; then ended="The looper ended without finishing this issue, and with no progress: nothing landed, and no step checkpointed${resumed:+ beyond the one it resumed from}."; fi
