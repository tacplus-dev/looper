class Unreadable(Exception):
    pass


def run(cmd, stdin=None):
    try:
        p = subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Unreadable(f"{cmd[0]}: {e}") from None
    if p.returncode != 0:
        err = (p.stderr or "").strip()[:200]
        raise Unreadable(f"{cmd[0]} exit {p.returncode}{': ' + err if err else ''}")
    return p.stdout


def gitlab(path, tok=None):
    """A GET of the GitLab API, its body; the token (GITLAB_TOKEN unless given)
    goes on stdin."""
    tok = tok or ENV.get("GITLAB_TOKEN", "")
    if not tok:
        raise Unreadable("no GITLAB_TOKEN")
    api = ENV.get("LOOPER_BUILD_API", "https://gitlab.com/api/v4").rstrip("/")
    try:
        return run(["curl", "-fsS", "--retry", "2", "-H", "@-", f"{api}/{path}"], stdin=f"PRIVATE-TOKEN: {tok}\n")
    except Unreadable as e:
        raise Unreadable(f"GET {path.split('?')[0]}: {e}") from None


def enc(p):
    return p.replace("/", "%2F")


def project_token(project):
    """The token a project's jobs are read with: the build project's own, from
    Secret Manager (LOOPER_RECAP_BUILD_TOKEN_SECRET), else None (GITLAB_TOKEN)."""
    ref = ENV.get("LOOPER_RECAP_BUILD_TOKEN_SECRET", "")
    if project != ENV.get("LOOPER_RECAP_BUILD_PROJECT", "tacplus-dev/build") or not ref:
        return None
    m = re.fullmatch(r"projects/([^/]+)/secrets/([^/]+)/versions/([^/]+)", ref)
    if not m:
        raise Unreadable("LOOPER_RECAP_BUILD_TOKEN_SECRET is not projects/<project>/secrets/<secret>/versions/<version>")
    try:
        tok = run(["gcloud", "secrets", "versions", "access", m.group(3), f"--secret={m.group(2)}", f"--project={m.group(1)}"]).strip()
    except Unreadable as e:
        raise Unreadable(f"the build token ({ref}): {e}") from None
    if not tok:
        raise Unreadable(f"the build token ({ref}): empty")
    return tok


def project_jobs(project, start, until, tok=None):
    """The finished jobs of a project in the window (finished in it), oldest first."""
    jobs, pages = {}, int(num("LOOPER_RECAP_PAGES", 10))
    for page in range(1, pages + 1):
        body = gitlab(f"projects/{enc(project)}/jobs?scope[]=success&scope[]=failed&scope[]=canceled&per_page=100&page={page}", tok)
        try:
            got = json.loads(body)
        except ValueError:
            raise Unreadable(f"the jobs of {project}: not JSON") from None
        if not isinstance(got, list):
            raise Unreadable(f"the jobs of {project}: not a list")
        for j in got:
            f = when(j.get("finished_at"))
            if f is not None and start <= f < until:
                jobs[j["id"]] = j
        created = [when(j.get("created_at")) for j in got]
        # Newest first: a page whose jobs were all created a day before the
        # window (no job runs 11 hours and more) ends it.
        if len(got) < 100 or all(c is not None and c < start - DAY for c in created):
            break
    return [jobs[k] for k in sorted(jobs)]


# --- a job's log --------------------------------------------------------------

LOG_TS = re.compile(r"\[(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)\]")
PULL = re.compile(r"failed to pull image|error pulling image|pull access denied|manifest unknown|toomanyrequests|ErrImagePull|image pull failed", re.I)
PLAN = re.compile(r"plan: plan for (\S+): capacity (\d+) .*; running: (.*)$")
STARTS = re.compile(r"plan: #(\d+) starts\b")
WAITS = re.compile(r"plan: #(\d+) waits: (.*)$")
LANDING = re.compile(r"\[lander\] \[[^]]+\] landing #(\d+) ")
LANDED = re.compile(r"\[lander\] \[[^]]+\] #(\d+): landed on main: .*on the gates (\S+)")
NOT_LANDED = re.compile(r"\[lander\] \[[^]]+\] #(\d+): nothing landed")
DEFERRED = re.compile(r"\[lander\] \[[^]]+\] #(\d+): deferred to the next job")
DISK = re.compile(r"disk at the end: (\d+)% used")
# The plan's line for each job it plans (looper-dispatch plan_job): its resource group.
PLANNED = re.compile(r"\] planned (\S+) \(.*, resource_group (\S+)\)$")


QUEUED = re.compile(r"queued since (\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)")

# The manager's log (looper#70, repo-looper --manage) and the kicker's
# capacity line (looper-dispatch, a pass every LOOPER_INTERVAL), looper#72.
MERGING = re.compile(r"\] merging #(\d+) \(\S+, queued (\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)\)")
M_LANDED = re.compile(r"\] #(\d+): landed on main: ([0-9a-f]+)\.\.([0-9a-f]+), on the gates (\S+)")
M_NOT = re.compile(r"\] #(\d+): not merged \(exit (\d+)\)")
M_RESOLVED = re.compile(r"\] #(\d+): resolved its conflicts by regenerating: (.*)$")
M_DEFERRED = re.compile(r"\] #(\d+): left queued for the next manager")
# A land's build (looper#128): its queue time apart from its run time.
M_BUILD = re.compile(r"\] #(\d+): its build (\S+): queued (\d+) s, (?:(?:ran|running) (\d+) s|not started)")
CAPACITY = re.compile(r"\] capacity: (.*)$")
CAP_REPO = re.compile(r"(\S+) reports=(\d+)(?: running=(\d+))?(?: cap=\d+)? waiting=([\d,]*) landing=(\d+|\?)")


def held_reason(r):
    """A plan's reason an issue waits: its key, and for a conflict what overlaps."""
    if r.startswith("no free slot"):
        return "no_free_slot", None
    if "would outlast this job" in r:
        return "limit_outlasts_job", None
    return "conflict", re.sub(r" \(#\d+, [^()]*\)$", "", re.sub(r"^the plan: ", "", r)).strip()[:300]


# What would have let the work a reason serialized run in parallel, and what
# makes that safe: for the advice (Jody, on looper#57: "much of this can be
# done in parallel").
PARALLEL = {
    "no_free_slot": "more slots: a larger runner or a second job of the repository (each child its own worktree)",
    "limit_outlasts_job": "a fresh job for the issue instead of idling until this one ends",
    "conflict": "file-level conflicts instead of areas, when the issues touch different files of the area",
    "behind_a_land": "parallel lands of disjoint diffs (no file in common), each on its own gate set",
    "scan_holds_repo": "a scan in its own resource group (looper-<repo>, the reports' looper-<repo>-<issue>), or a shorter one",
    "image_stale": "an image build that is not cancelled by newer pushes, or one per push",
}


def read_log(text, started, finished):
    """What a job's log says: its prepare time and VM, a pull or gate failure,
    and for a looper job its plans, holds, lands and disk."""
    out = {"prepare_at": None, "host": None, "pull": False, "gate_fail": False,
           "plans": [], "holds": {}, "overlaps": {}, "lands": [], "deferred": 0, "disk_pct": None, "groups": {}}
    now = started
    waiting = {}   # issue -> (reason, since)
    landing = {}   # issue -> since

    def hold(n, t):
        if n in waiting:
            r, since = waiting.pop(n)
            if since is not None and t is not None:
                out["holds"].setdefault(r, {})
                out["holds"][r][n] = out["holds"][r].get(n, 0) + max(0, secs(since, t))

    def queued(n, line, t):
        # A child's land behind the others' (looper#34): the lander says since when.
        q = QUEUED.search(line)
        if q and when(q.group(1)) is not None and t is not None:
            per = out["holds"].setdefault("behind_a_land", {})
            per[n] = per.get(n, 0) + max(0, secs(when(q.group(1)), t))

    for line in re.split(r"[\r\n]+", text):
        line = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", line)
        m = LOG_TS.search(line)
        if m:
            now = when(m.group(1)) or now
        m = re.search(r"section_start:(\d+):prepare_script", line)
        if m and out["prepare_at"] is None:
            out["prepare_at"] = dt.datetime.fromtimestamp(int(m.group(1)), dt.timezone.utc)
        m = re.search(r"Running on (\S+)", line)
        if m and out["host"] is None:
            out["host"] = m.group(1)
        if PULL.search(line):
            out["pull"] = True
        if "nothing landed: the gates failed" in line or "verdict: FAIL" in line:
            out["gate_fail"] = True
        m = PLAN.search(line)
        if m:
            running = [x for x in m.group(3).split() if x.startswith("#")]
            out["plans"].append({"capacity": int(m.group(2)), "running": len(running)})
            continue
        m = STARTS.search(line)
        if m:
            hold(m.group(1), now)
            if out["plans"]:
                out["plans"][-1]["running"] += 1
            continue
        m = WAITS.search(line)
        if m:
            n, (r, overlap) = m.group(1), held_reason(m.group(2))
            if n in waiting and waiting[n][0] != r:
                hold(n, now)
            waiting.setdefault(n, (r, now))
            out["holds"].setdefault(r, {}).setdefault(n, 0)
            if overlap:
                out["overlaps"].setdefault(overlap, set()).add(int(n))
            continue
        m = LANDING.search(line)
        if m:
            landing[m.group(1)] = now
            queued(m.group(1), line, now)
            continue
        m = LANDED.search(line) or NOT_LANDED.search(line)
        if m:
            since = landing.pop(m.group(1), None)
            if since is not None:
                out["lands"].append({"issue": int(m.group(1)), "set": m.group(2) if m.re is LANDED else None,
                                     "landed": m.re is LANDED, "s": secs(since, now)})
            continue
        m = DEFERRED.search(line)
        if m:
            out["deferred"] += 1
            queued(m.group(1), line, now)
            continue
        m = DISK.search(line)
        if m:
            out["disk_pct"] = int(m.group(1))
            continue
        m = PLANNED.search(line)
        if m:
            out["groups"][m.group(1)] = m.group(2)
    for n in list(waiting):
        hold(n, finished)
    return out


def lines_at(text):
    """A log's lines, each with the time of its last timestamp so far."""
    now = None
    for line in re.split(r"[\r\n]+", text):
        line = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", line)
        m = LOG_TS.search(line)
        if m:
            now = when(m.group(1)) or now
        yield now, line


def read_manager(text):
    """A manager's log (looper#70): each land it judged, from `merging #N
    (..., queued T)` to its verdict (merged, sent back on exit 3, red on 4,
    else failed), with the conflicts it resolved by regenerating; the lands
    it left queued for the next manager; and each land's build, its queue
    time (trigger to start) apart from its run time (looper#128)."""
    out = {"lands": [], "deferred": [], "builds": []}
    cur, resolved = {}, {}
    for now, line in lines_at(text):
        m = MERGING.search(line)
        if m:
            cur[m.group(1)] = {"issue": int(m.group(1)), "queued": when(m.group(2)), "start": now}
            continue
        m = M_RESOLVED.search(line)
        if m:
            resolved[m.group(1)] = [f.strip() for f in m.group(2).split(", ") if f.strip()]
            continue
        m = M_LANDED.search(line) or M_NOT.search(line)
        if m:
            ld = cur.pop(m.group(1), None)
            if ld is None:
                continue
            ld["end"] = now
            ld["resolved"] = resolved.pop(m.group(1), [])
            if m.re is M_LANDED:
                ld.update(outcome="merged", after=m.group(3), set=m.group(4))
            else:
                ld["outcome"] = {"3": "sent_back", "4": "red"}.get(m.group(2), "failed")
            out["lands"].append(ld)
            continue
        m = M_DEFERRED.search(line)
        if m:
            out["deferred"].append(int(m.group(1)))
            continue
        m = M_BUILD.search(line)
        if m:
            out["builds"].append({"issue": int(m.group(1)), "url": m.group(2), "queue_s": int(m.group(3)),
                                  "run_s": None if m.group(4) is None else int(m.group(4))})
    return out


def read_kicker(text):
    """The kicker's capacity lines (looper#72): (time, {repo: (reports, of them
    running, [ready issues with no report job], lands queued or None)}) a pass.
    A line without running= (the kicker's before looper#92) counts every
    report as running; a line's cap= (the kicker's before looper#107, its
    waiting= only the issues at that cap) is not read."""
    out = []
    for now, line in lines_at(text):
        m = CAPACITY.search(line)
        if m and now is not None:
            out.append((now, {r: (int(k), int(n or k), [int(x) for x in w.split(",") if x], None if l == "?" else int(l))
                              for r, k, n, w, l in CAP_REPO.findall(m.group(1))}))
    return out


def failure_class(job, log):
    r = job.get("failure_reason") or ""
    if log["pull"] and log["prepare_at"] is None or r == "image_pull_failure":
        return "image_pull"
    if r in ("runner_system_failure", "scheduler_failure"):
        return "runner_system_failure"
    if r in ("job_execution_timeout", "stuck_or_timeout_failure"):
        return "timeout"
    if r == "script_failure":
        return "gate_failure" if log["gate_fail"] or job.get("name") == "gates" else "script_failure"
    return f"other:{r or 'unknown'}"


def looper_repo(name):
    """A looper job's (kind, repository): looper-<repo>-<n>, looper-scan-<repo>,
    looper-<repo>-manager."""
    m = re.fullmatch(r"looper-scan-(.+)", name or "")
    if m:
        return "scan", m.group(1)
    m = re.fullmatch(r"looper-(.+)-manager", name or "")
    if m:
        return "manager", m.group(1)
    m = re.fullmatch(r"looper-(.+)-(\d+)", name or "")
    if m:
        return "work", m.group(1)
    return None, None


def resource_group(name, groups):
    """A looper job's resource group: as the plan's log names it (groups), else
    as looper-dispatch's plan sets it since looper#70: a scan's looper-<repo>,
    a manager's looper-<repo>-main, a report's its own name."""
    if name in groups:
        return groups[name]
    kind, repo = looper_repo(name)
    return {"scan": f"looper-{repo}", "manager": f"looper-{repo}-main"}.get(kind, name)


# --- collect -----------------------------------------------------------------


def collect(until):
    start = until - DAY
    night = until.strftime("%Y-%m-%d")
    projects = ENV.get("LOOPER_RECAP_PROJECTS", "").split() or \
        (ENV.get("LOOPER_SUGGEST_PROJECTS", "").split() or ["tacplus-dev/looper", "tacplus-dev/build"]) + ["tacplus-dev/cluster"]
    projects = list(dict.fromkeys(projects))
    sources, items = {}, []
    out = {"night": night, "window": {"from": stamp(start), "until": stamp(until)}, "thresholds": T,
           "sources": sources, "projects": {}, "failed_jobs": [], "loopers": {}, "runner_pools": {},
           "longest": {"queues": [], "lands": [], "scans": [], "holds": []}}
    queues, lands, scans, holdl = [], [], [], []
    passes, managers, vmwait, groups = [], {}, [], {}

    for project in projects:
        try:
            tok = project_token(project)
            jobs = project_jobs(project, start, until, tok)
        except Unreadable as e:
            sources[f"gitlab:{project}"] = f"unavailable: {e}"
            continue
        sources[f"gitlab:{project}"] = "ok"
        rows = []
        for j in jobs:
            try:
                text = gitlab(f"projects/{enc(project)}/jobs/{j['id']}/trace", tok)
            except Unreadable:
                text = ""
            c, s, f = when(j.get("created_at")), when(j.get("started_at")), when(j.get("finished_at"))
            lg = read_log(text, s, f)
            groups.update(lg["groups"])
            if j.get("name") == "looper-kick":
                passes.append((j["id"], read_kicker(text)))
            if looper_repo(j.get("name"))[0] == "manager":
                lg["manager"] = read_manager(text)
            rows.append((j, lg, c, s, f))
        by_name = {}
        for j, lg, c, s, f in rows:
            by_name.setdefault(((j.get("pipeline") or {}).get("id"), j.get("name")), []).append(j)
        p = {"jobs": len(rows), "status": {}, "failures": {}, "queue_s": None, "prepare_s": None, "run_s": None}
        qs, ps, rs = [], [], []
        fails = {}
        for j, lg, c, s, f in rows:
            st = j.get("status") or "?"
            p["status"][st] = p["status"].get(st, 0) + 1
            q, pr, rn = secs(c, s), secs(s, lg["prepare_at"]), secs(s, f)
            qs.append(q); ps.append(pr); rs.append(rn)
            url = j.get("web_url") or ""
            if q is not None:
                queues.append({"project": project, "job": j.get("name"), "s": q, "url": url})
            # A job no runner took (canceled while pending) is in no pool.
            if j.get("runner"):
                runner = j["runner"].get("description") or str(j["runner"].get("id"))
                pool = out["runner_pools"].setdefault(runner, {"jobs": 0, "vms": set(), "failed_before_ready": 0, "prepare": [], "disk": []})
                pool["jobs"] += 1
                if lg["host"]:
                    pool["vms"].add(lg["host"])
                if lg["prepare_at"] is None and st == "failed":
                    pool["failed_before_ready"] += 1
                pool["prepare"].append(pr)
                if lg["disk_pct"] is not None:
                    pool["disk"].append(lg["disk_pct"])
            if st == "failed":
                cls = failure_class(j, lg)
                later = [k for k in by_name[((j.get("pipeline") or {}).get("id"), j.get("name"))] if k["id"] > j["id"]]
                rec = any(k.get("status") == "success" for k in later)
                p["failures"][cls] = p["failures"].get(cls, 0) + 1
                fails.setdefault(cls, []).append((rec, url, rn or 0))
                out["failed_jobs"].append({"project": project, "id": j["id"], "job": j.get("name"), "class": cls,
                                           "reason": j.get("failure_reason"), "recovered": rec,
                                           "before_ready": lg["prepare_at"] is None, "url": url})
            kind, repo = looper_repo(j.get("name"))
            if kind is None:
                continue
            lp = out["loopers"].setdefault(repo, {"jobs": 0, "plans": [], "holds": {}, "overlaps": {}, "lands": [], "deferred_lands": 0,
                                                  "scans": [], "scan_runs": [], "queued": [], "pools": {}})
            lp["jobs"] += 1
            if kind == "manager":
                mg = managers.setdefault(repo, {"jobs": 0, "lands": [], "deferred": [], "builds": [], "urls": []})
                mg["jobs"] += 1
                mg["lands"] += [dict(x, url=url) for x in lg["manager"]["lands"]]
                mg["deferred"] += lg["manager"]["deferred"]
                mg["builds"] += lg["manager"]["builds"]
                mg["urls"].append(url)
            if kind == "scan" and rn is not None:
                lp["scans"].append(rn)
                lp["scan_runs"].append((s, f, j.get("name")))
                scans.append({"repo": repo, "s": rn, "url": url})
            m = re.fullmatch(r"looper-.+-(\d+)", j.get("name") or "")
            pool = (j.get("runner") or {}).get("description")
            if kind == "work" and pool:
                lp["pools"][pool] = lp["pools"].get(pool, 0) + 1
            if kind == "work" and q is not None:
                lp["queued"].append((int(m.group(1)), j.get("name"), c, s, url, pool))
            lp["plans"] += lg["plans"]
            for ov, ns in lg["overlaps"].items():
                lp["overlaps"].setdefault(ov, set()).update(ns)
            for r, per in lg["holds"].items():
                h = lp["holds"].setdefault(r, {"count": 0, "issues": set(), "s": []})
                for n, held in per.items():
                    h["count"] += 1
                    h["issues"].add(int(n))
                    h["s"].append(held)
                    holdl.append({"repo": repo, "issue": int(n), "reason": r, "s": held, "url": url})
            for ld in lg["lands"]:
                lp["lands"].append(ld)
                lands.append({"repo": repo, "issue": ld["issue"], "set": ld["set"] or "failed", "s": ld["s"], "url": url})
            lp["deferred_lands"] += lg["deferred"]
        p["queue_s"], p["prepare_s"], p["run_s"] = dist(qs), dist(ps), dist(rs)
        out["projects"][project] = p
        for cls, fl in sorted(fails.items()):
            n, rec = len(fl), all(r for r, _, _ in fl)
            # The hours its failed jobs ran before failing: lost, then waited again on the retry.
            items.append({"key": f"failures/{project}/{cls}", "count": n, "over": n >= T["count"], "recovered": rec,
                          "wait_hours": hours(sum(x for _, _, x in fl)),
                          "summary": f"gitlab.com/{project}: {n} job{'s' * (n != 1)} failed with {cls}, "
                                     f"{sum(1 for r, _, _ in fl if r)} recovered on retry",
                          "evidence": sorted(u for _, u, _ in fl)[:5]})
        for what, d, lim in (("queue", p["queue_s"], T["queue_p90_s"]), ("prepare", p["prepare_s"], T["prepare_p90_s"])):
            if d and d["p90"] > lim:
                items.append({"key": f"{what}/{project}", "count": d["n"], "over": True, "recovered": False,
                              "summary": f"gitlab.com/{project}: {what} time p90 {minutes(d['p90'])} min over {d['n']} jobs "
                                         f"(p50 {minutes(d['p50'])}, max {minutes(d['max'])}; threshold {minutes(lim)} min)",
                              "evidence": [f"https://gitlab.com/{project}/-/jobs"]})

    # The looper jobs, per repository.
    pools = {}
    for repo, lp in sorted(out["loopers"].items()):
        # The pool its reports ran on (the most of them, looper#92).
        ps = lp.pop("pools")
        pools[repo] = min(ps, key=lambda x: (-ps[x], x)) if ps else None
        # A job of an issue queued while the repository's scan ran: the scan
        # held it only in the scan's resource group (GitLab runs one job of a
        # group at a time; since looper#70 a report has its own, looper#92).
        runs, held = lp.pop("scan_runs"), {}
        for n, name, c, s, url, pool in lp.pop("queued"):
            scan = 0
            for a, b, sn in runs:
                if resource_group(sn, groups) != resource_group(name, groups):
                    continue
                o = secs(max(a, c), min(b, s))
                if o and o > 0:
                    scan += o
                    held[n] = held.get(n, 0) + o
                    holdl.append({"repo": repo, "issue": n, "reason": "scan_holds_repo", "s": o, "url": url})
            # The rest of its queue it waited for a runner's VM (looper#72).
            if secs(c, s) - scan >= T["vm_wait_s"]:
                vmwait.append({"repo": repo, "issue": n, "s": secs(c, s) - scan, "url": url, "pool": pool})
        if held:
            lp["holds"]["scan_holds_repo"] = {"count": len(held), "issues": set(held), "s": [held[n] for n in sorted(held)]}
        plans = lp.pop("plans")
        lp["slots"] = None if not plans else {
            "plans": len(plans), "capacity": max(x["capacity"] for x in plans),
            "peak": max(x["running"] for x in plans),
            "mean_use": round(sum(x["running"] / max(1, x["capacity"]) for x in plans) / len(plans), 2)}
        ovs = lp.pop("overlaps")
        for r, h in sorted(lp["holds"].items()):
            mx = max(h["s"]) if h["s"] else 0
            lp["holds"][r] = {"count": h["count"], "issues": sorted(h["issues"]), "max_hours": hours(mx), "total_hours": hours(sum(h["s"]))}
            if r == "conflict":
                lp["holds"][r]["overlaps"] = [{"issues": sorted(ns), "what": ov} for ov, ns in sorted(ovs.items())][:10]
            if mx >= T["hold_hours"] * 3600:
                items.append({"key": f"held/{repo}/{r}", "count": h["count"], "over": True, "recovered": False,
                              "wait_hours": hours(sum(h["s"])), "parallel": PARALLEL[r],
                              "summary": f"{repo}: issues held back by {r} {h['count']} time{'s' * (h['count'] != 1)} "
                                         f"({', '.join('#%d' % i for i in sorted(h['issues']))}), up to {hours(mx)} h, {hours(sum(h['s']))} h in all"
                                         + (f"; overlapping: {'; '.join(ov for ov in sorted(ovs))[:300]}" if r == "conflict" and ovs else ""),
                              "evidence": sorted({x["url"] for x in holdl if x["repo"] == repo and x["reason"] == r})[:5]})
        lp["waits"] = {"hours": hours(sum(x["s"] for x in holdl if x["repo"] == repo)),
                       "by_reason": {r: h["total_hours"] for r, h in sorted(lp["holds"].items())}, "by_issue": {}}
        per = {}
        for x in holdl:
            if x["repo"] == repo and x["s"]:
                per.setdefault(x["issue"], {}).setdefault(x["reason"], 0)
                per[x["issue"]][x["reason"]] += x["s"]
        lp["waits"]["by_issue"] = {str(n): {"hours": hours(sum(per[n].values())), "why": {r: hours(v) for r, v in sorted(per[n].items())}}
                                   for n in sorted(per)}
        sets = {}
        for ld in lp["lands"]:
            sets.setdefault(ld["set"] or "failed", []).append(ld["s"])
        lp["lands"] = {k: {"count": len(v), "minutes": {kk: minutes(vv) if kk != "n" else vv for kk, vv in dist(v).items()}}
                       for k, v in sorted(sets.items())}
        for k, v in sorted(sets.items()):
            if k != "failed" and max(v) >= T["land_minutes"] * 60:
                items.append({"key": f"land/{repo}/{k}", "count": len(v), "over": True, "recovered": False,
                              "summary": f"{repo}: {len(v)} land{'s' * (len(v) != 1)} on the gates {k}, up to {minutes(max(v))} min "
                                         f"(p50 {minutes(pct(v, 50))}; threshold {T['land_minutes']} min)",
                              "evidence": sorted({x['url'] for x in lands if x['repo'] == repo and x['set'] == k})[:5]})
        if lp["deferred_lands"]:
            n = lp["deferred_lands"]
            items.append({"key": f"deferred/{repo}", "count": n, "over": n >= T["count"], "recovered": True,
                          "summary": f"{repo}: {n} land{'s' * (n != 1)} deferred to the next job (not enough time left in the job)",
                          "evidence": [f"https://gitlab.com/{ENV.get('LOOPER_ORG', 'tacplus-dev')}/looper/-/jobs"]})
        sc = lp.pop("scans")
        lp["scan_minutes"] = [minutes(s) for s in sorted(sc)]
        if sc and max(sc) >= T["scan_minutes"] * 60:
            items.append({"key": f"scan/{repo}", "count": len(sc), "over": True, "recovered": False,
                          "summary": f"{repo}: its nightly scan held the repository {minutes(max(sc))} min (threshold {T['scan_minutes']} min)",
                          "evidence": sorted({x['url'] for x in scans if x['repo'] == repo})[:5]})

    for runner, pool in sorted(out["runner_pools"].items()):
        disk = pool.pop("disk")
        out["runner_pools"][runner] = {"jobs": pool["jobs"], "vms": len(pool["vms"]), "failed_before_ready": pool["failed_before_ready"],
                                       "boot_to_ready_s": dist(pool["prepare"]),
                                       "disk_pct": None if not disk else {"jobs": len(disk), "max": max(disk), "p50": pct(disk, 50)}}
        if disk and max(disk) >= T["disk_pct"]:
            items.append({"key": f"disk/{runner}", "count": sum(1 for x in disk if x >= T["disk_pct"]), "over": True, "recovered": False,
                          "summary": f"runner {runner}: disk {max(disk)}% used at a job's end (threshold {T['disk_pct']}%)",
                          "evidence": [f"https://gitlab.com/{ENV.get('LOOPER_ORG', 'tacplus-dev')}/looper/-/jobs"]})

    out["managers"] = managers_of(managers, start, until, sources, items)
    out["concurrency"] = concurrency_of(passes, out["managers"], items, pools)
    out["capacity"] = capacity_of(queues, vmwait, items)
    out["actions"] = actions(start, until, sources, items)
    out["image"] = image_check(until, sources, items)

    out["failed_jobs"].sort(key=lambda x: (x["project"], x["id"]))
    top = lambda xs: sorted(xs, key=lambda x: (-(x["s"] or 0), x["url"]))[:5]
    out["longest"] = {"queues": [dict(x, minutes=minutes(x.pop("s"))) for x in top(queues)],
                      "lands": [dict(x, minutes=minutes(x.pop("s"))) for x in top(lands)],
                      "scans": [dict(x, minutes=minutes(x.pop("s"))) for x in top(scans)],
                      "holds": [dict(x, hours=hours(x.pop("s"))) for x in top(holdl)]}
    out["items"] = sorted(items, key=lambda x: x["key"])
    return out


def gh_json(*args):
    try:
        return json.loads(run(["gh", "api", *args]))
    except ValueError:
        raise Unreadable(f"gh api {args[-1] if args else ''}: not JSON") from None


REVERTS = re.compile(r"^Revert \"|^This reverts commit [0-9a-f]{7,}", re.M)


def managers_of(managers, start, until, sources, items):
    """Each manager's score (looper#72; Jody, 2026-11-03: "If there is a problem
    we are going to hold that manager responsible"): its report-to-merge time
    (a land queued to merged), the hours lands waited for it, the conflicts it
    resolved by regenerating against those it sent back, red gates, the lands
    it left for the next manager, the work redone (a land of an issue again
    after it was sent back or red), its builds' queue time apart from their
    run time (looper#128: a build is the latest line of its pipeline, a later
    manager's taking it up), and from GitHub its merges' build status
    (LOOPER_RECAP_BUILD_CONTEXT, tacplus-dev/build: a red main after its merge)
    and the reverts on its main."""
    org = ENV.get("LOOPER_ORG", "tacplus-dev")
    ctx = ENV.get("LOOPER_RECAP_BUILD_CONTEXT", "tacplus-dev/build")
    out, bad = {}, []
    for repo, mg in sorted(managers.items()):
        lands = sorted(mg["lands"], key=lambda x: (x["end"] or x["start"], x["issue"]))
        merged = [x for x in lands if x["outcome"] == "merged"]
        by = lambda o: [x for x in lands if x["outcome"] == o]
        r2m = [secs(x["queued"], x["end"]) for x in merged]
        waited = sum(max(0, secs(x["queued"], x["start"]) or 0) for x in lands)
        redone, seen_bad = [], set()
        for x in lands:
            if x["issue"] in seen_bad:
                redone.append(x["issue"])
            if x["outcome"] in ("sent_back", "red"):
                seen_bad.add(x["issue"])
        merges = []
        for x in merged:
            st = None
            try:
                got = gh_json(f"repos/{org}/{repo}/commits/{x['after']}/status")
                st = next((y.get("state") for y in got.get("statuses") or [] if y.get("context") == ctx), "none")
            except (Unreadable, AttributeError) as e:
                bad.append(f"{repo} {x['after']} ({e})")
            merges.append({"issue": x["issue"], "after": x["after"], "set": x["set"], "status": st, "url": x["url"]})
        reverts = None
        try:
            got = gh_json("-X", "GET", f"repos/{org}/{repo}/commits", "-f", "sha=main",
                          "-f", f"since={stamp(start)}", "-f", f"until={stamp(until)}", "-f", "per_page=100")
            reverts = sorted(({"sha": c["sha"][:12], "title": (c["commit"]["message"].splitlines() or [""])[0][:120], "url": c.get("html_url")}
                              for c in got if REVERTS.search((c.get("commit") or {}).get("message") or "")), key=lambda c: c["sha"])
        except (Unreadable, KeyError, TypeError, AttributeError) as e:
            bad.append(f"{repo} commits ({e})")
        red_main = [m for m in merges if m["status"] in ("failure", "error")]
        d = dist(r2m)
        builds = list({b["url"]: b for b in mg["builds"]}.values())
        bq, br = dist([b["queue_s"] for b in builds]), dist([b["run_s"] for b in builds])
        sc = out[repo] = {
            "jobs": mg["jobs"], "lands": len(lands), "merged": len(merged), "sent_back": len(by("sent_back")),
            "resolved": sum(1 for x in lands if x["resolved"]), "red_gates": len(by("red")), "failed": len(by("failed")),
            "deferred": len(mg["deferred"]), "redone": sorted(redone),
            "report_to_merge_minutes": d and {k: minutes(v) if k != "n" else v for k, v in d.items()},
            "waited_hours": hours(waited), "merges": merges, "red_main": [m["after"] for m in red_main],
            "reverts": reverts, "builds": len(builds),
            "build_queue_minutes": bq and {k: minutes(v) if k != "n" else v for k, v in bq.items()},
            "build_run_minutes": br and {k: minutes(v) if k != "n" else v for k, v in br.items()},
            "builds_not_started": sum(1 for b in builds if b["run_s"] is None)}
        ev = sorted(set(mg["urls"]))[:5]
        if red_main:
            items.append({"key": f"manager/{repo}/red-main", "count": len(red_main), "over": True, "recovered": False,
                          "summary": f"{repo}: main red after {len(red_main)} of the manager's {len(merged)} merge{'s' * (len(merged) != 1)} "
                                     f"({', '.join('#%d at %s' % (m['issue'], m['after']) for m in red_main)}; {ctx})",
                          "evidence": [f"https://github.com/{org}/{repo}/commit/{m['after']}" for m in red_main][:5]})
        if reverts:
            items.append({"key": f"manager/{repo}/reverts", "count": len(reverts), "over": True, "recovered": False,
                          "summary": f"{repo}: {len(reverts)} revert{'s' * (len(reverts) != 1)} on main ({'; '.join(c['title'] for c in reverts)[:200]})",
                          "evidence": [c["url"] for c in reverts if c["url"]][:5]})
        if sc["sent_back"]:
            n = sc["sent_back"]
            items.append({"key": f"manager/{repo}/sent-back", "count": n, "over": n >= T["count"],
                          "recovered": all(i in redone for i in {x["issue"] for x in by("sent_back")}),
                          "summary": f"{repo}: the manager sent {n} branch{'es' * (n != 1)} back on a conflict, resolved {sc['resolved']} by regenerating; "
                                     f"redone: {', '.join('#%d' % i for i in sc['redone']) or 'none'}",
                          "evidence": ev})
        if d and d["p90"] >= T["merge_minutes"] * 60:
            items.append({"key": f"manager/{repo}/merge-time", "count": d["n"], "over": True, "recovered": False,
                          "wait_hours": hours(waited),
                          "summary": f"{repo}: report to merge p90 {minutes(d['p90'])} min over {d['n']} merge{'s' * (d['n'] != 1)} "
                                     f"(p50 {minutes(d['p50'])}, max {minutes(d['max'])}; threshold {T['merge_minutes']} min); lands waited {hours(waited)} h for the manager",
                          "evidence": ev})
    if managers:
        sources["github-main"] = "ok" if not bad else "partial: " + "; ".join(bad)[:500]
    return out


def build_times(m):
    """A manager's builds, their queue time apart from their run time (looper#128)."""
    bq, br = m.get("build_queue_minutes"), m.get("build_run_minutes")
    if not bq:
        return ""
    return (f", {m['builds']} build{'s' * (m['builds'] != 1)} queued p50 {bq['p50']}, p90 {bq['p90']} min"
            + (f", ran p50 {br['p50']}, p90 {br['p90']} min" if br else "")
            + (f", {m['builds_not_started']} not started" if m["builds_not_started"] else ""))


def concurrency_of(passes, managers, items, pools):
    """How many reports ran at once and how long ready issues waited
    (looper#107; Jody, 2026-11-07: "loopers are never blocked. We start as many
    as we need. If we have a problem we will look to address it."), from the
    kicker's capacity lines: no cap holds a ready issue back, so a problem shows
    up here as a number. In all and per repository: the reports active at once
    (created, pending or running) and of them running, their peak and their
    mean over the passes' time; the hours ready issues waited with no report job
    (for the kicker's pass, the plan and its runner), `wait/<repo>` from
    LOOPER_RECAP_WAIT_HOURS; and per repository its merge backlog (lands queued,
    a pass), `manager/<repo>/backlog` when its p90 is LOOPER_RECAP_BACKLOG or
    more, advised after two nights running (the item's `running`). A report's
    own wait for a VM is the capacity's (capacity_of)."""
    obs = []
    for _, ps in sorted(passes):
        for k, (t, per) in enumerate(ps):
            nxt = ps[k + 1][0] if k + 1 < len(ps) else None
            obs.append((t, min(secs(t, nxt), PASS_GAP) if nxt else PASS_S, per))
    obs.sort(key=lambda x: x[0])
    span = sum(d for _, d, _ in obs)

    def at_once(xs):  # [(value, seconds)]: the peak and the mean over the time
        return {"max": max((v for v, _ in xs), default=0), "mean": round(sum(v * d for v, d in xs) / span, 2) if span else 0}

    out = {"passes": len(obs), "hours": hours(span),
           "reports": at_once([(sum(x[0] for x in per.values()), d) for _, d, per in obs]),
           "running": at_once([(sum(x[1] for x in per.values()), d) for _, d, per in obs]),
           "waiting_hours": hours(sum(d * len(x[2]) for _, d, per in obs for x in per.values())), "repos": {}}
    for repo in sorted({r for _, _, per in obs for r in per}):
        waits, backlog = {}, []
        for _, d, per in obs:
            k, _, w, l = per.get(repo, (0, 0, [], 0))   # no line for it: nothing at work, queued or ready
            for n in w:
                waits[n] = waits.get(n, 0) + d
            if l is not None:
                backlog.append(l)
        wh, b90 = sum(waits.values()), pct(backlog, 90) or 0
        c = out["repos"][repo] = {
            "reports": at_once([(per.get(repo, (0,))[0], d) for _, d, per in obs]),
            "running": at_once([(per.get(repo, (0, 0))[1], d) for _, d, per in obs]),
            "waiting_hours": hours(wh), "waiting": {str(n): hours(v) for n, v in sorted(waits.items())},
            "pool": pools.get(repo), "backlog": {"p90": b90, "max": max(backlog, default=0)}}
        busy = (f"{c['reports']['max']} reports at once at most (mean {c['reports']['mean']}), {c['running']['max']} running"
                f" (mean {c['running']['mean']}) over the kicker's {len(obs)} passes")
        if wh >= T["wait_hours"] * 3600:
            items.append({"key": f"wait/{repo}", "count": len(waits), "over": True, "recovered": False, "wait_hours": hours(wh),
                          "summary": f"{repo}: ready issues waited {hours(wh)} h with no report job ("
                                     + ", ".join("#%d %s h" % (n, hours(v)) for n, v in sorted(waits.items()))
                                     + f"): no cap holds them back (looper#107), so the kicker, the plan or its runner did not start them; {busy}"
                                     + f" (threshold {whole(T['wait_hours'])} h)",
                          "evidence": [f"https://gitlab.com/{ENV.get('LOOPER_ORG', 'tacplus-dev')}/looper/-/jobs"]})
        if b90 >= T["backlog"]:
            items.append({"key": f"manager/{repo}/backlog", "count": b90, "over": True, "recovered": False, "running": 2,
                          "wait_hours": (managers.get(repo) or {}).get("waited_hours", 0),
                          "summary": f"{repo}: its manager behind: merge backlog p90 {b90}, max {c['backlog']['max']} lands; {busy} (threshold {T['backlog']})",
                          "evidence": [f"https://gitlab.com/{ENV.get('LOOPER_ORG', 'tacplus-dev')}/looper/-/jobs"]})
    return out


def capacity_of(queues, vmwait, items):
    """The numbers the hub brings Jody for a manual scale-up (looper#72;
    decisions/looper-job-per-issue-2026-11-03.md: "Capacity is manual"): the
    queue p90 of every job, the issues whose report waited for a VM (its queue
    less a scan's, LOOPER_RECAP_VM_WAIT or more) and what one more VM costs a
    day (LOOPER_RECAP_VM_MACHINE at LOOPER_RECAP_VM_USD_HOUR)."""
    q = dist([x["s"] for x in queues])
    wh = sum(x["s"] for x in vmwait)
    vm = dict(VM, usd_hour=whole(VM["usd_hour"]), usd_day=whole(round(VM["usd_hour"] * 24, 2)))
    out = {"queue_minutes": q and {k: minutes(v) if k != "n" else v for k, v in q.items()},
           "waiting_for_vm": {"issues": len(vmwait), "hours": hours(wh),
                              "jobs": [{"repo": x["repo"], "issue": x["issue"], "minutes": minutes(x["s"]), "url": x["url"], "pool": x["pool"]}
                                       for x in sorted(vmwait, key=lambda x: (-x["s"], x["url"]))]},
           "one_more_vm": vm}
    if vmwait:
        items.append({"key": "capacity/vm", "count": len(vmwait), "over": wh >= T["vm_wait_hours"] * 3600, "recovered": False,
                      "wait_hours": hours(wh),
                      "summary": f"{len(vmwait)} issue{'s' * (len(vmwait) != 1)} waited {hours(wh)} h for a VM "
                                 f"({', '.join('%s#%d %s min' % (x['repo'], x['issue'], minutes(x['s'])) for x in sorted(vmwait, key=lambda x: -x['s']))}); "
                                 f"queue p90 {minutes(q['p90']) if q else '-'} min; one more {vm['machine']} is about ${vm['usd_day']} a day "
                                 f"(threshold {whole(T['vm_wait_hours'])} h; the scale-up is Jody's call)",
                      "evidence": sorted(x["url"] for x in vmwait)[:5]})
    return out


def actions(start, until, sources, items):
    org = ENV.get("LOOPER_ORG", "tacplus-dev")
    pat = re.compile(ENV.get("LOOPER_RECAP_WORKFLOWS", "nightly|release|image"), re.I)
    try:
        repos = ENV.get("LOOPER_RECAP_ACTIONS_REPOS", "").split() or sorted(
            r["name"] for r in json.loads(run(["gh", "repo", "list", org, "--no-archived", "--limit", "200", "--json", "name"])))
    except (Unreadable, ValueError, KeyError, TypeError) as e:
        sources["github-actions"] = f"unavailable: {e}"
        return None
    runs, bad = [], []
    for r in repos:
        try:
            got = json.loads(run(["gh", "api", "-X", "GET", f"repos/{org}/{r}/actions/runs",
                                  "-f", f"created={stamp(start)}..{stamp(until)}", "-f", "per_page=100"]))
        except (Unreadable, ValueError) as e:
            bad.append(f"{r} ({e})")
            continue
        for w in got.get("workflow_runs") or []:
            if not pat.search(w.get("name") or ""):
                continue
            runs.append({"repo": r, "workflow": w.get("name"), "id": w.get("id"), "conclusion": w.get("conclusion") or w.get("status"),
                         "minutes": None if secs(when(w.get("run_started_at")), when(w.get("updated_at"))) is None
                         else minutes(secs(when(w.get("run_started_at")), when(w.get("updated_at")))),
                         "url": w.get("html_url")})
    sources["github-actions"] = "ok" if not bad else "partial: " + "; ".join(sorted(bad))
    runs.sort(key=lambda x: (x["repo"], x["workflow"], x["id"] or 0))
    by = {}
    for x in runs:
        b = by.setdefault(f"{x['repo']}/{x['workflow']}", {"runs": 0, "failed": 0, "minutes": []})
        b["runs"] += 1
        b["failed"] += x["conclusion"] in ("failure", "timed_out", "startup_failure")
        b["minutes"].append(x["minutes"])
    for k, b in sorted(by.items()):
        fl = [x for x in runs if f"{x['repo']}/{x['workflow']}" == k and x["conclusion"] in ("failure", "timed_out", "startup_failure")]
        if fl:
            last_fail = max(x["id"] for x in fl)
            rec = any(x["conclusion"] == "success" and x["id"] > last_fail for x in runs if f"{x['repo']}/{x['workflow']}" == k)
            items.append({"key": f"actions/{k}", "count": len(fl), "over": len(fl) >= T["count"], "recovered": rec,
                          "summary": f"GitHub Actions {k}: {len(fl)} of {b['runs']} runs failed" + (", a later run succeeded" if rec else ""),
                          "evidence": [x["url"] for x in fl][:5]})
        b["minutes"] = dist(b["minutes"])
    return {"by_workflow": by, "runs": runs}


def image_check(until, sources, items):
    """The looper image's revision against main's head (looper#58): a stale
    image, its missing commits and the latest image workflow run."""
    ref = ENV.get("LOOPER_RECAP_IMAGE", "ghcr.io/tacplus-dev/looper:main")
    repo = ENV.get("LOOPER_RECAP_IMAGE_REPO", "tacplus-dev/looper")
    if not ref:
        sources["image"] = "not configured"
        return None
    try:
        got = json.loads(run(["docker", "buildx", "imagetools", "inspect", ref, "--format", "{{json .Image}}"]))
        # One platform's image, or a map of the platforms' (the same revision each).
        imgs = [got] if "config" in got else [got[k] for k in sorted(got)]
        revs = sorted({((i.get("config") or {}).get("Labels") or {}).get("org.opencontainers.image.revision") or "" for i in imgs})
        rev = revs[0] if len(revs) == 1 else ""
        head = json.loads(run(["gh", "api", f"repos/{repo}/commits/main"]))["sha"]
    except (Unreadable, ValueError, KeyError, TypeError, AttributeError) as e:
        sources["image"] = f"unavailable: {e}"
        return None
    sources["image"] = "ok"
    out = {"ref": ref, "revision": rev or None, "main": head, "current": rev == head, "missing": [], "latest_run": None}
    if rev == head:
        return out
    try:
        if rev:
            cmp = json.loads(run(["gh", "api", f"repos/{repo}/compare/{rev}...{head}"]))
            out["missing"] = [{"sha": c["sha"][:12], "date": stamp(when(c["commit"]["committer"]["date"])),
                               "title": (c["commit"]["message"].splitlines() or [""])[0][:120]} for c in cmp.get("commits") or []]
        wr = (json.loads(run(["gh", "api", "-X", "GET", f"repos/{repo}/actions/workflows/image.yml/runs",
                              "-f", "branch=main", "-f", "per_page=1"])).get("workflow_runs") or [None])[0]
        if wr:
            out["latest_run"] = {"id": wr.get("id"), "sha": (wr.get("head_sha") or "")[:12], "status": wr.get("status"),
                                 "conclusion": wr.get("conclusion"), "url": wr.get("html_url")}
    except (Unreadable, ValueError, KeyError, TypeError) as e:
        sources["image"] = f"partial: {e}"
    oldest = min((when(c["date"]) for c in out["missing"]), default=None)
    lag = secs(oldest, until) if oldest else None
    lim = T["image_hours"] * 3600
    run_s = out["latest_run"]
    items.append({"key": f"image/{repo}", "count": len(out["missing"]), "over": lag is None or lag >= lim, "recovered": False,
                  "wait_hours": hours(min(lag, DAY.total_seconds())) if lag else 0, "parallel": PARALLEL["image_stale"],
                  "summary": f"{ref} is at {(rev or 'no revision')[:12]}, main at {head[:12]}: {len(out['missing'])} commit"
                             f"{'s' * (len(out['missing']) != 1)} of main not in it"
                             + (f", the oldest {hours(lag)} h old" if lag else "")
                             + (f"; the latest image run: {run_s['conclusion'] or run_s['status']} at {run_s['sha']}" if run_s else ""),
                  "evidence": [x for x in [run_s and run_s["url"]] if x]})
    return out


# --- classify ----------------------------------------------------------------


def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError) as e:
        die(f"cannot read {path}: {e}")


def classify(night, history):
    d = dt.date.fromisoformat(night["night"])
    before = {}
    for k in range(1, 7):
        day = (d - dt.timedelta(days=k)).isoformat()
        p = os.path.join(history, f"{day}.json") if history else ""
        if p and os.path.isfile(p):
            before[day] = {x["key"] for x in load(p).get("items", [])}
    out = {"night": night["night"], "history": sorted(before), "recurring": [], "transient": [], "once": []}
    for it in night.get("items", []):
        seen = sorted([day for day, keys in before.items() if it["key"] in keys] + [night["night"]])
        row = {"key": it["key"], "summary": it["summary"], "nights": len(seen), "seen": seen, "over": it["over"],
               "recovered": it["recovered"], "evidence": it.get("evidence", []), "wait_hours": it.get("wait_hours", 0)}
        if it.get("parallel"):
            row["parallel"] = it["parallel"]
        if it.get("running"):
            # Advice only after so many nights running over its threshold (a merge backlog, looper#72).
            row["running"] = next((k for k in range(1, 7) if (d - dt.timedelta(days=k)).isoformat() not in seen), 7)
            (out["recurring"] if row["running"] >= it["running"] else out["once"]).append(dict(row, needs=it["running"]))
        elif len(seen) >= 2 or it["over"]:
            out["recurring"].append(row)
        elif it["recovered"]:
            out["transient"].append(row)
        else:
            out["once"].append(row)
    # The advice ranks by the hours of waiting it would remove (Jody, on looper#57).
    out["recurring"].sort(key=lambda x: (-x["wait_hours"], x["key"]))
    return out


# --- report ------------------------------------------------------------------


def section(text, head):
    m = re.search(rf"^## {re.escape(head)}\n(.*?)(?=^## |\Z)", text, re.M | re.S)
    return m.group(1) if m else ""


def advice(sdir, night):
    """The suggestions of DIR that give advice on the night's items: key -> [(name, file)]."""
    found = {}
    if not sdir or not os.path.isdir(sdir):
        return found
    for f in sorted(os.listdir(sdir)):
        if not re.fullmatch(r"\d{4}-\d\d-\d\d-[a-z0-9-]+\.md", f):
            continue
        with open(os.path.join(sdir, f)) as h:
            text = h.read()
        name = (re.match(r"Suggestion: (.*)", text) or [None, f])[1].strip()
        for line in section(text, "Advice").splitlines():
            m = re.match(r"Recap:\s*(\d{4}-\d\d-\d\d)\s+(.*)", line.strip())
            if m and m.group(1) == night:
                for k in re.split(r"[,\s]+", m.group(2).strip()):
                    if k:
                        found.setdefault(k, []).append((name, f))
    return found


def covered(path, keys):
    out = {}
    if not path or not os.path.isfile(path):
        return out
    with open(path) as h:
        for line in h:
            parts = line.strip().split(None, 2)
            if len(parts) >= 2 and parts[0] in keys and re.fullmatch(r"([\w.-]+/)?[\w.-]+#\d+|https://\S+/(issues|-/issues)/\d+", parts[1]):
                why = re.sub(r"[<>\[\]`]", "", parts[2] if len(parts) > 2 else "")[:200]
                out.setdefault(parts[0], []).append(parts[1] + (f": {why}" if why else ""))
    return out


def fmt(d, unit=60):
    return "-" if not d else f"{whole(round(d['p90'] / unit, 1))}"


def report(night, classes, sdir, cov):
    n = night["night"]
    adv = advice(sdir, n)
    cv = covered(cov, {x["key"] for x in classes["recurring"]})
    L = [f"# Recap of {n}", "",
         f"The 24 hours to {night['window']['until']}, gathered by `looper-recap collect` and classified against "
         f"{len(classes['history'])} earlier night{'s' * (len(classes['history']) != 1)} (tacplus-dev/looper#57). "
         f"The data: [{n}.json]({n}.json).", "", "## Summary", "",
         "| Project | Jobs | Failed | Queue p90 (min) | Prepare p90 (min) | Run p90 (min) |", "|---|---|---|---|---|---|"]
    for p, d in sorted(night["projects"].items()):
        L.append(f"| {p} | {d['jobs']} | {d['status'].get('failed', 0)} | {fmt(d['queue_s'])} | {fmt(d['prepare_s'])} | {fmt(d['run_s'])} |")
    fails = {}
    for d in night["projects"].values():
        for c, k in d["failures"].items():
            fails[c] = fails.get(c, 0) + k
    L += ["", "Failures by class: " + (", ".join(f"{c} {k}" for c, k in sorted(fails.items(), key=lambda x: (-x[1], x[0]))) or "none") + "."]
    slots = [f"{r} peak {lp['slots']['peak']} of {lp['slots']['capacity']} (mean use {lp['slots']['mean_use']}, {lp['slots']['plans']} plans)"
             for r, lp in sorted(night["loopers"].items()) if lp.get("slots")]
    L.append("Slot use: " + ("; ".join(slots) or "no plan") + ".")
    for what, k, unit in (("queues", "job", "min"), ("lands", "set", "min"), ("holds", "reason", "h")):
        xs = night["longest"][what][:3]
        if xs:
            val = "hours" if unit == "h" else "minutes"
            L.append(f"Longest {what}: " + "; ".join(
                f"[{x.get('repo') or x.get('project')} {('#%d ' % x['issue']) if 'issue' in x else ''}{x[k]}]({x['url']}) {x[val]} {unit}" for x in xs) + ".")
    waits = [f"{r} {lp['waits']['hours']} h (" + ", ".join(f"{k} {v}" for k, v in sorted(lp["waits"]["by_reason"].items(), key=lambda x: (-x[1], x[0])) if v) + ")"
             for r, lp in sorted(night["loopers"].items(), key=lambda x: (-x[1]["waits"]["hours"], x[0])) if lp.get("waits", {}).get("hours")]
    L.append("Hours ready issues waited: " + ("; ".join(waits) or "none") + ".")
    mgs = []
    for r, m in sorted((night.get("managers") or {}).items()):
        r2m = m["report_to_merge_minutes"]
        mgs.append(f"{r} {m['merged']} merged" + (f" (report to merge p50 {r2m['p50']}, p90 {r2m['p90']} min)" if r2m else "")
                   + f", conflicts resolved {m['resolved']} against {m['sent_back']} sent back, red gates {m['red_gates']}"
                   + f", main red after {len(m['red_main'])}" + (f" ({', '.join(m['red_main'])})" if m["red_main"] else "")
                   + f", reverts {'?' if m['reverts'] is None else len(m['reverts'])}"
                   + f", redone {len(m['redone'])}" + (f" ({', '.join('#%d' % i for i in m['redone'])})" if m["redone"] else "")
                   + (f", {m['deferred']} left for the next" if m["deferred"] else "")
                   + build_times(m))
    L.append("Managers: " + ("; ".join(mgs) or "none") + ".")
    cc = night.get("concurrency")
    if cc and cc["passes"]:
        L.append(f"Concurrency (no caps, looper#107): over the kicker's {cc['passes']} passes, at most {cc['reports']['max']} reports at once"
                 f" (mean {cc['reports']['mean']}), {cc['running']['max']} running (mean {cc['running']['mean']});"
                 f" ready issues waited {cc['waiting_hours']} h with no report job. "
                 + "; ".join(f"{r} at most {c['reports']['max']} (mean {c['reports']['mean']}), {c['running']['max']} running,"
                             f" waited {c['waiting_hours']} h" + (f" ({', '.join('#%s' % n for n in c['waiting'])})" if c["waiting"] else "")
                             + f", merge backlog p90 {c['backlog']['p90']}"
                             for r, c in sorted(cc["repos"].items())) + ".")
    else:
        L.append("Concurrency: no kicker pass read.")
    cp = night.get("capacity")
    if cp:
        w, vm = cp["waiting_for_vm"], cp["one_more_vm"]
        L.append(f"Capacity: queue p90 {(cp['queue_minutes'] or {}).get('p90', '-')} min over {(cp['queue_minutes'] or {}).get('n', 0)} jobs; "
                 f"{w['issues']} issue{'s' * (w['issues'] != 1)} waited {w['hours']} h for a VM"
                 + (" (" + ", ".join(f"[{x['repo']}#{x['issue']}]({x['url']}) {x['minutes']} min" for x in w["jobs"][:3]) + ")" if w["jobs"] else "")
                 + f"; one more {vm['machine']} is about ${vm['usd_day']} a day (${vm['usd_hour']} an hour).")
    im = night.get("image")
    if im:
        L.append(f"Image: {im['ref']} " + ("is at main's head." if im["current"] else
                 f"is {len(im['missing'])} commit{'s' * (len(im['missing']) != 1)} behind main ({(im['revision'] or 'no revision')[:12]} against {im['main'][:12]})"
                 + (f"; the latest image run: [{im['latest_run']['conclusion'] or im['latest_run']['status']}]({im['latest_run']['url']})" if im.get("latest_run") else "") + "."))
    gone = [f"{k} ({v})" for k, v in sorted(night["sources"].items()) if v != "ok"]
    if gone:
        L.append("Not read: " + "; ".join(gone) + ".")
    L += ["", "## Recurring: advice", "", "Ranked by the hours of waiting each would remove.", ""]
    for x in classes["recurring"]:
        why = (f"{x['running']} nights running" if x.get("needs") else f"{x['nights']} of 7 nights") + (", over its threshold tonight" if x["over"] else "") + \
            (f", {x['wait_hours']} h of waiting" if x.get("wait_hours") else "")
        links = [f"[{nm}](../{f})" for nm, f in adv.get(x["key"], [])] + [f"covered by {c}" for c in cv.get(x["key"], [])]
        L.append(f"- `{x['key']}`: {x['summary']} ({why}). " + ("Advice: " + "; ".join(links) if links else "No advice tonight."))
    if not classes["recurring"]:
        L.append("Nothing recurring.")
    L += ["", "## Transient: noted", ""]
    L += [f"- `{x['key']}`: {x['summary']} (once in 7 nights, recovered on retry)." for x in classes["transient"]] or ["None."]
    L += ["", "## Once, not recovered: noted", ""]
    L += [f"- `{x['key']}`: {x['summary']} (" + (f"{x['running']} night{'s' * (x['running'] != 1)} running; advice after {x['needs']}" if x.get("needs")
          else "once in 7 nights; recurring if it comes back") + ")." for x in classes["once"]] or ["None."]
    return "\n".join(L) + "\n"


# --- main --------------------------------------------------------------------


def opts(args, names):
    got, rest = {}, []
    while args:
        a = args.pop(0)
        if a in names:
            if not args:
                die(f"{a} needs a value (see --help)")
            got[a] = args.pop(0)
        elif a.startswith("--"):
            die(f"unknown option: {a} (see --help)")
        else:
            rest.append(a)
    return got, rest


def usage():
    with open(__file__) as f:
        lines = f.read().splitlines()
    for ln in lines[3:]:
        if not ln.startswith("#"):
            break
        print(ln[2:])


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage()
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd == "collect":
        o, rest = opts(args, {"--until", "--out"})
        if rest:
            die(f"unexpected: {' '.join(rest)}")
        if "--until" in o:
            until = when(o["--until"])
            if until is None:
                die(f"--until {o['--until']} is not a time (YYYY-MM-DDTHH:MM:SSZ)")
        else:
            until = dt.datetime.now(dt.timezone.utc).replace(second=0, microsecond=0)
        text = json.dumps(collect(until), indent=1, sort_keys=True, default=sorted) + "\n"
        if "--out" in o:
            with open(o["--out"], "w") as f:
                f.write(text)
        else:
            sys.stdout.write(text)
        return 0
    if cmd == "classify":
        o, rest = opts(args, {"--history"})
        if len(rest) != 1:
            die("classify NIGHT.json [--history DIR]")
        sys.stdout.write(json.dumps(classify(load(rest[0]), o.get("--history")), indent=1, sort_keys=True) + "\n")
        return 0
    if cmd == "report":
        o, rest = opts(args, {"--suggestions", "--covered"})
        if len(rest) != 2:
            die("report NIGHT.json CLASSES.json [--suggestions DIR] [--covered FILE]")
        sys.stdout.write(report(load(rest[0]), load(rest[1]), o.get("--suggestions"), o.get("--covered")))
        return 0
    die(f"unknown command: {cmd} (see --help)")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
