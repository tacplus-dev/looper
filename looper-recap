def when(s):
    """A timestamp of the APIs (ISO 8601, Z or an offset, with or without a fraction), as UTC."""
    if not s:
        return None
    s = re.sub(r"\.\d+", "", str(s)).replace("Z", "+00:00")
    try:
        t = dt.datetime.fromisoformat(s)
    except ValueError:
        return None
    if t.tzinfo is None:
        t = t.replace(tzinfo=dt.timezone.utc)
    return t.astimezone(dt.timezone.utc)


def stamp(t):
    return t.strftime("%Y-%m-%dT%H:%M:%SZ")


def secs(a, b):
    return None if a is None or b is None else int((b - a).total_seconds())


def pct(values, p):
    """The p-th percentile, nearest rank; None for none."""
    v = sorted(x for x in values if x is not None)
    if not v:
        return None
    return v[max(0, math.ceil(p / 100 * len(v)) - 1)]


def dist(values):
    v = [x for x in values if x is not None]
    if not v:
        return None
    return {"n": len(v), "p50": pct(v, 50), "p90": pct(v, 90), "max": max(v)}


def whole(x):
    return int(x) if x == int(x) else x


def hours(s):
    return whole(round(s / 3600, 2))


def minutes(s):
    return whole(round(s / 60, 1))


