# looper-build: the build pipeline (looper#17; tacplus-dev/roadmap
# decisions/deterministic-builds-2026-10-27.md). A build takes (repo, commit)
# as it is and gives a verdict, pass or fail, and on a release tag an image;
# it never changes the repository. The pipeline is gitlab.com/tacplus-dev/build
# (ci/build.gitlab-ci.yml here), whose jobs run this script:
#
#   plan     fetch exactly the commit, read its pin (tacplus.lock, or
#            build.lock: looper#71), and write the child pipeline whose gates
#            job runs in the pinned build image
#            (a nightly with no repository: the child pipeline of every
#            pinned repository's nightly, looper#164)
#   gates    in that image, with no agent: `just gates` on the commit, or the
#            gate set asked for from its gates.yaml (looper#71); a change to a
#            tracked file fails it; then the code it generates (a `generated`
#            recipe), for the security checks
#   scan     the child pipeline's security-<repo> job, in the looper image:
#            the security checks (looper-scan's, looper#49), then the
#            build's verdict, the commit status: the gates' reason, the
#            security checks', or pass (a release's is report-pass's, after
#            publish), the one status job of an ordinary build (looper#237)
#   verify   in that image too, on a release tag and on a verify run (the
#            nightly's, looper#74): `just verify`, the formal verification,
#            which no land runs (tacplus-dev/tacplus#275); a verify run skips
#            it when `just verify-changed <the last verified commit>` does not
#            print run. Its record is the job's artifact verify/
#   verify-report  the record as the repository's latest (the next verify
#            run's last verified commit), which the nightly scan files as bugs
#            when it is red (looper-verify)
#   gates-report  a nightly's gates verdict on main, as the repository's
#            latest, which the nightly scan reads instead of running the
#            gates (looper#73)
#   status   the GitHub commit status (context tacplus-dev/build): pending
#            (with the CI file's BUILD_CHILD_VERDICT, plan's, and its own
#            failure); scan's verdict; report-pass and report-fail (with
#            BUILD_CHILD_VERDICT, a release's alone). None on a nightly or
#            verify run
#   publish  on a release tag, a job of the child pipeline once every check
#            passed: the image, built with rootless BuildKit in a build image
#            that has it (BUILD_BUILDER_IMAGE: tacplus-image-build,
#            tacplus-dev/tacplus#315; no host Docker, looper#73), pushed to
#            Artifact Registry through Workload Identity Federation, and its
#            digest; with no such image, docker buildx on the Docker tags
#   sbom     the release image's SBOM, in the looper image (the scanners)
#   release-report  a branch release's verdict (looper#252): main's release
#            builds main-green, the commit the rolling check found green,
#            and a release/X.Y branch's its head; green, the release's record
#            moves to it, never back to an older commit, naming the tacplus
#            it was built with (looper#262), and its commit status
#            (tacplus-dev/release/<branch>) is green; main's that moved starts
#            fleet-seatrials' pipeline (a failed trigger logged, never red);
#            red, a record of the red one, which the nightly scan files as a bug
#
# Self-contained (no looper-lib.sh, no jq on the gates path): the plan embeds
# this very file in the gates job, which runs in the repository's pinned build
# image, not in the looper image.
#
# Credentials: GitHub only through the read-only tacplus-reader app
# (TACPLUS_READER_APP_ID, TACPLUS_READER_INSTALLATION_ID and the file variable
# TACPLUS_READER_APP_KEY, project variables of tacplus-dev/build, looper#12):
# each step mints its own one-hour installation token with the least
# permissions it needs. A job that holds a write credential (a looper's
# GH_TOKEN, GITLAB_TOKEN, ...) refuses to run.
set -euo pipefail

BUILD_ORG="${BUILD_ORG:-tacplus-dev}"
BUILD_GITHUB_URL="${BUILD_GITHUB_URL:-https://github.com}"
BUILD_GITHUB_API="${BUILD_GITHUB_API:-https://api.github.com}"
BUILD_OUT="${BUILD_OUT:-$PWD}"
BUILD_RUNNER_TAGS="${BUILD_RUNNER_TAGS:-arm64, build}"
BUILD_REGISTRY="${BUILD_REGISTRY:-us-docker.pkg.dev/jody1-328023/tacplus}"
BUILD_PLATFORMS="${BUILD_PLATFORMS:-linux/amd64,linux/arm64}"
# A branch release's verdict is a status of its own (looper#252): a commit
# green in a land's build is not yet released.
BUILD_STATUS_CONTEXT="${BUILD_STATUS_CONTEXT:-tacplus-dev/${BUILD_RELEASE:+release/}${BUILD_RELEASE:-build}}"
# The image the security checks run in (the looper image: the scanners), by
# default the one the plan runs in.
BUILD_SCAN_IMAGE="${BUILD_SCAN_IMAGE:-${CI_JOB_IMAGE:-ghcr.io/tacplus-dev/looper:main}}"
# The image publish runs in (looper#73): a build image with rootless BuildKit
# (tacplus-image-build, tacplus-dev/tacplus#315), by digest. Empty: none yet,
# and publish runs in the looper image with host Docker (docker buildx), on
# BUILD_DOCKER_TAGS, the runners that still mount the Docker socket.
BUILD_BUILDER_IMAGE="${BUILD_BUILDER_IMAGE:-}"
BUILD_DOCKER_TAGS="${BUILD_DOCKER_TAGS:-$BUILD_RUNNER_TAGS}"
# A nightly's jobs (looper#185), the fan-out's and each repository's: a nightly
# waits on nobody, a land's build waits on a run and blocks a queue, so the
# nightly never takes every build slot. It runs on BUILD_NIGHTLY_TAGS (a
# runner entry of its own whose concurrent leaves the pool room; by default
# the build runner's), and its fan-out BUILD_NIGHTLY_SLOTS repositories at a time.
BUILD_NIGHTLY_TAGS="${BUILD_NIGHTLY_TAGS:-$BUILD_RUNNER_TAGS}"
BUILD_NIGHTLY_SLOTS="${BUILD_NIGHTLY_SLOTS:-1}"
# A report's build (BUILD_REPORT, looper#195): a land's moves main, a report's
# only tells its run early, so at most BUILD_REPORT_SLOTS report gates run at
# once and the rest of the build pool is the lands' (an 18-land batch build
# once waited behind six report builds holding every slot ~55 min each).
BUILD_REPORT_SLOTS="${BUILD_REPORT_SLOTS:-4}"
# The build pool's nodes (looper#209: tacplus's gates pod takes a whole node,
# and the spot pool ran 2 when four report builds' gates filled it and a
# 24-land batch's first jobs got no pod for 15 min): report builds take at most
# one fewer, never under one, so a node is left to a land's build. Empty: no
# bound but BUILD_REPORT_SLOTS.
BUILD_POOL_NODES="${BUILD_POOL_NODES:-}"
# A report build's jobs (looper#209), on a runner entry of their own whose pods
# a land's build may preempt (a PriorityClass below the build runner's,
# tacplus-dev/cluster#42); by default the build runner's.
BUILD_REPORT_TAGS="${BUILD_REPORT_TAGS:-$BUILD_RUNNER_TAGS}"
# Gates that print nothing for BUILD_GATES_IDLE seconds are hung, and stopped
# (looper#195: a report build's job sat 1h52m silent after its test gate,
# holding a build slot until the hub cancelled it by hand).
BUILD_GATES_IDLE="${BUILD_GATES_IDLE:-3600}"
# The security job's requests and limits where it runs CodeQL (a nightly's
# and a release's, looper#189), as GitLab's KUBERNETES_* job variables:
# "<cpu> <memory> <cpu limit> <memory limit>", within the build runner's
# ceilings (3500m, 12Gi); looper-scan sizes CodeQL's --ram and --threads to
# the limits.
BUILD_SCAN_CODEQL_REQUESTS="${BUILD_SCAN_CODEQL_REQUESTS:-2 12Gi 3500m 12Gi}"
# A build's (looper#207: tacplus's took 49 minutes in the runner's default
# 1-CPU pod, its scanners one after another), in the same form: per
# repository, BUILD_SCAN_REQUESTS_<repo>, else BUILD_SCAN_REQUESTS. looper-scan
# runs its scanners side by side, as many as the job's CPUs. The requests fit
# a c4a-standard-4 node after its DaemonSets (tacplus-dev/cloud#87: 3, 10Gi).
BUILD_SCAN_REQUESTS="${BUILD_SCAN_REQUESTS:-2 8Gi 3500m 12Gi}"
# The gates job's (looper#202: tacplus's gates were OOM-killed in the
# runner's default 8Gi pod), per repository: BUILD_GATES_REQUESTS_<repo> (its
# name with any character but [A-Za-z0-9_] as _), in the same form; unset,
# the runner's defaults. A build project variable, so a nightly's fan-out
# plans read it too.
# The build runner's ceilings, "<cpu> <memory>" (tacplus-dev/cluster's
# gitlab-runner: its *_limit_overwrite_max_allowed), that both are within.
BUILD_RUNNER_CEILINGS="${BUILD_RUNNER_CEILINGS:-3500m 12Gi}"
# Host Docker's builder (buildx), and the emulators for a foreign platform, by digest.
BUILD_BUILDKIT_IMAGE="${BUILD_BUILDKIT_IMAGE:-moby/buildkit:v0.33.1@sha256:cec9f139f45e93c5c69c60f8b07cfad9f43f4ef6b6a6cd917527fea5ff2e3dea}"
BUILD_BINFMT_IMAGE="${BUILD_BINFMT_IMAGE:-tonistiigi/binfmt:qemu-v10.0.4@sha256:8f58e6214f4cc9dc83ce8f5acad1ece508eb6b20e696a8c1e9f274481982c541}"

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

usage() {
  cat <<'EOF'
usage: looper-build plan                  write build-gates.yml (the gates job, in the pinned image)
       looper-build gates                 just gates on the commit, in this directory's checkout
       looper-build gates-local           the gates of the checkout BUILD_SRC at BUILD_SHA (a looper VM's local build)
       looper-build status STATE [TEXT]   the commit status: pending, success or failure
       looper-build scan                  the security checks (looper-scan run, report), then the build's commit status
       looper-build publish [--dry-run]   the release image, its digest and archive (--dry-run: build only)
       looper-build sbom                  the release image's SBOM, of publish's archive (image.tar)
       looper-build verify                just verify on the commit (a verify run: when verify-changed says run)
       looper-build verify-report         the verify job's record, published as the repository's latest
       looper-build gates-report          a nightly's gates verdict, published as the repository's latest
       looper-build release-report        a branch release's verdict: its record moved forward, or its red one
Environment: BUILD_REPO, BUILD_SHA, BUILD_TAG (a release, vX.Y.Z), BUILD_RELEASE (a branch release: main, whose
commit is main-green's, or release/X.Y, its head, which the plan reads, BUILD_SHA empty; branches: each release/X.Y
branch with something new since its record; with BUILD_REPO empty, every pinned repository's), BUILD_RELEASE_REGISTRY,
GCP_RELEASE_WIF_PROVIDER and GCP_RELEASE_PUBLISH_SA (where a branch release publishes and as whom: its plan writes
them into its publish job; a tag's, BUILD_REGISTRY, GCP_WIF_PROVIDER and GCP_PUBLISH_SA), BUILD_NIGHTLY (true: the
nightly security checks of the main branch, whose head the plan reads when BUILD_SHA is empty; with BUILD_REPO
empty too, the plan's child pipeline is every pinned repository's nightly, BUILD_NIGHTLY_SLOTS of them at a
time; a nightly's jobs on BUILD_NIGHTLY_TAGS, default the build runner's), BUILD_VERIFY
(true: the formal verification of the main branch, likewise; BUILD_VERIFY_SINCE, _RESULT and _RUN: the last
record's verified commit, its result and run, which the plan reads), BUILD_GATES
(the commit's gates.yaml sets to run, joined by +; empty: its full, else just gates) and BUILD_BASE (their
LOOPER_GATES_BASE, a full hash), BUILD_BUILDER_IMAGE (the build image a release's publish runs in, with
rootless BuildKit; empty: the looper image, host Docker, on BUILD_DOCKER_TAGS), BUILD_WAIT (the requester's wait, in seconds: a gates job whose pipeline
is older runs no gates, and gates running longer are stopped, red), BUILD_GATES_IDLE (gates silent this many seconds are stopped, red; default 3600),
BUILD_GATES_REQUESTS_<repo> (the gates job's "<cpu> <memory> <cpu limit> <memory limit>"; unset, the runner's
defaults), BUILD_SCAN_REQUESTS_<repo> (a build's security job's, in the same form; unset,
BUILD_SCAN_REQUESTS, default 2 8Gi 3500m 12Gi), within BUILD_RUNNER_CEILINGS ("<cpu> <memory>", default 3500m 12Gi), the tacplus-reader
app (TACPLUS_READER_APP_ID, TACPLUS_READER_INSTALLATION_ID, TACPLUS_READER_APP_KEY); release-report's
BUILD_TACPLUS_COMMIT and BUILD_PIN_IMAGE (the plan's: the tacplus a release is built with, none for build.lock) and
BUILD_SEATRIALS_TRIGGER_TOKEN, BUILD_SEATRIALS_PROJECT (fleet-seatrials' pipeline trigger after a main release moved,
default tacplus-dev/fleet-seatrials; no token, none);
outputs go to BUILD_OUT (default: here).
EOF
}

log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

# A log's last two lines, one line with no colour, for a red verdict a report
# can read: the commit status shows it, the land's comment quotes it (looper#144).
log_tail() { # file
  sed 's/\x1b\[[0-9;]*[A-Za-z]//g; s/[[:cntrl:]]//g; s/^[[:space:]]*//; s/[[:space:]]*$//' "$1" 2>/dev/null | grep -v '^$' | tail -n 2 |
    awk '{ printf "%s%s", (NR > 1 ? "; " : ""), substr($0, 1, 200) } END { print "" }' || true
}

# The verdict, one line in $BUILD_OUT/build-verdict: "pass" or "fail: <why>".
# fail ends the job.
verdict() { # pass | fail <why>
  if [[ "$1" == pass ]]; then
    echo pass > "$BUILD_OUT/build-verdict"; log "verdict: pass"
  else
    shift; echo "fail: $*" > "$BUILD_OUT/build-verdict"; log "verdict: FAIL: $*"; exit 1
  fi
}

# --- inputs ---------------------------------------------------------------

check_inputs() {
  [[ "${BUILD_REPO:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$BUILD_REPO" != *..* ]] ||
    verdict fail "BUILD_REPO '${BUILD_REPO:-}' is not a repository name"
  [[ "${BUILD_SHA:-}" =~ ^[0-9a-f]{40}$ ]] ||
    [[ "${1:-}" == plan && -z "${BUILD_SHA:-}" && ("${BUILD_NIGHTLY:-}" == true || "${BUILD_VERIFY:-}" == true || -n "${BUILD_RELEASE:-}") ]] ||
    verdict fail "BUILD_SHA '${BUILD_SHA:-}' is not a full commit hash"
  if [[ -n "${BUILD_RELEASE:-}" ]]; then check_release_inputs "${1:-}"; fi
  [[ -z "${BUILD_TAG:-}" || "$BUILD_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    verdict fail "BUILD_TAG '$BUILD_TAG' is not a release tag vX.Y.Z"
  [[ "${BUILD_NIGHTLY:-}" != true || -z "${BUILD_TAG:-}" ]] || verdict fail "a nightly build is not a release (BUILD_TAG $BUILD_TAG)"
  if [[ "${BUILD_VERIFY:-}" == true ]]; then
    [[ -z "${BUILD_TAG:-}" ]] || verdict fail "a verify run is not a release (BUILD_TAG $BUILD_TAG): a release verifies in its own pipeline"
    [[ "${BUILD_NIGHTLY:-}" != true ]] || verdict fail "a verify run is not the nightly security checks (BUILD_NIGHTLY)"
  fi
  [[ -z "${BUILD_VERIFY_SINCE:-}" || "$BUILD_VERIFY_SINCE" =~ ^[0-9a-f]{40}$ ]] ||
    verdict fail "BUILD_VERIFY_SINCE '$BUILD_VERIFY_SINCE' is not a full commit hash"
  [[ "${BUILD_VERIFY_RESULT:-}" =~ ^(pass|fail)?$ ]] || verdict fail "BUILD_VERIFY_RESULT '$BUILD_VERIFY_RESULT' is not pass or fail"
  [[ "${BUILD_VERIFY_RUN:-}" =~ $RUN_URL ]] || verdict fail "BUILD_VERIFY_RUN '$BUILD_VERIFY_RUN' is not a pipeline's URL"
  [[ "${BUILD_GATES:-}" =~ ^([A-Za-z0-9_-]+(\+[A-Za-z0-9_-]+)*)?$ ]] ||
    verdict fail "BUILD_GATES '${BUILD_GATES:-}' is not a gate set (gates.yaml's set names, joined by +)"
  [[ -z "${BUILD_BASE:-}" || "$BUILD_BASE" =~ ^[0-9a-f]{40}$ ]] || verdict fail "BUILD_BASE '$BUILD_BASE' is not a full commit hash"
  [[ "${BUILD_WAIT:-}" =~ ^[0-9]*$ ]] || verdict fail "BUILD_WAIT '$BUILD_WAIT' is not a number of seconds"
  [[ "$BUILD_GATES_IDLE" =~ ^[0-9]{1,9}$ ]] && ((10#$BUILD_GATES_IDLE >= 1)) ||
    verdict fail "BUILD_GATES_IDLE '$BUILD_GATES_IDLE' is not a number of seconds (1 or more)"
  [[ "${BUILD_REPORT:-}" =~ ^(true|false)?$ ]] || verdict fail "BUILD_REPORT '$BUILD_REPORT' is not true or false"
  if [[ "${BUILD_REPORT:-}" == true ]]; then
    [[ -z "${BUILD_TAG:-}" && "${BUILD_NIGHTLY:-}" != true && "${BUILD_VERIFY:-}" != true ]] ||
      verdict fail "a report's build is not a release, a nightly or a verify run"
  fi
  if report_slotted; then
    [[ "$BUILD_REPORT_SLOTS" =~ ^[1-9][0-9]*$ ]] && ((BUILD_REPORT_SLOTS <= 100)) ||
      verdict fail "BUILD_REPORT_SLOTS '$BUILD_REPORT_SLOTS' is not a number of report builds at a time (1 to 100)"
    [[ -z "$BUILD_POOL_NODES" ]] || { [[ "$BUILD_POOL_NODES" =~ ^[1-9][0-9]{0,2}$ ]] ||
      verdict fail "BUILD_POOL_NODES '$BUILD_POOL_NODES' is not a number of build pool nodes (1 to 999)"; }
  fi
  [[ "$BUILD_RUNNER_CEILINGS" =~ ^$QUANTITY\ $QUANTITY$ ]] ||
    verdict fail "BUILD_RUNNER_CEILINGS '$BUILD_RUNNER_CEILINGS' is not \"<cpu> <memory>\""
  check_requests BUILD_SCAN_CODEQL_REQUESTS
  check_requests BUILD_SCAN_REQUESTS
  [[ -z "${!GATES_REQUESTS:-}" ]] || check_requests "$GATES_REQUESTS"
  [[ -z "${!SCAN_REQUESTS:-}" ]] || check_requests "$SCAN_REQUESTS"
}

# A branch release (looper#252): main or release/X.Y, the commit the plan's to
# resolve (never one asked for: main's is main-green's), its full gates, no
# wait, and nothing of a land's, a tag's, a nightly's or a verify run's.
RELEASE_BRANCH='^(main|release/[0-9]+\.[0-9]+)$'
check_release_inputs() { # [plan]
  [[ "$BUILD_RELEASE" =~ $RELEASE_BRANCH ]] ||
    verdict fail "BUILD_RELEASE '$BUILD_RELEASE' is not a release branch (main, release/X.Y; branches: the plan's fan-out)"
  [[ "$1" != plan || -z "${BUILD_SHA:-}" ]] ||
    verdict fail "a release of $BUILD_RELEASE builds the commit the plan resolves (main: main-green's), not BUILD_SHA $BUILD_SHA"
  [[ -z "${BUILD_TAG:-}" && "${BUILD_NIGHTLY:-}" != true && "${BUILD_VERIFY:-}" != true && "${BUILD_REPORT:-}" != true ]] ||
    verdict fail "a release of $BUILD_RELEASE is not a tag's release, a nightly, a verify run or a report's build"
  [[ -z "${BUILD_GATES:-}${BUILD_BASE:-}${BUILD_WAIT:-}" ]] ||
    verdict fail "a release of $BUILD_RELEASE runs its full gates with no base and no wait"
}

# A branch release's publish (looper#265): the release registry in tacplus-ci
# (tacplus-dev/cloud#115), as its one writer, through the provider that admits
# the build project's protected main alone; the plan writes them into its job,
# so it has them all, well formed, or plans nothing (red: its commit resolved,
# release-report records it): never the tags' registry.
check_release_registry() {
  local v
  for v in BUILD_RELEASE_REGISTRY GCP_RELEASE_WIF_PROVIDER GCP_RELEASE_PUBLISH_SA; do
    [[ -n "${!v:-}" ]] ||
      verdict fail "a release of $BUILD_RELEASE publishes to the release registry (tacplus-dev/cloud#115), and this pipeline does not set $v"
  done
  [[ "$BUILD_RELEASE_REGISTRY" =~ ^[a-z0-9.-]+(/[a-z0-9._-]+)+$ ]] ||
    verdict fail "BUILD_RELEASE_REGISTRY '$BUILD_RELEASE_REGISTRY' is not a registry's repository (<host>/<project>/<repository>)"
  [[ "$GCP_RELEASE_WIF_PROVIDER" =~ ^projects/[0-9]+/locations/global/workloadIdentityPools/[a-z0-9-]+/providers/[a-z0-9-]+$ ]] ||
    verdict fail "GCP_RELEASE_WIF_PROVIDER '$GCP_RELEASE_WIF_PROVIDER' is not a Workload Identity provider (projects/N/locations/global/workloadIdentityPools/P/providers/R)"
  [[ "$GCP_RELEASE_PUBLISH_SA" =~ ^[a-z][a-z0-9-]*@[a-z][a-z0-9-]*\.iam\.gserviceaccount\.com$ ]] ||
    verdict fail "GCP_RELEASE_PUBLISH_SA '$GCP_RELEASE_PUBLISH_SA' is not a service account"
}

# A release: a tag's (vX.Y.Z) or a branch's (looper#252).
is_release() { [[ -n "${BUILD_TAG:-}" || -n "${BUILD_RELEASE:-}" ]]; }
# A branch's name as a tag and a package version have it: main, release-1.2.
release_slug() { echo "${1//\//-}"; } # branch
# What a release publishes as: X.Y.Z, or <branch>-<commit, 12 hex> (main-0123456789ab).
release_version() {
  if [[ -n "${BUILD_TAG:-}" ]]; then echo "${BUILD_TAG#v}"; else echo "$(release_slug "$BUILD_RELEASE")-${BUILD_SHA:0:12}"; fi
}

# A Kubernetes quantity, as a request or a limit is (1, 3500m, 12Gi).
QUANTITY='[0-9]+(\.[0-9]+)?(m|[KMGTPE]i?)?'

# The variable that sizes this repository's gates job (BUILD_GATES_REQUESTS_<repo>).
GATES_REQUESTS="BUILD_GATES_REQUESTS_${BUILD_REPO:-}"; GATES_REQUESTS="${GATES_REQUESTS//[^A-Za-z0-9_]/_}"
# And its build's security job (BUILD_SCAN_REQUESTS_<repo>, looper#207).
SCAN_REQUESTS="BUILD_SCAN_REQUESTS_${BUILD_REPO:-}"; SCAN_REQUESTS="${SCAN_REQUESTS//[^A-Za-z0-9_]/_}"

# A quantity in thousandths of its unit (of a CPU, of a byte).
units() { # quantity
  awk -v q="$1" 'BEGIN {
    n = q; sub(/[A-Za-z]+$/, "", n); s = substr(q, length(n) + 1)
    f["m"] = 0.001; f[""] = 1; f["K"] = 1e3; f["M"] = 1e6; f["G"] = 1e9; f["T"] = 1e12; f["P"] = 1e15; f["E"] = 1e18
    f["Ki"] = 2^10; f["Mi"] = 2^20; f["Gi"] = 2^30; f["Ti"] = 2^40; f["Pi"] = 2^50; f["Ei"] = 2^60
    printf "%.0f\n", n * f[s] * 1000 }'
}
le() { awk -v a="$(units "$1")" -v b="$(units "$2")" 'BEGIN { exit !(a + 0 <= b + 0) }'; } # quantity quantity

# A job's "<cpu> <memory> <cpu limit> <memory limit>", in the variable named:
# four quantities, each request within its limit, the limits within the
# build runner's ceilings (a job past them is refused when it starts).
check_requests() { # variable
  local v="${!1}" r c
  [[ "$v" =~ ^$QUANTITY\ $QUANTITY\ $QUANTITY\ $QUANTITY$ ]] ||
    verdict fail "$1 '$v' is not \"<cpu> <memory> <cpu limit> <memory limit>\""
  read -r -a r <<<"$v"; read -r -a c <<<"$BUILD_RUNNER_CEILINGS"
  le "${r[0]}" "${r[2]}" && le "${r[1]}" "${r[3]}" || verdict fail "$1 '$v' asks more than its limit"
  le "${r[2]}" "${c[0]}" && le "${r[3]}" "${c[1]}" || verdict fail "$1 '$v' is past the build runner's ceilings ($BUILD_RUNNER_CEILINGS)"
}

# A job's KUBERNETES_* variables, of "<cpu> <memory> <cpu limit> <memory limit>".
k8s_requests() { # requests
  local r; read -r -a r <<<"$1"
  printf '    KUBERNETES_CPU_REQUEST: "%s"\n    KUBERNETES_MEMORY_REQUEST: "%s"\n    KUBERNETES_CPU_LIMIT: "%s"\n    KUBERNETES_MEMORY_LIMIT: "%s"\n' "${r[@]}"
}

# The security job's KUBERNETES_* variables: BUILD_SCAN_CODEQL_REQUESTS where
# it runs CodeQL, a nightly's and a release's (looper#189); a build's
# BUILD_SCAN_REQUESTS_<repo>, else BUILD_SCAN_REQUESTS (looper#207).
scan_requests() {
  if [[ "$(scan_kind)" != build ]]; then k8s_requests "$BUILD_SCAN_CODEQL_REQUESTS"
  else k8s_requests "${!SCAN_REQUESTS:-$BUILD_SCAN_REQUESTS}"; fi
}

# The gates job's (BUILD_GATES_REQUESTS_<repo>, looper#202); unset, none: the
# runner's defaults.
gates_requests() {
  [[ -z "${!GATES_REQUESTS:-}" ]] || k8s_requests "${!GATES_REQUESTS}"
}

# A run's URL, as a record names it (written into the child pipeline).
RUN_URL='^(https://[A-Za-z0-9./_~%-]+)?$'

# The kind of the security checks (looper-scan): release, nightly or build.
scan_kind() {
  if is_release; then echo release; elif [[ "${BUILD_NIGHTLY:-}" == true ]]; then echo nightly; else echo build; fi
}

# A build holds no credential that can change a repository: refuse to run
# beside one. The names are the loopers' (and GitHub's, GitLab's, Anthropic's);
# any other variable whose value is shaped like a personal or OAuth token
# (ghp_, github_pat_, gho_, ghu_, glpat-) is refused too. GCP_ID_TOKEN, the
# job's identity for Workload Identity Federation, only where it is allowed
# (publish).
WRITE_CREDENTIALS=(GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITLAB_TOKEN CLAUDE_CODE_OAUTH_TOKEN
                   ANTHROPIC_API_KEY GHCR_PUSH_TOKEN)
refuse_write_credentials() { # [allowed name...]
  local v found=() allowed=" $* "
  for v in "${WRITE_CREDENTIALS[@]}" GCP_ID_TOKEN; do
    [[ "$allowed" == *" $v "* ]] && continue
    [[ -n "${!v:-}" ]] && found+=("$v")
  done
  for v in $(compgen -e); do
    case "${!v:-}" in ghp_*|github_pat_*|gho_*|ghu_*|glpat-*) [[ " ${found[*]} " == *" $v "* ]] || found+=("$v") ;; esac
  done
  ((${#found[@]} == 0)) || verdict fail "this job holds a write credential (${found[*]}): a build must not"
}

# --- GitHub, read-only ------------------------------------------------------

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# A one-hour installation token of the tacplus-reader app, with only the
# permissions given ('"contents":"read"', ...), for the given repositories
# (none: every repository the app is installed on). Printed on stdout. The
# app's key is a file variable; only its signature leaves this process.
reader_token() { # permissions-json-members [repo...]
  local perms="$1" repos="" r now header payload jwt body resp token
  shift
  : "${TACPLUS_READER_APP_ID:?the tacplus-reader app id (TACPLUS_READER_APP_ID) is not set}"
  : "${TACPLUS_READER_INSTALLATION_ID:?TACPLUS_READER_INSTALLATION_ID is not set}"
  [[ -f "${TACPLUS_READER_APP_KEY:-}" ]] || { log "TACPLUS_READER_APP_KEY is not a file (a file variable of the build project)"; return 1; }
  for r in "$@"; do repos+="${repos:+,}\"$r\""; done
  now="$(date +%s)"
  header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
  payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$TACPLUS_READER_APP_ID" | b64url)"
  jwt="$header.$payload.$(printf '%s' "$header.$payload" | openssl dgst -sha256 -sign "$TACPLUS_READER_APP_KEY" | b64url)"
  body="{\"permissions\":{$perms}${repos:+,\"repositories\":[$repos]}}"
  resp="$(curl -fsS -X POST -H "Authorization: Bearer $jwt" -H 'Accept: application/vnd.github+json' \
            -d "$body" "$BUILD_GITHUB_API/app/installations/$TACPLUS_READER_INSTALLATION_ID/access_tokens")" ||
    { log "GitHub refused the tacplus-reader app a token"; return 1; }
  token="$(printf '%s' "$resp" | tr -d '\n' | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  [[ -n "$token" ]] || { log "no token in GitHub's answer"; return 1; }
  printf '%s\n' "$token"
}

# Git authenticates to GitHub, and to no other host, with $BUILD_GITHUB_TOKEN,
# through its environment alone (as DOCKER_GITHUB_CREDS in looper-lib.sh): the
# empty value first drops any other helper for that host, so none stores it.
# shellcheck disable=SC2016  # expanded by git's shell, when git asks
git_credentials() {
  export GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=2
  export GIT_CONFIG_KEY_0="credential.$BUILD_GITHUB_URL.helper" GIT_CONFIG_VALUE_0=
  export GIT_CONFIG_KEY_1="credential.$BUILD_GITHUB_URL.helper"
  export GIT_CONFIG_VALUE_1='!f() { test "$1" = get || exit 0; test -n "$BUILD_GITHUB_TOKEN" || exit 0; echo username=x-access-token; echo "password=$BUILD_GITHUB_TOKEN"; }; f'
}

repo_url() { echo "$BUILD_GITHUB_URL/$BUILD_ORG/$BUILD_REPO.git"; }

# Exactly the commit, nothing else, into dir.
fetch_commit() { # dir
  rm -rf "$1"; git init -q "$1"
  git -C "$1" remote add origin "$(repo_url)"
  git -C "$1" fetch -q --depth 1 origin "$BUILD_SHA" 2>&1 | tail -5 >&2 || true
  git -C "$1" rev-parse -q --verify "FETCH_HEAD^{commit}" >/dev/null 2>&1 ||
    verdict fail "$BUILD_ORG/$BUILD_REPO has no commit $BUILD_SHA (or it cannot be read)"
  git -C "$1" -c advice.detachedHead=false checkout -q FETCH_HEAD
  [[ "$(git -C "$1" rev-parse HEAD)" == "$BUILD_SHA" ]] || verdict fail "checked out $(git -C "$1" rev-parse HEAD), not $BUILD_SHA"
}

# The source credential must not be able to push: GitHub refuses a push
# (even --dry-run asks for the receive-pack) with a read-only token.
refuse_push_credential() { # dir
  if git -C "$1" push -q --dry-run origin "HEAD:refs/heads/looper-build-push-probe" >/dev/null 2>&1; then
    verdict fail "the source credential can push to $BUILD_ORG/$BUILD_REPO: a build's must be read-only"
  fi
  log "the source credential cannot push (refused, as it must be)"
}

# --- the pin ----------------------------------------------------------------

# tacplus.lock, as tacplus validates it (pkg/tacplusyaml/lock.go): an exact
# release and the build image by digest, of the same line. A repository that
# is no tacplus project (the looper's, looper#71) pins its build image alone,
# by digest, in build.lock, in the same form (`build_image: <image>`). Prints
# the image.
PIN_IMAGE='^[a-z0-9][a-z0-9._/-]*(:([A-Za-z0-9_][A-Za-z0-9._-]*))?@sha256:[0-9a-f]{64}$'
read_pin() { # dir
  local lock="$1/tacplus.lock" version image tag
  if [[ ! -f "$lock" && -f "$1/build.lock" ]]; then
    image="$(sed -n 's/^build_image:[[:space:]]*"\{0,1\}\([^"[:space:]]*\)"\{0,1\}[[:space:]]*$/\1/p' "$1/build.lock" | head -1)"
    [[ "$image" =~ $PIN_IMAGE ]] ||
      verdict fail "build.lock: build_image: '$image' must name the image by digest (<name>[:<tag>]@sha256:<64 hex>)"
    echo "$image"; return 0
  fi
  [[ -f "$lock" ]] || verdict fail "no pin: $BUILD_REPO has no tacplus.lock (nor build.lock) at $BUILD_SHA (run \`tacplus pin\` and commit it)"
  version="$(pin_version "$1")"
  image="$(sed -n 's/^build_image:[[:space:]]*"\{0,1\}\([^"[:space:]]*\)"\{0,1\}[[:space:]]*$/\1/p' "$lock" | head -1)"
  [[ "$version" =~ ^([0-9]+)\.([0-9]+)\.[0-9]+$ ]] ||
    verdict fail "tacplus.lock: tacplus: '$version' must be an exact MAJOR.MINOR.PATCH release"
  local line="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
  [[ "$image" =~ $PIN_IMAGE ]] ||
    verdict fail "tacplus.lock: build_image: '$image' must name the image by digest (<name>[:<tag>]@sha256:<64 hex>)"
  tag="${BASH_REMATCH[2]}"
  if [[ "$tag" =~ ^([0-9]+)\.([0-9]+)\.[0-9]+$ && "${BASH_REMATCH[1]}.${BASH_REMATCH[2]}" != "$line" ]]; then
    verdict fail "tacplus.lock: build_image '$image' is not of the pin's line $line"
  fi
  echo "$image"
}

# tacplus.lock's release (X.Y.Z, as read_pin checked it); none, a build.lock's.
pin_version() { # dir
  [[ -f "$1/tacplus.lock" ]] || return 0
  sed -n 's/^tacplus:[[:space:]]*"\{0,1\}\([^"[:space:]]*\)"\{0,1\}[[:space:]]*$/\1/p' "$1/tacplus.lock" | head -1
}

# The tacplus a branch release is built with (looper#262; the decision's D4,
# consumers checked against the release's digest before they deploy): the
# commit of its pin's release, tag vX.Y.Z of tacplus-dev/tacplus, read with a
# token of its own for that repository alone. Prints the commit; none it can
# read fails the plan, and so the release is red: a record naming no tacplus
# is one fleet-seatrials would refuse.
pin_tacplus_commit() { # scratch-git-dir version
  local token at
  token="$(reader_token '"contents":"read","metadata":"read"' tacplus)" ||
    verdict fail "the tacplus $BUILD_REPO is built with cannot be told: no read-only token for $BUILD_ORG/tacplus (the tacplus-reader app)"
  at="$(BUILD_GITHUB_TOKEN="$token" git -C "$1" ls-remote "$BUILD_GITHUB_URL/$BUILD_ORG/tacplus.git" "refs/tags/v$2" "refs/tags/v$2^{}" 2>/dev/null |
          awk 'NR==1 || /\^\{\}$/ {c=$1} END {print c}')" || true
  [[ "$at" =~ ^[0-9a-f]{40}$ ]] ||
    verdict fail "the tacplus $BUILD_REPO is built with cannot be told: $BUILD_ORG/tacplus has no tag v$2 (or it cannot be read)"
  echo "$at"
}

# A release: the build project's pipeline runs on its protected tag
# <repo>/vX.Y.Z (what Workload Identity Federation trusts, tacplus#223), and
# the repository's tag vX.Y.Z is the commit built.
#
# A branch's (looper#252) runs on the build project's protected main, which
# GCP trusts too (tacplus-dev/cloud's binding), and its commit is the one its
# plan resolved, carried in every job: nothing resolves it again.
check_release() { # dir
  if [[ -n "${BUILD_RELEASE:-}" ]]; then
    [[ "${CI_COMMIT_REF_NAME:-}" == main && -z "${CI_COMMIT_TAG:-}" && "${CI_COMMIT_REF_PROTECTED:-}" == true ]] ||
      verdict fail "a release of $BUILD_REPO $BUILD_RELEASE runs on the build project's protected main, not '${CI_COMMIT_REF_NAME:-}'"
    return 0
  fi
  [[ -n "${BUILD_TAG:-}" ]] || return 0
  [[ "${CI_COMMIT_TAG:-}" == "$BUILD_REPO/$BUILD_TAG" ]] ||
    verdict fail "a release build of $BUILD_REPO $BUILD_TAG runs on the build project's protected tag $BUILD_REPO/$BUILD_TAG, not '${CI_COMMIT_REF_NAME:-}'"
  local at
  at="$(git -C "$1" ls-remote origin "refs/tags/$BUILD_TAG^{}" "refs/tags/$BUILD_TAG" | awk 'NR==1 || /\^\{\}$/ {c=$1} END {print c}')"
  [[ "$at" == "$BUILD_SHA" ]] || verdict fail "$BUILD_REPO's tag $BUILD_TAG is at '${at:-nothing}', not $BUILD_SHA"
}

# --- plan -------------------------------------------------------------------

cmd_plan() {
  refuse_write_credentials
  if [[ "${BUILD_NIGHTLY:-}" == true && -z "${BUILD_REPO:-}${BUILD_SHA:-}${BUILD_TAG:-}${BUILD_RELEASE:-}" && "${BUILD_VERIFY:-}" != true ]]; then
    plan_fanout; return 0
  fi
  if [[ "${BUILD_RELEASE:-}" == branches || ( -n "${BUILD_RELEASE:-}" && -z "${BUILD_REPO:-}" ) ]]; then
    plan_release_fanout; return 0
  fi
  check_inputs plan
  [[ "${BUILD_NIGHTLY:-}" != true ]] || BUILD_RUNNER_TAGS="$BUILD_NIGHTLY_TAGS"
  [[ "${BUILD_REPORT:-}" != true ]] || BUILD_RUNNER_TAGS="$BUILD_REPORT_TAGS"
  mkdir -p "$BUILD_OUT"
  BUILD_GITHUB_TOKEN="$(reader_token '"contents":"read","metadata":"read"' "$BUILD_REPO")" ||
    verdict fail "no read-only GitHub token (the tacplus-reader app)"
  export BUILD_GITHUB_TOKEN; git_credentials
  local src="$BUILD_OUT/plan-src" image
  if [[ -n "${BUILD_RELEASE:-}" ]]; then   # a branch release: main-green's commit, or the branch's head
    rm -rf "$src"; git init -q "$src"
    BUILD_SHA="$(release_head "$src" "$BUILD_REPO" "$BUILD_RELEASE")" ||
      verdict fail "$BUILD_ORG/$BUILD_REPO has no $(release_ref "$BUILD_RELEASE" | sed 's:^refs/heads/::')$([[ "$BUILD_RELEASE" != main ]] || echo " (the commit of main the rolling check found green, looper#249)"): nothing to release"
    echo "$BUILD_SHA" > "$BUILD_OUT/build-sha"
    log "release: $BUILD_REPO $BUILD_RELEASE is $BUILD_SHA ($(release_ref "$BUILD_RELEASE"))"
    check_release_registry
  elif [[ -z "${BUILD_SHA:-}" ]]; then   # a nightly or a verify run: the main branch as it is now
    # From a repository of its own: the one it runs in (an Actions checkout's
    # extraheader, looper#58) has no say in what GitHub is sent.
    rm -rf "$src"; git init -q "$src"
    BUILD_SHA="$(git -C "$src" ls-remote "$(repo_url)" refs/heads/main 2>/dev/null | cut -f1)" || true
    [[ "$BUILD_SHA" =~ ^[0-9a-f]{40}$ ]] || verdict fail "$BUILD_ORG/$BUILD_REPO has no main branch to scan"
    log "$([[ "${BUILD_VERIFY:-}" == true ]] && echo verify || echo nightly): $BUILD_REPO main is $BUILD_SHA"
  fi
  # A verify run's change check is against the last record's verified commit;
  # a release verifies with no change check.
  BUILD_VERIFY_SINCE=""; BUILD_VERIFY_RESULT=""; BUILD_VERIFY_RUN=""
  [[ "${BUILD_VERIFY:-}" != true ]] || verify_last
  fetch_commit "$src"
  check_release "$src"
  image="$(read_pin "$src")"
  BUILD_TACPLUS_COMMIT=""
  if [[ -n "${BUILD_RELEASE:-}" ]]; then
    local version; version="$(pin_version "$src")"
    if [[ -z "$version" ]]; then BUILD_TACPLUS_COMMIT=none; log "release: $BUILD_REPO pins build.lock: no tacplus it is built with"
    else
      BUILD_TACPLUS_COMMIT="$(pin_tacplus_commit "$src" "$version")"
      log "release: $BUILD_REPO is built with tacplus $version, ${BUILD_TACPLUS_COMMIT:0:12}, in $image"
    fi
  fi
  rm -rf "$src"
  write_gates_pipeline "$image" > "$BUILD_OUT/build-gates.yml"
  if [[ "${BUILD_VERIFY:-}" == true ]]; then
    log "plan: $BUILD_REPO $BUILD_SHA: the formal verification in $image, if changed since ${BUILD_VERIFY_SINCE:-(no record: it runs)}"
  else
    log "plan: $BUILD_REPO $BUILD_SHA${BUILD_TAG:+ ($BUILD_TAG)}${BUILD_RELEASE:+ (a release of $BUILD_RELEASE, as $(release_version))} gates in $image, security checks ($(scan_kind)) in $BUILD_SCAN_IMAGE$(! is_release || echo ", the formal verification")"
  fi
  ! report_slotted ||
    log "plan: $(if [[ "${BUILD_NIGHTLY:-}" == true ]]; then echo "a nightly"; else echo "a report's build"; fi): its gates in $(report_slot), $(report_slots) report builds at a time$(report_bound), its jobs on $BUILD_RUNNER_TAGS; a land's build holds no slot"
  if is_release && [[ -n "$BUILD_BUILDER_IMAGE" ]]; then
    log "plan: publish in $BUILD_BUILDER_IMAGE (rootless BuildKit) on $BUILD_RUNNER_TAGS"
  elif is_release; then
    log "plan: publish needs host Docker (no BUILD_BUILDER_IMAGE, a build image with tacplus-image-build): on $BUILD_DOCKER_TAGS"
  fi
}

# The nightly of every repository (looper#164): GitLab allows a project 10
# pipeline schedules and the org has more repositories (tacplus-dev/cloud#65),
# so a nightly with no repository is one pipeline. Its plan lists the org's
# repositories the tacplus-reader app is installed on, not archived (as the
# looper's own scan lists them), and keeps those whose main pins a build image
# (tacplus.lock or build.lock: the cutover's rule, looper#71). Its child
# pipeline has, per repository, that repository's nightly as it runs alone:
# its plan job (this command, with BUILD_REPO), and the gates and security
# checks' pipeline that job writes, triggered with strategy: depend. Each
# trigger needs its own plan alone, so one repository's failure stops no
# other's; the fan-out is red when one is. Two levels below the build's own
# pipeline, GitLab's limit. No commit status: no commit's verdict. A few at a
# time (looper#185): the nth repository's plan and trigger hold the resource
# group nightly-slot-<n mod BUILD_NIGHTLY_SLOTS>, the trigger (strategy:
# depend) until its child pipeline is done, so the nightly finishes but never
# fills the build pool; all on BUILD_NIGHTLY_TAGS.
plan_fanout() {
  mkdir -p "$BUILD_OUT"
  local token list r pinned=() unpinned=()
  [[ "$BUILD_NIGHTLY_SLOTS" =~ ^[1-9][0-9]*$ ]] && ((BUILD_NIGHTLY_SLOTS <= 100)) ||
    verdict fail "BUILD_NIGHTLY_SLOTS '$BUILD_NIGHTLY_SLOTS' is not a number of repositories at a time (1 to 100)"
  token="$(reader_token '"contents":"read","metadata":"read"')" || verdict fail "no read-only GitHub token (the tacplus-reader app)"
  list="$(org_repos "$token")" || verdict fail "cannot list the repositories of $BUILD_ORG (the tacplus-reader app's installation)"
  for r in $list; do
    if ! [[ "$r" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$r" != *..* ]]; then log "fan-out: '$r' is not a repository name: skipped"
    elif pins_build_image "$token" "$r"; then pinned+=("$r")
    else unpinned+=("$r"); fi
  done
  ((${#pinned[@]})) || verdict fail "no repository of $BUILD_ORG pins its build image on main (tacplus.lock, build.lock)"
  write_fanout_pipeline "${pinned[@]}" > "$BUILD_OUT/build-gates.yml"
  log "plan: the nightly of ${#pinned[@]} repositories of $BUILD_ORG, $BUILD_NIGHTLY_SLOTS at a time on $BUILD_NIGHTLY_TAGS: ${pinned[*]}; no pin on main: ${unpinned[*]:-none}"
}

# The org's repositories the app's installation reads, not archived, by name, sorted.
org_repos() { # token
  local page=1 resp n
  while :; do
    resp="$(curl -fsS -H "Authorization: Bearer $1" -H 'Accept: application/vnd.github+json' \
              "$BUILD_GITHUB_API/installation/repositories?per_page=100&page=$page")" || return 1
    n="$(jq '.repositories | length' <<<"$resp")" || return 1
    jq -r --arg o "$BUILD_ORG" '.repositories[] | select(.owner.login == $o and (.archived | not)) | .name' <<<"$resp" || return 1
    ((n == 100)) || break
    page=$((page + 1))
  done | LC_ALL=C sort -u
  return "${PIPESTATUS[0]}"
}

# Whether the repository's main pins its build image: GitHub's 200 for a pin
# file, 404 for none; any other answer fails the plan rather than drop it.
pins_build_image() { # token repo
  local f code
  for f in tacplus.lock build.lock; do
    code="$(curl -sS -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $1" -H 'Accept: application/vnd.github+json' \
              "$BUILD_GITHUB_API/repos/$BUILD_ORG/$2/contents/$f?ref=main")" || code="${code:-000}"
    case "$code" in
      200) return 0 ;;
      404) ;;
      *) verdict fail "cannot tell whether $BUILD_ORG/$2 pins its build image: GitHub answered $code for $f" ;;
    esac
  done
  return 1
}

write_fanout_pipeline() { # repo...
  local r slot n=0
  echo "# Written by looper-build plan: the nightly of each repository of $BUILD_ORG whose main pins its build image."
  cat <<'EOF'
default:
  retry:
    max: 2
    when: [runner_system_failure, scheduler_failure, unknown_failure, runner_external_dependency_failure, api_failure]
stages: [plan, nightly]
EOF
  for r in "$@"; do
    slot="nightly-slot-$((n++ % BUILD_NIGHTLY_SLOTS))"
    cat <<EOF
nightly-plan-$r:
  stage: plan
  image: "$BUILD_SCAN_IMAGE"
  tags: [$BUILD_NIGHTLY_TAGS]
  resource_group: $slot
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$r"
    BUILD_SHA: ""
    BUILD_ORG: "$BUILD_ORG"
    BUILD_NIGHTLY: "true"
    BUILD_NIGHTLY_TAGS: "$BUILD_NIGHTLY_TAGS"
    BUILD_REPORT_SLOTS: "$BUILD_REPORT_SLOTS"
    BUILD_POOL_NODES: "$BUILD_POOL_NODES"
  script:
    - looper-build plan
  artifacts:
    when: always
    expire_in: 30 days
    paths: [build-gates.yml, build-verdict]
nightly-$r:
  stage: nightly
  needs: [nightly-plan-$r]
  resource_group: $slot
  trigger:
    include:
      - artifact: build-gates.yml
        job: nightly-plan-$r
    strategy: depend
    forward:
      yaml_variables: false
      pipeline_variables: false
EOF
  done
}

# A branch release's commit (looper#252): main's is main-green's, the last
# commit of main the rolling check found green (looper#249), never main's
# head, which no check may have built; a release/X.Y branch's is its head,
# which its own release build checks. Read once, by the plan.
release_ref() { # branch
  if [[ "$1" == main ]]; then echo refs/heads/main-green; else echo "refs/heads/$1"; fi
}
release_head() { # scratch-git-dir repo branch
  local c
  c="$(git -C "$1" ls-remote "$BUILD_GITHUB_URL/$BUILD_ORG/$2.git" "$(release_ref "$3")" 2>/dev/null | cut -f1)" || return 1
  [[ "$c" =~ ^[0-9a-f]{40}$ ]] || return 1
  echo "$c"
}

# A release's records (looper#252): the build project's generic package
# release-<repo>, version <branch> (main, release-1.2): record, the release a
# deployment rolls to (repo, branch, commit, image by digest, run, at), and
# red, the last red one (repo, branch, commit, why, run, at).
release_url() { # repo branch file
  echo "$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/release-$1/$(release_slug "$2")/$3"
}
# A record's field, read with the job's token; nothing when there is none.
release_field() { # repo branch file key
  [[ -n "${CI_JOB_TOKEN:-}" && -n "${CI_API_V4_URL:-}" && -n "${CI_PROJECT_ID:-}" ]] || return 0
  { curl -fsS -H "JOB-TOKEN: $CI_JOB_TOKEN" "$(release_url "$1" "$2" "$3")" 2>/dev/null || true; } | sed -n "s/^$4 //p" | tail -n 1
}

# The release builds of many (looper#252), one pipeline as a nightly's
# fan-out is (GitLab's 10 schedules a project): BUILD_RELEASE main, every
# pinned repository's main (BUILD_REPO empty), or branches, each release/X.Y
# branch of BUILD_REPO or of every pinned repository. A branch is built when it
# has something new: its commit (main-green's, a release branch's head) not
# its record's. A main with no main-green yet is no release, said so. Each
# one's plan and trigger, as the nightly's, on BUILD_NIGHTLY_TAGS and in its
# slots (a release waits on nobody: the lands' builds never wait behind it).
plan_release_fanout() {
  mkdir -p "$BUILD_OUT"
  local token list r b br c had scratch="$BUILD_OUT/plan-src" pairs=() skipped=()
  [[ "$BUILD_RELEASE" == branches || "$BUILD_RELEASE" =~ $RELEASE_BRANCH ]] ||
    verdict fail "BUILD_RELEASE '$BUILD_RELEASE' is not a release branch (main, release/X.Y) or branches"
  [[ -z "${BUILD_SHA:-}${BUILD_TAG:-}" && "${BUILD_NIGHTLY:-}" != true && "${BUILD_VERIFY:-}" != true ]] ||
    verdict fail "a release's fan-out resolves each commit itself: no sha, tag, nightly or verify run"
  check_release_registry
  [[ -z "${BUILD_REPO:-}" || ( "$BUILD_REPO" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$BUILD_REPO" != *..* ) ]] ||
    verdict fail "BUILD_REPO '$BUILD_REPO' is not a repository name"
  [[ "$BUILD_NIGHTLY_SLOTS" =~ ^[1-9][0-9]*$ ]] && ((BUILD_NIGHTLY_SLOTS <= 100)) ||
    verdict fail "BUILD_NIGHTLY_SLOTS '$BUILD_NIGHTLY_SLOTS' is not a number of repositories at a time (1 to 100)"
  token="$(reader_token '"contents":"read","metadata":"read"')" || verdict fail "no read-only GitHub token (the tacplus-reader app)"
  if [[ -n "${BUILD_REPO:-}" ]]; then list="$BUILD_REPO"
  else
    list="$(org_repos "$token")" || verdict fail "cannot list the repositories of $BUILD_ORG (the tacplus-reader app's installation)"
  fi
  BUILD_GITHUB_TOKEN="$token"; export BUILD_GITHUB_TOKEN; git_credentials
  rm -rf "$scratch"; git init -q "$scratch"
  for r in $list; do
    if ! [[ "$r" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$r" != *..* ]]; then log "release: '$r' is not a repository name: skipped"; continue; fi
    [[ -n "${BUILD_REPO:-}" ]] || pins_build_image "$token" "$r" || continue
    if [[ "$BUILD_RELEASE" == branches ]]; then
      b="$(git -C "$scratch" ls-remote "$BUILD_GITHUB_URL/$BUILD_ORG/$r.git" 'refs/heads/release/*')" ||
        verdict fail "cannot list the release branches of $BUILD_ORG/$r"
      b="$(sed -n 's:^[0-9a-f]*\trefs/heads/::p' <<<"$b" | { grep -E "$RELEASE_BRANCH" || true; } | LC_ALL=C sort -V)"
    else b="$BUILD_RELEASE"; fi
    for br in $b; do
      if ! c="$(release_head "$scratch" "$r" "$br")"; then skipped+=("$r $br (no $(release_ref "$br" | sed 's:^refs/heads/::'))"); continue; fi
      had="$(release_field "$r" "$br" record commit)"
      if [[ "$had" == "$c" ]]; then skipped+=("$r $br (nothing new: ${c:0:7} is its release)"); continue; fi
      pairs+=("$r $br")
    done
  done
  rm -rf "$scratch"
  write_release_fanout_pipeline "${pairs[@]}" > "$BUILD_OUT/build-gates.yml"
  log "plan: the release of ${#pairs[@]} branches of $BUILD_ORG, $BUILD_NIGHTLY_SLOTS at a time on $BUILD_NIGHTLY_TAGS: $( ((${#pairs[@]})) && printf '%s, ' "${pairs[@]}" | sed 's/, $//' || echo none); skipped: $( ((${#skipped[@]})) && printf '%s, ' "${skipped[@]}" | sed 's/, $//' || echo none)"
}

write_release_fanout_pipeline() { # "repo branch"...
  local p r b j slot n=0
  echo "# Written by looper-build plan: the release of each branch of $BUILD_ORG with something new (looper#252)."
  cat <<'EOF'
default:
  retry:
    max: 2
    when: [runner_system_failure, scheduler_failure, unknown_failure, runner_external_dependency_failure, api_failure]
stages: [plan, release]
EOF
  # GitLab refuses a child pipeline with no job: nothing new is one saying so.
  if (($# == 0)); then
    cat <<EOF
nothing-new:
  stage: plan
  image: "$BUILD_SCAN_IMAGE"
  tags: [$BUILD_NIGHTLY_TAGS]
  variables:
    GIT_STRATEGY: none
  script:
    - echo "no branch of $BUILD_ORG has anything new to release"
EOF
    return 0
  fi
  for p in "$@"; do
    r="${p% *}"; b="${p#* }"; j="$r-$(release_slug "$b")"
    slot="nightly-slot-$((n++ % BUILD_NIGHTLY_SLOTS))"
    cat <<EOF
release-plan-$j:
  stage: plan
  image: "$BUILD_SCAN_IMAGE"
  tags: [$BUILD_NIGHTLY_TAGS]
  resource_group: $slot
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$r"
    BUILD_SHA: ""
    BUILD_ORG: "$BUILD_ORG"
    BUILD_RELEASE: "$b"
    BUILD_RELEASE_REGISTRY: "$BUILD_RELEASE_REGISTRY"
    GCP_RELEASE_WIF_PROVIDER: "$GCP_RELEASE_WIF_PROVIDER"
    GCP_RELEASE_PUBLISH_SA: "$GCP_RELEASE_PUBLISH_SA"
    BUILD_NIGHTLY_TAGS: "$BUILD_NIGHTLY_TAGS"
  script:
    - looper-build plan || { looper-build release-report || true; exit 1; }
  artifacts:
    when: always
    expire_in: 30 days
    paths: [build-gates.yml, build-verdict, build-sha]
release-$j:
  stage: release
  needs: [release-plan-$j]
  resource_group: $slot
  trigger:
    include:
      - artifact: build-gates.yml
        job: release-plan-$j
    strategy: depend
    forward:
      yaml_variables: false
      pipeline_variables: false
EOF
  done
}

# The child pipeline: the gates job, in the pinned image, running this
# script; the security checks (looper-scan, looper#49) in the looper image,
# on the commit and on the code the gates generated; and on a release, the
# formal verification (looper#74). A verify run's is the verification alone.
write_gates_pipeline() { # image
  echo "# Written by looper-build plan: $BUILD_REPO at $BUILD_SHA, in its pinned build image."
  # A job whose runner is lost (its spot VM preempted) runs again, as the
  # parent's do: their default does not reach this child pipeline (looper#148).
  # Not on stuck_or_timeout_failure: the gates' 11h timeout is their own.
  cat <<'EOF'
default:
  retry:
    max: 2
    when: [runner_system_failure, scheduler_failure, unknown_failure, runner_external_dependency_failure, api_failure]
EOF
  if [[ "${BUILD_VERIFY:-}" != true ]]; then gates_jobs "$1"; fi
  if [[ "${BUILD_VERIFY:-}" == true ]] || is_release; then verify_jobs "$1"; fi
  if is_release; then publish_jobs; fi
  if [[ -n "${BUILD_RELEASE:-}" ]]; then release_report_job "$1"; fi
}

# A job's script: this very script, embedded, run with the command given.
embedded_script() { # command
  cat <<'EOF'
  script:
    - |
      cat > "$CI_PROJECT_DIR/looper-build" <<'LOOPER_BUILD_EOF'
EOF
  sed 's/^/      /' "$SELF"
  cat <<EOF
      LOOPER_BUILD_EOF
      bash "\$CI_PROJECT_DIR/looper-build" $1
EOF
}

# A report's build's slot (looper#195): the resource group its gates job
# holds, report-slot-<its pipeline's id mod report_slots>. GitLab starts
# one job of a resource group at a time, and one waiting for it holds no
# runner, so a land's build, queued later, still finds one.
report_slot() {
  local id="${CI_PIPELINE_ID:-0}"; [[ "$id" =~ ^[0-9]{1,18}$ ]] || id=0
  echo "report-slot-$(( 10#$id % $(report_slots) ))"
}
# A build whose gates hold a report slot: no land's (looper#209), a report's
# (BUILD_REPORT) or a repository's nightly, never a release or a verify run.
report_slotted() {
  [[ -z "${BUILD_TAG:-}" && "${BUILD_VERIFY:-}" != true ]] && [[ "${BUILD_REPORT:-}" == true || "${BUILD_NIGHTLY:-}" == true ]]
}
# The report builds at a time: BUILD_REPORT_SLOTS, below BUILD_POOL_NODES when
# it is set (looper#209), and at least one.
report_slots() {
  local s="$BUILD_REPORT_SLOTS"
  if [[ -n "$BUILD_POOL_NODES" ]] && (( BUILD_POOL_NODES - 1 < s )); then s=$(( BUILD_POOL_NODES > 1 ? BUILD_POOL_NODES - 1 : 1 )); fi
  echo "$s"
}
report_bound() {
  [[ "$(report_slots)" != "$BUILD_REPORT_SLOTS" ]] || return 0
  echo " (BUILD_REPORT_SLOTS $BUILD_REPORT_SLOTS, held below the build pool's $BUILD_POOL_NODES nodes, BUILD_POOL_NODES: a node is left to a land's build)"
}

gates_jobs() { # image
  # The gates' own timeout, a report job's longest (repo-looper's
  # JOB_MAX_HOURS): tacplus's full gates take over 3h, and the project's
  # default ended them at 1h (looper#140). A report's holds its slot (looper#195),
  # and so does a nightly's (looper#209).
  local slot=""; ! report_slotted || slot="
  resource_group: $(report_slot)"
  cat <<EOF
gates:
  image: "$1"
  tags: [$BUILD_RUNNER_TAGS]$slot
  timeout: 11h
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_TAG: "${BUILD_TAG:-}"
    BUILD_RELEASE: "${BUILD_RELEASE:-}"
    BUILD_ORG: "$BUILD_ORG"
    BUILD_GATES: "${BUILD_GATES:-}"
    BUILD_BASE: "${BUILD_BASE:-}"
    BUILD_WAIT: "$([[ -n "${BUILD_TAG:-}" || "${BUILD_NIGHTLY:-}" == true ]] || echo "${BUILD_WAIT:-}")"
EOF
  gates_requests
  embedded_script gates
  cat <<'EOF'
  artifacts:
    when: always
    expire_in: 30 days
    paths: [gates.log, build-verdict, built/, generated/]
EOF
  # The security checks, then the build's verdict on the commit as this
  # build's (the parent's pipeline: BUILD_STATUS_URL): cmd_scan, one job where
  # gates-failed, security-report, security-failed and report-pass were
  # (looper#237: GitLab's free plan counts every job of the alive pipelines).
  # A nightly's sets none: its findings are filed, the commit is main's.
  local nightly=""; [[ "${BUILD_NIGHTLY:-}" != true ]] || nightly='
    BUILD_NIGHTLY: "true"'
  cat <<EOF
security-$BUILD_REPO:
  image: "$BUILD_SCAN_IMAGE"
  tags: [$BUILD_RUNNER_TAGS]
  needs: [{job: gates, artifacts: true}]
  when: always
  timeout: 3h
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_TAG: "${BUILD_TAG:-}"
    BUILD_RELEASE: "${BUILD_RELEASE:-}"
    BUILD_ORG: "$BUILD_ORG"
    BUILD_SCAN_KIND: "$(scan_kind)"
    BUILD_GATES: "${BUILD_GATES:-}"
    BUILD_BASE: "${BUILD_BASE:-}"
    BUILD_STATUS_URL: "${CI_PIPELINE_URL:-}"$nightly
EOF
  scan_requests
  cat <<EOF
  script:
    - looper-build scan
  artifacts:
    when: always
    expire_in: 90 days
    paths: [security/]
EOF
  # A nightly's gates verdict, main's as it is, published for the nightly scan
  # (looper#73): the scan reads it rather than run the gates with Docker.
  [[ "${BUILD_NIGHTLY:-}" != true ]] || cat <<EOF
gates-report:
  image: "$BUILD_SCAN_IMAGE"
  tags: [$BUILD_RUNNER_TAGS]
  needs: [{job: gates, artifacts: true}]
  when: always
  allow_failure: true
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_NIGHTLY: "true"
  script:
    - looper-build gates-report
EOF
}

# The formal verification (looper#74): its job in the pinned image (the
# verifiers are the build image's), and the report publishing its record.
verify_jobs() { # image
  cat <<EOF
verify-$BUILD_REPO:
  image: "$1"
  tags: [$BUILD_RUNNER_TAGS]
  timeout: 6h
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_TAG: "${BUILD_TAG:-}"
    BUILD_RELEASE: "${BUILD_RELEASE:-}"
    BUILD_ORG: "$BUILD_ORG"
    BUILD_VERIFY: "${BUILD_VERIFY:-false}"
    BUILD_VERIFY_SINCE: "$BUILD_VERIFY_SINCE"
    BUILD_VERIFY_RESULT: "$BUILD_VERIFY_RESULT"
    BUILD_VERIFY_RUN: "$BUILD_VERIFY_RUN"
EOF
  embedded_script verify
  cat <<EOF
  artifacts:
    when: always
    expire_in: 1 year
    paths: [verify/]
verify-report:
  image: "$BUILD_SCAN_IMAGE"
  tags: [$BUILD_RUNNER_TAGS]
  needs: [{job: "verify-$BUILD_REPO", artifacts: true}]
  when: always
  allow_failure: true
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
  script:
    - looper-build verify-report
EOF
}

# A release's image (looper#73), once the gates, the security checks and the
# formal verification passed: publish in the builder image (rootless BuildKit,
# no host Docker), else in the looper image on the Docker tags; its identity
# the job's id_token, which GCP trusts on this project's protected tags alone.
# The SBOM is the looper image's (its scanners), of the archive publish keeps.
#
# A branch release's (looper#265) publishes to the release registry as the
# release account: its provider is the id_token's literal audience, and its
# pair goes by names of its own, since a project variable takes precedence
# over a job's GCP_WIF_PROVIDER.
publish_jobs() {
  local image="$BUILD_BUILDER_IMAGE" tags="$BUILD_RUNNER_TAGS" aud='$GCP_WIF_PROVIDER' registry="$BUILD_REGISTRY" release=""
  [[ -n "$image" ]] || { image="$BUILD_SCAN_IMAGE"; tags="$BUILD_DOCKER_TAGS"; }
  if [[ -n "${BUILD_RELEASE:-}" ]]; then
    aud="$GCP_RELEASE_WIF_PROVIDER"; registry="$BUILD_RELEASE_REGISTRY"
    release="$(printf '    GCP_RELEASE_WIF_PROVIDER: "%s"\n    GCP_RELEASE_PUBLISH_SA: "%s"' "$GCP_RELEASE_WIF_PROVIDER" "$GCP_RELEASE_PUBLISH_SA")"
  fi
  cat <<EOF
publish-$BUILD_REPO:
  image: "$image"
  tags: [$tags]
  needs: [{job: gates, artifacts: false}, {job: "security-$BUILD_REPO", artifacts: false}, {job: "verify-$BUILD_REPO", artifacts: false}]
  environment:
    name: registry
  id_tokens:
    GCP_ID_TOKEN:
      aud: https://iam.googleapis.com/$aud
  timeout: 2h
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_TAG: "${BUILD_TAG:-}"
    BUILD_RELEASE: "${BUILD_RELEASE:-}"
    BUILD_ORG: "$BUILD_ORG"
    BUILD_REGISTRY: "$registry"
    BUILD_PLATFORMS: "$BUILD_PLATFORMS"
EOF
  [[ -z "$release" ]] || echo "$release"
  embedded_script publish
  cat <<EOF
  artifacts:
    expire_in: 7 days
    paths: [image, image.tar]
sbom-$BUILD_REPO:
  image: "$BUILD_SCAN_IMAGE"
  tags: [$BUILD_RUNNER_TAGS]
  needs: [{job: "publish-$BUILD_REPO", artifacts: true}]
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_TAG: "${BUILD_TAG:-}"
    BUILD_RELEASE: "${BUILD_RELEASE:-}"
  script:
    - looper-build sbom
  artifacts:
    expire_in: 1 year
    paths: [image, sbom.cdx.json, sbom.spdx.json]
EOF
}

# A branch release's verdict (looper#252), after every other job of its
# pipeline (.post, whatever they did): green when the SBOM job, the last of
# them, passed and so left the image published; else red. One at a time per
# branch (its resource group), so two releases of one branch never both read
# the record before either writes it. It has no source (GIT_STRATEGY none):
# the tacplus the release is built with, the plan's (looper#262). Main's
# alone has the environment seatrials-trigger, the scope of fleet-seatrials'
# trigger token, which no other job reaches.
release_report_job() { # image
  local env=""; [[ "$BUILD_RELEASE" != main ]] || env='
  environment:
    name: seatrials-trigger
    action: access'
  cat <<EOF
release-report:
  stage: .post
  image: "$BUILD_SCAN_IMAGE"
  tags: [$BUILD_RUNNER_TAGS]
  when: always
  resource_group: release-$BUILD_REPO-$(release_slug "$BUILD_RELEASE")
  dependencies: ["sbom-$BUILD_REPO"]$env
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_RELEASE: "$BUILD_RELEASE"
    BUILD_ORG: "$BUILD_ORG"
    BUILD_STATUS_URL: "${CI_PIPELINE_URL:-}"
    BUILD_TACPLUS_COMMIT: "$BUILD_TACPLUS_COMMIT"
    BUILD_PIN_IMAGE: "$1"
  script:
    - looper-build release-report
  artifacts:
    when: always
    expire_in: 1 year
    paths: [release/]
EOF
}

# The repository's last record (looper#74): the build project's generic
# package verify-<repo>, read and written with a job's token.
verify_url() { echo "$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/verify-$BUILD_REPO/latest/$1"; } # file

# The last record's verified commit, result and run, into BUILD_VERIFY_SINCE,
# _RESULT and _RUN; none when there is no record or it cannot be read: the
# verification runs.
verify_last() {
  local f v r u
  if [[ -z "${CI_JOB_TOKEN:-}" || -z "${CI_API_V4_URL:-}" || -z "${CI_PROJECT_ID:-}" ]]; then
    log "verify: no job token to read the last record with: it runs"; return 0
  fi
  f="$(mktemp)"
  if ! curl -fsS -H "JOB-TOKEN: $CI_JOB_TOKEN" -o "$f" "$(verify_url record)" 2>/dev/null; then
    rm -f "$f"; log "verify: no record of a verification of $BUILD_REPO: it runs"; return 0
  fi
  v="$(sed -n 's/^verified //p' "$f" | tail -n 1)"; r="$(sed -n 's/^result //p' "$f" | tail -n 1)"
  u="$(sed -n 's/^run //p' "$f" | tail -n 1)"; rm -f "$f"
  if [[ "$v" =~ ^[0-9a-f]{40}$ && "$r" =~ ^(pass|fail)$ && "$u" =~ $RUN_URL ]]; then
    BUILD_VERIFY_SINCE="$v"; BUILD_VERIFY_RESULT="$r"; BUILD_VERIFY_RUN="$u"
    log "verify: last verified $v ($r, ${u:-no run named})"
  else
    log "verify: the record of $BUILD_REPO cannot be read: it runs"
  fi
}

# --- gates ------------------------------------------------------------------

# GitLab's own job credentials (the job token can call GitLab's API, and is in
# the clone URL) are no part of a build: dropped before the repository's code.
# So is fleet-seatrials' trigger token (looper#262), release-report's alone by
# its environment's scope, should that scope ever be lost.
drop_job_credentials() {
  unset CI_JOB_TOKEN CI_BUILD_TOKEN CI_REGISTRY_PASSWORD CI_DEPENDENCY_PROXY_PASSWORD CI_REPOSITORY_URL \
        CI_JOB_JWT CI_JOB_JWT_V1 CI_JOB_JWT_V2 BUILD_SEATRIALS_TRIGGER_TOKEN
}

# A build nobody waits for any more (looper#130): its requester waits
# BUILD_WAIT seconds for a verdict, and a gates job that starts later (the
# runners busy) runs no gates. It is counted from the pipeline's creation
# (CI_PIPELINE_CREATED_AT); a nightly's and a release's have no wait, and are
# never abandoned. The job ends itself: the trigger token cannot cancel it.
check_wanted() {
  [[ -n "${BUILD_WAIT:-}" && -n "${CI_PIPELINE_CREATED_AT:-}" ]] || return 0
  local created m
  created="$(date -u -d "$CI_PIPELINE_CREATED_AT" +%s 2>/dev/null)" ||
    { log "the pipeline's creation time '$CI_PIPELINE_CREATED_AT' cannot be read: it builds"; return 0; }
  (( $(date +%s) - created > BUILD_WAIT )) || return 0
  verdict fail "abandoned: no verdict wanted after $(span "$BUILD_WAIT")"
}

# Seconds as repo-looper's hours: 3h, 2h30m, 10m (rounded up), under a minute 45s.
span() { # seconds
  local m=$(( ($1 + 59) / 60 ))
  if (( $1 < 60 )); then echo "$1s"; elif (( m < 60 )); then echo "${m}m"
  elif (( m % 60 )); then echo "$(( m / 60 ))h$(( m % 60 ))m"; else echo "$(( m / 60 ))h"; fi
}

# The gates' command, in the commit's checkout, its output in gates.log and on
# stderr; returns its exit status. Gates silent (gates.log unchanged) for
# BUILD_GATES_IDLE seconds are hung (looper#195): their process group, the
# gates and all they started, is stopped and the verdict is red. So are gates
# still running BUILD_WAIT seconds after they started (looper#198): their
# requester waits that long from the build's start and then gives up, and the
# trigger token cannot cancel the pipeline; a nightly's and a release's have
# no wait.
run_gates() { # src command
  local log="$BUILD_OUT/gates.log" idle=$((10#$BUILD_GATES_IDLE)) pid rc=0 last t0 why=""
  t0="$(date +%s)"
  : > "$log"
  # Job control: the gates run in a process group of their own, whose id is $!.
  set -m
  { (cd "$1" && LOOPER_GATES_BASE="${BUILD_BASE:-}" exec bash -c "$2") 2>&1 | tee "$log" >&2; exit "${PIPESTATUS[0]}"; } &
  pid=$!
  set +m
  while kill -0 "$pid" 2>/dev/null; do
    sleep 1
    last="$(stat -c %Y "$log" 2>/dev/null || date +%s)"
    if (( $(date +%s) - last >= idle )); then why="printed nothing for $(span "$idle"): stopped (BUILD_GATES_IDLE)"
    elif [[ -n "${BUILD_WAIT:-}" ]] && (( $(date +%s) - t0 >= 10#$BUILD_WAIT )); then
      why="ran past their requester's wait of $(span "$((10#$BUILD_WAIT))"): stopped (BUILD_WAIT)"
    fi
    if [[ -n "$why" ]] && kill -0 "$pid" 2>/dev/null; then
      log "gates: ${why%%: stopped*}: stopping them"
      kill -TERM -- "-$pid" 2>/dev/null || true
      sleep 5; kill -KILL -- "-$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      verdict fail "the gates $why: $(log_tail "$log")"
    fi
    why=""
  done
  wait "$pid" || rc=$?
  return "$rc"
}

cmd_gates() {
  refuse_write_credentials
  check_inputs
  mkdir -p "$BUILD_OUT"
  check_wanted
  local key="${TACPLUS_READER_APP_KEY:-}"
  BUILD_GITHUB_TOKEN="$(reader_token '"contents":"read","metadata":"read"')" ||
    verdict fail "no read-only GitHub token (the tacplus-reader app)"
  # The app's key is gone before the repository's code runs: it could mint
  # tokens with the app's every permission (commit statuses).
  [[ -n "$key" ]] && rm -f "$key"
  unset TACPLUS_READER_APP_KEY TACPLUS_READER_APP_ID TACPLUS_READER_INSTALLATION_ID
  drop_job_credentials
  export BUILD_GITHUB_TOKEN; git_credentials
  # Private Go modules of the org come from GitHub through the token, not the proxy.
  export GOPRIVATE="${GOPRIVATE:-github.com/$BUILD_ORG/*}"

  local src="$BUILD_OUT/src"
  fetch_commit "$src"
  refuse_push_credential "$src"
  gates_of "$src" fetch
  built "$src"
  generated "$src"
  verdict pass
}

# The gates of the checkout src, at BUILD_SHA, in this image: the set asked for
# from its gates.yaml, else `just gates`; red when they fail, change a tracked
# file or move HEAD. With fetch, BUILD_BASE is fetched from origin first (a
# build job's checkout is shallow).
gates_of() { # src [fetch]
  local src="$1" rc=0 changed run what
  image_tacplus "$src"
  if [[ -f "$src/gates.yaml" ]]; then
    # The set the manager's diff calls for (looper#71), from the commit's own map.
    run="$(gate_run "$src/gates.yaml" "${BUILD_GATES:-full}")" || verdict fail "$run"
    what="the gates ${BUILD_GATES:-full} (gates.yaml)"
    if [[ -n "${BUILD_BASE:-}" ]]; then
      [[ -z "${2:-}" ]] || { git -C "$src" fetch -q --depth 1 origin "$BUILD_BASE" 2>&1 | tail -5 >&2 || true; }
      git -C "$src" rev-parse -q --verify "$BUILD_BASE^{commit}" >/dev/null 2>&1 ||
        verdict fail "$BUILD_ORG/$BUILD_REPO has no base commit $BUILD_BASE (or it cannot be read)"
    fi
  else
    [[ -z "${BUILD_GATES:-}" || "$BUILD_GATES" == full ]] ||
      verdict fail "no gates.yaml: $BUILD_REPO maps no gate set $BUILD_GATES at $BUILD_SHA"
    command -v just >/dev/null || verdict fail "the build image has no just"
    if ! (cd "$src" && just --summary 2>/dev/null | tr ' ' '\n' | grep -qx gates); then
      verdict fail "no gates: $BUILD_REPO's justfile has no \`gates\` recipe at $BUILD_SHA"
    fi
    run="just gates"; what="just gates"
  fi
  log "gates: $BUILD_REPO $BUILD_SHA: $what"
  run_gates "$src" "$run" || rc=$?
  changed="$(git -C "$src" status --porcelain --untracked-files=no)"
  [[ -z "$changed" ]] || verdict fail "the build changed tracked files: $(echo "$changed" | head -20 | tr '\n' ' ')"
  [[ "$(git -C "$src" rev-parse HEAD)" == "$BUILD_SHA" ]] || verdict fail "the build moved HEAD off $BUILD_SHA"
  ((rc == 0)) || verdict fail "$what exited $rc: $(log_tail "$BUILD_OUT/gates.log")"
}

# A looper VM's local build (looper#238; looper-vm build): the gates of a
# checkout already on disk (BUILD_SRC, at BUILD_SHA), in the pinned build image
# this runs in, which looper-vm started through the VM's container socket. No
# fetch and no credential: feedback for its report only, never a land's
# verdict (the manager's build is). Its verdict, the gates' log and nothing
# else (no built files, no generated code: no security checks follow it).
cmd_gates_local() {
  refuse_write_credentials
  check_inputs
  [[ -n "${BUILD_SRC:-}" && -e "$BUILD_SRC/.git" ]] || verdict fail "BUILD_SRC '${BUILD_SRC:-}' is not a checkout"
  mkdir -p "$BUILD_OUT"
  gates_of "$BUILD_SRC"
  verdict pass
}

# A tacplus project's recipes run the pinned image's own tacplus (looper#137):
# the job is already in that image, with no Docker, so a justfile's wrapper
# that runs it with `docker run` (TACPLUS_BIN's default in kernel's and
# eventbus's) cannot. TACPLUS_BIN=tacplus, once the job's image is the one
# tacplus.lock pins (GitLab's CI_JOB_IMAGE; outside a job it cannot be told,
# and the justfile's default stays). A repository pinned by build.lock is no
# tacplus project: nothing to do.
image_tacplus() { # src
  [[ -f "$1/tacplus.lock" ]] || return 0
  local pin; pin="$(read_pin "$1")"
  local image="${BUILD_IMAGE:-${CI_JOB_IMAGE:-}}"
  if [[ -z "$image" ]]; then
    log "no CI_JOB_IMAGE: not a build job, the justfile's own tacplus"; return 0
  fi
  [[ "$image" == "$pin" ]] || verdict fail "the job runs in $image, not the build image tacplus.lock pins ($pin)"
  command -v tacplus >/dev/null || verdict fail "the build image tacplus.lock pins ($pin) has no tacplus"
  export TACPLUS_BIN=tacplus
  log "TACPLUS_BIN=tacplus: the image's own tacplus ($pin)"
}

# The command of the gate sets named (a+b), in a gate map (gates.yaml,
# repo-looper's format: looper#48): each set's run:, in turn, as the manager's
# land would run them. Prints why when a set is not there.
gate_run() { # gates.yaml sets
  local s r cmd=""
  for s in ${2//+/ }; do
    r="$(awk -v want="$s" '
      function unq(v) {
        sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
        if (v ~ /^".*"$/) { v = substr(v, 2, length(v) - 2); gsub(/\\"/, "\"", v); gsub(/\\\\/, "\\", v) }
        else if (v ~ /^\047.*\047$/) { v = substr(v, 2, length(v) - 2); gsub(/\047\047/, "\047", v) }
        return v
      }
      /^[A-Za-z0-9_-]+:[ \t]*$/ { set = $0; sub(/:.*/, "", set); next }
      set == want && /^[ \t]+run:/ { v = $0; sub(/^[ \t]+run:/, "", v); print unq(v); exit }' "$1")"
    [[ -n "$r" ]] || { echo "gates.yaml has no gate set $s with a run: command"; return 1; }
    cmd+="${cmd:+ && }( $r )"
  done
  echo "$cmd"
}

# A top-level scalar of a YAML file, unquoted, without its comment.
yaml_scalar() { # file key
  local v
  v="$(sed -nE "s/^$2:[[:space:]]*//p" "$1" | head -1 | sed -E 's/(^|[[:space:]]+)#.*$//; s/[[:space:]]+$//')"
  [[ "$v" =~ ^\"(.*)\"$ || "$v" =~ ^\'(.*)\'$ ]] && v="${BASH_REMATCH[1]}"
  printf '%s' "$v"
}

# A field a tacplus config names: its own, else that of the config it
# imports, resolved relative to it (tacplus docs/USER.md: Config Composition).
tacplus_field() { # config key
  local f="$1" v i
  for ((i = 0; i < 8; i++)); do
    v="$(yaml_scalar "$f" "$2")"; [[ -z "$v" ]] || { printf '%s' "$v"; return 0; }
    v="$(yaml_scalar "$f" import)"; [[ -n "$v" ]] || return 0
    [[ "$v" == /* ]] || v="$(dirname "$f")/$v"
    [[ -f "$v" ]] || return 0
    f="$v"
  done
}

# A path relative to a directory, without ./ or trailing /; fails when it is
# not a directory inside it.
inside_dir() { # path
  local d="${1#./}"
  while [[ "$d" == */ ]]; do d="${d%/}"; done
  [[ -n "$d" && "$d" != . && "$d" != /* && "/$d/" != */../* ]] || return 1
  printf '%s' "$d"
}

# The tree a tacplus config generates, relative to its project, as tacplus
# writes it (its runner): the output-name (default model) in the output-dir,
# unless the output-dir already ends in it (looper#152: operator's
# `output-dir: .` with `output-name: tacplus` is tacplus/). Fails when the
# config names no output-dir or the tree is not a directory inside its project.
tacplus_generated_dir() { # config
  local dir name
  dir="$(tacplus_field "$1" output-dir)"; [[ -n "$dir" ]] || return 1
  name="$(tacplus_field "$1" output-name)"; name="${name:-model}"
  [[ "$name" != */* && "$name" != . && "$name" != .. ]] || return 1
  if [[ "$dir" == . || "$dir" == ./ ]]; then dir=""
  else dir="$(inside_dir "$dir")" || return 1
  fi
  [[ "${dir##*/}" == "$name" ]] || dir="${dir:+$dir/}$name"
  printf '%s' "$dir"
}
# How a config names its tree, for a note.
tacplus_output_spec() { # config
  printf "output-dir '%s', output-name '%s'" "$(tacplus_field "$1" output-dir)" "$(tacplus_field "$1" output-name)"
}

# The generated trees of a checkout (looper#155): the tree each tracked
# tacplus.yaml (the root's, a client subproject's: looper#149) generates,
# relative to the checkout, one a line; none of a config without an
# output-dir or whose tree is not a directory inside its project.
generated_trees() { # src
  local c d
  while IFS= read -r c; do
    d="$(tacplus_generated_dir "$1/$c")" || continue
    printf '%s\n' "$(dirname "$c")/$d" | sed 's#^\./##'
  done < <(git -C "$1" ls-files -- tacplus.yaml '*/tacplus.yaml')
}

# What the gates built that the security checks need (looper#49), the gates
# job's artifact built/: the untracked files of the checkout that are source
# or a manifest (code generated in place, which a Go module or a Cargo
# workspace may not build without) or bytecode (target/classes, for
# SpotBugs) or a release jar (RELEASE_JAR: what trivy rootfs reads for the
# dependencies it shades, looper#147), and every file of a tacplus.yaml's
# generated tree (looper#155: gateway's src/registry.rs include_str!s the
# registry.json and AGENT.md tacplus writes in target/generated-sources/model,
# without which the security job's clippy cannot compile it), never
# dependencies or other output. The security job lays it over its own checkout
# of the commit.
built() { # src
  local out="$BUILD_OUT/built" t
  rm -rf "$out"; mkdir -p "$out"
  { git -C "$1" ls-files -z --others |
      { grep -zE "(^|/)target/classes/|\.(go|rs|py|java|kt|scala|ts|tsx|js|mjs|cs|swift)\$|(^|/)(go\.(mod|sum)|Cargo\.(toml|lock)|pom\.xml|package(-lock)?\.json|pyproject\.toml|requirements[^/]*\.txt)\$|$RELEASE_JAR" || true; }
    while IFS= read -r t; do git -C "$1" ls-files -z --others -- "$t/"; done < <(generated_trees "$1"); } |
    LC_ALL=C sort -zu |
    { grep -zvE "(^|/)(node_modules|vendor|\.venv|venv|\.git)/|(^|/)target/(.*/)?(debug|release|deps|build)/|$NOT_RELEASE_JAR" || true; } |
    (cd "$1" && tar --null -T - -cf -) | tar -xf - -C "$out" || verdict fail "the gates' built files could not be kept"
  [[ -n "$(ls -A "$out")" ]] || rmdir "$out"
}
# A release jar: a Maven module's target/*.jar or .war, a Gradle project's
# build/libs/*; not its sources, javadoc or tests, nor the shade plugin's
# original- (the jar before its dependencies were shaded in).
RELEASE_JAR='(^|/)(target|build/libs)/[^/]+\.(jar|war)$'
NOT_RELEASE_JAR='(^|/)original-[^/]+\.(jar|war)$|-(sources|javadoc|tests|test-sources)\.jar$'

# The code the commit generates, for the security checks (looper#49): what
# the repository's `generated` recipe, when it has one, writes into the
# directory it is given ($BUILD_OUT/generated, the gates job's artifact). A
# repository that commits its generated code needs none: the checkout is scanned.
generated() { # src
  local out="$BUILD_OUT/generated" rc=0
  rm -rf "$out"
  (cd "$1" && just --summary 2>/dev/null | tr ' ' '\n' | grep -qx generated) || return 0
  mkdir -p "$out"
  log "gates: $BUILD_REPO: just generated (for the security checks)"
  (cd "$1" && just generated "$out") 2>&1 | tee -a "$BUILD_OUT/gates.log" >&2 || rc="${PIPESTATUS[0]}"
  ((rc == 0)) || verdict fail "just generated exited $rc: $(log_tail "$BUILD_OUT/gates.log")"
  [[ -z "$(git -C "$1" status --porcelain --untracked-files=no)" ]] || verdict fail "just generated changed tracked files"
}

# --- verify -----------------------------------------------------------------

# The formal verification (looper#74; tacplus-dev/tacplus#275), in the
# pinned build image, as the gates job runs: `just verify` on the commit, on
# a release tag always, on a verify run only when `just verify-changed <the
# last verified commit>` prints run (no record, or a check that cannot tell,
# runs it too). Its record, verify/record (a "key value" line each: repo,
# kind, checked, verified, result pass|fail|none, run, and skipped when it
# did not run), is the job's artifact; a skip keeps the last verification's
# commit, result and run. A red run keeps its failed harnesses (failures.md:
# each one's section of tacplus verify's report, with its counterexample) and
# the log's tail, and fails the job.
cmd_verify() {
  refuse_write_credentials
  check_inputs
  local out="$BUILD_OUT/verify" key="${TACPLUS_READER_APP_KEY:-}" src="$BUILD_OUT/src" kind=nightly rc=0 ans
  local since="${BUILD_VERIFY_SINCE:-}"
  ! is_release || kind=release
  rm -rf "$out"; mkdir -p "$out"
  BUILD_GITHUB_TOKEN="$(reader_token '"contents":"read","metadata":"read"')" ||
    verdict fail "no read-only GitHub token (the tacplus-reader app)"
  [[ -n "$key" ]] && rm -f "$key"
  unset TACPLUS_READER_APP_KEY TACPLUS_READER_APP_ID TACPLUS_READER_INSTALLATION_ID
  drop_job_credentials
  export BUILD_GITHUB_TOKEN; git_credentials
  export GOPRIVATE="${GOPRIVATE:-github.com/$BUILD_ORG/*}"
  fetch_commit "$src"
  refuse_push_credential "$src"
  image_tacplus "$src"
  verify_record() { # result verified run [skipped]
    { echo "repo $BUILD_REPO"; echo "kind $kind"; echo "checked $BUILD_SHA"; echo "verified $2"; echo "result $1"
      echo "run $3"; [[ -z "${4:-}" ]] || echo "skipped $4"; echo "checked_by ${CI_PIPELINE_URL:-}"; } > "$out/record"
  }
  if ! (cd "$src" && just --summary 2>/dev/null | tr ' ' '\n' | grep -qx verify); then
    log "verify: $BUILD_REPO's justfile has no \`verify\` recipe at $BUILD_SHA: nothing to verify"
    verify_record none "" "${CI_PIPELINE_URL:-}"; verdict pass; return 0
  fi
  if [[ "$kind" == nightly ]]; then
    if [[ -n "$since" && -n "${BUILD_VERIFY_RESULT:-}" ]]; then
      git -C "$src" fetch -q --depth 1 origin "$since" 2>&1 | tail -5 >&2 || true
      ans="$(cd "$src" && just verify-changed "$since" 2>/dev/null | head -n 1)" || ans=""
      if [[ "$ans" == skip* ]]; then
        log "verify: $ans"
        verify_record "$BUILD_VERIFY_RESULT" "$since" "${BUILD_VERIFY_RUN:-}" "unchanged since $since"
        verdict pass; return 0
      fi
      log "verify: just verify-changed $since: ${ans:-no answer}: it runs"
    else
      log "verify: no record of a verification: it runs"
    fi
  fi
  log "verify: $BUILD_REPO $BUILD_SHA ($kind): just verify"
  (cd "$src" && just verify) 2>&1 | tee "$out/verify.log" >&2 || rc="${PIPESTATUS[0]}"
  failed_harnesses < "$out/verify.log" > "$out/failures.md"
  tail -n 80 "$out/verify.log" > "$out/log-tail"
  if ((rc == 0)); then verify_record pass "$BUILD_SHA" "${CI_PIPELINE_URL:-}"; verdict pass
  else verify_record fail "$BUILD_SHA" "${CI_PIPELINE_URL:-}"; verdict fail "just verify exited $rc (verify/verify.log)"; fi
}

# The sections of tacplus verify's report (verification-report.md, which
# just verify prints on a failure) whose harness did not verify: from its
# `### <message> -- <harness>` to the next heading or `===` line.
failed_harnesses() {
  awk '
    function flush() { if (sec != "" && failed) printf "%s\n", sec; sec = ""; failed = 0 }
    /^### / { flush(); sec = $0; next }
    /^(## |# |=== )/ { flush(); next }
    sec != "" { sec = sec "\n" $0
                if ($0 ~ /^\*\*Status:\*\* / && $0 !~ /^\*\*Status:\*\* (VERIFIED|PASSED|SUCCESS)/) failed = 1 }
    END { flush() }'
}

# The verify job's record as the repository's latest (the build project's
# generic package verify-<repo>, with the job's token): the next verify run's
# last verified commit, and what the nightly scan files (looper-verify). A
# skip publishes its record alone: the failures beside it stay those of the
# run it names.
cmd_verify_report() {
  check_inputs
  local d="$BUILD_OUT/verify" f files=(record)
  [[ -f "$d/record" ]] || { log "the verify job left no record: nothing to publish"; return 0; }
  cat "$d/record" >&2
  grep -q '^skipped ' "$d/record" || files+=(failures.md log-tail)
  : "${CI_JOB_TOKEN:?no job token: the report publishes with it}" "${CI_API_V4_URL:?}" "${CI_PROJECT_ID:?}"
  for f in "${files[@]}"; do
    [[ -s "$d/$f" ]] || echo "(none)" > "$d/$f"
    curl -fsS -o /dev/null -H "JOB-TOKEN: $CI_JOB_TOKEN" --upload-file "$d/$f" "$(verify_url "$f")" ||
      { log "the package registry refused $f"; exit 1; }
  done
  log "published as verify-$BUILD_REPO/latest: ${files[*]}"
}

# --- gates-report -------------------------------------------------------------

# A nightly's gates on main (looper#73), as the repository's latest: the build
# project's generic package gates-<repo>, its record (repo, kind, checked,
# result pass, fail or none, why, run, at) and the gates' log tail. The
# nightly scan reads it (repo-looper) instead of running the gates itself.
cmd_gates_report() {
  check_inputs
  [[ "${BUILD_NIGHTLY:-}" == true ]] || { log "gates-report: not a nightly: a build's gates are no verdict on main; nothing published"; return 0; }
  local d="$BUILD_OUT/gates-report" f v result why
  mkdir -p "$d"
  v="$(head -n 1 "$BUILD_OUT/build-verdict" 2>/dev/null || true)"
  case "$v" in
    pass) result=pass; why="" ;;
    fail:*) result=fail; why="${v#fail: }" ;;
    *) result=none; why="the gates job left no verdict (its runner lost, after GitLab's retries, or it timed out)" ;;
  esac
  { printf 'repo %s\nkind nightly\nchecked %s\nresult %s\n' "$BUILD_REPO" "$BUILD_SHA" "$result"
    [[ -z "$why" ]] || printf 'why %s\n' "$why"
    printf 'run %s\nat %s\n' "${CI_PIPELINE_URL:-}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"; } > "$d/record"
  tail -n 200 "$BUILD_OUT/gates.log" > "$d/log-tail" 2>/dev/null || true
  cat "$d/record" >&2
  : "${CI_JOB_TOKEN:?no job token: the report publishes with it}" "${CI_API_V4_URL:?}" "${CI_PROJECT_ID:?}"
  for f in record log-tail; do
    [[ -s "$d/$f" ]] || echo "(none)" > "$d/$f"
    curl -fsS -o /dev/null -H "JOB-TOKEN: $CI_JOB_TOKEN" --upload-file "$d/$f" \
      "$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/gates-$BUILD_REPO/latest/$f" ||
      { log "the package registry refused $f"; exit 1; }
  done
  log "published as gates-$BUILD_REPO/latest: record log-tail"
}

# --- status -----------------------------------------------------------------

cmd_status() { # state [description]
  local state="${1:-}" text="${2:-}"
  case "$state" in pending|success|failure|error) ;; *) usage >&2; exit 2 ;; esac
  refuse_write_credentials
  # No commit's verdict (the plan sets its status on every run, looper#237):
  # before the inputs, which a nightly's fan-out leaves empty.
  if [[ "${BUILD_NIGHTLY:-}" == true || "${BUILD_VERIFY:-}" == true || "${BUILD_SMOKE:-}" == true || "${BUILD_RUNNER_IMAGE:-}" == true ]]; then
    log "status: a nightly, a verify run, a smoke or a runner image run sets no commit status: $state not set"; return 0
  fi
  # A branch release's commit is its plan's to resolve (looper#252): before
  # it, and in a fan-out of many, there is none to mark.
  if [[ -n "${BUILD_RELEASE:-}" && -z "${BUILD_SHA:-}" ]]; then
    BUILD_SHA="$(head -n 1 "$BUILD_OUT/build-sha" 2>/dev/null || true)"
    [[ -n "$BUILD_SHA" && "$BUILD_RELEASE" != branches && -n "${BUILD_REPO:-}" ]] ||
      { log "status: a release of ${BUILD_RELEASE} with no commit resolved yet: $state not set"; return 0; }
  fi
  check_inputs
  # A pending or green status names the build's key, its gate set and base
  # (looper#134): a request for the same key reuses this build (repo-looper).
  [[ -n "$text" ]] || case "$state" in
    pending) text="building${BUILD_GATES:+: gates $BUILD_GATES}${BUILD_BASE:+ on base $BUILD_BASE}" ;;
    success) text="pass${BUILD_GATES:+: gates $BUILD_GATES}${BUILD_BASE:+ on base $BUILD_BASE}" ;;
    # No build-verdict here when the gates' child pipeline failed (the plan passed): sed exits 2 on the missing file.
    # The security job's (cmd_scan) BUILD_NO_VERDICT when the gates job left none (looper#148).
    # Its BUILD_STATUS_OF=security only when the gates passed: red gates' reason is theirs (looper#144).
    *) if [[ "${BUILD_STATUS_OF:-}" == security ]]; then
         [[ "$(head -n 1 "$BUILD_OUT/build-verdict" 2>/dev/null)" == pass ]] ||
           { log "status: the gates failed: their reason is the gates', not the security checks'"; return 0; }
         text="$(sed -n '1s/^fail: /security: /p' "$BUILD_OUT/security/verdict" 2>/dev/null || true)"
       else
         text="$(sed -n '1s/^fail: //p' "$BUILD_OUT/build-verdict" 2>/dev/null || true)"
       fi
       text="${text:-${BUILD_NO_VERDICT:-the build failed}}" ;;
  esac
  local token="${BUILD_STATUS_TOKEN:-}" body url="${BUILD_STATUS_URL:-${CI_PIPELINE_URL:-}}" set
  unset BUILD_STATUS_TOKEN
  [[ -n "$token" ]] || token="$(reader_token '"statuses":"write","metadata":"read"' "$BUILD_REPO")" || { log "no token for the commit status"; exit 1; }
  # A release's own "the build failed" (report-fail) leaves the reason its security job set on this pipeline.
  if [[ "$state" == failure && "$text" == "the build failed" && -n "$url" ]] &&
     set="$(curl -fsS -H "Authorization: Bearer $token" -H 'Accept: application/vnd.github+json' \
              "$BUILD_GITHUB_API/repos/$BUILD_ORG/$BUILD_REPO/commits/$BUILD_SHA/statuses?per_page=100" 2>/dev/null |
            jq -r --arg c "$BUILD_STATUS_CONTEXT" --arg u "$url" \
              'first(.[] | select(.context == $c and .target_url == $u and .state == "failure") | .description) // empty' 2>/dev/null)" &&
     [[ -n "$set" ]]; then
    log "status: $BUILD_ORG/$BUILD_REPO@$BUILD_SHA $BUILD_STATUS_CONTEXT failure already set by this build: $set"; return 0
  fi
  body="$(jq -cn --arg s "$state" --arg c "$BUILD_STATUS_CONTEXT" --arg d "${text:0:140}" --arg u "$url" \
            '{state: $s, context: $c, description: $d} + (if $u == "" then {} else {target_url: $u} end)')"
  curl -fsS -o /dev/null -X POST -H "Authorization: Bearer $token" -H 'Accept: application/vnd.github+json' \
    -d "$body" "$BUILD_GITHUB_API/repos/$BUILD_ORG/$BUILD_REPO/statuses/$BUILD_SHA" ||
    { log "GitHub refused the commit status"; exit 1; }
  log "status: $BUILD_ORG/$BUILD_REPO@$BUILD_SHA $BUILD_STATUS_CONTEXT $state: $text"
}

# --- scan -------------------------------------------------------------------

# The security job (looper#49), and the build's verdict (looper#237: one job
# where gates-failed, security-report, security-failed and report-pass were):
# looper-scan run, its report (whose failure fails nothing), then the commit
# status, by cmd_status: the gates' reason when they failed, or that their job
# left no verdict (its runner lost or timed out, looper#148); else the
# security checks' (looper#144); else pass, but a release's, which the
# parent's report-pass sets once publish passed. A nightly's sets none.
# Exits as the scan did, or 1 when the status could not be set. The status's
# token is minted first: looper-scan run removes the app's key before the
# repository's code runs, and with it every later token (every candidate red
# on its status alone, its gates and checks green: 2026-11-25). The token is
# no exported variable: the scan and the code it runs never see it; only the
# status step is given it.
cmd_scan() {
  local rc=0 st=() token=""
  if [[ "${BUILD_NIGHTLY:-}" != true ]]; then
    token="$(reader_token '"statuses":"write","metadata":"read"' "$BUILD_REPO")" ||
      log "scan: no token for the commit status before the checks (the status step tries again)"
  fi
  looper-scan run || rc=$?
  looper-scan report || log "scan: the security report failed (it fails no build)"
  if [[ "${BUILD_NIGHTLY:-}" == true ]]; then log "scan: a nightly: no commit status"; return "$rc"; fi
  if [[ "$(head -n 1 "$BUILD_OUT/build-verdict" 2>/dev/null)" != pass ]]; then
    st=(BUILD_NO_VERDICT="no gates verdict: the gates job's runner was lost (runner_system_failure, after GitLab's retries) or it timed out" "$SELF" status failure)
  elif (( rc )); then
    st=(BUILD_STATUS_OF=security BUILD_NO_VERDICT="no security verdict: the security checks exited $rc and left no verdict" "$SELF" status failure)
  elif [[ -n "${BUILD_TAG:-}" ]]; then
    log "scan: a release: its pass is report-pass's, once publish passed"; return 0
  elif [[ -n "${BUILD_RELEASE:-}" ]]; then
    log "scan: a release of $BUILD_RELEASE: its pass is release-report's, once publish passed"; return 0
  else
    st=("$SELF" status success)
  fi
  BUILD_OUT="$BUILD_OUT" BUILD_STATUS_TOKEN="$token" env "${st[@]}" || { log "scan: the commit status was not set"; return 1; }
  return "$rc"
}

# --- publish ----------------------------------------------------------------

# The registry's short-lived GCP token, from the job's GitLab id_token
# (GCP_ID_TOKEN), through Workload Identity Federation (GCP_WIF_PROVIDER,
# tacplus#223); GCP_PUBLISH_SA, when set, is impersonated. A branch
# release's (looper#265) is the release account's, GCP_RELEASE_PUBLISH_SA,
# through GCP_RELEASE_WIF_PROVIDER, both its job's: never the tags'. No key file, no
# stored token: gcloud's config and the registry client's (DOCKER_CONFIG's
# config.json, which buildctl and docker both read) live in a temporary
# directory. The token is REGISTRY_TOKEN, for the registry's API.
registry_login() { # tmp
  : "${GCP_ID_TOKEN:?the publish job has no id_tokens GCP_ID_TOKEN}"
  local provider sa=() v
  if [[ -n "${BUILD_RELEASE:-}" ]]; then
    for v in GCP_RELEASE_WIF_PROVIDER GCP_RELEASE_PUBLISH_SA; do
      [[ -n "${!v:-}" ]] || verdict fail "a release of $BUILD_RELEASE publishes as the release account (tacplus-dev/cloud#115): its job has no $v"
    done
    provider="$GCP_RELEASE_WIF_PROVIDER"; sa=(--service-account="$GCP_RELEASE_PUBLISH_SA")
  else
    : "${GCP_WIF_PROVIDER:?the build project variable GCP_WIF_PROVIDER is not set (tacplus-dev/tacplus#223)}"
    provider="$GCP_WIF_PROVIDER"
    [[ -n "${GCP_PUBLISH_SA:-}" ]] && sa=(--service-account="$GCP_PUBLISH_SA")
  fi
  export CLOUDSDK_CONFIG="$1/gcloud" CLOUDSDK_CORE_DISABLE_PROMPTS=1 DOCKER_CONFIG="$1/docker"
  mkdir -p "$DOCKER_CONFIG"
  ( umask 077
    printf '%s' "$GCP_ID_TOKEN" > "$1/oidc-token"
    gcloud iam workload-identity-pools create-cred-config "$provider" "${sa[@]}" \
      --credential-source-file="$1/oidc-token" --output-file="$1/federation.json" >/dev/null )
  gcloud auth login --cred-file="$1/federation.json" --quiet >/dev/null 2>&1 ||
    verdict fail "Workload Identity Federation refused this job ($provider)"
  REGISTRY_TOKEN="$(gcloud auth print-access-token)" && [[ -n "$REGISTRY_TOKEN" ]] ||
    verdict fail "Workload Identity Federation gave no token for the registry"
  ( umask 077
    printf '{"auths": {"%s": {"auth": "%s"}}}\n' "${BUILD_REGISTRY%%/*}" \
      "$(printf 'oauth2accesstoken:%s' "$REGISTRY_TOKEN" | openssl base64 -A)" > "$DOCKER_CONFIG/config.json" )
}

# The manifest a release's tag names in the registry, as it serves the bytes
# (their sha256 is the image's digest), into file; returns 1 when there is
# none (404). Any other answer fails: a release is never pushed over one
# the registry could not show.
registry_manifest() { # name file
  local host="${1%%/*}" path="${1#*/}" code
  code="$(curl -sS -o "$2" -w '%{http_code}' -H "Authorization: Bearer $REGISTRY_TOKEN" \
            -H 'Accept: application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.docker.distribution.manifest.v2+json' \
            "https://$host/v2/${path%:*}/manifests/${path##*:}")" || code="${code:-000}"
  case "$code" in
    200) [[ -s "$2" ]] || verdict fail "the registry served an empty manifest for $1" ;;
    404) return 1 ;;
    *) verdict fail "the registry answered $code for $1: whether the release is there cannot be told" ;;
  esac
}

# The digest of the image the builder built (its --metadata-file).
built_digest() { # metadata.json
  sed -n 's/.*"containerimage\.digest"[[:space:]]*:[[:space:]]*"\(sha256:[0-9a-f]\{64\}\)".*/\1/p' "$1" | head -1
}

# A reproducible image of the checkout: every timestamp is the commit's
# (SOURCE_DATE_EPOCH, rewrite-timestamp), no provenance or SBOM attestation
# (they carry the build's time and identity), OCI media types for every
# output, so the same commit gives the same digest whether it is pushed or
# written to a file. Rootless BuildKit's buildctl (BUILDKIT_HOST, the
# daemon tacplus-image-build started), else docker buildx. Prints the digest.
build_image() { # src output-spec tmp
  local meta="$3/metadata-$RANDOM.json" epoch
  epoch="$(git -C "$1" log -1 --format=%ct)"
  if [[ "$IMAGE_BUILDER" == buildkit ]]; then
    # buildctl adds no attestation unless asked.
    buildctl build --frontend dockerfile.v0 --local "context=$1" --local "dockerfile=$1" \
      --opt filename=Dockerfile --opt "platform=$BUILD_PLATFORMS" --opt image-resolve-mode=pull \
      --opt "build-arg:SOURCE_DATE_EPOCH=$epoch" --opt "build-arg:VERSION=${BUILD_TAG:-$(release_version)}" --opt "build-arg:REVISION=$BUILD_SHA" \
      --opt "label:org.opencontainers.image.revision=$BUILD_SHA" \
      --opt "label:org.opencontainers.image.source=$BUILD_GITHUB_URL/$BUILD_ORG/$BUILD_REPO" \
      --output "$2,rewrite-timestamp=true" --metadata-file "$meta" >&2 ||
      verdict fail "the image of $BUILD_REPO $BUILD_SHA did not build"
  else
    SOURCE_DATE_EPOCH="$epoch" docker buildx build --builder "$BUILDER" --platform "$BUILD_PLATFORMS" \
      --provenance=false --sbom=false --pull \
      --build-arg "SOURCE_DATE_EPOCH=$epoch" --build-arg "VERSION=${BUILD_TAG:-$(release_version)}" --build-arg "REVISION=$BUILD_SHA" \
      --label "org.opencontainers.image.revision=$BUILD_SHA" \
      --label "org.opencontainers.image.source=$BUILD_GITHUB_URL/$BUILD_ORG/$BUILD_REPO" \
      --output "$2,rewrite-timestamp=true" --metadata-file "$meta" "$1" >&2 ||
      verdict fail "the image of $BUILD_REPO $BUILD_SHA did not build"
  fi
  built_digest "$meta"
}

# The builder (looper#73): rootless BuildKit where the image has it
# (tacplus-image-build, tacplus-dev/tacplus#315), which runs in the job's own
# container with no host Docker and builds a foreign platform with its own
# QEMU helpers; else docker buildx on the host's Docker, said so. A daemon
# that does not start fails the job: never a fall back to Docker.
setup_image_builder() {
  if command -v tacplus-image-build >/dev/null; then
    IMAGE_BUILDER=buildkit
    BUILDKIT_HOST="$(tacplus-image-build start)" && [[ -n "$BUILDKIT_HOST" ]] ||
      verdict fail "rootless BuildKit did not start (tacplus-image-build: it needs a user namespace, seccomp and AppArmor unconfined)"
    export BUILDKIT_HOST
    log "publish: rootless BuildKit ($BUILDKIT_HOST)"
  else
    IMAGE_BUILDER=docker
    log "publish: no tacplus-image-build in this image: host Docker (docker buildx), as a job on the Docker tags has"
    setup_builder
  fi
}

# Docker's builder of its own (BuildKit by digest), and the emulators for a
# platform it cannot build: they are installed (once per machine) and the
# builder made again, since BuildKit finds them when it starts.
setup_builder() {
  local p missing=""
  new_builder
  for p in ${BUILD_PLATFORMS//,/ }; do
    builder_platforms | grep -qxF "$p" || missing+=" $p"
  done
  [[ -n "$missing" ]] || return 0
  log "no emulator for$missing: installing them ($BUILD_BINFMT_IMAGE)"
  docker run --rm --privileged "$BUILD_BINFMT_IMAGE" --install all >/dev/null 2>&1 ||
    verdict fail "could not install the emulators for$missing"
  docker buildx rm "$BUILDER" >/dev/null 2>&1 || true
  new_builder
  for p in $missing; do
    builder_platforms | grep -qxF "$p" || verdict fail "the builder cannot build $p"
  done
}
new_builder() {
  docker buildx create --name "$BUILDER" --driver docker-container \
    --driver-opt "image=$BUILD_BUILDKIT_IMAGE" >/dev/null || verdict fail "no buildx builder"
}
# The platforms the builder can build, one per line.
builder_platforms() {
  docker buildx inspect --bootstrap "$BUILDER" 2>/dev/null | sed -n 's/^Platforms:[[:space:]]*//p' | tr ',' '\n' | tr -d ' *'
}

# The builder this run made, and its directory: gone at its end.
publish_cleanup() { # tmp
  if [[ "${IMAGE_BUILDER:-}" == buildkit ]]; then tacplus-image-build stop >/dev/null 2>&1 || true
  elif [[ "${IMAGE_BUILDER:-}" == docker ]]; then docker buildx rm "$BUILDER" >/dev/null 2>&1 || true; fi
  rm -rf "$1"
}

# The release image (looper#73: rootless BuildKit, setup_image_builder), its
# OCI archive kept as image.tar for the SBOM job, and its name by digest as
# image.
cmd_publish() {
  local dry=0
  [[ "${1:-}" == --dry-run ]] && dry=1
  refuse_write_credentials GCP_ID_TOKEN
  check_inputs
  is_release || verdict fail "publish needs a release tag (BUILD_TAG vX.Y.Z) or branch (BUILD_RELEASE)"
  mkdir -p "$BUILD_OUT"
  BUILD_GITHUB_TOKEN="$(reader_token '"contents":"read","metadata":"read"' "$BUILD_REPO")" ||
    verdict fail "no read-only GitHub token (the tacplus-reader app)"
  export BUILD_GITHUB_TOKEN; git_credentials
  local src="$BUILD_OUT/publish-src" tmp name built pushed existing
  fetch_commit "$src"
  check_release "$src"
  [[ -f "$src/Dockerfile" ]] || verdict fail "$BUILD_REPO has no Dockerfile at $BUILD_SHA: nothing to publish"
  tmp="$(mktemp -d)"; BUILDER="looper-build-$$"; IMAGE_BUILDER=""
  # shellcheck disable=SC2064  # the builder and directory of this run
  trap "publish_cleanup '$tmp'" EXIT
  setup_image_builder
  name="$BUILD_REGISTRY/$BUILD_REPO:$(release_version)"
  rm -f "$BUILD_OUT/image" "$BUILD_OUT/image.tar"
  built="$(build_image "$src" "type=oci,dest=$BUILD_OUT/image.tar" "$tmp")"
  [[ -n "$built" ]] || verdict fail "the builder reported no digest"
  log "built $name@$built"
  if ((dry)); then
    echo "$name@$built" > "$BUILD_OUT/image"
    log "dry run: nothing pushed"; return 0
  fi
  registry_login "$tmp"
  # An immutable release: an image already there must be this one.
  # (The digest is that of the manifest's bytes as the registry serves them.)
  if registry_manifest "$name" "$tmp/existing"; then
    existing="sha256:$(sha256sum < "$tmp/existing" | cut -d' ' -f1)"
    [[ "$existing" == "$built" ]] || verdict fail "$name is already published as $existing; this build gives $built"
    log "$name is already published, with this digest"
  else
    pushed="$(build_image "$src" "type=image,name=$name,push=true,oci-mediatypes=true" "$tmp")"
    [[ "$pushed" == "$built" ]] || verdict fail "not reproducible: the pushed image is $pushed, the build before it $built"
  fi
  echo "$name@$built" > "$BUILD_OUT/image"
  log "published $name@$built"
}

# The SBOM job: the release image's SBOM, of the archive publish kept.
cmd_sbom() {
  refuse_write_credentials
  check_inputs
  is_release || verdict fail "an SBOM is a release's (BUILD_TAG vX.Y.Z, or BUILD_RELEASE a branch)"
  [[ -s "$BUILD_OUT/image.tar" ]] || verdict fail "no image.tar: the publish job kept no image archive"
  release_sbom "$BUILD_OUT/image.tar"
}

# The release's SBOM (looper#49), of the image published, CycloneDX and SPDX:
# the publish job's artifacts sbom.cdx.json and sbom.spdx.json (kept), and the
# build project's generic package sbom-<repo>, version X.Y.Z.
release_sbom() { # oci-archive
  local scan; scan="$(dirname "$SELF")/looper-scan"
  [[ -x "$scan" ]] || verdict fail "no looper-scan beside looper-build: the release's SBOM cannot be made"
  "$scan" sbom "oci-archive:$1" "$BUILD_OUT" || verdict fail "the SBOM of $BUILD_REPO $(release_version) could not be made"
  local f
  if [[ "${BUILD_SBOM_UPLOAD:-1}" == 1 && -n "${CI_JOB_TOKEN:-}" && -n "${CI_API_V4_URL:-}" && -n "${CI_PROJECT_ID:-}" ]]; then
    for f in sbom.cdx.json sbom.spdx.json; do
      curl -fsS -o /dev/null -H "JOB-TOKEN: $CI_JOB_TOKEN" --upload-file "$BUILD_OUT/$f" \
        "$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/sbom-$BUILD_REPO/$(release_version)/$f" ||
        verdict fail "the package registry refused the SBOM $f"
    done
    log "SBOM published: sbom-$BUILD_REPO $(release_version)"
  fi
}

# --- release-report -----------------------------------------------------------

# A branch release's verdict (looper#252), the last job of its pipeline, or
# its plan's when the plan failed: green when publish and the SBOM left the
# image (BUILD_OUT/image, by digest), else red. Green, its record (release_url)
# moves to this commit when the one it names is this commit or an ancestor of
# it: an older build never moves it back, whichever finishes last, so a
# deployment that rolls to the record never deploys it after a newer one; the
# commit status (tacplus-dev/release/<branch>) is green either way, saying
# which. Red, the red record, which the nightly scan files as a bug (a build
# holds no credential that writes an issue), and the status red with its
# reason. Its record is the job's artifact too (release/).
cmd_release_report() {
  refuse_write_credentials
  [[ -n "${BUILD_RELEASE:-}" ]] || { log "release-report: not a branch release: nothing to record"; return 0; }
  [[ -n "${BUILD_SHA:-}" ]] || BUILD_SHA="$(head -n 1 "$BUILD_OUT/build-sha" 2>/dev/null || true)"
  [[ -n "${BUILD_SHA:-}" ]] || { log "release-report: no commit of $BUILD_RELEASE was resolved (the plan said why): nothing to record"; return 0; }
  check_inputs
  : "${CI_JOB_TOKEN:?no job token: the record is published with it}" "${CI_API_V4_URL:?}" "${CI_PROJECT_ID:?}"
  local d="$BUILD_OUT/release" image="" why text v old token now
  mkdir -p "$d"; now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  image="$(head -n 1 "$BUILD_OUT/image" 2>/dev/null || true)"
  [[ "$image" =~ ^[^@[:space:]]+:$(release_version)@sha256:[0-9a-f]{64}$ ]] || image=""
  # The tacplus it was built with (looper#262), the plan's: a tacplus
  # project's commit and the build image by digest; a build.lock's none.
  local tp="" bad=""
  if [[ "${BUILD_TACPLUS_COMMIT:-}" =~ ^[0-9a-f]{40}$ && "${BUILD_PIN_IMAGE:-}" =~ $PIN_IMAGE ]]; then
    tp="tacplus $BUILD_TACPLUS_COMMIT $BUILD_PIN_IMAGE"
  elif [[ "${BUILD_TACPLUS_COMMIT:-}" != none ]]; then
    bad="the tacplus $BUILD_REPO is built with cannot be told (BUILD_TACPLUS_COMMIT '${BUILD_TACPLUS_COMMIT:-}', BUILD_PIN_IMAGE '${BUILD_PIN_IMAGE:-}'): ${image:-its image} is published, not released"
  fi
  token="$(reader_token '"statuses":"write","contents":"read","metadata":"read"' "$BUILD_REPO")" ||
    verdict fail "no token for the release's commit status (the tacplus-reader app)"
  if [[ -z "$image" || -n "$bad" ]]; then
    v="$(head -n 1 "$BUILD_OUT/build-verdict" 2>/dev/null || true)"
    # With no reason of its own (a later job failed), the status keeps the one
    # its gates' or security checks' job set on this pipeline (cmd_status).
    if [[ -n "$image" ]]; then why="$bad"; text="release: $why"
    elif [[ "$v" == fail:* ]]; then why="${v#fail: }"; text="release: $why"
    else why="a job of the release failed (its gates, security checks, formal verification, publish or SBOM: the run and the commit status tacplus-dev/release/$BUILD_RELEASE say which); nothing was published"; text="the build failed"; fi
    { printf 'repo %s\nbranch %s\ncommit %s\nwhy %s\nrun %s\nat %s\n' "$BUILD_REPO" "$BUILD_RELEASE" "$BUILD_SHA" "$why" "${BUILD_STATUS_URL:-${CI_PIPELINE_URL:-}}" "$now"; } > "$d/red"
    cat "$d/red" >&2
    curl -fsS -o /dev/null -H "JOB-TOKEN: $CI_JOB_TOKEN" --upload-file "$d/red" "$(release_url "$BUILD_REPO" "$BUILD_RELEASE" red)" ||
      log "release-report: the package registry refused the red record"
    BUILD_OUT="$BUILD_OUT" BUILD_STATUS_TOKEN="$token" "$SELF" status failure "$text" || log "release-report: the commit status was not set"
    log "release-report: $BUILD_REPO $BUILD_RELEASE at $BUILD_SHA is red: $why"
    return 1
  fi
  old="$(release_field "$BUILD_REPO" "$BUILD_RELEASE" record commit)"
  if [[ -n "$old" && "$old" != "$BUILD_SHA" ]] && ! release_follows "$token" "$old"; then
    log "release-report: the record names ${old:0:12}, not an ancestor of $BUILD_SHA: a newer (or another) release is recorded, and an older build never takes its place"
    BUILD_OUT="$BUILD_OUT" BUILD_STATUS_TOKEN="$token" "$SELF" status success "green, not released: the release of $BUILD_RELEASE is ${old:0:12}, newer" ||
      log "release-report: the commit status was not set"
    return 0
  fi
  { printf 'repo %s\nbranch %s\ncommit %s\nimage %s\n' "$BUILD_REPO" "$BUILD_RELEASE" "$BUILD_SHA" "$image"
    [[ -z "$tp" ]] || printf '%s\n' "$tp"
    printf 'run %s\nat %s\n' "${BUILD_STATUS_URL:-${CI_PIPELINE_URL:-}}" "$now"; } > "$d/record"
  cat "$d/record" >&2
  curl -fsS -o /dev/null -H "JOB-TOKEN: $CI_JOB_TOKEN" --upload-file "$d/record" "$(release_url "$BUILD_REPO" "$BUILD_RELEASE" record)" ||
    verdict fail "the package registry refused the release's record: $image is published, not released"
  BUILD_OUT="$BUILD_OUT" BUILD_STATUS_TOKEN="$token" "$SELF" status success "released: ${image##*/}" || log "release-report: the commit status was not set"
  log "release-report: released $BUILD_REPO $BUILD_RELEASE: $image, as release-$BUILD_REPO/$(release_slug "$BUILD_RELEASE")/record"
  [[ "$BUILD_RELEASE" != main ]] || seatrials_trigger
}

# A main release that moved its record starts fleet-seatrials' pipeline on its
# main (looper#262), so dev rolls to it now, not at its daily schedule. No
# variables: fleet-seatrials reads the records itself and refuses anything
# older. Its pipeline trigger token (BUILD_SEATRIALS_TRIGGER_TOKEN, a masked
# variable of the build project scoped to the environment seatrials-trigger,
# release-report's alone) goes to curl on its stdin, never its arguments. A
# trigger that fails only leaves the roll to that schedule: logged, never the
# release's failure.
seatrials_trigger() {
  local project="${BUILD_SEATRIALS_PROJECT:-tacplus-dev/fleet-seatrials}" resp url
  if [[ -z "${BUILD_SEATRIALS_TRIGGER_TOKEN:-}" ]]; then
    log "seatrials not started: no trigger token (BUILD_SEATRIALS_TRIGGER_TOKEN); it rolls at its daily schedule"; return 0
  fi
  if resp="$(printf '%s' "$BUILD_SEATRIALS_TRIGGER_TOKEN" | curl -fsS --max-time 60 -X POST -F 'token=<-' -F ref=main \
               "$CI_API_V4_URL/projects/${project//\//%2F}/trigger/pipeline" 2>&1)"; then
    url="$(printf '%s' "$resp" | grep -o '"web_url"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n 1 | sed 's/.*"\([^"]*\)"$/\1/')" || true
    log "seatrials: pipeline ${url:-of $project} started"
  else
    log "seatrials not started: GitLab refused $project's trigger ($(printf '%s' "$resp" | tail -n 1)); it rolls at its daily schedule"
  fi
}

# Whether the recorded commit is an ancestor of this one: their histories,
# commits alone, fetched with a read-only token. One that cannot be told is
# no ancestor: the record stays.
release_follows() { # token old
  local g="$BUILD_OUT/release-src" ok=1
  rm -rf "$g"; git init -q "$g"
  BUILD_GITHUB_TOKEN="$1"; export BUILD_GITHUB_TOKEN; git_credentials
  git -C "$g" remote add origin "$(repo_url)"
  if git -C "$g" fetch -q --filter=tree:0 origin "$BUILD_SHA" "$2" 2>/dev/null; then
    git -C "$g" merge-base --is-ancestor "$2" "$BUILD_SHA" 2>/dev/null && ok=0
  else
    log "release-report: ${2:0:12} or $BUILD_SHA cannot be fetched: whether it is older cannot be told"
  fi
  rm -rf "$g"
  return "$ok"
}

# Sourced (looper-scan, looper#49): its functions, and nothing run.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0

case "${1:-}" in
  plan) cmd_plan ;;
  gates) cmd_gates ;;
  gates-local) cmd_gates_local ;;
  status) shift; cmd_status "$@" ;;
  scan) cmd_scan ;;
  publish) shift; cmd_publish "$@" ;;
  sbom) cmd_sbom ;;
  verify) cmd_verify ;;
  verify-report) cmd_verify_report ;;
  gates-report) cmd_gates_report ;;
  release-report) cmd_release_report ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
