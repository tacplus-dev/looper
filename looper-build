# looper-build: the build pipeline (looper#17; tacplus-dev/roadmap
# decisions/deterministic-builds-2026-10-27.md). A build takes (repo, commit)
# as it is and gives a verdict, pass or fail, and on a release tag an image;
# it never changes the repository. The pipeline is gitlab.com/tacplus-dev/build
# (ci/build.gitlab-ci.yml here), whose jobs run this script:
#
#   plan     fetch exactly the commit, read its pin (tacplus.lock, or
#            build.lock: looper#71), and write the child pipeline whose gates
#            job runs in the pinned build image
#   gates    in that image, with no agent: `just gates` on the commit, or the
#            gate set asked for from its gates.yaml (looper#71); a change to a
#            tracked file fails it; then the code it generates (a `generated`
#            recipe), for the security checks
#   (the security checks, looper#49, are looper-scan's: the child pipeline's
#            security-<repo> and security-report jobs, in the looper image)
#   verify   in that image too, on a release tag and on a verify run (the
#            nightly's, looper#74): `just verify`, the formal verification,
#            which no land runs (tacplus-dev/tacplus#275); a verify run skips
#            it when `just verify-changed <the last verified commit>` does not
#            print run. Its record is the job's artifact verify/
#   verify-report  the record as the repository's latest (the next verify
#            run's last verified commit), which the nightly scan files as bugs
#            when it is red (looper-verify)
#   status   the GitHub commit status (context tacplus-dev/build)
#   publish  on a release tag: the image, pushed to Artifact Registry through
#            Workload Identity Federation, its digest and its SBOM
#
# Self-contained (no looper-lib.sh, no jq on the gates path): the plan embeds
# this very file in the gates job, which runs in the repository's pinned build
# image, not in the looper image.
#
# Credentials: GitHub only through the read-only tacplus-reader app
# (TACPLUS_READER_APP_ID, TACPLUS_READER_INSTALLATION_ID and the file variable
# TACPLUS_READER_APP_KEY, project variables of tacplus-dev/build, looper#12):
# each step mints its own one-hour installation token with the least
# permissions it needs. A job that holds a write credential (a looper's
# GH_TOKEN, GITLAB_TOKEN, ...) refuses to run.
set -euo pipefail

BUILD_ORG="${BUILD_ORG:-tacplus-dev}"
BUILD_GITHUB_URL="${BUILD_GITHUB_URL:-https://github.com}"
BUILD_GITHUB_API="${BUILD_GITHUB_API:-https://api.github.com}"
BUILD_OUT="${BUILD_OUT:-$PWD}"
BUILD_RUNNER_TAGS="${BUILD_RUNNER_TAGS:-arm64, build}"
BUILD_REGISTRY="${BUILD_REGISTRY:-us-docker.pkg.dev/jody1-328023/tacplus}"
BUILD_PLATFORMS="${BUILD_PLATFORMS:-linux/amd64,linux/arm64}"
BUILD_STATUS_CONTEXT="${BUILD_STATUS_CONTEXT:-tacplus-dev/build}"
# The image the security checks run in (the looper image: the scanners), by
# default the one the plan runs in.
BUILD_SCAN_IMAGE="${BUILD_SCAN_IMAGE:-${CI_JOB_IMAGE:-ghcr.io/tacplus-dev/looper:main}}"
# The builder publish runs in, and the emulators for a foreign platform, by digest.
BUILD_BUILDKIT_IMAGE="${BUILD_BUILDKIT_IMAGE:-moby/buildkit:v0.33.1@sha256:cec9f139f45e93c5c69c60f8b07cfad9f43f4ef6b6a6cd917527fea5ff2e3dea}"
BUILD_BINFMT_IMAGE="${BUILD_BINFMT_IMAGE:-tonistiigi/binfmt:qemu-v10.0.4@sha256:8f58e6214f4cc9dc83ce8f5acad1ece508eb6b20e696a8c1e9f274481982c541}"

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

usage() {
  cat <<'EOF'
usage: looper-build plan                  write build-gates.yml (the gates job, in the pinned image)
       looper-build gates                 just gates on the commit, in this directory's checkout
       looper-build status STATE [TEXT]   the commit status: pending, success or failure
       looper-build publish [--dry-run]   the release image and its digest (--dry-run: build only)
       looper-build verify                just verify on the commit (a verify run: when verify-changed says run)
       looper-build verify-report         the verify job's record, published as the repository's latest
Environment: BUILD_REPO, BUILD_SHA, BUILD_TAG (a release, vX.Y.Z), BUILD_NIGHTLY (true: the
nightly security checks of the main branch, whose head the plan reads when BUILD_SHA is empty), BUILD_VERIFY
(true: the formal verification of the main branch, likewise; BUILD_VERIFY_SINCE, _RESULT and _RUN: the last
record's verified commit, its result and run, which the plan reads), BUILD_GATES
(the commit's gates.yaml sets to run, joined by +; empty: its full, else just gates) and BUILD_BASE (their
LOOPER_GATES_BASE, a full hash), the tacplus-reader
app (TACPLUS_READER_APP_ID, TACPLUS_READER_INSTALLATION_ID, TACPLUS_READER_APP_KEY);
outputs go to BUILD_OUT (default: here).
EOF
}

log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

# The verdict, one line in $BUILD_OUT/build-verdict: "pass" or "fail: <why>".
# fail ends the job.
verdict() { # pass | fail <why>
  if [[ "$1" == pass ]]; then
    echo pass > "$BUILD_OUT/build-verdict"; log "verdict: pass"
  else
    shift; echo "fail: $*" > "$BUILD_OUT/build-verdict"; log "verdict: FAIL: $*"; exit 1
  fi
}

# --- inputs ---------------------------------------------------------------

check_inputs() {
  [[ "${BUILD_REPO:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$BUILD_REPO" != *..* ]] ||
    verdict fail "BUILD_REPO '${BUILD_REPO:-}' is not a repository name"
  [[ "${BUILD_SHA:-}" =~ ^[0-9a-f]{40}$ ]] ||
    [[ "${1:-}" == plan && -z "${BUILD_SHA:-}" && ("${BUILD_NIGHTLY:-}" == true || "${BUILD_VERIFY:-}" == true) ]] ||
    verdict fail "BUILD_SHA '${BUILD_SHA:-}' is not a full commit hash"
  [[ -z "${BUILD_TAG:-}" || "$BUILD_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    verdict fail "BUILD_TAG '$BUILD_TAG' is not a release tag vX.Y.Z"
  [[ "${BUILD_NIGHTLY:-}" != true || -z "${BUILD_TAG:-}" ]] || verdict fail "a nightly build is not a release (BUILD_TAG $BUILD_TAG)"
  if [[ "${BUILD_VERIFY:-}" == true ]]; then
    [[ -z "${BUILD_TAG:-}" ]] || verdict fail "a verify run is not a release (BUILD_TAG $BUILD_TAG): a release verifies in its own pipeline"
    [[ "${BUILD_NIGHTLY:-}" != true ]] || verdict fail "a verify run is not the nightly security checks (BUILD_NIGHTLY)"
  fi
  [[ -z "${BUILD_VERIFY_SINCE:-}" || "$BUILD_VERIFY_SINCE" =~ ^[0-9a-f]{40}$ ]] ||
    verdict fail "BUILD_VERIFY_SINCE '$BUILD_VERIFY_SINCE' is not a full commit hash"
  [[ "${BUILD_VERIFY_RESULT:-}" =~ ^(pass|fail)?$ ]] || verdict fail "BUILD_VERIFY_RESULT '$BUILD_VERIFY_RESULT' is not pass or fail"
  [[ "${BUILD_VERIFY_RUN:-}" =~ $RUN_URL ]] || verdict fail "BUILD_VERIFY_RUN '$BUILD_VERIFY_RUN' is not a pipeline's URL"
  [[ "${BUILD_GATES:-}" =~ ^([A-Za-z0-9_-]+(\+[A-Za-z0-9_-]+)*)?$ ]] ||
    verdict fail "BUILD_GATES '${BUILD_GATES:-}' is not a gate set (gates.yaml's set names, joined by +)"
  [[ -z "${BUILD_BASE:-}" || "$BUILD_BASE" =~ ^[0-9a-f]{40}$ ]] || verdict fail "BUILD_BASE '$BUILD_BASE' is not a full commit hash"
}

# A run's URL, as a record names it (written into the child pipeline).
RUN_URL='^(https://[A-Za-z0-9./_~%-]+)?$'

# The kind of the security checks (looper-scan): release, nightly or build.
scan_kind() {
  if [[ -n "${BUILD_TAG:-}" ]]; then echo release; elif [[ "${BUILD_NIGHTLY:-}" == true ]]; then echo nightly; else echo build; fi
}

# A build holds no credential that can change a repository: refuse to run
# beside one. The names are the loopers' (and GitHub's, GitLab's, Anthropic's);
# any other variable whose value is shaped like a personal or OAuth token
# (ghp_, github_pat_, gho_, ghu_, glpat-) is refused too. GCP_ID_TOKEN, the
# job's identity for Workload Identity Federation, only where it is allowed
# (publish).
WRITE_CREDENTIALS=(GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITLAB_TOKEN CLAUDE_CODE_OAUTH_TOKEN
                   ANTHROPIC_API_KEY GHCR_PUSH_TOKEN)
refuse_write_credentials() { # [allowed name...]
  local v found=() allowed=" $* "
  for v in "${WRITE_CREDENTIALS[@]}" GCP_ID_TOKEN; do
    [[ "$allowed" == *" $v "* ]] && continue
    [[ -n "${!v:-}" ]] && found+=("$v")
  done
  for v in $(compgen -e); do
    case "${!v:-}" in ghp_*|github_pat_*|gho_*|ghu_*|glpat-*) [[ " ${found[*]} " == *" $v "* ]] || found+=("$v") ;; esac
  done
  ((${#found[@]} == 0)) || verdict fail "this job holds a write credential (${found[*]}): a build must not"
}

# --- GitHub, read-only ------------------------------------------------------

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# A one-hour installation token of the tacplus-reader app, with only the
# permissions given ('"contents":"read"', ...), for the given repositories
# (none: every repository the app is installed on). Printed on stdout. The
# app's key is a file variable; only its signature leaves this process.
reader_token() { # permissions-json-members [repo...]
  local perms="$1" repos="" r now header payload jwt body resp token
  shift
  : "${TACPLUS_READER_APP_ID:?the tacplus-reader app id (TACPLUS_READER_APP_ID) is not set}"
  : "${TACPLUS_READER_INSTALLATION_ID:?TACPLUS_READER_INSTALLATION_ID is not set}"
  [[ -f "${TACPLUS_READER_APP_KEY:-}" ]] || { log "TACPLUS_READER_APP_KEY is not a file (a file variable of the build project)"; return 1; }
  for r in "$@"; do repos+="${repos:+,}\"$r\""; done
  now="$(date +%s)"
  header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
  payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$TACPLUS_READER_APP_ID" | b64url)"
  jwt="$header.$payload.$(printf '%s' "$header.$payload" | openssl dgst -sha256 -sign "$TACPLUS_READER_APP_KEY" | b64url)"
  body="{\"permissions\":{$perms}${repos:+,\"repositories\":[$repos]}}"
  resp="$(curl -fsS -X POST -H "Authorization: Bearer $jwt" -H 'Accept: application/vnd.github+json' \
            -d "$body" "$BUILD_GITHUB_API/app/installations/$TACPLUS_READER_INSTALLATION_ID/access_tokens")" ||
    { log "GitHub refused the tacplus-reader app a token"; return 1; }
  token="$(printf '%s' "$resp" | tr -d '\n' | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  [[ -n "$token" ]] || { log "no token in GitHub's answer"; return 1; }
  printf '%s\n' "$token"
}

# Git authenticates to GitHub, and to no other host, with $BUILD_GITHUB_TOKEN,
# through its environment alone (as DOCKER_GITHUB_CREDS in looper-lib.sh): the
# empty value first drops any other helper for that host, so none stores it.
# shellcheck disable=SC2016  # expanded by git's shell, when git asks
git_credentials() {
  export GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=2
  export GIT_CONFIG_KEY_0="credential.$BUILD_GITHUB_URL.helper" GIT_CONFIG_VALUE_0=
  export GIT_CONFIG_KEY_1="credential.$BUILD_GITHUB_URL.helper"
  export GIT_CONFIG_VALUE_1='!f() { test "$1" = get || exit 0; test -n "$BUILD_GITHUB_TOKEN" || exit 0; echo username=x-access-token; echo "password=$BUILD_GITHUB_TOKEN"; }; f'
}

repo_url() { echo "$BUILD_GITHUB_URL/$BUILD_ORG/$BUILD_REPO.git"; }

# Exactly the commit, nothing else, into dir.
fetch_commit() { # dir
  rm -rf "$1"; git init -q "$1"
  git -C "$1" remote add origin "$(repo_url)"
  git -C "$1" fetch -q --depth 1 origin "$BUILD_SHA" 2>&1 | tail -5 >&2 || true
  git -C "$1" rev-parse -q --verify "FETCH_HEAD^{commit}" >/dev/null 2>&1 ||
    verdict fail "$BUILD_ORG/$BUILD_REPO has no commit $BUILD_SHA (or it cannot be read)"
  git -C "$1" -c advice.detachedHead=false checkout -q FETCH_HEAD
  [[ "$(git -C "$1" rev-parse HEAD)" == "$BUILD_SHA" ]] || verdict fail "checked out $(git -C "$1" rev-parse HEAD), not $BUILD_SHA"
}

# The source credential must not be able to push: GitHub refuses a push
# (even --dry-run asks for the receive-pack) with a read-only token.
refuse_push_credential() { # dir
  if git -C "$1" push -q --dry-run origin "HEAD:refs/heads/looper-build-push-probe" >/dev/null 2>&1; then
    verdict fail "the source credential can push to $BUILD_ORG/$BUILD_REPO: a build's must be read-only"
  fi
  log "the source credential cannot push (refused, as it must be)"
}

# --- the pin ----------------------------------------------------------------

# tacplus.lock, as tacplus validates it (pkg/tacplusyaml/lock.go): an exact
# release and the build image by digest, of the same line. A repository that
# is no tacplus project (the looper's, looper#71) pins its build image alone,
# by digest, in build.lock, in the same form (`build_image: <image>`). Prints
# the image.
PIN_IMAGE='^[a-z0-9][a-z0-9._/-]*(:([A-Za-z0-9_][A-Za-z0-9._-]*))?@sha256:[0-9a-f]{64}$'
read_pin() { # dir
  local lock="$1/tacplus.lock" version image tag
  if [[ ! -f "$lock" && -f "$1/build.lock" ]]; then
    image="$(sed -n 's/^build_image:[[:space:]]*"\{0,1\}\([^"[:space:]]*\)"\{0,1\}[[:space:]]*$/\1/p' "$1/build.lock" | head -1)"
    [[ "$image" =~ $PIN_IMAGE ]] ||
      verdict fail "build.lock: build_image: '$image' must name the image by digest (<name>[:<tag>]@sha256:<64 hex>)"
    echo "$image"; return 0
  fi
  [[ -f "$lock" ]] || verdict fail "no pin: $BUILD_REPO has no tacplus.lock (nor build.lock) at $BUILD_SHA (run \`tacplus pin\` and commit it)"
  version="$(sed -n 's/^tacplus:[[:space:]]*"\{0,1\}\([^"[:space:]]*\)"\{0,1\}[[:space:]]*$/\1/p' "$lock" | head -1)"
  image="$(sed -n 's/^build_image:[[:space:]]*"\{0,1\}\([^"[:space:]]*\)"\{0,1\}[[:space:]]*$/\1/p' "$lock" | head -1)"
  [[ "$version" =~ ^([0-9]+)\.([0-9]+)\.[0-9]+$ ]] ||
    verdict fail "tacplus.lock: tacplus: '$version' must be an exact MAJOR.MINOR.PATCH release"
  local line="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
  [[ "$image" =~ $PIN_IMAGE ]] ||
    verdict fail "tacplus.lock: build_image: '$image' must name the image by digest (<name>[:<tag>]@sha256:<64 hex>)"
  tag="${BASH_REMATCH[2]}"
  if [[ "$tag" =~ ^([0-9]+)\.([0-9]+)\.[0-9]+$ && "${BASH_REMATCH[1]}.${BASH_REMATCH[2]}" != "$line" ]]; then
    verdict fail "tacplus.lock: build_image '$image' is not of the pin's line $line"
  fi
  echo "$image"
}

# A release: the build project's pipeline runs on its protected tag
# <repo>/vX.Y.Z (what Workload Identity Federation trusts, tacplus#223), and
# the repository's tag vX.Y.Z is the commit built.
check_release() { # dir
  [[ -n "${BUILD_TAG:-}" ]] || return 0
  [[ "${CI_COMMIT_TAG:-}" == "$BUILD_REPO/$BUILD_TAG" ]] ||
    verdict fail "a release build of $BUILD_REPO $BUILD_TAG runs on the build project's protected tag $BUILD_REPO/$BUILD_TAG, not '${CI_COMMIT_REF_NAME:-}'"
  local at
  at="$(git -C "$1" ls-remote origin "refs/tags/$BUILD_TAG^{}" "refs/tags/$BUILD_TAG" | awk 'NR==1 || /\^\{\}$/ {c=$1} END {print c}')"
  [[ "$at" == "$BUILD_SHA" ]] || verdict fail "$BUILD_REPO's tag $BUILD_TAG is at '${at:-nothing}', not $BUILD_SHA"
}

# --- plan -------------------------------------------------------------------

cmd_plan() {
  refuse_write_credentials
  check_inputs plan
  mkdir -p "$BUILD_OUT"
  BUILD_GITHUB_TOKEN="$(reader_token '"contents":"read","metadata":"read"' "$BUILD_REPO")" ||
    verdict fail "no read-only GitHub token (the tacplus-reader app)"
  export BUILD_GITHUB_TOKEN; git_credentials
  local src="$BUILD_OUT/plan-src" image
  if [[ -z "${BUILD_SHA:-}" ]]; then   # a nightly or a verify run: the main branch as it is now
    # From a repository of its own: the one it runs in (an Actions checkout's
    # extraheader, looper#58) has no say in what GitHub is sent.
    rm -rf "$src"; git init -q "$src"
    BUILD_SHA="$(git -C "$src" ls-remote "$(repo_url)" refs/heads/main 2>/dev/null | cut -f1)" || true
    [[ "$BUILD_SHA" =~ ^[0-9a-f]{40}$ ]] || verdict fail "$BUILD_ORG/$BUILD_REPO has no main branch to scan"
    log "$([[ "${BUILD_VERIFY:-}" == true ]] && echo verify || echo nightly): $BUILD_REPO main is $BUILD_SHA"
  fi
  # A verify run's change check is against the last record's verified commit;
  # a release verifies with no change check.
  BUILD_VERIFY_SINCE=""; BUILD_VERIFY_RESULT=""; BUILD_VERIFY_RUN=""
  [[ "${BUILD_VERIFY:-}" != true ]] || verify_last
  fetch_commit "$src"
  check_release "$src"
  image="$(read_pin "$src")"
  rm -rf "$src"
  write_gates_pipeline "$image" > "$BUILD_OUT/build-gates.yml"
  if [[ "${BUILD_VERIFY:-}" == true ]]; then
    log "plan: $BUILD_REPO $BUILD_SHA: the formal verification in $image, if changed since ${BUILD_VERIFY_SINCE:-(no record: it runs)}"
  else
    log "plan: $BUILD_REPO $BUILD_SHA${BUILD_TAG:+ ($BUILD_TAG)} gates in $image, security checks ($(scan_kind)) in $BUILD_SCAN_IMAGE${BUILD_TAG:+, the formal verification}"
  fi
}

# The child pipeline: the gates job, in the pinned image, running this
# script; the security checks (looper-scan, looper#49) in the looper image,
# on the commit and on the code the gates generated; and on a release, the
# formal verification (looper#74). A verify run's is the verification alone.
write_gates_pipeline() { # image
  echo "# Written by looper-build plan: $BUILD_REPO at $BUILD_SHA, in its pinned build image."
  # A job whose runner is lost (its spot VM preempted) runs again, as the
  # parent's do: their default does not reach this child pipeline (looper#148).
  # Not on stuck_or_timeout_failure: the gates' 11h timeout is their own.
  cat <<'EOF'
default:
  retry:
    max: 2
    when: [runner_system_failure, scheduler_failure, unknown_failure]
EOF
  if [[ "${BUILD_VERIFY:-}" != true ]]; then gates_jobs "$1"; fi
  if [[ "${BUILD_VERIFY:-}" == true || -n "${BUILD_TAG:-}" ]]; then verify_jobs "$1"; fi
}

# A job's script: this very script, embedded, run with the command given.
embedded_script() { # command
  cat <<'EOF'
  script:
    - |
      cat > "$CI_PROJECT_DIR/looper-build" <<'LOOPER_BUILD_EOF'
EOF
  sed 's/^/      /' "$SELF"
  cat <<EOF
      LOOPER_BUILD_EOF
      bash "\$CI_PROJECT_DIR/looper-build" $1
EOF
}

gates_jobs() { # image
  # The gates' own timeout, a report job's longest (repo-looper's
  # JOB_MAX_HOURS): tacplus's full gates take over 3h, and the project's
  # default ended them at 1h (looper#140).
  cat <<EOF
gates:
  image: "$1"
  tags: [$BUILD_RUNNER_TAGS]
  timeout: 11h
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_TAG: "${BUILD_TAG:-}"
    BUILD_ORG: "$BUILD_ORG"
    BUILD_GATES: "${BUILD_GATES:-}"
    BUILD_BASE: "${BUILD_BASE:-}"
EOF
  embedded_script gates
  cat <<'EOF'
  artifacts:
    when: always
    expire_in: 30 days
    paths: [gates.log, build-verdict, built/, generated/]
EOF
  # A failed gates job's verdict, on the commit as this build's (the parent's
  # pipeline): the gates' own reason from its artifact, or none when its runner
  # was lost on every try (looper#148). The parent's report-fail, which cannot
  # read it, then leaves it be.
  cat <<EOF
gates-failed:
  image: "$BUILD_SCAN_IMAGE"
  tags: [$BUILD_RUNNER_TAGS]
  needs: [{job: gates, artifacts: true}]
  when: on_failure
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_TAG: "${BUILD_TAG:-}"
    BUILD_ORG: "$BUILD_ORG"
    BUILD_STATUS_URL: "${CI_PIPELINE_URL:-}"
    BUILD_NO_VERDICT: "no gates verdict: the gates job's runner was lost (runner_system_failure, after GitLab's retries) or it timed out"
  script:
    - looper-build status failure
EOF
  cat <<EOF
security-$BUILD_REPO:
  image: "$BUILD_SCAN_IMAGE"
  tags: [$BUILD_RUNNER_TAGS]
  needs: [{job: gates, artifacts: true}]
  when: always
  timeout: 3h
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_TAG: "${BUILD_TAG:-}"
    BUILD_ORG: "$BUILD_ORG"
    BUILD_SCAN_KIND: "$(scan_kind)"
  script:
    - looper-scan run
  artifacts:
    when: always
    expire_in: 90 days
    paths: [security/]
security-report:
  image: "$BUILD_SCAN_IMAGE"
  tags: [$BUILD_RUNNER_TAGS]
  needs: [{job: "security-$BUILD_REPO", artifacts: true}]
  when: always
  allow_failure: true
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_SCAN_KIND: "$(scan_kind)"
  script:
    - looper-scan report
EOF
}

# The formal verification (looper#74): its job in the pinned image (the
# verifiers are the build image's), and the report publishing its record.
verify_jobs() { # image
  cat <<EOF
verify-$BUILD_REPO:
  image: "$1"
  tags: [$BUILD_RUNNER_TAGS]
  timeout: 6h
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_TAG: "${BUILD_TAG:-}"
    BUILD_ORG: "$BUILD_ORG"
    BUILD_VERIFY: "${BUILD_VERIFY:-false}"
    BUILD_VERIFY_SINCE: "$BUILD_VERIFY_SINCE"
    BUILD_VERIFY_RESULT: "$BUILD_VERIFY_RESULT"
    BUILD_VERIFY_RUN: "$BUILD_VERIFY_RUN"
EOF
  embedded_script verify
  cat <<EOF
  artifacts:
    when: always
    expire_in: 1 year
    paths: [verify/]
verify-report:
  image: "$BUILD_SCAN_IMAGE"
  tags: [$BUILD_RUNNER_TAGS]
  needs: [{job: "verify-$BUILD_REPO", artifacts: true}]
  when: always
  allow_failure: true
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
  script:
    - looper-build verify-report
EOF
}

# The repository's last record (looper#74): the build project's generic
# package verify-<repo>, read and written with a job's token.
verify_url() { echo "$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/verify-$BUILD_REPO/latest/$1"; } # file

# The last record's verified commit, result and run, into BUILD_VERIFY_SINCE,
# _RESULT and _RUN; none when there is no record or it cannot be read: the
# verification runs.
verify_last() {
  local f v r u
  if [[ -z "${CI_JOB_TOKEN:-}" || -z "${CI_API_V4_URL:-}" || -z "${CI_PROJECT_ID:-}" ]]; then
    log "verify: no job token to read the last record with: it runs"; return 0
  fi
  f="$(mktemp)"
  if ! curl -fsS -H "JOB-TOKEN: $CI_JOB_TOKEN" -o "$f" "$(verify_url record)" 2>/dev/null; then
    rm -f "$f"; log "verify: no record of a verification of $BUILD_REPO: it runs"; return 0
  fi
  v="$(sed -n 's/^verified //p' "$f" | tail -n 1)"; r="$(sed -n 's/^result //p' "$f" | tail -n 1)"
  u="$(sed -n 's/^run //p' "$f" | tail -n 1)"; rm -f "$f"
  if [[ "$v" =~ ^[0-9a-f]{40}$ && "$r" =~ ^(pass|fail)$ && "$u" =~ $RUN_URL ]]; then
    BUILD_VERIFY_SINCE="$v"; BUILD_VERIFY_RESULT="$r"; BUILD_VERIFY_RUN="$u"
    log "verify: last verified $v ($r, ${u:-no run named})"
  else
    log "verify: the record of $BUILD_REPO cannot be read: it runs"
  fi
}

# --- gates ------------------------------------------------------------------

# GitLab's own job credentials (the job token can call GitLab's API, and is in
# the clone URL) are no part of a build: dropped before the repository's code.
drop_job_credentials() {
  unset CI_JOB_TOKEN CI_BUILD_TOKEN CI_REGISTRY_PASSWORD CI_DEPENDENCY_PROXY_PASSWORD CI_REPOSITORY_URL \
        CI_JOB_JWT CI_JOB_JWT_V1 CI_JOB_JWT_V2
}

cmd_gates() {
  refuse_write_credentials
  check_inputs
  mkdir -p "$BUILD_OUT"
  local key="${TACPLUS_READER_APP_KEY:-}"
  BUILD_GITHUB_TOKEN="$(reader_token '"contents":"read","metadata":"read"')" ||
    verdict fail "no read-only GitHub token (the tacplus-reader app)"
  # The app's key is gone before the repository's code runs: it could mint
  # tokens with the app's every permission (commit statuses).
  [[ -n "$key" ]] && rm -f "$key"
  unset TACPLUS_READER_APP_KEY TACPLUS_READER_APP_ID TACPLUS_READER_INSTALLATION_ID
  drop_job_credentials
  export BUILD_GITHUB_TOKEN; git_credentials
  # Private Go modules of the org come from GitHub through the token, not the proxy.
  export GOPRIVATE="${GOPRIVATE:-github.com/$BUILD_ORG/*}"

  local src="$BUILD_OUT/src" rc=0 changed run what
  fetch_commit "$src"
  refuse_push_credential "$src"
  image_tacplus "$src"
  if [[ -f "$src/gates.yaml" ]]; then
    # The set the manager's diff calls for (looper#71), from the commit's own map.
    run="$(gate_run "$src/gates.yaml" "${BUILD_GATES:-full}")" || verdict fail "$run"
    what="the gates ${BUILD_GATES:-full} (gates.yaml)"
    if [[ -n "${BUILD_BASE:-}" ]]; then
      git -C "$src" fetch -q --depth 1 origin "$BUILD_BASE" 2>&1 | tail -5 >&2 || true
      git -C "$src" rev-parse -q --verify "$BUILD_BASE^{commit}" >/dev/null 2>&1 ||
        verdict fail "$BUILD_ORG/$BUILD_REPO has no base commit $BUILD_BASE (or it cannot be read)"
    fi
  else
    [[ -z "${BUILD_GATES:-}" || "$BUILD_GATES" == full ]] ||
      verdict fail "no gates.yaml: $BUILD_REPO maps no gate set $BUILD_GATES at $BUILD_SHA"
    command -v just >/dev/null || verdict fail "the build image has no just"
    if ! (cd "$src" && just --summary 2>/dev/null | tr ' ' '\n' | grep -qx gates); then
      verdict fail "no gates: $BUILD_REPO's justfile has no \`gates\` recipe at $BUILD_SHA"
    fi
    run="just gates"; what="just gates"
  fi
  log "gates: $BUILD_REPO $BUILD_SHA: $what"
  (cd "$src" && LOOPER_GATES_BASE="${BUILD_BASE:-}" bash -c "$run") 2>&1 | tee "$BUILD_OUT/gates.log" >&2 || rc="${PIPESTATUS[0]}"
  changed="$(git -C "$src" status --porcelain --untracked-files=no)"
  [[ -z "$changed" ]] || verdict fail "the build changed tracked files: $(echo "$changed" | head -20 | tr '\n' ' ')"
  [[ "$(git -C "$src" rev-parse HEAD)" == "$BUILD_SHA" ]] || verdict fail "the build moved HEAD off $BUILD_SHA"
  ((rc == 0)) || verdict fail "$what exited $rc (gates.log)"
  built "$src"
  generated "$src"
  verdict pass
}

# A tacplus project's recipes run the pinned image's own tacplus (looper#137):
# the job is already in that image, with no Docker, so a justfile's wrapper
# that runs it with `docker run` (TACPLUS_BIN's default in kernel's and
# eventbus's) cannot. TACPLUS_BIN=tacplus, once the job's image is the one
# tacplus.lock pins (GitLab's CI_JOB_IMAGE; outside a job it cannot be told,
# and the justfile's default stays). A repository pinned by build.lock is no
# tacplus project: nothing to do.
image_tacplus() { # src
  [[ -f "$1/tacplus.lock" ]] || return 0
  local pin; pin="$(read_pin "$1")"
  if [[ -z "${CI_JOB_IMAGE:-}" ]]; then
    log "no CI_JOB_IMAGE: not a build job, the justfile's own tacplus"; return 0
  fi
  [[ "$CI_JOB_IMAGE" == "$pin" ]] || verdict fail "the job runs in $CI_JOB_IMAGE, not the build image tacplus.lock pins ($pin)"
  command -v tacplus >/dev/null || verdict fail "the build image tacplus.lock pins ($pin) has no tacplus"
  export TACPLUS_BIN=tacplus
  log "TACPLUS_BIN=tacplus: the image's own tacplus ($pin)"
}

# The command of the gate sets named (a+b), in a gate map (gates.yaml,
# repo-looper's format: looper#48): each set's run:, in turn, as the manager's
# land would run them. Prints why when a set is not there.
gate_run() { # gates.yaml sets
  local s r cmd=""
  for s in ${2//+/ }; do
    r="$(awk -v want="$s" '
      function unq(v) {
        sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
        if (v ~ /^".*"$/) { v = substr(v, 2, length(v) - 2); gsub(/\\"/, "\"", v); gsub(/\\\\/, "\\", v) }
        else if (v ~ /^\047.*\047$/) { v = substr(v, 2, length(v) - 2); gsub(/\047\047/, "\047", v) }
        return v
      }
      /^[A-Za-z0-9_-]+:[ \t]*$/ { set = $0; sub(/:.*/, "", set); next }
      set == want && /^[ \t]+run:/ { v = $0; sub(/^[ \t]+run:/, "", v); print unq(v); exit }' "$1")"
    [[ -n "$r" ]] || { echo "gates.yaml has no gate set $s with a run: command"; return 1; }
    cmd+="${cmd:+ && }( $r )"
  done
  echo "$cmd"
}

# What the gates built that the security checks need (looper#49), the gates
# job's artifact built/: the untracked files of the checkout that are source
# or a manifest (code generated in place, which a Go module or a Cargo
# workspace may not build without) or bytecode (target/classes, for
# SpotBugs) or a release jar (RELEASE_JAR: what trivy rootfs reads for the
# dependencies it shades, looper#147), never dependencies or other output.
# The security job lays it over its own checkout of the commit.
built() { # src
  local out="$BUILD_OUT/built"
  rm -rf "$out"; mkdir -p "$out"
  git -C "$1" ls-files -z --others |
    { grep -zE "(^|/)target/classes/|\.(go|rs|py|java|kt|scala|ts|tsx|js|mjs|cs|swift)\$|(^|/)(go\.(mod|sum)|Cargo\.(toml|lock)|pom\.xml|package(-lock)?\.json|pyproject\.toml|requirements[^/]*\.txt)\$|$RELEASE_JAR" || true; } |
    { grep -zvE "(^|/)(node_modules|vendor|\.venv|venv|\.git)/|(^|/)target/(.*/)?(debug|release|deps|build)/|$NOT_RELEASE_JAR" || true; } |
    (cd "$1" && tar --null -T - -cf -) | tar -xf - -C "$out" || verdict fail "the gates' built files could not be kept"
  [[ -n "$(ls -A "$out")" ]] || rmdir "$out"
}
# A release jar: a Maven module's target/*.jar or .war, a Gradle project's
# build/libs/*; not its sources, javadoc or tests, nor the shade plugin's
# original- (the jar before its dependencies were shaded in).
RELEASE_JAR='(^|/)(target|build/libs)/[^/]+\.(jar|war)$'
NOT_RELEASE_JAR='(^|/)original-[^/]+\.(jar|war)$|-(sources|javadoc|tests|test-sources)\.jar$'

# The code the commit generates, for the security checks (looper#49): what
# the repository's `generated` recipe, when it has one, writes into the
# directory it is given ($BUILD_OUT/generated, the gates job's artifact). A
# repository that commits its generated code needs none: the checkout is scanned.
generated() { # src
  local out="$BUILD_OUT/generated" rc=0
  rm -rf "$out"
  (cd "$1" && just --summary 2>/dev/null | tr ' ' '\n' | grep -qx generated) || return 0
  mkdir -p "$out"
  log "gates: $BUILD_REPO: just generated (for the security checks)"
  (cd "$1" && just generated "$out") 2>&1 | tee -a "$BUILD_OUT/gates.log" >&2 || rc="${PIPESTATUS[0]}"
  ((rc == 0)) || verdict fail "just generated exited $rc (gates.log)"
  [[ -z "$(git -C "$1" status --porcelain --untracked-files=no)" ]] || verdict fail "just generated changed tracked files"
}

# --- verify -----------------------------------------------------------------

# The formal verification (looper#74; tacplus-dev/tacplus#275), in the
# pinned build image, as the gates job runs: `just verify` on the commit, on
# a release tag always, on a verify run only when `just verify-changed <the
# last verified commit>` prints run (no record, or a check that cannot tell,
# runs it too). Its record, verify/record (a "key value" line each: repo,
# kind, checked, verified, result pass|fail|none, run, and skipped when it
# did not run), is the job's artifact; a skip keeps the last verification's
# commit, result and run. A red run keeps its failed harnesses (failures.md:
# each one's section of tacplus verify's report, with its counterexample) and
# the log's tail, and fails the job.
cmd_verify() {
  refuse_write_credentials
  check_inputs
  local out="$BUILD_OUT/verify" key="${TACPLUS_READER_APP_KEY:-}" src="$BUILD_OUT/src" kind=nightly rc=0 ans
  local since="${BUILD_VERIFY_SINCE:-}"
  [[ -z "${BUILD_TAG:-}" ]] || kind=release
  rm -rf "$out"; mkdir -p "$out"
  BUILD_GITHUB_TOKEN="$(reader_token '"contents":"read","metadata":"read"')" ||
    verdict fail "no read-only GitHub token (the tacplus-reader app)"
  [[ -n "$key" ]] && rm -f "$key"
  unset TACPLUS_READER_APP_KEY TACPLUS_READER_APP_ID TACPLUS_READER_INSTALLATION_ID
  drop_job_credentials
  export BUILD_GITHUB_TOKEN; git_credentials
  export GOPRIVATE="${GOPRIVATE:-github.com/$BUILD_ORG/*}"
  fetch_commit "$src"
  refuse_push_credential "$src"
  image_tacplus "$src"
  verify_record() { # result verified run [skipped]
    { echo "repo $BUILD_REPO"; echo "kind $kind"; echo "checked $BUILD_SHA"; echo "verified $2"; echo "result $1"
      echo "run $3"; [[ -z "${4:-}" ]] || echo "skipped $4"; echo "checked_by ${CI_PIPELINE_URL:-}"; } > "$out/record"
  }
  if ! (cd "$src" && just --summary 2>/dev/null | tr ' ' '\n' | grep -qx verify); then
    log "verify: $BUILD_REPO's justfile has no \`verify\` recipe at $BUILD_SHA: nothing to verify"
    verify_record none "" "${CI_PIPELINE_URL:-}"; verdict pass; return 0
  fi
  if [[ "$kind" == nightly ]]; then
    if [[ -n "$since" && -n "${BUILD_VERIFY_RESULT:-}" ]]; then
      git -C "$src" fetch -q --depth 1 origin "$since" 2>&1 | tail -5 >&2 || true
      ans="$(cd "$src" && just verify-changed "$since" 2>/dev/null | head -n 1)" || ans=""
      if [[ "$ans" == skip* ]]; then
        log "verify: $ans"
        verify_record "$BUILD_VERIFY_RESULT" "$since" "${BUILD_VERIFY_RUN:-}" "unchanged since $since"
        verdict pass; return 0
      fi
      log "verify: just verify-changed $since: ${ans:-no answer}: it runs"
    else
      log "verify: no record of a verification: it runs"
    fi
  fi
  log "verify: $BUILD_REPO $BUILD_SHA ($kind): just verify"
  (cd "$src" && just verify) 2>&1 | tee "$out/verify.log" >&2 || rc="${PIPESTATUS[0]}"
  failed_harnesses < "$out/verify.log" > "$out/failures.md"
  tail -n 80 "$out/verify.log" > "$out/log-tail"
  if ((rc == 0)); then verify_record pass "$BUILD_SHA" "${CI_PIPELINE_URL:-}"; verdict pass
  else verify_record fail "$BUILD_SHA" "${CI_PIPELINE_URL:-}"; verdict fail "just verify exited $rc (verify/verify.log)"; fi
}

# The sections of tacplus verify's report (verification-report.md, which
# just verify prints on a failure) whose harness did not verify: from its
# `### <message> -- <harness>` to the next heading or `===` line.
failed_harnesses() {
  awk '
    function flush() { if (sec != "" && failed) printf "%s\n", sec; sec = ""; failed = 0 }
    /^### / { flush(); sec = $0; next }
    /^(## |# |=== )/ { flush(); next }
    sec != "" { sec = sec "\n" $0
                if ($0 ~ /^\*\*Status:\*\* / && $0 !~ /^\*\*Status:\*\* (VERIFIED|PASSED|SUCCESS)/) failed = 1 }
    END { flush() }'
}

# The verify job's record as the repository's latest (the build project's
# generic package verify-<repo>, with the job's token): the next verify run's
# last verified commit, and what the nightly scan files (looper-verify). A
# skip publishes its record alone: the failures beside it stay those of the
# run it names.
cmd_verify_report() {
  check_inputs
  local d="$BUILD_OUT/verify" f files=(record)
  [[ -f "$d/record" ]] || { log "the verify job left no record: nothing to publish"; return 0; }
  cat "$d/record" >&2
  grep -q '^skipped ' "$d/record" || files+=(failures.md log-tail)
  : "${CI_JOB_TOKEN:?no job token: the report publishes with it}" "${CI_API_V4_URL:?}" "${CI_PROJECT_ID:?}"
  for f in "${files[@]}"; do
    [[ -s "$d/$f" ]] || echo "(none)" > "$d/$f"
    curl -fsS -o /dev/null -H "JOB-TOKEN: $CI_JOB_TOKEN" --upload-file "$d/$f" "$(verify_url "$f")" ||
      { log "the package registry refused $f"; exit 1; }
  done
  log "published as verify-$BUILD_REPO/latest: ${files[*]}"
}

# --- status -----------------------------------------------------------------

cmd_status() { # state [description]
  local state="${1:-}" text="${2:-}"
  case "$state" in pending|success|failure|error) ;; *) usage >&2; exit 2 ;; esac
  refuse_write_credentials
  check_inputs
  [[ -n "$text" ]] || case "$state" in
    pending) text="building${BUILD_GATES:+: gates $BUILD_GATES}" ;;
    success) text="pass${BUILD_GATES:+: gates $BUILD_GATES}" ;;
    # No build-verdict here when the gates' child pipeline failed (the plan passed): sed exits 2 on the missing file.
    # A gates-failed job's (BUILD_NO_VERDICT) when the gates job left none (looper#148).
    *) text="$(sed -n '1s/^fail: //p' "$BUILD_OUT/build-verdict" 2>/dev/null || true)"; text="${text:-${BUILD_NO_VERDICT:-the build failed}}" ;;
  esac
  local token body url="${BUILD_STATUS_URL:-${CI_PIPELINE_URL:-}}" set
  token="$(reader_token '"statuses":"write","metadata":"read"' "$BUILD_REPO")" || { log "no token for the commit status"; exit 1; }
  # The build's own "the build failed" leaves the reason its gates-failed job set on this pipeline.
  if [[ "$state" == failure && "$text" == "the build failed" && -n "$url" ]] &&
     set="$(curl -fsS -H "Authorization: Bearer $token" -H 'Accept: application/vnd.github+json' \
              "$BUILD_GITHUB_API/repos/$BUILD_ORG/$BUILD_REPO/commits/$BUILD_SHA/statuses?per_page=100" 2>/dev/null |
            jq -r --arg c "$BUILD_STATUS_CONTEXT" --arg u "$url" \
              'first(.[] | select(.context == $c and .target_url == $u and .state == "failure") | .description) // empty' 2>/dev/null)" &&
     [[ -n "$set" ]]; then
    log "status: $BUILD_ORG/$BUILD_REPO@$BUILD_SHA $BUILD_STATUS_CONTEXT failure already set by this build: $set"; return 0
  fi
  body="$(jq -cn --arg s "$state" --arg c "$BUILD_STATUS_CONTEXT" --arg d "${text:0:140}" --arg u "$url" \
            '{state: $s, context: $c, description: $d} + (if $u == "" then {} else {target_url: $u} end)')"
  curl -fsS -o /dev/null -X POST -H "Authorization: Bearer $token" -H 'Accept: application/vnd.github+json' \
    -d "$body" "$BUILD_GITHUB_API/repos/$BUILD_ORG/$BUILD_REPO/statuses/$BUILD_SHA" ||
    { log "GitHub refused the commit status"; exit 1; }
  log "status: $BUILD_ORG/$BUILD_REPO@$BUILD_SHA $BUILD_STATUS_CONTEXT $state: $text"
}

# --- publish ----------------------------------------------------------------

# Docker logs in to the registry with a short-lived GCP token from the job's
# GitLab id_token (GCP_ID_TOKEN), through Workload Identity Federation
# (GCP_WIF_PROVIDER, tacplus#223); GCP_PUBLISH_SA, when set, is impersonated.
# No key file, no stored token: both configs live in a temporary directory.
registry_login() { # tmp
  : "${GCP_ID_TOKEN:?the publish job has no id_tokens GCP_ID_TOKEN}"
  : "${GCP_WIF_PROVIDER:?the build project variable GCP_WIF_PROVIDER is not set (tacplus-dev/tacplus#223)}"
  local sa=()
  [[ -n "${GCP_PUBLISH_SA:-}" ]] && sa=(--service-account="$GCP_PUBLISH_SA")
  export CLOUDSDK_CONFIG="$1/gcloud" CLOUDSDK_CORE_DISABLE_PROMPTS=1 DOCKER_CONFIG="$1/docker"
  mkdir -p "$DOCKER_CONFIG"
  ( umask 077
    printf '%s' "$GCP_ID_TOKEN" > "$1/oidc-token"
    gcloud iam workload-identity-pools create-cred-config "$GCP_WIF_PROVIDER" "${sa[@]}" \
      --credential-source-file="$1/oidc-token" --output-file="$1/federation.json" >/dev/null )
  gcloud auth login --cred-file="$1/federation.json" --quiet >/dev/null 2>&1 ||
    verdict fail "Workload Identity Federation refused this job ($GCP_WIF_PROVIDER)"
  gcloud auth print-access-token | docker login -u oauth2accesstoken --password-stdin "https://${BUILD_REGISTRY%%/*}" >/dev/null ||
    verdict fail "the registry refused the federated token"
}

# The digest of the image buildx built (its --metadata-file).
built_digest() { # metadata.json
  sed -n 's/.*"containerimage\.digest"[[:space:]]*:[[:space:]]*"\(sha256:[0-9a-f]\{64\}\)".*/\1/p' "$1" | head -1
}

# A reproducible image of the checkout: every timestamp is the commit's
# (SOURCE_DATE_EPOCH, rewrite-timestamp), no provenance or SBOM attestation
# (they carry the build's time and identity), OCI media types for every
# output, so the same commit gives the same digest whether it is pushed or
# written to a file. Prints the digest.
build_image() { # src output-spec tmp
  local meta="$3/metadata-$RANDOM.json" epoch
  epoch="$(git -C "$1" log -1 --format=%ct)"
  SOURCE_DATE_EPOCH="$epoch" docker buildx build --builder "$BUILDER" --platform "$BUILD_PLATFORMS" \
    --provenance=false --sbom=false --pull \
    --build-arg "SOURCE_DATE_EPOCH=$epoch" --build-arg "VERSION=${BUILD_TAG:-}" --build-arg "REVISION=$BUILD_SHA" \
    --label "org.opencontainers.image.revision=$BUILD_SHA" \
    --label "org.opencontainers.image.source=$BUILD_GITHUB_URL/$BUILD_ORG/$BUILD_REPO" \
    --output "$2,rewrite-timestamp=true" --metadata-file "$meta" "$1" >&2 ||
    verdict fail "the image of $BUILD_REPO $BUILD_SHA did not build"
  built_digest "$meta"
}

# A builder of its own (BuildKit by digest), and the emulators for a platform
# it cannot build: they are installed (once per machine) and the builder made
# again, since BuildKit finds them when it starts.
setup_builder() {
  local p missing=""
  new_builder
  for p in ${BUILD_PLATFORMS//,/ }; do
    builder_platforms | grep -qxF "$p" || missing+=" $p"
  done
  [[ -n "$missing" ]] || return 0
  log "no emulator for$missing: installing them ($BUILD_BINFMT_IMAGE)"
  docker run --rm --privileged "$BUILD_BINFMT_IMAGE" --install all >/dev/null 2>&1 ||
    verdict fail "could not install the emulators for$missing"
  docker buildx rm "$BUILDER" >/dev/null 2>&1 || true
  new_builder
  for p in $missing; do
    builder_platforms | grep -qxF "$p" || verdict fail "the builder cannot build $p"
  done
}
new_builder() {
  docker buildx create --name "$BUILDER" --driver docker-container \
    --driver-opt "image=$BUILD_BUILDKIT_IMAGE" >/dev/null || verdict fail "no buildx builder"
}
# The platforms the builder can build, one per line.
builder_platforms() {
  docker buildx inspect --bootstrap "$BUILDER" 2>/dev/null | sed -n 's/^Platforms:[[:space:]]*//p' | tr ',' '\n' | tr -d ' *'
}

cmd_publish() {
  local dry=0
  [[ "${1:-}" == --dry-run ]] && dry=1
  refuse_write_credentials GCP_ID_TOKEN
  check_inputs
  [[ -n "${BUILD_TAG:-}" ]] || verdict fail "publish needs a release tag (BUILD_TAG vX.Y.Z)"
  mkdir -p "$BUILD_OUT"
  BUILD_GITHUB_TOKEN="$(reader_token '"contents":"read","metadata":"read"' "$BUILD_REPO")" ||
    verdict fail "no read-only GitHub token (the tacplus-reader app)"
  export BUILD_GITHUB_TOKEN; git_credentials
  local src="$BUILD_OUT/publish-src" tmp name built pushed existing
  fetch_commit "$src"
  check_release "$src"
  [[ -f "$src/Dockerfile" ]] || verdict fail "$BUILD_REPO has no Dockerfile at $BUILD_SHA: nothing to publish"
  tmp="$(mktemp -d)"; BUILDER="looper-build-$$"
  # shellcheck disable=SC2064  # the builder and directory of this run
  trap "docker buildx rm '$BUILDER' >/dev/null 2>&1; rm -rf '$tmp'" EXIT
  setup_builder
  name="$BUILD_REGISTRY/$BUILD_REPO:${BUILD_TAG#v}"
  built="$(build_image "$src" "type=oci,dest=$tmp/image.tar" "$tmp")"
  [[ -n "$built" ]] || verdict fail "buildx reported no digest"
  log "built $name@$built"
  if ((dry)); then
    echo "$name@$built" > "$BUILD_OUT/image"
    BUILD_SBOM_UPLOAD=0 release_sbom "$tmp/image.tar"
    log "dry run: nothing pushed"; return 0
  fi
  registry_login "$tmp"
  # An immutable release: an image already there must be this one.
  # (The digest is that of the manifest's bytes as the registry serves them.)
  if docker buildx imagetools inspect --raw "$name" > "$tmp/existing" 2>/dev/null && [[ -s "$tmp/existing" ]]; then
    existing="sha256:$(sha256sum < "$tmp/existing" | cut -d' ' -f1)"
    [[ "$existing" == "$built" ]] || verdict fail "$name is already published as $existing; this build gives $built"
    log "$name is already published, with this digest"
  else
    pushed="$(build_image "$src" "type=image,name=$name,push=true,oci-mediatypes=true" "$tmp")"
    [[ "$pushed" == "$built" ]] || verdict fail "not reproducible: the pushed image is $pushed, the build before it $built"
  fi
  echo "$name@$built" > "$BUILD_OUT/image"
  log "published $name@$built"
  release_sbom "$tmp/image.tar"
}

# The release's SBOM (looper#49), of the image published, CycloneDX and SPDX:
# the publish job's artifacts sbom.cdx.json and sbom.spdx.json (kept), and the
# build project's generic package sbom-<repo>, version X.Y.Z.
release_sbom() { # oci-archive
  local scan; scan="$(dirname "$SELF")/looper-scan"
  [[ -x "$scan" ]] || verdict fail "no looper-scan beside looper-build: the release's SBOM cannot be made"
  "$scan" sbom "oci-archive:$1" "$BUILD_OUT" || verdict fail "the SBOM of $BUILD_REPO $BUILD_TAG could not be made"
  local f
  if [[ "${BUILD_SBOM_UPLOAD:-1}" == 1 && -n "${CI_JOB_TOKEN:-}" && -n "${CI_API_V4_URL:-}" && -n "${CI_PROJECT_ID:-}" ]]; then
    for f in sbom.cdx.json sbom.spdx.json; do
      curl -fsS -o /dev/null -H "JOB-TOKEN: $CI_JOB_TOKEN" --upload-file "$BUILD_OUT/$f" \
        "$CI_API_V4_URL/projects/$CI_PROJECT_ID/packages/generic/sbom-$BUILD_REPO/${BUILD_TAG#v}/$f" ||
        verdict fail "the package registry refused the SBOM $f"
    done
    log "SBOM published: sbom-$BUILD_REPO ${BUILD_TAG#v}"
  fi
}

# Sourced (looper-scan, looper#49): its functions, and nothing run.
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0

case "${1:-}" in
  plan) cmd_plan ;;
  gates) cmd_gates ;;
  status) shift; cmd_status "$@" ;;
  publish) shift; cmd_publish "$@" ;;
  verify) cmd_verify ;;
  verify-report) cmd_verify_report ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
