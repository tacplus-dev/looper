#
# looper-build: the build pipeline (looper#17; tacplus-dev/roadmap
# decisions/deterministic-builds-2026-10-27.md). A build takes (repo, commit)
# as it is and gives a verdict, pass or fail, and on a release tag an image;
# it never changes the repository. The pipeline is gitlab.com/tacplus-dev/build
# (ci/build.gitlab-ci.yml here), whose jobs run this script:
#
#   plan     fetch exactly the commit, read its tacplus.lock, and write the
#            child pipeline whose gates job runs in the pinned build image
#   gates    in that image, with no agent: `just gates` on the commit; a
#            change to a tracked file fails it
#   status   the GitHub commit status (context tacplus-dev/build)
#   publish  on a release tag: the image, pushed to Artifact Registry through
#            Workload Identity Federation, and its digest
#
# Self-contained (no looper-lib.sh, no jq on the gates path): the plan embeds
# this very file in the gates job, which runs in the repository's pinned build
# image, not in the looper image.
#
# Credentials: GitHub only through the read-only tacplus-reader app
# (TACPLUS_READER_APP_ID, TACPLUS_READER_INSTALLATION_ID and the file variable
# TACPLUS_READER_APP_KEY, project variables of tacplus-dev/build, looper#12):
# each step mints its own one-hour installation token with the least
# permissions it needs. A job that holds a write credential (a looper's
# GH_TOKEN, GITLAB_TOKEN, ...) refuses to run.
set -euo pipefail

BUILD_ORG="${BUILD_ORG:-tacplus-dev}"
BUILD_GITHUB_URL="${BUILD_GITHUB_URL:-https://github.com}"
BUILD_GITHUB_API="${BUILD_GITHUB_API:-https://api.github.com}"
BUILD_OUT="${BUILD_OUT:-$PWD}"
BUILD_RUNNER_TAGS="${BUILD_RUNNER_TAGS:-arm64, build}"
BUILD_REGISTRY="${BUILD_REGISTRY:-us-docker.pkg.dev/jody1-328023/tacplus}"
BUILD_PLATFORMS="${BUILD_PLATFORMS:-linux/amd64,linux/arm64}"
BUILD_STATUS_CONTEXT="${BUILD_STATUS_CONTEXT:-tacplus-dev/build}"
# The builder publish runs in, and the emulators for a foreign platform, by digest.
BUILD_BUILDKIT_IMAGE="${BUILD_BUILDKIT_IMAGE:-moby/buildkit:v0.33.1@sha256:cec9f139f45e93c5c69c60f8b07cfad9f43f4ef6b6a6cd917527fea5ff2e3dea}"
BUILD_BINFMT_IMAGE="${BUILD_BINFMT_IMAGE:-tonistiigi/binfmt:qemu-v10.0.4@sha256:8f58e6214f4cc9dc83ce8f5acad1ece508eb6b20e696a8c1e9f274481982c541}"

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

usage() {
  cat <<'EOF'
usage: looper-build plan                  write build-gates.yml (the gates job, in the pinned image)
       looper-build gates                 just gates on the commit, in this directory's checkout
       looper-build status STATE [TEXT]   the commit status: pending, success or failure
       looper-build publish [--dry-run]   the release image and its digest (--dry-run: build only)
Environment: BUILD_REPO, BUILD_SHA, BUILD_TAG (a release, vX.Y.Z), the tacplus-reader
app (TACPLUS_READER_APP_ID, TACPLUS_READER_INSTALLATION_ID, TACPLUS_READER_APP_KEY);
outputs go to BUILD_OUT (default: here).
EOF
}

log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }

# The verdict, one line in $BUILD_OUT/build-verdict: "pass" or "fail: <why>".
# fail ends the job.
verdict() { # pass | fail <why>
  if [[ "$1" == pass ]]; then
    echo pass > "$BUILD_OUT/build-verdict"; log "verdict: pass"
  else
    shift; echo "fail: $*" > "$BUILD_OUT/build-verdict"; log "verdict: FAIL: $*"; exit 1
  fi
}

# --- inputs ---------------------------------------------------------------

check_inputs() {
  [[ "${BUILD_REPO:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$BUILD_REPO" != *..* ]] ||
    verdict fail "BUILD_REPO '${BUILD_REPO:-}' is not a repository name"
  [[ "${BUILD_SHA:-}" =~ ^[0-9a-f]{40}$ ]] || verdict fail "BUILD_SHA '${BUILD_SHA:-}' is not a full commit hash"
  [[ -z "${BUILD_TAG:-}" || "$BUILD_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
    verdict fail "BUILD_TAG '$BUILD_TAG' is not a release tag vX.Y.Z"
}

# A build holds no credential that can change a repository: refuse to run
# beside one. The names are the loopers' (and GitHub's, GitLab's, Anthropic's);
# any other variable whose value is shaped like a personal or OAuth token
# (ghp_, github_pat_, gho_, ghu_, glpat-) is refused too. GCP_ID_TOKEN, the
# job's identity for Workload Identity Federation, only where it is allowed
# (publish).
WRITE_CREDENTIALS=(GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITLAB_TOKEN CLAUDE_CODE_OAUTH_TOKEN
                   ANTHROPIC_API_KEY GHCR_PUSH_TOKEN)
refuse_write_credentials() { # [allowed name...]
  local v found=() allowed=" $* "
  for v in "${WRITE_CREDENTIALS[@]}" GCP_ID_TOKEN; do
    [[ "$allowed" == *" $v "* ]] && continue
    [[ -n "${!v:-}" ]] && found+=("$v")
  done
  for v in $(compgen -e); do
    case "${!v:-}" in ghp_*|github_pat_*|gho_*|ghu_*|glpat-*) [[ " ${found[*]} " == *" $v "* ]] || found+=("$v") ;; esac
  done
  ((${#found[@]} == 0)) || verdict fail "this job holds a write credential (${found[*]}): a build must not"
}

# --- GitHub, read-only ------------------------------------------------------

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# A one-hour installation token of the tacplus-reader app, with only the
# permissions given ('"contents":"read"', ...), for the given repositories
# (none: every repository the app is installed on). Printed on stdout. The
# app's key is a file variable; only its signature leaves this process.
reader_token() { # permissions-json-members [repo...]
  local perms="$1" repos="" r now header payload jwt body resp token
  shift
  : "${TACPLUS_READER_APP_ID:?the tacplus-reader app id (TACPLUS_READER_APP_ID) is not set}"
  : "${TACPLUS_READER_INSTALLATION_ID:?TACPLUS_READER_INSTALLATION_ID is not set}"
  [[ -f "${TACPLUS_READER_APP_KEY:-}" ]] || { log "TACPLUS_READER_APP_KEY is not a file (a file variable of the build project)"; return 1; }
  for r in "$@"; do repos+="${repos:+,}\"$r\""; done
  now="$(date +%s)"
  header="$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)"
  payload="$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$TACPLUS_READER_APP_ID" | b64url)"
  jwt="$header.$payload.$(printf '%s' "$header.$payload" | openssl dgst -sha256 -sign "$TACPLUS_READER_APP_KEY" | b64url)"
  body="{\"permissions\":{$perms}${repos:+,\"repositories\":[$repos]}}"
  resp="$(curl -fsS -X POST -H "Authorization: Bearer $jwt" -H 'Accept: application/vnd.github+json' \
            -d "$body" "$BUILD_GITHUB_API/app/installations/$TACPLUS_READER_INSTALLATION_ID/access_tokens")" ||
    { log "GitHub refused the tacplus-reader app a token"; return 1; }
  token="$(printf '%s' "$resp" | tr -d '\n' | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"
  [[ -n "$token" ]] || { log "no token in GitHub's answer"; return 1; }
  printf '%s\n' "$token"
}

# Git authenticates to GitHub, and to no other host, with $BUILD_GITHUB_TOKEN,
# through its environment alone (as DOCKER_GITHUB_CREDS in looper-lib.sh): the
# empty value first drops any other helper for that host, so none stores it.
# shellcheck disable=SC2016  # expanded by git's shell, when git asks
git_credentials() {
  export GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=2
  export GIT_CONFIG_KEY_0="credential.$BUILD_GITHUB_URL.helper" GIT_CONFIG_VALUE_0=
  export GIT_CONFIG_KEY_1="credential.$BUILD_GITHUB_URL.helper"
  export GIT_CONFIG_VALUE_1='!f() { test "$1" = get || exit 0; test -n "$BUILD_GITHUB_TOKEN" || exit 0; echo username=x-access-token; echo "password=$BUILD_GITHUB_TOKEN"; }; f'
}

repo_url() { echo "$BUILD_GITHUB_URL/$BUILD_ORG/$BUILD_REPO.git"; }

# Exactly the commit, nothing else, into dir.
fetch_commit() { # dir
  rm -rf "$1"; git init -q "$1"
  git -C "$1" remote add origin "$(repo_url)"
  git -C "$1" fetch -q --depth 1 origin "$BUILD_SHA" 2>&1 | tail -5 >&2 || true
  git -C "$1" rev-parse -q --verify "FETCH_HEAD^{commit}" >/dev/null 2>&1 ||
    verdict fail "$BUILD_ORG/$BUILD_REPO has no commit $BUILD_SHA (or it cannot be read)"
  git -C "$1" -c advice.detachedHead=false checkout -q FETCH_HEAD
  [[ "$(git -C "$1" rev-parse HEAD)" == "$BUILD_SHA" ]] || verdict fail "checked out $(git -C "$1" rev-parse HEAD), not $BUILD_SHA"
}

# The source credential must not be able to push: GitHub refuses a push
# (even --dry-run asks for the receive-pack) with a read-only token.
refuse_push_credential() { # dir
  if git -C "$1" push -q --dry-run origin "HEAD:refs/heads/looper-build-push-probe" >/dev/null 2>&1; then
    verdict fail "the source credential can push to $BUILD_ORG/$BUILD_REPO: a build's must be read-only"
  fi
  log "the source credential cannot push (refused, as it must be)"
}

# --- the pin ----------------------------------------------------------------

# tacplus.lock, as tacplus validates it (pkg/tacplusyaml/lock.go): an exact
# release and the build image by digest, of the same line. Prints the image.
read_pin() { # dir
  local lock="$1/tacplus.lock" version image tag
  [[ -f "$lock" ]] || verdict fail "no pin: $BUILD_REPO has no tacplus.lock at $BUILD_SHA (run \`tacplus pin\` and commit it)"
  version="$(sed -n 's/^tacplus:[[:space:]]*"\{0,1\}\([^"[:space:]]*\)"\{0,1\}[[:space:]]*$/\1/p' "$lock" | head -1)"
  image="$(sed -n 's/^build_image:[[:space:]]*"\{0,1\}\([^"[:space:]]*\)"\{0,1\}[[:space:]]*$/\1/p' "$lock" | head -1)"
  [[ "$version" =~ ^([0-9]+)\.([0-9]+)\.[0-9]+$ ]] ||
    verdict fail "tacplus.lock: tacplus: '$version' must be an exact MAJOR.MINOR.PATCH release"
  local line="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}"
  [[ "$image" =~ ^[a-z0-9][a-z0-9._/-]*(:([A-Za-z0-9_][A-Za-z0-9._-]*))?@sha256:[0-9a-f]{64}$ ]] ||
    verdict fail "tacplus.lock: build_image: '$image' must name the image by digest (<name>[:<tag>]@sha256:<64 hex>)"
  tag="${BASH_REMATCH[2]}"
  if [[ "$tag" =~ ^([0-9]+)\.([0-9]+)\.[0-9]+$ && "${BASH_REMATCH[1]}.${BASH_REMATCH[2]}" != "$line" ]]; then
    verdict fail "tacplus.lock: build_image '$image' is not of the pin's line $line"
  fi
  echo "$image"
}

# A release: the build project's pipeline runs on its protected tag
# <repo>/vX.Y.Z (what Workload Identity Federation trusts, tacplus#223), and
# the repository's tag vX.Y.Z is the commit built.
check_release() { # dir
  [[ -n "${BUILD_TAG:-}" ]] || return 0
  [[ "${CI_COMMIT_TAG:-}" == "$BUILD_REPO/$BUILD_TAG" ]] ||
    verdict fail "a release build of $BUILD_REPO $BUILD_TAG runs on the build project's protected tag $BUILD_REPO/$BUILD_TAG, not '${CI_COMMIT_REF_NAME:-}'"
  local at
  at="$(git -C "$1" ls-remote origin "refs/tags/$BUILD_TAG^{}" "refs/tags/$BUILD_TAG" | awk 'NR==1 || /\^\{\}$/ {c=$1} END {print c}')"
  [[ "$at" == "$BUILD_SHA" ]] || verdict fail "$BUILD_REPO's tag $BUILD_TAG is at '${at:-nothing}', not $BUILD_SHA"
}

# --- plan -------------------------------------------------------------------

cmd_plan() {
  refuse_write_credentials
  check_inputs
  mkdir -p "$BUILD_OUT"
  BUILD_GITHUB_TOKEN="$(reader_token '"contents":"read","metadata":"read"' "$BUILD_REPO")" ||
    verdict fail "no read-only GitHub token (the tacplus-reader app)"
  export BUILD_GITHUB_TOKEN; git_credentials
  local src="$BUILD_OUT/plan-src" image
  fetch_commit "$src"
  check_release "$src"
  image="$(read_pin "$src")"
  rm -rf "$src"
  write_gates_pipeline "$image" > "$BUILD_OUT/build-gates.yml"
  log "plan: $BUILD_REPO $BUILD_SHA${BUILD_TAG:+ ($BUILD_TAG)} gates in $image"
}

# The child pipeline: one job, in the pinned image, running this script.
write_gates_pipeline() { # image
  cat <<EOF
# Written by looper-build plan: the gates of $BUILD_REPO at $BUILD_SHA, in its pinned build image.
gates:
  image: "$1"
  tags: [$BUILD_RUNNER_TAGS]
  variables:
    GIT_STRATEGY: none
    BUILD_REPO: "$BUILD_REPO"
    BUILD_SHA: "$BUILD_SHA"
    BUILD_TAG: "${BUILD_TAG:-}"
    BUILD_ORG: "$BUILD_ORG"
  script:
    - |
      cat > "\$CI_PROJECT_DIR/looper-build" <<'LOOPER_BUILD_EOF'
EOF
  sed 's/^/      /' "$SELF"
  cat <<'EOF'
      LOOPER_BUILD_EOF
      bash "$CI_PROJECT_DIR/looper-build" gates
  artifacts:
    when: always
    expire_in: 30 days
    paths: [gates.log, build-verdict]
EOF
}

# --- gates ------------------------------------------------------------------

# GitLab's own job credentials (the job token can call GitLab's API, and is in
# the clone URL) are no part of a build: dropped before the repository's code.
drop_job_credentials() {
  unset CI_JOB_TOKEN CI_BUILD_TOKEN CI_REGISTRY_PASSWORD CI_DEPENDENCY_PROXY_PASSWORD CI_REPOSITORY_URL \
        CI_JOB_JWT CI_JOB_JWT_V1 CI_JOB_JWT_V2
}

cmd_gates() {
  refuse_write_credentials
  check_inputs
  mkdir -p "$BUILD_OUT"
  local key="${TACPLUS_READER_APP_KEY:-}"
  BUILD_GITHUB_TOKEN="$(reader_token '"contents":"read","metadata":"read"')" ||
    verdict fail "no read-only GitHub token (the tacplus-reader app)"
  # The app's key is gone before the repository's code runs: it could mint
  # tokens with the app's every permission (commit statuses).
  [[ -n "$key" ]] && rm -f "$key"
  unset TACPLUS_READER_APP_KEY TACPLUS_READER_APP_ID TACPLUS_READER_INSTALLATION_ID
  drop_job_credentials
  export BUILD_GITHUB_TOKEN; git_credentials
  # Private Go modules of the org come from GitHub through the token, not the proxy.
  export GOPRIVATE="${GOPRIVATE:-github.com/$BUILD_ORG/*}"

  local src="$BUILD_OUT/src" rc=0 changed
  fetch_commit "$src"
  refuse_push_credential "$src"
  command -v just >/dev/null || verdict fail "the build image has no just"
  if ! (cd "$src" && just --summary 2>/dev/null | tr ' ' '\n' | grep -qx gates); then
    verdict fail "no gates: $BUILD_REPO's justfile has no \`gates\` recipe at $BUILD_SHA"
  fi
  log "gates: $BUILD_REPO $BUILD_SHA: just gates"
  (cd "$src" && just gates) 2>&1 | tee "$BUILD_OUT/gates.log" >&2 || rc="${PIPESTATUS[0]}"
  changed="$(git -C "$src" status --porcelain --untracked-files=no)"
  [[ -z "$changed" ]] || verdict fail "the build changed tracked files: $(echo "$changed" | head -20 | tr '\n' ' ')"
  [[ "$(git -C "$src" rev-parse HEAD)" == "$BUILD_SHA" ]] || verdict fail "the build moved HEAD off $BUILD_SHA"
  ((rc == 0)) || verdict fail "just gates exited $rc (gates.log)"
  verdict pass
}

# --- status -----------------------------------------------------------------

cmd_status() { # state [description]
  local state="${1:-}" text="${2:-}"
  case "$state" in pending|success|failure|error) ;; *) usage >&2; exit 2 ;; esac
  refuse_write_credentials
  check_inputs
  [[ -n "$text" ]] || case "$state" in
    pending) text="building" ;;
    success) text="pass" ;;
    *) text="$(sed -n '1s/^fail: //p' "$BUILD_OUT/build-verdict" 2>/dev/null)"; text="${text:-the build failed}" ;;
  esac
  local token body
  token="$(reader_token '"statuses":"write","metadata":"read"' "$BUILD_REPO")" || { log "no token for the commit status"; exit 1; }
  body="$(jq -cn --arg s "$state" --arg c "$BUILD_STATUS_CONTEXT" --arg d "${text:0:140}" --arg u "${CI_PIPELINE_URL:-}" \
            '{state: $s, context: $c, description: $d} + (if $u == "" then {} else {target_url: $u} end)')"
  curl -fsS -o /dev/null -X POST -H "Authorization: Bearer $token" -H 'Accept: application/vnd.github+json' \
    -d "$body" "$BUILD_GITHUB_API/repos/$BUILD_ORG/$BUILD_REPO/statuses/$BUILD_SHA" ||
    { log "GitHub refused the commit status"; exit 1; }
  log "status: $BUILD_ORG/$BUILD_REPO@$BUILD_SHA $BUILD_STATUS_CONTEXT $state: $text"
}

# --- publish ----------------------------------------------------------------

# Docker logs in to the registry with a short-lived GCP token from the job's
# GitLab id_token (GCP_ID_TOKEN), through Workload Identity Federation
# (GCP_WIF_PROVIDER, tacplus#223); GCP_PUBLISH_SA, when set, is impersonated.
# No key file, no stored token: both configs live in a temporary directory.
registry_login() { # tmp
  : "${GCP_ID_TOKEN:?the publish job has no id_tokens GCP_ID_TOKEN}"
  : "${GCP_WIF_PROVIDER:?the build project variable GCP_WIF_PROVIDER is not set (tacplus-dev/tacplus#223)}"
  local sa=()
  [[ -n "${GCP_PUBLISH_SA:-}" ]] && sa=(--service-account="$GCP_PUBLISH_SA")
  export CLOUDSDK_CONFIG="$1/gcloud" CLOUDSDK_CORE_DISABLE_PROMPTS=1 DOCKER_CONFIG="$1/docker"
  mkdir -p "$DOCKER_CONFIG"
  ( umask 077
    printf '%s' "$GCP_ID_TOKEN" > "$1/oidc-token"
    gcloud iam workload-identity-pools create-cred-config "$GCP_WIF_PROVIDER" "${sa[@]}" \
      --credential-source-file="$1/oidc-token" --output-file="$1/federation.json" >/dev/null )
  gcloud auth login --cred-file="$1/federation.json" --quiet >/dev/null 2>&1 ||
    verdict fail "Workload Identity Federation refused this job ($GCP_WIF_PROVIDER)"
  gcloud auth print-access-token | docker login -u oauth2accesstoken --password-stdin "https://${BUILD_REGISTRY%%/*}" >/dev/null ||
    verdict fail "the registry refused the federated token"
}

# The digest of the image buildx built (its --metadata-file).
built_digest() { # metadata.json
  sed -n 's/.*"containerimage\.digest"[[:space:]]*:[[:space:]]*"\(sha256:[0-9a-f]\{64\}\)".*/\1/p' "$1" | head -1
}

# A reproducible image of the checkout: every timestamp is the commit's
# (SOURCE_DATE_EPOCH, rewrite-timestamp), no provenance or SBOM attestation
# (they carry the build's time and identity), OCI media types for every
# output, so the same commit gives the same digest whether it is pushed or
# written to a file. Prints the digest.
build_image() { # src output-spec tmp
  local meta="$3/metadata-$RANDOM.json" epoch
  epoch="$(git -C "$1" log -1 --format=%ct)"
  SOURCE_DATE_EPOCH="$epoch" docker buildx build --builder "$BUILDER" --platform "$BUILD_PLATFORMS" \
    --provenance=false --sbom=false --pull \
    --build-arg "SOURCE_DATE_EPOCH=$epoch" --build-arg "VERSION=${BUILD_TAG:-}" --build-arg "REVISION=$BUILD_SHA" \
    --label "org.opencontainers.image.revision=$BUILD_SHA" \
    --label "org.opencontainers.image.source=$BUILD_GITHUB_URL/$BUILD_ORG/$BUILD_REPO" \
    --output "$2,rewrite-timestamp=true" --metadata-file "$meta" "$1" >&2 ||
    verdict fail "the image of $BUILD_REPO $BUILD_SHA did not build"
  built_digest "$meta"
}

# A builder of its own (BuildKit by digest), and the emulators for a platform
# it cannot build: they are installed (once per machine) and the builder made
# again, since BuildKit finds them when it starts.
setup_builder() {
  local p missing=""
  new_builder
  for p in ${BUILD_PLATFORMS//,/ }; do
    builder_platforms | grep -qxF "$p" || missing+=" $p"
  done
  [[ -n "$missing" ]] || return 0
  log "no emulator for$missing: installing them ($BUILD_BINFMT_IMAGE)"
  docker run --rm --privileged "$BUILD_BINFMT_IMAGE" --install all >/dev/null 2>&1 ||
    verdict fail "could not install the emulators for$missing"
  docker buildx rm "$BUILDER" >/dev/null 2>&1 || true
  new_builder
  for p in $missing; do
    builder_platforms | grep -qxF "$p" || verdict fail "the builder cannot build $p"
  done
}
new_builder() {
  docker buildx create --name "$BUILDER" --driver docker-container \
    --driver-opt "image=$BUILD_BUILDKIT_IMAGE" >/dev/null || verdict fail "no buildx builder"
}
# The platforms the builder can build, one per line.
builder_platforms() {
  docker buildx inspect --bootstrap "$BUILDER" 2>/dev/null | sed -n 's/^Platforms:[[:space:]]*//p' | tr ',' '\n' | tr -d ' *'
}

cmd_publish() {
  local dry=0
  [[ "${1:-}" == --dry-run ]] && dry=1
  refuse_write_credentials GCP_ID_TOKEN
  check_inputs
  [[ -n "${BUILD_TAG:-}" ]] || verdict fail "publish needs a release tag (BUILD_TAG vX.Y.Z)"
  mkdir -p "$BUILD_OUT"
  BUILD_GITHUB_TOKEN="$(reader_token '"contents":"read","metadata":"read"' "$BUILD_REPO")" ||
    verdict fail "no read-only GitHub token (the tacplus-reader app)"
  export BUILD_GITHUB_TOKEN; git_credentials
  local src="$BUILD_OUT/publish-src" tmp name built pushed existing
  fetch_commit "$src"
  check_release "$src"
  [[ -f "$src/Dockerfile" ]] || verdict fail "$BUILD_REPO has no Dockerfile at $BUILD_SHA: nothing to publish"
  tmp="$(mktemp -d)"; BUILDER="looper-build-$$"
  # shellcheck disable=SC2064  # the builder and directory of this run
  trap "docker buildx rm '$BUILDER' >/dev/null 2>&1; rm -rf '$tmp'" EXIT
  setup_builder
  name="$BUILD_REGISTRY/$BUILD_REPO:${BUILD_TAG#v}"
  built="$(build_image "$src" "type=oci,dest=$tmp/image.tar" "$tmp")"
  [[ -n "$built" ]] || verdict fail "buildx reported no digest"
  log "built $name@$built"
  if ((dry)); then
    echo "$name@$built" > "$BUILD_OUT/image"
    log "dry run: nothing pushed"; return 0
  fi
  registry_login "$tmp"
  # An immutable release: an image already there must be this one.
  # (The digest is that of the manifest's bytes as the registry serves them.)
  if docker buildx imagetools inspect --raw "$name" > "$tmp/existing" 2>/dev/null && [[ -s "$tmp/existing" ]]; then
    existing="sha256:$(sha256sum < "$tmp/existing" | cut -d' ' -f1)"
    [[ "$existing" == "$built" ]] || verdict fail "$name is already published as $existing; this build gives $built"
    log "$name is already published, with this digest"
  else
    pushed="$(build_image "$src" "type=image,name=$name,push=true,oci-mediatypes=true" "$tmp")"
    [[ "$pushed" == "$built" ]] || verdict fail "not reproducible: the pushed image is $pushed, the build before it $built"
  fi
  echo "$name@$built" > "$BUILD_OUT/image"
  log "published $name@$built"
}

case "${1:-}" in
  plan) cmd_plan ;;
  gates) cmd_gates ;;
  status) shift; cmd_status "$@" ;;
  publish) shift; cmd_publish "$@" ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
