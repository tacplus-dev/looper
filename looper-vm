# looper-vm: the looper that runs on a project's own spot VM (looper#238;
# tacplus-dev/roadmap decisions/looper-build-vms-2026-11-24.md, points 2, 3,
# 5, 9 and 10). It changes where and how a report runs, not what it does: each
# issue is today's report, `repo-looper --repo NAME --issue N`, as a child.
#
#   looper-vm --repo NAME     the parent: works NAME's ready issues, all of them at once, until
#                             it is idle (exit 0: the VM shuts down) or SIGTERM (exit 0 within
#                             LOOPER_VM_STOP_GRACE seconds, each issue's work checkpointed);
#                             --repo again adds a repository to the same parent
#   looper-vm --org ORG [--except NAME,...]
#                             the same parent for an org's shared VM (decision point 12): every
#                             ORG repository with an open approved issue, less those named (each
#                             on a VM of its own), its children across all of them
#   looper-vm build --repo NAME [--issue N] --dir CHECKOUT --sha SHA [--gates SET] [--base SHA] --log FILE
#                             a local build: the gates of SHA (gates.yaml's SET, else its full,
#                             else `just gates`) in the build image the commit pins (build.lock,
#                             tacplus.lock), a child container through the VM's container socket,
#                             once one of the VM's LOOPER_VM_BUILDS slots is free (the wait said);
#                             the full log in FILE; exit 0 on a pass, 1 on a failure
#   looper-vm check --repo NAME | --org ORG [--except NAME,...]
#                             a rolling check machine's (looper#249; tacplus-dev/cloud#111's
#                             looper-role check): `looper-check --repo NAME --until-idle` for
#                             each repository (--org: the org's unarchived ones, less
#                             --except's), each a child started again LOOPER_VM_CHECK_RESTART
#                             seconds (default 60) after it ends while another still checks,
#                             its builds this machine's local builds; as the check's app
#                             (looper-token start check); once every check ended idle, exit 0
#                             (the machine sizes itself to 0); SIGTERM as the parent's
#   looper-vm merger --org ORG [--except NAME,...] | --repo NAME...
#                             the merger's machine (looper#251, tacplus-dev/cloud#111): no
#                             model, no container socket, no project code. Every
#                             LOOPER_MERGER_POLL seconds (default 60) one `looper-merger pass`
#                             per repository (--repo's, or each ORG repository with an open
#                             merge request into main, less --except's), one at a time, each
#                             at most LOOPER_MERGER_TIMEOUT seconds (default 900), as the
#                             merger's identity (looper-token's merger role); until SIGTERM
#                             (exit 0 at once: a pass holds no state, the next one starts over)
#   looper-vm --self-test     its tools, the container socket and the cache, checked
#
# The parent never blocks (decision point 2): its loop only schedules and
# records. Everything that waits (reading the forge, a report, its model, its
# builds) runs in a child process, with no limit on them and children of their
# own allowed. Every LOOPER_VM_POLL seconds it reaps the children that ended,
# starts a lister (`repo-looper --list`, at most one at a time, stopped after
# LOOPER_VM_LIST_TIMEOUT) when none runs, and starts a report for each issue
# the last list named that no child of its works. An issue whose report ended
# is not started again for LOOPER_VM_COOLDOWN seconds (a report that fails at
# once does not spin). Its records are in LOOPER_CACHE/vm: running (issue pid
# start, one a line, rewritten each pass), vm.log, and each report's log.
#
# Resume from the forge, never the disk (point 3): the parent reads nothing it
# wrote before it started. Its reports are LOOPER_VM's (repo-looper's VM mode):
# their --list names the ready issues and the ones looper:in-progress but
# otherwise ready, whose run a stopped VM left (this VM works its project
# alone: looper#241 starts no in-cluster report for it); a report resumes from
# the issue's work-in-progress branch and its checkpoint, as every report does.
#
# Shutdown (point 2; a spot VM gets about 30 s): on SIGTERM or SIGINT the
# parent signals its whole tree (each child and every descendant, whatever
# its process group) with SIGTERM once; each report checkpoints (its branch,
# and a comment on its issue) and exits; what still runs
# LOOPER_VM_STOP_GRACE - 3 seconds after the signal is killed, and the parent
# exits 0 within LOOPER_VM_STOP_GRACE (default 25).
#
# Idle exit: with no report running and no ready issue for LOOPER_VM_IDLE_MINUTES
# (default 15), it exits 0 and the VM shuts down (the kicker starts it again
# when the project has work: scale to zero). A list that fails counts as none.
#
# The cache (point 3), LOOPER_CACHE (default /cache; the cache disk, else any
# directory: it is only a cache). It must be at the same path on the VM's host
# (LOOPER_CACHE_HOST, if it is not), since the build containers bind-mount it:
#   .looper-vm        its stamp; a cache without it (half-written, another
#                     layout) is discarded, moved aside at once and removed by
#                     a child: never waited on, never repaired
#   git/NAME.git      one shared git object store: each report's clone borrows
#                     its objects (alternates), the clone's refs and work tree
#                     its own; a report refreshes it under a lock it waits
#                     LOOPER_STORE_LOCK seconds for at most, and the store is
#                     never pruned (gc.auto 0), so no borrowed object goes away.
#                     One git cannot read is discarded at start.
#   work              LOOPER_WORK: the reports' clones, LOOPER_WORK/NAME/issues/N
#   deps              the dependency and compiler caches every build container
#                     shares (Go's module and build caches, cargo's registry
#                     and git, npm's, Gradle's, sccache's and ccache's): stores
#                     whose tools lock or address by content, so two builds at
#                     once never corrupt them. Maven's local repository is not
#                     shared (it does not lock): each build has its own.
#   builds            each local build's checkout and verdict, removed after
#   vm                the parent's records
# A cache that cannot be written is left alone and a local one used
# (LOOPER_VM_LOCAL_CACHE, default $TMPDIR/looper-vm-cache): slower, never stuck.
#
# Local builds (point 4): a report's --build, and its pre-land gate, are a
# local build the report's looper runs (repo-looper's build_server, LOOPER_VM
# set): `looper-build gates-local` in the commit's pinned build image, a
# container started through the container socket (LOOPER_VM_DOCKER, default
# docker), the cache mounted at its own path. Feedback only: the merge path
# stays the manager's build (point 6), or, where a report's --land opens a
# merge request (looper#250), its build status, set off the VM. At most LOOPER_VM_BUILDS run at once
# (looper#248; default a quarter of the VM's CPUs): one that waits for a slot
# says so in its log, and for how long once it has one; the parent logs, each
# pass, the builds running and waiting and the longest wait, and names each
# build that starts waiting. A report's looper stops its run once it asks for
# more than LOOPER_VM_BUILDS_PER_ISSUE local builds (repo-looper's).
#
# Environment: GH_TOKEN and the model's credentials, as repo-looper's;
# LOOPER_CACHE, LOOPER_CACHE_HOST, LOOPER_VM_POLL (seconds, default 60),
# LOOPER_VM_LIST_EVERY (seconds between lists, default 300),
# LOOPER_VM_IDLE_MINUTES, LOOPER_VM_STOP_GRACE, LOOPER_VM_LIST_TIMEOUT (seconds,
# default 300), LOOPER_VM_COOLDOWN (seconds, default 300), LOOPER_VM_DOCKER, LOOPER_VM_BUILDS,
# LOOPER_VM_REPO_LOOPER (default the repo-looper beside this script),
# LOOPER_VM_LOOPER_BUILD (likewise, looper-build), LOOPER_VM_LOOPER_CHECK (likewise,
# looper-check), LOOPER_VM_CHECK_RESTART, LOOPER_VM_MERGER (likewise,
# looper-merger). The merger's machine is given no environment but the cache's,
# so its settings default here, each the deployment's to change: LOOPER_MERGER_KEY
# and LOOPER_MERGER_APP_ID (the app it merges as: the manager's, tacplus-manager,
# until tacplus-merger exists), LOOPER_MERGER_TRUSTED (whose green it reads:
# tacplus-reader[bot], the build off the VM's, looper#250), LOOPER_CHECK_LOGIN
# (whose state of the rolling check its gate reads: tacplus-manager[bot], the
# check machine's app until tacplus-check exists), LOOPER_MERGER_DIR (the gate's
# clones, $LOOPER_CACHE/merger), LOOPER_MERGER_POLL, LOOPER_MERGER_TIMEOUT.
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
HERE="$(dirname "$SELF")"
REPO_LOOPER="${LOOPER_VM_REPO_LOOPER:-$HERE/repo-looper}"
LOOPER_BUILD="${LOOPER_VM_LOOPER_BUILD:-$HERE/looper-build}"
LOOPER_CHECK="${LOOPER_VM_LOOPER_CHECK:-$HERE/looper-check}"
MERGER="${LOOPER_VM_MERGER:-$HERE/looper-merger}"
TOKEN_CMD="${LOOPER_TOKEN:-$HERE/looper-token}"
CACHE="${LOOPER_CACHE:-/cache}"
POLL="${LOOPER_VM_POLL:-60}"
IDLE=$(( ${LOOPER_VM_IDLE_MINUTES:-15} * 60 ))
STOP_GRACE="${LOOPER_VM_STOP_GRACE:-25}"
LIST_TIMEOUT="${LOOPER_VM_LIST_TIMEOUT:-300}"
# Seconds from one list's start to the next (looper#256): a list is dozens of
# forge calls a repository, and one a pass, a minute, on two VMs spent the
# GitHub App installation's hourly API limit (2026-11-26: every list refused,
# no issue taken up until the hour turned).
LIST_EVERY="${LOOPER_VM_LIST_EVERY:-300}"
COOLDOWN="${LOOPER_VM_COOLDOWN:-300}"
DOCKER="${LOOPER_VM_DOCKER:-docker}"
# The cache's layout: a cache with another stamp is discarded.
STAMP="looper-vm cache 1"

usage() { sed -n '5,/^set -euo pipefail$/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'; }
log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
die() { log "FATAL $*" >&2; exit 2; }

# --- the cache ----------------------------------------------------------------

# A directory to discard: moved aside at once, removed by a child the parent
# does not wait for.
discard() { # dir why
  local aside="$1.discarded-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  log "the cache $1 is discarded: $2"
  if mv "$1" "$aside" 2>/dev/null; then (rm -rf "$aside" >/dev/null 2>&1 &)
  else rm -rf "$1" 2>/dev/null || true; fi
}

# The cache, ready: LOOPER_CACHE when it can be written, else a local one; a
# stale or half-written one discarded, its git store too when git cannot read
# it. Sets CACHE. Never waits on the cache: every check is bounded.
cache_ready() {
  local probe
  if ! mkdir -p "$CACHE" 2>/dev/null || ! probe="$(mktemp "$CACHE/.probe.XXXXXX" 2>/dev/null)"; then
    log "the cache $CACHE cannot be written: a local one instead (slower, the same result)"
    CACHE="${LOOPER_VM_LOCAL_CACHE:-${TMPDIR:-/tmp}/looper-vm-cache}"; mkdir -p "$CACHE"
  else
    rm -f "$probe"
  fi
  if [[ "$(cat "$CACHE/.looper-vm" 2>/dev/null)" != "$STAMP" ]]; then
    if [[ -n "$(ls -A "$CACHE" 2>/dev/null)" ]]; then
      local f; for f in "$CACHE"/* "$CACHE"/.[!.]*; do
        [[ -e "$f" && "$f" != *.discarded-* && "$f" != "$CACHE/lost+found" ]] || continue   # a new disk's lost+found is the filesystem's
        discard "$f" "no stamp (\"$STAMP\"): another layout, or half-written"
      done
    fi
  fi
  local g; for g in "$CACHE"/git/*.git; do
    [[ -d "$g" ]] || continue
    timeout 20 git -C "$g" rev-parse -q --verify "refs/heads/main^{commit}" >/dev/null 2>&1 &&
      timeout 20 git -C "$g" count-objects >/dev/null 2>&1 || discard "$g" "git cannot read it"
  done
  cache_dirs
  echo "$STAMP" > "$CACHE/.looper-vm"
}
cache_dirs() {
  mkdir -p "$CACHE/git" "$CACHE/work" "$CACHE/builds" "$CACHE/vm" \
    "$CACHE/deps/go/mod" "$CACHE/deps/go/build" "$CACHE/deps/cargo/registry" "$CACHE/deps/cargo/git" \
    "$CACHE/deps/npm" "$CACHE/deps/gradle" "$CACHE/deps/sccache" "$CACHE/deps/ccache"
  # Each report's model is its own user (looper#68): the shared caches are everyone's.
  chmod 0755 "$CACHE" "$CACHE/git" "$CACHE/work" "$CACHE/builds" 2>/dev/null || true
  chmod 1777 "$CACHE/deps" "$CACHE"/deps/* "$CACHE"/deps/*/* 2>/dev/null || true
}

# --- the parent ---------------------------------------------------------------

# Every process of the trees under the pids given, the pids included: by
# parent pid, read from /proc, so a child that left its process group (timeout,
# setsid) is still in its parent's tree.
tree_of() { # pid...
  local -A kids=()
  local f line p pp st out=() queue=("$@")
  for f in /proc/[0-9]*/stat; do
    read -r line < "$f" 2>/dev/null || continue
    p="${line%% *}"; read -r st pp _ <<<"${line##*) }"
    kids[$pp]+=" $p"
  done
  while (( ${#queue[@]} )); do
    p="${queue[0]}"; queue=("${queue[@]:1}")
    [[ -d "/proc/$p" ]] || continue
    out+=("$p")
    # shellcheck disable=SC2206
    [[ -z "${kids[$p]:-}" ]] || queue+=(${kids[$p]})
  done
  echo "${out[*]}"
}

declare -A CHILD=() ENDED=()   # REPO#N -> pid; REPO#N -> when its report ended
LISTER="" LISTED=0 LISTED_AT=0 IDLE_SINCE="" STOPPING="" STATE="" SLOTS=1

record() { # the running children, for a person or a test to read
  local n
  { for n in "${!CHILD[@]}"; do echo "$n ${CHILD[$n]}"; done; } > "$STATE/running.new"
  mv -f "$STATE/running.new" "$STATE/running"
}

# A report of the issue, as a child: today's report, in this VM's mode.
start_report() { # REPO#N
  local k="$1" r="${1%%#*}" n="${1#*#}"
  LOOPER_VM="$SELF" LOOPER_WORK="$CACHE/work" LOOPER_GIT_STORE="$CACHE/git/$r.git" LOOPER_CACHE="$CACHE" \
    LOOPER_RUNS="$CACHE/work/$r/runs" \
    "$REPO_LOOPER" --repo "$r" --issue "$n" >> "$STATE/$r-$n.log" 2>&1 < /dev/null &
  CHILD[$k]=$!
  log "$k: its report started (pid $!, log $STATE/$r-$n.log)"
}

# The repositories this parent works, one a line: those --repo named, or
# (--org) the org's with an open approved issue (one search, not a list per
# repository: an org has dozens), less --except's. Only public ones, as the
# kicker's search, unless LOOPER_PRIVATE_REPORTS is 1.
vm_repos() {
  if [[ -z "$ORG" ]]; then printf '%s\n' "${REPOS[@]}"; return 0; fi
  local vis=(--visibility public) names
  [[ "${LOOPER_PRIVATE_REPORTS:-}" != 1 ]] || vis=()
  names="$(timeout -k 5 60 gh search issues --owner "$ORG" --state open --label "${LOOPER_VM_LABEL:-approved}" --limit 1000 \
    --json repository --jq '.[].repository.name' "${vis[@]}" < /dev/null)" || return 1
  local skip=(-e '') x
  for x in ${EXCEPT//,/ }; do skip+=(-e "$x"); done
  sort -u <<<"$names" | grep -vxF "${skip[@]}" || true
}

# The lister, a child: each repository's `repo-looper --list`, its issues as
# "REPO N" lines. One repository whose list fails costs only its own issues,
# not the others' (it says so and exits 1).
list_all() {
  local r rs rc=0 out
  rs="$(vm_repos)" || { log "the repositories of $ORG could not be read (gh search)" >&2; return 1; }
  for r in $rs; do
    if out="$(timeout -k 5 "$LIST_TIMEOUT" env LOOPER_VM="$SELF" LOOPER_WORK="$CACHE/work" "$REPO_LOOPER" --repo "$r" --list < /dev/null)"; then
      sed -n "s/^\([0-9][0-9]*\)\$/$r \1/p" <<<"$out"
    else rc=1; log "the list of $r's ready issues failed" >&2; fi
  done
  return "$rc"
}

# The children that ended, reaped: `wait` on one that ended does not block.
reap() {
  local n rc
  for n in "${!CHILD[@]}"; do
    kill -0 "${CHILD[$n]}" 2>/dev/null && continue
    rc=0; wait "${CHILD[$n]}" 2>/dev/null || rc=$?
    log "$n: its report ended (exit $rc); not started again for ${COOLDOWN}s"
    ENDED[$n]=$(date +%s); unset "CHILD[$n]"
  done
  if [[ -n "$LISTER" ]] && ! kill -0 "$LISTER" 2>/dev/null; then
    rc=0; wait "$LISTER" 2>/dev/null || rc=$?
    mv -f "$STATE/list.new" "$STATE/list"
    (( rc == 0 )) || log "the list of $WHAT failed (exit $rc): only what it named is taken: $(tail -n 2 "$STATE/vm.log" 2>/dev/null | tr '\n' ' ' | cut -c1-300)"
    LISTER=""; LISTED=1
  fi
}

# One pass: never waits on anything but its own short file reads.
pass() {
  local r n k now; now=$(date +%s)
  reap
  if [[ -z "$LISTER" ]] && (( now - LISTED_AT >= LIST_EVERY )); then
    list_all > "$STATE/list.new" 2>> "$STATE/vm.log" < /dev/null &
    LISTER=$!; LISTED_AT=$now
  fi
  local ready=0
  if [[ -s "$STATE/list" ]]; then
    while read -r r n; do
      [[ "$r" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$n" =~ ^[0-9]+$ ]] || continue
      ready=1; k="$r#$n"
      [[ -z "${CHILD[$k]:-}" ]] || continue
      (( now - ${ENDED[$k]:-0} >= COOLDOWN )) || continue
      start_report "$k"
    done < "$STATE/list"
  fi
  record
  builds_said
  if (( ${#CHILD[@]} || ready || ! LISTED )); then IDLE_SINCE=""
  else
    IDLE_SINCE="${IDLE_SINCE:-$now}"
    if (( now - IDLE_SINCE >= IDLE )); then
      log "idle: no report running and no ready issue in $WHAT for $(( IDLE / 60 ))m: exiting (the VM shuts down)"
      [[ -z "$LISTER" ]] || kill -TERM $(tree_of "$LISTER") 2>/dev/null || true
      exit 0
    fi
  fi
}

# SIGTERM: the tree signalled once (a process started after, a checkpoint's
# push, is not), the reports' checkpoints given until 3 seconds before the
# grace, the rest killed, and the parent out within the grace.
stop() {
  [[ -z "$STOPPING" ]] || return 0
  STOPPING=$(date +%s)
  local roots=("${CHILD[@]}") pids n
  [[ -z "$LISTER" ]] || roots+=("$LISTER")
  log "SIGTERM: stopping ${#CHILD[@]} report(s) (${!CHILD[*]}); each checkpoints its work, and this exits within ${STOP_GRACE}s"
  pids="$(tree_of "${roots[@]}")"
  # shellcheck disable=SC2086
  [[ -z "$pids" ]] || kill -TERM $pids 2>/dev/null || true
  while (( $(date +%s) < STOPPING + STOP_GRACE - 3 )); do
    for n in "${!CHILD[@]}"; do kill -0 "${CHILD[$n]}" 2>/dev/null || { wait "${CHILD[$n]}" 2>/dev/null || true; unset "CHILD[$n]"; }; done
    (( ${#CHILD[@]} )) || break
    sleep 0.2
  done
  pids="$(tree_of "${CHILD[@]}" ${LISTER:+"$LISTER"})"
  if [[ -n "$pids" ]]; then
    log "killing what still runs $(( STOP_GRACE - 3 ))s after SIGTERM: report(s) ${!CHILD[*]}"
    # shellcheck disable=SC2086
    kill -KILL $pids 2>/dev/null || true
  fi
  CHILD=(); [[ -z "${STATE:-}" ]] || record
  log "stopped in $(( $(date +%s) - STOPPING ))s"
  exit 0
}

# The VM's credentials (tacplus-dev/cloud#108): nothing secret is in the VM's
# metadata or its cloud-init. The reports mint their GitHub tokens themselves
# (repo-looper through looper-token, which on a VM signs as the VM's own
# service account); the deployment's app and key ring default to tacplus-dev's
# (not secrets: an app's id and a key ring's path). The model's token is read
# once, here, from Secret Manager as the VM's account, and passed to the
# children in their environment; a VM that cannot read it stops at once,
# saying so, rather than start reports that cannot run.
vm_credentials() {
  export LOOPER_KMS_KEYRING="${LOOPER_KMS_KEYRING:-projects/tacplus-ci/locations/us-central1/keyRings/looper}"
  export LOOPER_REPORT_APP_ID="${LOOPER_REPORT_APP_ID:-5632122}"
  export LOOPER_REPORT_INSTALLATION_ID="${LOOPER_REPORT_INSTALLATION_ID:-179024135}"
  [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}${ANTHROPIC_API_KEY:-}" ]] && return 0
  local secret="${LOOPER_VM_MODEL_SECRET:-looper-model-token}" project="${LOOPER_VM_SECRET_PROJECT:-tacplus-ci}" t
  t="$(timeout 60 gcloud secrets versions access latest --secret="$secret" --project="$project" 2>"$STATE/secret-err")" && [[ -n "$t" ]] ||
    die "no model token: Secret Manager $project/$secret refused this VM's account: $(tr '\n' ' ' < "$STATE/secret-err" | cut -c1-300)"
  export CLAUDE_CODE_OAUTH_TOKEN="$t"; rm -f "$STATE/secret-err"
}

# The parent's own GitHub identity, for its lister (looper#238): repo-looper
# mints a token for a report's run, never for --list, which in GitLab runs
# under the plan's. Here the parent holds the report app's token as gh's
# configuration, kept fresh by looper-token for the parent's life, and its
# lister reads it (GH_CONFIG_DIR); each report still mints its own. Without
# it gh had no login and every list failed (exit 4), the VM idled and stopped.
vm_identity() { # role (default report)
  [[ -z "${GH_TOKEN:-}" ]] || return 0
  local d="$STATE/gh" role="${1:-report}"; rm -rf "$d"; mkdir -p "$d"; chmod 0700 "$d"
  # LOOPER_VM tells looper-token it is on a VM (sign as the VM's account, no
  # id_token); the parent is a VM's too, not only its children.
  LOOPER_VM="$SELF" "$TOKEN_CMD" start "$role" "$d" $$ >/dev/null 2>>"$STATE/vm.log" ||
    die "no $role token for the $(case "$role" in report) echo lister ;; *) echo "$role" ;; esac) (looper-token start $role): $(tail -n 3 "$STATE/vm.log" | tr '\n' ' ' | cut -c1-300)"
  export GH_CONFIG_DIR="$d" GH_NO_UPDATE_NOTIFIER=1
}

# --repo's or --org's, checked; WHAT says which.
targets() {
  local r
  if [[ -n "$ORG" ]]; then
    (( ${#REPOS[@]} == 0 )) || die "--org and --repo are one or the other"
    [[ "$ORG" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "--org '$ORG' is not an org's name"
    [[ "$EXCEPT" =~ ^([A-Za-z0-9][A-Za-z0-9._-]*(,[A-Za-z0-9][A-Za-z0-9._-]*)*)?$ ]] || die "--except '$EXCEPT' is not NAME,..."
    WHAT="$ORG${EXCEPT:+ (but ${EXCEPT//,/, })}"
  else
    [[ -z "$EXCEPT" ]] || die "--except goes with --org"
    (( ${#REPOS[@]} )) || die "--repo NAME (or --org ORG) is required"
    for r in "${REPOS[@]}"; do [[ "$r" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "--repo '$r' is not a repository's name"; done
    WHAT="${REPOS[*]}"; WHAT="${WHAT// /, }"
  fi
}

parent() {
  targets
  for v in POLL STOP_GRACE LIST_TIMEOUT LIST_EVERY COOLDOWN; do [[ "${!v}" =~ ^[0-9]+$ ]] || die "LOOPER_VM_$v '${!v}' is not a number of seconds"; done
  SLOTS="$(build_slots)" || exit 2
  (( STOP_GRACE >= 5 )) || die "LOOPER_VM_STOP_GRACE '$STOP_GRACE' is under 5 seconds"
  trap stop TERM INT
  cache_ready
  STATE="$CACHE/vm"; mkdir -p "$STATE"; rm -f "$STATE/list" "$STATE/list.new"
  vm_credentials
  vm_identity
  log "looper-vm of $WHAT: cache $CACHE, a pass every ${POLL}s, idle exit after $(( IDLE / 60 ))m, $SLOTS local build(s) at once"
  local z
  while :; do
    pass
    sleep "$POLL" & z=$!
    wait "$z" 2>/dev/null || true
  done
}

# --- a rolling check machine (looper#249) -----------------------------------------
#
# tacplus-dev/cloud#111's reserved machines: one for tacplus, one for the rest
# of the org, never spot, each running only while there is something to check
# (Jody, 2026-11-25: builders run only while used). Each repository's check is
# a child, `looper-check --repo NAME --until-idle`, back to back (its builds
# `looper-vm build`, this machine's slots), ending once its main is unmoved
# (exit 0, idle); one that ends is started again after LOOPER_VM_CHECK_RESTART
# seconds while another still checks, and once every check ended idle the
# machine's check ends, exit 0, and the machine sizes itself to 0. What starts
# it again is the orchestrator, the merger's always-on machine, on a
# `looper-check needed` of one of its repositories. With --org the
# repositories are listed again each LOOPER_VM_CHECK_RESTART seconds too, a
# failed list keeping the last. Its GitHub identity is the check's app
# (looper-token's role check: tacplus-check, else tacplus-manager; statuses,
# main-green, a revert's branch and pull request, the issues it files), never
# a report's: what the merger trusts.

# The repositories checked, one a line.
check_repos() {
  if [[ -z "$ORG" ]]; then printf '%s\n' "${REPOS[@]}"; return 0; fi
  local names skip=(-e '') x
  names="$(timeout -k 5 60 gh repo list "$ORG" --no-archived --source --limit 1000 --json name --jq '.[].name' < /dev/null)" || return 1
  for x in ${EXCEPT//,/ }; do skip+=(-e "$x"); done
  sort -u <<<"$names" | grep -vxF "${skip[@]}" || true
}

check_parent() {
  targets
  local restart="${LOOPER_VM_CHECK_RESTART:-60}" r rc now listed=0 repos=() z idle
  local -A IDLE_R=()   # REPO -> its last check ended idle
  [[ "$restart" =~ ^[0-9]+$ ]] || die "LOOPER_VM_CHECK_RESTART '$restart' is not a number of seconds"
  [[ "$STOP_GRACE" =~ ^[0-9]+$ ]] && (( STOP_GRACE >= 5 )) || die "LOOPER_VM_STOP_GRACE '$STOP_GRACE' is not 5 seconds or more"
  SLOTS="$(build_slots)" || exit 2
  trap stop TERM INT
  cache_ready
  STATE="$CACHE/vm"; mkdir -p "$STATE"
  export LOOPER_KMS_KEYRING="${LOOPER_KMS_KEYRING:-projects/tacplus-ci/locations/us-central1/keyRings/looper}"
  vm_identity check
  log "the rolling check of $WHAT: cache $CACHE, $SLOTS local build(s) at once"
  while :; do
    now=$(date +%s)
    for r in "${!CHILD[@]}"; do
      kill -0 "${CHILD[$r]}" 2>/dev/null && continue
      rc=0; wait "${CHILD[$r]}" 2>/dev/null || rc=$?
      log "$r: its check ended (exit $rc): started again in ${restart}s while another checks"
      ENDED[$r]=$now; unset "CHILD[$r]"
      if (( rc == 0 )); then IDLE_R[$r]=1; else unset "IDLE_R[$r]"; fi
    done
    if (( now - listed >= restart )); then
      if mapfile -t z < <(check_repos) && wait $! && (( ${#z[@]} )); then repos=("${z[@]}")
      else log "the repositories of $WHAT could not be listed: the last list kept (${repos[*]:-none})"; fi
      listed=$now
    fi
    if (( ${#CHILD[@]} == 0 && ${#repos[@]} )); then
      idle=1; for r in "${repos[@]}"; do [[ -n "${IDLE_R[$r]:-}" ]] || idle=0; done
      (( idle == 0 )) || { log "nothing to check in $WHAT: every check ended idle, the machine's check ends"; exit 0; }
    fi
    for r in "${repos[@]}"; do
      [[ "$r" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && -z "${CHILD[$r]:-}" ]] || continue
      (( now - ${ENDED[$r]:-0} >= restart )) || continue
      LOOPER_VM="$SELF" LOOPER_CACHE="$CACHE" LOOPER_CHECK_DIR="$CACHE/check" LOOPER_CHECK_BUILD="$SELF build" \
        "$LOOPER_CHECK" --repo "$r" --until-idle >> "$STATE/check-$r.log" 2>&1 < /dev/null &
      CHILD[$r]=$!
      log "$r: its check started (pid $!, log $STATE/check-$r.log)"
    done
    record
    builds_said
    sleep "$POLL" & z=$!
    wait "$z" 2>/dev/null || true
  done
}

# --- the merger's machine (looper#251) ------------------------------------------

# The repositories a merger's pass takes, one a line: --repo's, or (--org) the
# org's with an open merge request into main (one search), less --except's.
merger_repos() {
  if [[ -z "$ORG" ]]; then printf '%s\n' "${REPOS[@]}"; return 0; fi
  local names skip=(-e '') x
  names="$(timeout -k 5 60 gh search prs --owner "$ORG" --state open --base main --limit 1000 \
    --json repository --jq '.[].repository.name' < /dev/null)" || return 1
  for x in ${EXCEPT//,/ }; do skip+=(-e "$x"); done
  sort -u <<<"$names" | grep -vxF "${skip[@]}" || true
}

merger_stop() {
  log "SIGTERM: the merger stops${PASS:+ (its pass of $PASS_OF with it)}"
  # shellcheck disable=SC2046
  [[ -z "$PASS" ]] || kill -TERM $(tree_of "$PASS") 2>/dev/null || true
  exit 0
}

merger_machine() {
  local r rs rc z poll="${LOOPER_MERGER_POLL:-60}" limit="${LOOPER_MERGER_TIMEOUT:-900}"
  targets
  for v in poll limit; do [[ "${!v}" =~ ^[0-9]+$ ]] || die "LOOPER_MERGER_${v^^} '${!v}' is not a number of seconds"; done
  PASS="" PASS_OF=""
  trap merger_stop TERM INT
  cache_ready
  STATE="$CACHE/vm"; mkdir -p "$STATE"
  export LOOPER_ORG="${ORG:-${LOOPER_ORG:-tacplus-dev}}" LOOPER_FORGE=github
  export LOOPER_KMS_KEYRING="${LOOPER_KMS_KEYRING:-projects/tacplus-ci/locations/us-central1/keyRings/looper}"
  export LOOPER_MERGER_KEY="${LOOPER_MERGER_KEY:-tacplus-manager}" LOOPER_MERGER_APP_ID="${LOOPER_MERGER_APP_ID:-5632100}"
  export LOOPER_MERGER_TRUSTED="${LOOPER_MERGER_TRUSTED:-tacplus-reader[bot]}" LOOPER_CHECK_LOGIN="${LOOPER_CHECK_LOGIN:-tacplus-manager[bot]}"
  export LOOPER_MERGER_DIR="${LOOPER_MERGER_DIR:-$CACHE/merger}"
  mkdir -p "$LOOPER_MERGER_DIR"
  vm_identity merger
  log "the merger of $WHAT: a pass every ${poll}s as $LOOPER_MERGER_KEY's app $LOOPER_MERGER_APP_ID, green the status of $LOOPER_MERGER_TRUSTED, the rolling check $LOOPER_CHECK_LOGIN's"
  while :; do
    rs="$(merger_repos)" || { log "the repositories of $ORG with a merge request could not be read (gh search): none this pass"; rs=""; }
    for r in $rs; do
      [[ "$r" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
      rc=0; PASS_OF="$r"
      timeout -k 10 "$limit" "$MERGER" pass --repo "$r" < /dev/null > "$STATE/merger-pass.log" 2>&1 & PASS=$!
      wait "$PASS" || rc=$?
      PASS=""
      cat "$STATE/merger-pass.log"
      (( rc == 0 )) || log "$r: the merger's pass failed (exit $rc): $(tail -n 2 "$STATE/merger-pass.log" | tr '\n' ' ' | cut -c1-300)"
    done
    sleep "$poll" & z=$!
    wait "$z" 2>/dev/null || true
  done
}

# --- build slots (looper#248) ----------------------------------------------------
#
# At most LOOPER_VM_BUILDS local builds run at once on the VM (default a
# quarter of its CPUs, at least 1): several full gate runs sharing 8 CPUs all
# crawl. Each running build holds the lock of one slot (slots/slot-N) for its
# life, its lock going with it however it ends; one that finds none free
# waits, first come first served, one waiting build an issue (a newer request
# of the issue takes the older one's place). Each says what it is in a marker the parent
# reads (slots/wait-PID while it waits, slots/run-PID while it runs: when it
# started waiting, then how long it waited, and REPO#N SHA7).

# The VM's limit: LOOPER_VM_BUILDS, or its CPUs' quarter.
build_slots() {
  local n="${LOOPER_VM_BUILDS:-}"
  if [[ -z "$n" ]]; then n=$(( $(nproc 2>/dev/null || echo 4) / 4 )); (( n >= 1 )) || n=1; fi
  [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 )) || die "LOOPER_VM_BUILDS '$n' is not a number of builds"
  echo "$n"
}

# The live markers of a kind (wait, run): "PID ITS-LINE" lines. A dead build's
# (killed outright, its EXIT trap never run) is removed.
slot_markers() { # kind
  local f p l
  for f in "$CACHE/vm/slots/$1"-*; do
    [[ -f "$f" ]] || continue
    p="${f##*-}"
    if [[ -d "/proc/$p" ]] && l="$(cat "$f" 2>/dev/null)"; then echo "$p $l"; else rm -f "$f"; fi
  done
}

# A slot taken for this build (SLOT, its lock on the descriptor SLOT_FD), or
# waited for: the wait said in its log when it starts, every minute, and when
# it ends, with how long.
take_slot() { # what (REPO#N SHA7)
  local d="$CACHE/vm/slots" n i t0 q0 said="" now first p t what
  n="$(build_slots)"; mkdir -p "$d"
  t0=$(date +%s); q0="$t0"
  # One waiting build an issue: a run that asks again (a newer commit, or the
  # same one after its checkpoint) takes the place of its issue's build that
  # still waits, and keeps that place in the queue. Without it the queue filled
  # with builds nobody read any more (2026-11-26: 13 and 28 waiting, for 12 and
  # 22 issues), each taking a slot for a superseded commit when its turn came.
  if [[ "${1% *}" == *"#"* ]]; then
    while read -r p t what; do
      [[ -n "$p" && "$p" != "$$" && "${what% *}" == "${1% *}" ]] || continue
      (( t >= q0 )) || q0="$t"
      kill -TERM "$p" 2>/dev/null || true; rm -f "$d/wait-$p"
      echo "took the place of ${1% *}'s waiting build of ${what##* } (waiting for $(( t0 - t ))s): one waiting build an issue"
    done < <(slot_markers wait)
  fi
  echo "$q0 $1" > "$d/.new-$$" && mv -f "$d/.new-$$" "$d/wait-$$"
  while :; do
    first="$(slot_markers wait | sort -k2,2n -k1,1n | head -n 1 | cut -d' ' -f1)"
    if [[ "$first" == "$$" ]]; then
      for (( i = 1; i <= n; i++ )); do
        exec {SLOT_FD}>>"$d/slot-$i"
        if flock -n "$SLOT_FD"; then SLOT="$i"; break 2; fi
        exec {SLOT_FD}>&-
      done
    fi
    now=$(date +%s)
    if [[ -z "$said" ]]; then
      echo "waiting for a build slot: all $n of this looper VM's (LOOPER_VM_BUILDS) are taken: $(slot_markers run | cut -d' ' -f4- | paste -sd, - | sed 's/,/, /g')"; said="$now"
    elif (( now - said >= 60 )); then
      echo "still waiting for a build slot: $(( now - t0 ))s so far"; said="$now"
    fi
    sleep 1
  done
  now=$(date +%s)
  echo "$t0 $(( now - t0 )) $1" > "$d/.new-$$" && mv -f "$d/.new-$$" "$d/run-$$"; rm -f "$d/wait-$$"
  if [[ -n "$said" ]]; then echo "took build slot $SLOT of $n after $(( now - t0 ))s waiting"
  else echo "build slot $SLOT of $n (LOOPER_VM_BUILDS)"; fi
}

# The parent's word on the VM's builds, each pass: how many run and wait, the
# longest wait, and each build that started waiting since the last pass.
declare -A WAITING=()
builds_said() {
  local now runs waits p t what nw=0 longest=0
  local -A seen=()
  now=$(date +%s)
  runs="$(slot_markers run)"; waits="$(slot_markers wait)"
  while read -r p t what; do
    [[ -n "$p" ]] || continue
    nw=$(( nw + 1 )); seen[$p]=1
    (( now - t <= longest )) || longest=$(( now - t ))
    [[ -n "${WAITING[$p]:-}" ]] || log "${what% *}: its local build of ${what##* } waits for a build slot ($(grep -c . <<<"$runs" || true) of $SLOTS run)"
  done <<<"$waits"
  WAITING=(); for p in "${!seen[@]}"; do WAITING[$p]=1; done
  log "builds: $(grep -c . <<<"$runs" || true) running, $nw waiting$( (( nw == 0 )) || echo " (the longest for ${longest}s)"), of $SLOTS slots"
}

# --- a local build ------------------------------------------------------------

# The build image the checkout pins (looper-build's read_pin reads the same lines).
pin_of() { # dir
  local f; for f in tacplus.lock build.lock; do
    [[ -f "$1/$f" ]] || continue
    sed -n 's/^build_image:[[:space:]]*"\{0,1\}\([^"[:space:]]*\)"\{0,1\}[[:space:]]*$/\1/p' "$1/$f" | head -n 1 | grep . && return 0
  done
  return 1
}

# An image's environment variable, from its configuration.
image_env() { # image name
  "$DOCKER" image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$1" 2>/dev/null | sed -n "s/^$2=//p" | head -n 1
}

# The cache's path on the host, for a bind mount through the socket.
host_path() { local h="${LOOPER_CACHE_HOST:-$CACHE}"; echo "$h${1#"$CACHE"}"; } # path under the cache

build() {
  local dir="" sha="" gates="" base="" logf="" issue=""
  while (( $# )); do
    case "$1" in
      --repo) REPO="$2"; shift 2 ;; --issue) issue="$2"; shift 2 ;; --dir) dir="$2"; shift 2 ;; --sha) sha="$2"; shift 2 ;;
      --gates) gates="$2"; shift 2 ;; --base) base="$2"; shift 2 ;; --log) logf="$2"; shift 2 ;;
      *) die "build: unknown argument $1" ;;
    esac
  done
  [[ -n "$REPO" && -d "$dir" && "$sha" =~ ^[0-9a-f]{40}$ && "$base" =~ ^([0-9a-f]{40})?$ && -n "$logf" ]] ||
    die "build needs --repo NAME --dir CHECKOUT --sha SHA --log FILE"
  [[ "$gates" =~ ^([A-Za-z0-9_-]+(\+[A-Za-z0-9_-]+)*)?$ ]] || die "build: '$gates' is not a gate set"
  [[ "$issue" =~ ^([0-9]+)?$ ]] || die "build: --issue '$issue' is not an issue's number"
  build_slots >/dev/null
  : > "$logf"
  exec >> "$logf" 2>&1
  cache_dirs
  local b objects image id rc=0 cargo m=()
  b="$(mktemp -d "$CACHE/builds/$REPO-XXXXXX")"; chmod 0755 "$b"
  # shellcheck disable=SC2064
  trap "rm -rf '$b' '$CACHE/vm/slots/wait-$$' '$CACHE/vm/slots/run-$$'" EXIT
  trap 'echo "verdict: failure: ended before its gates ran: the VM is stopping, or a newer local build of this issue took its place in the queue"; exit 143' TERM
  # Its own checkout of the commit, borrowing the report's objects (and through
  # them the shared store's): the report's own work tree is the model's.
  objects="$(cd "$dir" && cd "$(git rev-parse --git-common-dir)/objects" && pwd)" || { echo "verdict: failure: $dir is no git checkout"; exit 1; }
  git init -q "$b/src" && echo "$objects" > "$b/src/.git/objects/info/alternates"
  git -C "$b/src" -c advice.detachedHead=false checkout -q --detach "$sha" 2>/dev/null ||
    { echo "verdict: failure: the commit $sha is not in $dir"; exit 1; }
  image="$(pin_of "$b/src")" || { echo "verdict: failure: $REPO pins no build image at ${sha:0:7} (build.lock, tacplus.lock): nothing built"; exit 1; }
  cp "$LOOPER_BUILD" "$b/looper-build"; mkdir -p "$b/out"
  id="looper-vm-$REPO-${sha:0:12}-$$"
  echo "local build of $REPO ${sha:0:7}, the gates ${gates:-full}${base:+ on base ${base:0:7}}, in $image (container $id)"
  take_slot "$REPO${issue:+#$issue} ${sha:0:7}"
  # The slot's lock is this script's alone: what a build leaves running does not hold it.
  "$DOCKER" pull -q "$image" >/dev/null 2>&1 {SLOT_FD}>&- || true   # by digest: a failure here is the run's to say
  cargo="$(image_env "$image" CARGO_HOME)" || cargo=""
  [[ -n "$cargo" ]] || cargo=/root/.cargo
  m=(-v "$(host_path "$CACHE"):$CACHE"
     -v "$(host_path "$CACHE/deps/cargo/registry"):$cargo/registry" -v "$(host_path "$CACHE/deps/cargo/git"):$cargo/git")
  trap '"$DOCKER" rm -f "$id" >/dev/null 2>&1; exit 143' TERM
  "$DOCKER" run --rm --name "$id" --label "looper-vm=$REPO" "${m[@]}" -w "$b/src" \
    -e BUILD_REPO="$REPO" -e BUILD_SHA="$sha" -e BUILD_GATES="$gates" -e BUILD_BASE="$base" -e BUILD_IMAGE="$image" \
    -e BUILD_SRC="$b/src" -e BUILD_OUT="$b/out" \
    -e GOMODCACHE="$CACHE/deps/go/mod" -e GOCACHE="$CACHE/deps/go/build" -e npm_config_cache="$CACHE/deps/npm" \
    -e GRADLE_USER_HOME="$CACHE/deps/gradle" -e SCCACHE_DIR="$CACHE/deps/sccache" -e CCACHE_DIR="$CACHE/deps/ccache" \
    "$image" bash "$b/looper-build" gates-local < /dev/null {SLOT_FD}>&- || rc=$?
  local v; v="$(cat "$b/out/build-verdict" 2>/dev/null)" || v=""
  if [[ "$v" == pass && "$rc" == 0 ]]; then echo "verdict: success: the gates ${gates:-full} passed"; exit 0; fi
  echo "verdict: failure: ${v:-the build container exited $rc with no verdict}"
  exit 1
}

# --- the self-test (looper#239's image) ----------------------------------------

self_test() {
  local t bad=0
  for t in bash git jq gh claude timeout flock "$DOCKER"; do
    command -v "$t" >/dev/null || { echo "self-test: no $t on the PATH"; bad=1; }
  done
  [[ -x "$REPO_LOOPER" ]] || { echo "self-test: no repo-looper at $REPO_LOOPER"; bad=1; }
  [[ -f "$LOOPER_BUILD" ]] || { echo "self-test: no looper-build at $LOOPER_BUILD"; bad=1; }
  if command -v "$DOCKER" >/dev/null && ! timeout 20 "$DOCKER" version >/dev/null 2>&1; then
    echo "self-test: $DOCKER cannot reach the container socket"; bad=1
  fi
  REPO=self-test cache_ready >/dev/null
  echo "self-test: cache $CACHE"
  (( bad == 0 )) && echo "self-test: ok"
  return "$bad"
}

REPO="" REPOS=() ORG="" EXCEPT="" WHAT=""
case "${1:-}" in
  build) shift; build "$@" ;;
  check)
    shift
    while (( $# )); do
      case "$1" in
        --repo) REPOS+=("${2:-}"); shift 2 || die "--repo needs a name" ;;
        --org) ORG="${2:-}"; shift 2 || die "--org needs a name" ;;
        --except) EXCEPT="${2:-}"; shift 2 || die "--except needs NAME,..." ;;
        *) die "unknown argument $1 (looper-vm --help)" ;;
      esac
    done
    check_parent ;;
  merger)
    shift
    while (( $# )); do
      case "$1" in
        --repo) REPOS+=("${2:-}"); shift 2 || die "--repo needs a name" ;;
        --org) ORG="${2:-}"; shift 2 || die "--org needs a name" ;;
        --except) EXCEPT="${2:-}"; shift 2 || die "--except needs NAME,..." ;;
        *) die "merger: unknown argument $1 (looper-vm --help)" ;;
      esac
    done
    merger_machine ;;
  --self-test) self_test ;;
  -h|--help|"") usage ;;
  *)
    while (( $# )); do
      case "$1" in
        --repo) REPOS+=("${2:-}"); shift 2 || die "--repo needs a name" ;;
        --org) ORG="${2:-}"; shift 2 || die "--org needs a name" ;;
        --except) EXCEPT="${2:-}"; shift 2 || die "--except needs NAME,..." ;;
        *) die "unknown argument $1 (looper-vm --help)" ;;
      esac
    done
    parent ;;
esac
